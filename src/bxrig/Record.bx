// `bxrig record [toggle|start|stop|status] [--region] [--audio=desktop|mic] [--webcam[=CORNER]] [--webcam-size=small|medium|large]`: screen
// recording on Wayland with wf-recorder. --webcam puts your webcam in a corner (bottom-right unless you name one: bottom-left, top-right,
// top-left) while it records, so it is part of the video; the bubble ends with the recording. Hyprland pins it in the corner (the BxRig module's
// rules); on Plasma it opens as a normal small window you can drag.
//   start    records the screen (or with --region the area you drag with slurp) to ~/Videos/bxrig-YYYYMMDD-HHMMSS.mp4
//            --audio=desktop adds what the speakers play (the monitor of the default sink), --audio=mic the default microphone;
//            both come from `pactl`. wf-recorder takes one audio source, so desktop and microphone together are not offered
//   stop     ends the recording (SIGINT, so the file is finished properly)
//   toggle   start when nothing is recording, stop when something is (the Hyprland shortcut uses this; it is the default action)
//   status   recording or not
// Exit: 0 done, 2 an unknown --audio value, 4 precondition (wf-recorder, slurp or pactl missing), 6 could not start or stop.
class Record {
	function init( cli, runner = "" ) {
		variables.text = new bxrig.util.Text();
		variables.cli = arguments.cli;
		variables.proc = new bxrig.util.Proc( arguments.runner );
		return this;
	}

	function recording() { return variables.proc.exec( [ "pgrep", "-x", "wf-recorder" ], 10 ).exitCode == 0; }
	function folder() { return new bxrig.util.Env().named( "videos", new bxrig.util.Env().named( "home", "" ) & "/Videos" ); }

	function audioKinds() { return [ "desktop", "mic" ]; }

	// The wf-recorder audio device for --audio: the monitor of the default sink (desktop) or the default source (mic); "" when pactl cannot say.
	function audioSource( audio ) {
		if ( !variables.proc.has( "pactl" ) ) return "";
		var r = variables.proc.exec( [ "pactl", arguments.audio == "desktop" ? "get-default-sink" : "get-default-source" ], 10 );
		var name = r.exitCode == 0 ? trim( r.output ) : "";
		return len( name ) && arguments.audio == "desktop" ? name & ".monitor" : name;
	}

	// The webcam bubble: started before the recording when --webcam is given, ended with it (only when the recording started it).
	function webcamMark() { return new bxrig.util.Env().state( "record-webcam" ); }

	function startWebcam( corner, size ) {
		var wc = new bxrig.Webcam( variables.cli );
		variables.proc.detach( wc.overlayArgv( arguments.corner, arguments.size ) );
		var f = webcamMark();
		directoryCreate( getDirectoryFromPath( f ), true, true );
		fileWrite( f, arguments.corner & " " & arguments.size );
		// give the camera a moment to open its window, so the recording starts with it
		variables.proc.exec( [ "sleep", "1" ], 5 );
	}

	function stopWebcam() {
		if ( !fileExists( webcamMark() ) ) return;
		variables.proc.exec( [ "pkill", "-f", "--", new bxrig.Webcam( variables.cli ).overlayPattern() ], 10 );
		fileDelete( webcamMark() );
	}

	function start( region, dryRun, asJson, audio = "", webcam = "", webcamSize = "medium" ) {
		var cmd = "record start";
		var wc = new bxrig.Webcam( variables.cli );
		if ( len( arguments.webcam ) && !arrayFind( wc.corners(), arguments.webcam ) ) return variables.cli.say( cmd, "usage", { error: "unknown corner " & arguments.webcam }, arguments.asJson, [ "error: --webcam is " & wc.corners().toList( ", " ) & ", not " & arguments.webcam ] );
		if ( len( arguments.webcam ) && !arrayFind( wc.sizes(), arguments.webcamSize ) ) return variables.cli.say( cmd, "usage", { error: "unknown size " & arguments.webcamSize }, arguments.asJson, [ "error: --webcam-size is small, medium or large, not " & arguments.webcamSize ] );
		if ( len( arguments.webcam ) && !variables.proc.has( "mpv" ) ) return variables.cli.say( cmd, "precondition", { error: "mpv is not installed" }, arguments.asJson, [ "error: mpv is not installed (it shows the webcam). Install: bxrig install mpv" ] );
		if ( len( arguments.webcam ) && !fileExists( "/dev/video0" ) ) return variables.cli.say( cmd, "precondition", { error: "no webcam" }, arguments.asJson, [ "error: no webcam found at /dev/video0" ] );
		if ( len( arguments.audio ) && !arrayFind( audioKinds(), arguments.audio ) ) return variables.cli.say( cmd, "usage", { error: "unknown audio " & arguments.audio }, arguments.asJson, [ "error: --audio is desktop or mic, not " & arguments.audio ] );
		if ( len( arguments.audio ) && !variables.proc.has( "pactl" ) ) return variables.cli.say( cmd, "precondition", { error: "pactl is not installed" }, arguments.asJson, [ "error: pactl is not installed (it comes with PipeWire's pulse support: bxrig install pipewire-pulse)" ] );
		if ( !variables.proc.has( "wf-recorder" ) ) return variables.cli.say( cmd, "precondition", { error: "wf-recorder is not installed" }, arguments.asJson, [ "error: wf-recorder is not installed. Install: bxrig install wf-recorder" ] );
		if ( arguments.region && !variables.proc.has( "slurp" ) ) return variables.cli.say( cmd, "precondition", { error: "slurp is not installed" }, arguments.asJson, [ "error: slurp is not installed (it comes with the Hyprland setup)" ] );
		if ( recording() ) return variables.cli.say( cmd, "ok", { recording: true, started: false }, arguments.asJson, [ "A recording is already running. Stop it: bxrig record stop" ] );
		var stamp = trim( variables.proc.exec( [ "date", "+%Y%m%d-%H%M%S" ], 10 ).output );
		var file = folder() & "/bxrig-" & stamp & ".mp4";
		var wf = len( arguments.audio ) ? 'exec wf-recorder -a"$3"' : "exec wf-recorder";
		var script = 'mkdir -p "$1" && ' & wf & ( arguments.region ? ' -g "$(slurp)"' : "" ) & ' -f "$2"';
		var argv = [ "sh", "-c", script, "_", folder(), file ];
		if ( len( arguments.audio ) ) argv.append( audioSource( arguments.audio ) );
		var data = { file: file, region: arguments.region, audio: arguments.audio, webcam: arguments.webcam, webcamSize: len( arguments.webcam ) ? arguments.webcamSize : "", command: argv };
		if ( len( arguments.webcam ) ) data.webcamCommand = wc.overlayArgv( arguments.webcam, arguments.webcamSize );
		if ( arguments.dryRun ) {
			var dl = [ "Dry run: " & argv.toList( " " ) ];
			if ( len( arguments.webcam ) ) dl.prepend( "Dry run: " & data.webcamCommand.toList( " " ) );
			return variables.cli.say( cmd, "ok", data, arguments.asJson, dl );
		}
		if ( len( arguments.webcam ) ) startWebcam( arguments.webcam, arguments.webcamSize );
		variables.proc.detach( argv );
		return variables.cli.say( cmd, "ok", variables.text.merge( data, { started: true } ), arguments.asJson, [ "Recording to " & file & ( len( arguments.audio ) ? " with " & arguments.audio & " audio" : "" ) & ( len( arguments.webcam ) ? ", the webcam " & arguments.webcam : "" ) & ". Stop: bxrig record stop" ] );
	}

	function stop( asJson ) {
		var cmd = "record stop";
		if ( !recording() ) return variables.cli.say( cmd, "ok", { recording: false }, arguments.asJson, [ "Nothing is recording." ] );
		var r = variables.proc.exec( [ "pkill", "-INT", "-x", "wf-recorder" ], 10 );
		stopWebcam();
		if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: "could not stop the recording" }, arguments.asJson, [ "error: could not stop the recording" ] );
		return variables.cli.say( cmd, "ok", { recording: false, stopped: true }, arguments.asJson, [ "The recording was stopped and saved in " & folder() & "." ] );
	}

	function toggle( region, dryRun, asJson, audio = "", webcam = "", webcamSize = "medium" ) {
		return recording() ? stop( arguments.asJson ) : start( arguments.region, arguments.dryRun, arguments.asJson, arguments.audio, arguments.webcam, arguments.webcamSize );
	}

	function status( asJson ) {
		var on = recording();
		return variables.cli.say( "record status", "ok", { recording: on }, arguments.asJson, [ on ? "Recording." : "Not recording." ] );
	}
}
