// The starter desktop configuration `setup hyprland` puts in place: the Noctalia config and palette, and a first hyprland.lua.
// Everything goes through the config service (backup, journal). Files the user already has are never overwritten:
// a changed Noctalia file is kept as it is, and hyprland.lua is written only when none exists.
class Starter {
	// opts: the StarterOptions keys (terminal, layout, workspaces, naturalScroll, layouts, theme, wallpaper); missing ones use the defaults.
	function init( quiet = false, opts = {} ) {
		variables.config = new bxrig.ConfigService().quiet( arguments.quiet );
		variables.opts = new bxrig.StarterOptions().parse( arguments.opts ).value;
		return this;
	}

	// The managed starter files in the config service entry shape (name, target, mode, content).
	function entries() {
		var cfg = variables.config.cfgHome();
		var home = new bxrig.util.Env().named( "home", "" );
		var out = new bxrig.NoctaliaConfig().entries( cfg, home, variables.opts.theme, variables.opts.wallpaper, new bxrig.BarSettings( new bxrig.util.Cli( new bxrig.util.Version().current() ) ).options() );
		out.append( { name: "hyprland", target: cfg & "/hypr/hyprland.lua", mode: "644", content: hyprlandText() } );
		for ( var pe in new bxrig.TemplateData().pluginEntries() ) out.append( pe );
		return out;
	}

	// The starter hyprland.lua with the chosen terminal and layout (HyprLayout): the tiled ones set general.layout, columns also centres
	// the master; floating keeps dwindle underneath (one keypress to tile) and floats every new window with a window rule.
	function hyprlandText() {
		var o = variables.opts;
		var so = new bxrig.StarterOptions();
		var t = new bxrig.TemplateData().text( "hyprland.lua" );
		t = replace( t, 'local terminal    = "kitty"', 'local terminal    = "' & o.terminal & '"' );
		var hl = new bxrig.HyprLayout();
		t = replace( t, 'layout           = "dwindle",', 'layout           = "' & hl.base( o.layout ) & '",' );
		if ( len( hl.masterFields( o.layout ) ) ) t = replace( t, 'hl.config({ master    = { new_status = "master" } })', 'hl.config({ master    = { new_status = "master", ' & hl.masterFields( o.layout ) & ' } })' );
		var rule = o.layout == "floating"
		? '-- Floating by default (layout: floating). Delete this rule, or press Super+T on a window (Super+Alt+T with the Mac style), to tile.' & chr( 10 ) & 'hl.window_rule({ name = "bxrig-floating", match = { class = ".*" }, float = true })'
		: '-- (Windows tile. To float every new window by default, add: hl.window_rule({ name = "floating", match = { class = ".*" }, float = true }))';
		t = replace( t, "-- BXRIG-FLOATING-RULE", rule );
		// a first scale for each connected screen (a high-density panel would otherwise start too big); no screen found: the marker line goes
		var scaleLua = new bxrig.DisplayScale().monitorsLua();
		t = replace( t, "-- BXRIG-MONITORS", len( scaleLua ) ? "-- Each screen gets a scale that shows about 1200 pixels of height (bxrig display scale NAME VALUE changes it)." & chr( 10 ) & scaleLua : '-- One rule per screen can go here: hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1.5 })' );
		t = replace( t, "-- BXRIG-WORKSPACES", so.workspacesLua( o.workspaces ) );
		t = replace( t, 'kb_layout    = "us",', so.keyboardLua( o.layouts ) );
		t = replace( t, 'natural_scroll = false,   -- true gives the macOS direction', 'natural_scroll = ' & ( o.naturalScroll ? "true" : "false" ) & ',   -- true gives the macOS direction' );
		return t;
	}

	// Writes what is missing. Returns { written, kept, failed }: names of entries. kept = already there (clean, or changed by the user).
	function apply() {
		var out = { written: [], kept: [], failed: [] };
		// the bar's logo and grid plates (the Noctalia config points at them); the full `assets install` writes them too
		try { new bxrig.Assets( new bxrig.util.Cli( new bxrig.util.Version().current() ) ).ensurePlates(); } catch ( any e ) {}
		for ( var e in entries() ) {
			var st = variables.config.configState( e );
			// hyprland.lua is the user's own file from the first start on: only a missing one is written
			if ( st != "missing" && ( e.name == "hyprland" || st == "clean" || st == "drifted" || st == "blocked" ) ) { out.kept.append( e.name ); continue; }
			if ( variables.config.configWrite( e, e.content, "apply", true, false ) == 0 ) out.written.append( e.name ); else out.failed.append( e.name );
		}
		return out;
	}
}
