// `bxrig ai shell [toggle|status] [--backend=hyprland|yakuake] [--dry-run]`: the pull-down AI shell. One shortcut shows and hides a
// terminal that runs your default coding agent (or a plain shell when none is set); it keeps its session while hidden.
//   hyprland  a terminal with its own window class (com.bxrig.ai); the Hyprland module's window rule sends it to the special
//             workspace `ai`; later calls toggle that workspace. Size and place are set at launch, best effort.
//   yakuake   KDE's drop-down terminal (Plasma). The first call starts Yakuake, opens a tab that runs the agent; later calls
//             toggle its window. Methods used over D-Bus: toggleWindowState, addSession, runCommand.
// Exit: 0 done, 4 precondition (no backend, no terminal that can carry a window class, agent not installed), 6 a command failed.
// The Hyprland and Yakuake calls follow their documentation but have not run on a real desktop yet (acceptance checklist).
class AiShell {
	function init( cli, runner = "" ) {
		variables.cli = arguments.cli;
		variables.proc = new bxrig.util.Proc( arguments.runner );
		variables.ai = new bxrig.Ai( arguments.cli, arguments.runner );
		variables.agents = new bxrig.AiAgents();
		variables.runnerArg = arguments.runner;
		return this;
	}

	function windowClass() { return "com.bxrig.ai"; }
	function workspaceName() { return "ai"; }

	function backend( forced = "" ) {
		if ( len( arguments.forced ) ) return arguments.forced;
		var shell = new bxrig.util.Desktop().shell();
		return shell == "plasma" ? "yakuake" : shell;
	}

	function detach( argv ) {
		var run = [ "sh", "-c", 'setsid "$@" >/dev/null 2>&1 &', "_" ];
		for ( var p in arguments.argv ) run.append( p );
		return variables.proc.exec( run, 10 );
	}

	// What the shell runs: the default agent through `secrets run`, else your login shell.
	function inner() {
		var id = variables.ai.defaultId();
		if ( len( id ) ) {
			var a = variables.agents.find( id );
			if ( !structIsEmpty( a ) && variables.ai.installed( a.command ) ) return { argv: variables.ai.agentCommand( a ), label: a.name };
		}
		return { argv: [ new bxrig.util.Env().named( "shell", "sh" ) ], label: "your shell" };
	}

	// A terminal that can give its window a class: the one named first in xdg-terminals.list when it can, else the first installed that can.
	function terminal() {
		var tc = new bxrig.TerminalConfig( true );
		var pref = variables.ai.terminal();
		var order = [];
		if ( !structIsEmpty( pref ) ) order.append( pref.id );
		for ( var id in tc.ids() ) if ( !arrayFind( order, id ) ) order.append( id );
		for ( var id in order ) {
			var t = tc.find( id );
			if ( len( tc.classArgs( id, windowClass() ) ) && variables.ai.installed( t.cmd ) ) return { id: id, cmd: t.cmd, classArgs: tc.classArgs( id, windowClass() ), execFlag: arrayFind( [ "ghostty", "alacritty" ], id ) ? [ "-e" ] : [] };
		}
		return {};
	}

	// ---- Hyprland ----
	function hasWindow() {
		var r = variables.proc.exec( [ "hyprctl", "clients", "-j" ], 10 );
		if ( r.exitCode != 0 ) return false;
		try { for ( var c in jsonDeserialize( r.output ) ) if ( ( c.class ?: "" ) == windowClass() ) return true; } catch ( any e ) {}
		return false;
	}

	/**
	 * Shows or hides the AI shell on Hyprland: the first time it starts the terminal as a centered floating window on the special workspace "ai", then it only toggles that workspace.
	 *
	 * @param dryRun True to report the steps without running them.
	 *
	 * @return A struct { error, steps }: error is empty when it worked, steps are the commands run or planned.
	 */
	function hyprlandToggle( dryRun ) {
		var steps = [];
		var dd = new bxrig.util.DropDown( variables.runnerArg );
		var geo = dd.geometry( 60, 45 );
		if ( !hasWindow() ) {
			var term = terminal();
			if ( structIsEmpty( term ) ) return { code: 4, error: "no terminal that can set a window class is installed (ghostty, kitty, alacritty, foot)" };
			var inn = inner();
			var argv = [ term.cmd ];
			for ( var p in term.classArgs ) argv.append( p );
			for ( var p in term.execFlag ) argv.append( p );
			for ( var p in inn.argv ) argv.append( p );
			// the terminal starts through Hyprland with its rules: floating, on the special workspace, centered, hanging from the top
			var launch = [ "hyprctl", "dispatch", "exec", dd.rules( workspaceName(), geo ) & " " & quoted( argv ) ];
			steps.append( launch );
			var placing = dd.place( "class:" & windowClass(), geo );
			for ( var pl in placing ) steps.append( pl );
			if ( !arguments.dryRun ) {
				var started = variables.proc.exec( launch, 10 );
				if ( started.exitCode != 0 ) return { code: 6, error: "hyprctl could not start the terminal: " & trim( started.output ) };
				for ( var i = 1; i <= 25; i++ ) { if ( hasWindow() ) break; variables.proc.exec( [ "sleep", "0.2" ], 5 ); }
				if ( !hasWindow() ) return { code: 6, error: "the terminal started but no window with the class " & windowClass() & " appeared (does " & term.id & " accept " & term.classArgs.toList( " " ) & "?)" };
				// belt and braces: place it again once its window exists
				for ( var pl2 in placing ) variables.proc.exec( pl2, 10 );
			}
			return { code: 0, action: "opened", label: inn.label, steps: steps };
		}
		var t1 = [ "hyprctl", "dispatch", "togglespecialworkspace", workspaceName() ];
		steps.append( t1 );
		if ( !arguments.dryRun ) {
			var r = variables.proc.exec( t1, 10 );
			// Hyprland's Lua mode may want the Lua form of the same dispatcher
			if ( r.exitCode != 0 ) r = variables.proc.exec( [ "hyprctl", "dispatch", 'hl.dsp.workspace.toggle_special("' & workspaceName() & '")' ], 10 );
			if ( r.exitCode != 0 ) return { code: 6, error: "hyprctl could not toggle the special workspace: " & trim( r.output ) };
		}
		return { code: 0, action: "toggled", label: "", steps: steps };
	}

	// ---- Yakuake ----
	function yakuakeRunning() {
		var r = variables.proc.exec( [ "dbus-send", "--session", "--print-reply", "--dest=org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus.NameHasOwner", "string:org.kde.yakuake" ], 10 );
		return r.exitCode == 0 && find( "boolean true", r.output ) > 0;
	}

	function yakuakeCall( path, method, args = [] ) {
		var argv = [ "dbus-send", "--session", "--type=method_call", "--dest=org.kde.yakuake", arguments.path, "org.kde.yakuake." & arguments.method ];
		for ( var a in arguments.args ) argv.append( a );
		return argv;
	}

	// The command line typed into the Yakuake tab: the argv, single-quoted word by word.
	function quoted( argv ) {
		var q = chr( 39 );
		return arguments.argv.map( function( w ) { return q & replace( w, q, q & chr( 92 ) & q & q, "all" ) & q; } ).toList( " " );
	}

	function stateFile() {
		var rt = new bxrig.util.Env().named( "xdgRuntimeDir", "" );
		return len( rt ) ? rt & "/bxrig-ai-shell" : "";
	}

	/**
	 * Writes the drop-down size into ~/.config/yakuakerc: a centered window 60% wide and 45% high that stays open when focus moves. Only keys the file does not have yet are written, so a size you chose yourself is kept; Yakuake reads the file when it starts.
	 *
	 * @param dryRun True to skip the write.
	 *
	 * @return Nothing.
	 */
	function yakuakeSettings( dryRun ) {
		var env = new bxrig.util.Env();
		var file = env.xdgConfig( "yakuakerc" );
		var text = fileExists( file ) ? fileRead( file ) : "";
		var ini = new bxrig.util.Ini();
		var lines = listToArray( replace( text, chr( 13 ), "", "all" ), chr( 10 ), true );
		var want = [ [ "Width", "60" ], [ "Height", "45" ], [ "Position", "50" ], [ "KeepOpen", "true" ] ];
		var changed = false;
		for ( var kv in want ) {
			if ( ini.values( text, "Window", kv[ 1 ], true ).len() ) continue;
			lines = ini.set( lines, "Window", kv[ 1 ], kv[ 2 ] );
			changed = true;
		}
		if ( changed && !arguments.dryRun ) {
			directoryCreate( getDirectoryFromPath( file ), true, true );
			new bxrig.ConfigService().quiet( true ).writeText( "yakuake-window", file, lines.toList( chr( 10 ) ) & chr( 10 ) );
		}
		return changed;
	}

	/**
	 * Starts Yakuake when it is not running and waits for its D-Bus name.
	 *
	 * @param dryRun True to report the step without running it.
	 *
	 * @return A struct { error, steps }.
	 */
	function yakuakeStart( dryRun ) {
		if ( !variables.ai.installed( "yakuake" ) ) return { error: "Yakuake is not installed. Install it: bxrig install yakuake", code: 4, steps: [] };
		yakuakeSettings( arguments.dryRun );
		if ( arguments.dryRun ) return { error: "", code: 0, steps: [ [ "yakuake" ] ] };
		detach( [ "yakuake" ] );
		for ( var n = 1; n <= 25; n++ ) {
			if ( yakuakeRunning() ) return { error: "", code: 0, steps: [ [ "yakuake" ] ] };
			variables.proc.exec( [ "sleep", "0.2" ], 5 );
		}
		return { error: "Yakuake did not start", code: 6, steps: [ [ "yakuake" ] ] };
	}

	/**
	 * Gets the shell ready in Yakuake. A freshly started Yakuake already has one tab, so that tab is used; a running one gets a new tab. The agent is typed into it; for a plain shell nothing is typed because the tab already is one.
	 *
	 * @param dryRun True to report the steps without running them.
	 * @param fresh True when Yakuake was just started by this call (default false).
	 *
	 * @return A struct { error, steps, label }.
	 */
	function yakuakeOpenTab( dryRun, fresh = false ) {
		var plan = inner();
		var steps = [];
		var agent = plan.label != "your shell";
		if ( !arguments.fresh ) {
			var add = yakuakeCall( "/yakuake/sessions", "addSession" );
			steps.append( add );
			if ( !arguments.dryRun ) {
				var first = variables.proc.exec( add, 10 );
				if ( first.exitCode != 0 ) return { error: "Yakuake refused a new tab: " & trim( first.output ), steps: [], label: "" };
			}
		}
		if ( agent ) {
			var run = yakuakeCall( "/yakuake/sessions", "runCommand", [ "string:" & quoted( plan.argv ) ] );
			steps.append( run );
			if ( !arguments.dryRun ) {
				var second = variables.proc.exec( run, 10 );
				if ( second.exitCode != 0 ) return { error: "Yakuake refused the command: " & trim( second.output ), steps: [], label: "" };
			}
		}
		var st = stateFile();
		if ( !arguments.dryRun && len( st ) ) fileWrite( st, "tab" & chr( 10 ) );
		return { error: "", steps: steps, label: plan.label };
	}

	/**
	 * Shows or hides the Yakuake drop-down, starting it and its tab first when needed (a short wait after a fresh start keeps the window from being hidden again).
	 *
	 * @param dryRun True to report the steps without running them.
	 *
	 * @return A struct { error, steps }.
	 */
	function yakuakeToggle( dryRun ) {
		var steps = [];
		var wasRunning = yakuakeRunning();
		var tabFile = stateFile();
		var haveTab = wasRunning && len( tabFile ) > 0 && fileExists( tabFile );
		if ( !wasRunning ) {
			var started = yakuakeStart( arguments.dryRun );
			if ( started.error != "" ) return { code: started.code, error: started.error };
			for ( var s1 in started.steps ) steps.append( s1 );
		}
		var shown = "";
		if ( !haveTab ) {
			var tab = yakuakeOpenTab( arguments.dryRun, !wasRunning );
			if ( tab.error != "" ) return { code: 6, error: tab.error };
			for ( var s2 in tab.steps ) steps.append( s2 );
			shown = tab.label;
		}
		// a Yakuake that has only just started needs a moment before it takes the show command
		if ( !wasRunning && !arguments.dryRun ) variables.proc.exec( [ "sleep", "0.8" ], 5 );
		var toggle = yakuakeCall( "/yakuake/window", "toggleWindowState" );
		steps.append( toggle );
		if ( !arguments.dryRun ) {
			var done = variables.proc.exec( toggle, 10 );
			if ( done.exitCode != 0 ) return { code: 6, error: "Yakuake could not toggle: " & trim( done.output ) };
		}
		return { code: 0, action: haveTab ? "toggled" : "opened", label: shown, steps: steps };
	}

	/**
	 * `ai shell [toggle|status]`: toggles the drop-down terminal or reports its state. A failure on a key press is also shown as a critical notification, so it is not silent.
	 *
	 * @param action "toggle" (default) or "status".
	 * @param forced A backend to use instead of the detected one: "hyprland" or "yakuake", or empty.
	 * @param dryRun True to report what would run.
	 * @param asJson True for JSON output.
	 *
	 * @return The exit code: 0 done, 2 usage, 4 no terminal or backend, 6 a step failed.
	 */
	function run( action, forced, dryRun, asJson ) {
		var cmd = "ai shell";
		var be = backend( arguments.forced );
		if ( !arrayFind( [ "hyprland", "yakuake" ], be ) ) return variables.cli.say( cmd, "precondition", { error: "No backend" }, arguments.asJson, [ "error: the pull-down AI shell needs a Hyprland session or KDE Plasma (Yakuake). Use --backend=hyprland or --backend=yakuake to choose." ] );
		if ( arguments.action == "status" ) {
			var present = be == "hyprland" ? hasWindow() : yakuakeRunning();
			var geo = be == "hyprland" ? new bxrig.util.DropDown( variables.runnerArg ).geometry( 60, 45 ) : { ok: false };
			var lines = [ "Backend: " & be, "Window: " & ( present ? "open" : "not started" ) ];
			if ( be == "hyprland" ) {
				lines.append( "Window class: " & windowClass() & ", special workspace: " & workspaceName() );
				lines.append( geo.ok ? "Placement: " & geo.w & "x" & geo.h & " at " & geo.x & "," & geo.y & " (centered, 60% x 45%)" : "Placement: hyprctl did not answer, so percent rules are used" );
			}
			return variables.cli.say( cmd, "ok", { backend: be, running: present, window_class: windowClass(), workspace: workspaceName(), geometry: geo }, arguments.asJson, lines );
		}
		if ( arguments.action != "toggle" ) return variables.cli.say( cmd, "usage", {}, arguments.asJson, [ new bxrig.CommandSpec().usage( "ai shell" ) ] );
		var r = be == "hyprland" ? hyprlandToggle( arguments.dryRun ) : yakuakeToggle( arguments.dryRun );
		if ( r.code != 0 ) {
			// from a key binding nobody sees the terminal output, so the error is also shown as a desktop notice
			if ( !CLIIsTerminal() && !arguments.asJson && variables.proc.has( "notify-send" ) ) variables.proc.exec( [ "notify-send", "-u", "critical", "AI shell", r.error ], 10 );
			return variables.cli.say( cmd, r.code, { error: r.error, backend: be }, arguments.asJson, [ "error: " & r.error ] );
		}
		var data = { backend: be, action: r.action, runs: r.label, steps: r.steps };
		var msg = arguments.dryRun ? "Dry run: " & r.steps.map( function( s ) { return s.toList( " " ); } ).toList( " ; " ) : "AI shell " & r.action & ( len( r.label ) ? " (" & r.label & ")" : "" ) & ".";
		return variables.cli.say( cmd, "ok", data, arguments.asJson, [ msg ], arguments.dryRun );
	}
}
