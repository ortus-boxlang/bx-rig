// `bxrig init`: the wizard (or an answers file) in, ordinary commands out. The saved answers live in
// ~/.config/bxrig/answers.json (mode 600, written atomically); a re-run starts from them.
//
// Exit codes: 0 done, 2 plan printed without --yes, 4 precondition (bad answers file, no terminal), 130 wizard cancelled,
// 7 some steps done and some failed, otherwise the exit code of the first failed step when nothing was done.
class Init {
	function init( cli, runner = "" ) {
		variables.cli = arguments.cli;
		variables.inst = new bxrig.Installer( arguments.runner );
		variables.config = new bxrig.ConfigService();
		return this;
	}

	function answersFile() { return variables.config.cfgHome() & "/bxrig/answers.json"; }

	// The saved answers ({} when there are none or the file is unreadable).
	function loadSaved() {
		return new bxrig.util.JsonStore().load( answersFile() );
	}

	function save( answers ) {
		variables.config.writeAtomic( answersFile(), jsonSerialize( arguments.answers ) & chr( 10 ), "600" );
	}

	// `init --export=FILE`: a copy of your saved answers (mode 600), to take to another machine: there, `init --from=FILE` fills the wizard with
	// them, or `init --answers=FILE --yes` runs them without asking. The answers hold no secrets (API keys are never in them).
	function exportAnswers( file, force, asJson ) {
		var saved = loadSaved();
		if ( structIsEmpty( saved ) ) {
			if ( arguments.asJson ) println( variables.cli.envelope( "init --export", 4, { error: "No saved answers" } ) );
			else println( "error: there are no saved answers yet. Run the wizard first: bxrig init" );
			return new bxrig.util.Exit().precondition();
		}
		if ( fileExists( arguments.file ) && !arguments.force ) {
			if ( arguments.asJson ) println( variables.cli.envelope( "init --export", 4, { error: arguments.file & " exists" } ) );
			else println( "error: " & arguments.file & " already exists (use --force to replace it)" );
			return new bxrig.util.Exit().precondition();
		}
		variables.config.writeAtomic( arguments.file, jsonSerialize( saved ) & chr( 10 ), "600" );
		if ( arguments.asJson ) println( variables.cli.envelope( "init --export", 0, { file: arguments.file } ) );
		else println( "Your answers were copied to " & arguments.file & ". On the other machine: bxrig init --from=" & arguments.file );
		return new bxrig.util.Exit().ok();
	}

	// `init --print-answers`
	function printAnswers( asJson, fromSystem = false ) {
		var saved = loadSaved();
		if ( arguments.fromSystem ) {
			// what this machine has, in the wizard's answers (merged over your saved ones): a starting point for a script or another machine
			var sys = new bxrig.SystemState();
			saved = sys.startingAnswers( saved, sys.scan( wizardSpec() ).answers, "tune" );
		}
		if ( arguments.asJson ) println( variables.cli.envelope( "init --print-answers", 0, { answers: saved, file: answersFile() } ) );
		else println( jsonSerialize( saved ) );
		return new bxrig.util.Exit().ok();
	}

	// Catalog app id -> its shells (only for apps that name some), so Customize never installs a Hyprland-only app on Plasma.
	function shellMap() {
		var out = {};
		for ( var a in new bxrig.Catalog().load().apps ) if ( structKeyExists( a, "shells" ) && a.shells.len() ) out[ a.id ] = a.shells;
		return out;
	}

	// The wizard's pages: the built-in ones plus the Customize pages generated from the catalog.
	function wizardSpec() {
		return new bxrig.AppPages().inject( jsonDeserialize( new bxrig.WizardData().demoPages() ), new bxrig.Catalog().load() );
	}

	// The apps named by the plan's `apps` install step, split into { new, installed } by what pacman already has.
	function appsSplit( plan ) {
		var out = { new: [], installed: [] };
		var state = "";
		for ( var st in arguments.plan.steps ) {
			if ( st.id != "apps" ) continue;
			if ( !isStruct( state ) ) state = new bxrig.SystemState();
			for ( var i = 3; i <= st.argv.len(); i++ ) {
				var id = st.argv[ i ];
				if ( left( id, 2 ) == "--" ) continue;
				if ( state.appInstalled( id ) ) out.installed.append( id ); else out.new.append( id );
			}
		}
		return out;
	}

	// The apps step names only what this system's catalog has: a name that is not there (an app this distribution does not offer) would make
	// `bxrig install` refuse the whole list. Those names are taken out and returned, to be reported as skipped; the rest installs.
	function dropUnknown( plan ) {
		var known = {};
		for ( var a in new bxrig.Catalog().load().apps ) known[ a.id ] = true;
		var unknown = [];
		var keepSteps = [];
		for ( var st in arguments.plan.steps ) {
			if ( st.id != "apps" ) { keepSteps.append( st ); continue; }
			var argv = [ st.argv[ 1 ], st.argv[ 2 ] ];
			var ids = [];
			for ( var i = 3; i <= st.argv.len(); i++ ) {
				var id = st.argv[ i ];
				if ( left( id, 2 ) == "--" ) argv.append( id );
				else if ( structKeyExists( known, id ) ) { argv.append( id ); ids.append( id ); }
				else unknown.append( id );
			}
			if ( !ids.len() ) continue;
			st.argv = argv;
			st.title = "install " & ids.toList( ", " );
			keepSteps.append( st );
		}
		arguments.plan.steps = keepSteps;
		arguments.plan.unknown = unknown;
		return unknown;
	}

	// What the plan will run into on this machine, said before it starts: a step that cannot work here is reported as skipped at the end,
	// and this says why up front.
	function planNotes( plan ) {
		var notes = [];
		for ( var st in arguments.plan.steps ) {
			if ( st.id == "docker-compat" && new bxrig.SystemState().appInstalled( "docker" ) ) notes.append( "the docker package is installed, so docker-compat will be skipped (it conflicts with podman-docker). Remove Docker first (sudo pacman -Rns docker) to use Podman as docker, or choose Docker as the engine." );
			if ( st.id == "editor-lazyvim" && directoryExists( new bxrig.util.Env().xdgConfig( "nvim" ) ) ) notes.append( "~/.config/nvim already exists, so the LazyVim starter will be skipped (your config is left alone)." );
		}
		return notes;
	}

	// This program, to run the plan's own commands: BXRIG_SELF (tests, odd installs), else `bxrig` on PATH.
	function selfPath() { return new bxrig.util.Env().named( "self", "bxrig" ); }

	// The command line for a step: our own path, --yes on our own commands.
	function commandFor( step ) {
		var argv = [];
		for ( var part in arguments.step.argv ) argv.append( part );
		if ( argv[ 1 ] == "bxrig" ) { argv[ 1 ] = selfPath(); argv.append( "--yes" ); }
		return argv;
	}

	// Runs the plan for these answers. yes/dryRun as every mutating command: no --yes prints it (exit 2), --dry-run exits 0.
	function run( answers, yes, dryRun, asJson ) {
		var plan = new bxrig.InitPlan().plan( arguments.answers, shellMap(), { theme: new bxrig.Palette().activeName() } );
		var unknown = dropUnknown( plan );
		var data = { steps: plan.steps, pending: plan.pending, errors: plan.errors, done: [], failed: [], skipped: [] };
		for ( var un in unknown ) data.skipped.append( { id: un, reason: "not available on this system (no entry in its catalog)" } );
		// what the install step would add and what is already there (left alone)
		data.apps = appsSplit( plan );
		data.notes = planNotes( plan );
		if ( plan.errors.len() ) {
			if ( arguments.asJson ) println( variables.cli.envelope( "init", 4, data ) );
			else for ( var e in plan.errors ) println( "error: " & e );
			return new bxrig.util.Exit().precondition();
		}
		if ( !arguments.yes || arguments.dryRun ) {
			var code = arguments.dryRun ? 0 : 2;
			if ( arguments.asJson ) { println( variables.cli.envelope( "init", code, data, arguments.dryRun ) ); return code; }
			println( new bxrig.util.Mutation().banner( arguments.dryRun ) & "init, " & plan.steps.len() & " steps" );
			for ( var s in plan.steps ) println( "  " & s.id & ": " & s.title & "   (" & commandFor( s ).toList( " " ) & ")" );
			if ( data.apps.new.len() || data.apps.installed.len() ) println( "  apps: " & data.apps.new.len() & " to install" & ( data.apps.new.len() ? " (" & data.apps.new.toList( ", " ) & ")" : "" ) & ", " & data.apps.installed.len() & " already installed and left alone" & ( data.apps.installed.len() ? " (" & data.apps.installed.toList( ", " ) & ")" : "" ) );
			if ( plan.pending.len() ) println( "  not applied yet (saved, no command for them): " & plan.pending.toList( ", " ) );
			for ( var nt in data.notes ) println( "  note: " & nt );
			println( new bxrig.util.Mutation().footer( arguments.dryRun ) );
			return code;
		}
		// A failed step is reported and the plan goes on: the steps are independent (one missing package or an optional desktop
		// feature must not cost you your apps, keys and defaults). Re-running init repeats only what is still missing.
		var firstCode = 0;
		// everything that happens is also written to a log (~/.local/state/bxrig/logs), to read or send later
		var log = new bxrig.InitLog();
		log.header( plan.steps, { mode: "plain (no screen)" } );
		data.log = log.file();
		for ( var step in plan.steps ) {
			var argv = commandFor( step );
			if ( !arguments.asJson ) println( "==> " & step.title );
			log.line( "==> step " & step.id & ": " & step.title );
			log.line( "    command: " & argv.toList( " " ) );
			var t0 = getTickCount();
			var r = variables.inst.proc().exec( argv, 3600 );
			if ( len( r.output ?: "" ) ) log.output( step.id, r.output );
			log.line( "    exit " & ( r.timeout ? "124 (timed out)" : r.exitCode ) & " after " & int( ( getTickCount() - t0 ) / 1000 ) & " s" );
			if ( !arguments.asJson && len( r.output ) ) print( r.output );
			if ( ( r.timeout || r.exitCode != 0 ) && ( step.optional ?: false ) ) {
				// an optional step (typing a key) that could not run is reported, and the plan goes on
				var why = new bxrig.util.Text().reason( variables.inst.proc().why( r ) );
				data.skipped.append( { id: step.id, reason: "could not run (exit " & ( r.timeout ? 124 : r.exitCode ) & ")" & ( len( why ) ? ": " & why : "" ) & "; do it later: " & commandFor( step ).toList( " " ) } );
			} else if ( r.timeout || r.exitCode != 0 ) {
				// the real error text (the last lines of what the step printed), not only its exit code
				var bad = { id: step.id, exit: r.timeout ? 124 : r.exitCode, command: argv.toList( " " ) };
				var tailText = variables.inst.proc().why( r );
				if ( len( tailText ) ) bad.output = tailText;
				else if ( r.timeout ) bad.output = "timed out";
				data.failed.append( bad );
				if ( !firstCode ) firstCode = r.timeout ? 124 : r.exitCode;
			} else data.done.append( { id: step.id } );
		}
		var exit = !data.failed.len() ? 0 : ( data.done.len() ? 7 : firstCode );
		if ( arguments.asJson ) { println( variables.cli.envelope( "init", exit, data ) ); return exit; }
		for ( var d in data.done ) println( "Done: " & d.id );
		for ( var f in data.failed ) {
			println( "Failed: " & f.id & " (exit " & f.exit & ")" );
			println( "  command: " & f.command );
			if ( structKeyExists( f, "output" ) ) for ( var ol in new bxrig.util.Text().lines( f.output ) ) println( "  | " & ol );
		}
		for ( var k in data.skipped ) println( "Skipped: " & k.id & " (" & k.reason & ")" );
		if ( plan.pending.len() ) println( "Saved but not applied yet: " & plan.pending.toList( ", " ) );
		println( "Log: " & log.file() );
		return exit;
	}

	// sudo's password, asked once on the plain terminal before the install screen starts (the steps run in the background and cannot ask).
	// Returns true when there is nothing to ask or it worked.
	function sudoReady() {
		var proc = variables.inst.proc();
		if ( proc.isRoot() || !proc.has( "sudo" ) ) return true;
		if ( proc.exec( [ "sudo", "-n", "true" ], 10 ).exitCode == 0 ) return true;
		println( "BxRig installs packages with sudo. Type your password once; the install then runs on its own." );
		return proc.exec( [ "sudo", "-v" ], 120 ).exitCode == 0;
	}

	// The install on the wizard's own screen: a progress bar and the step that runs now, `v` for the live log, and a log file kept for debugging.
	// Same plan, same commands and same exit codes as run(); it is what the wizard calls (plain output stays for --answers and --json).
	function runScreen( answers ) {
		var plan = new bxrig.InitPlan().plan( arguments.answers, shellMap(), { theme: new bxrig.Palette().activeName() } );
		if ( plan.errors.len() ) {
			for ( var e in plan.errors ) println( "error: " & e );
			return new bxrig.util.Exit().precondition();
		}
		var unknown = dropUnknown( plan );
		// sudo's password: when sudo would ask, the screen asks (hidden, once) and the steps run with a helper that gives sudo the password; the
		// screen owns the terminal, so a sudo prompt on it could neither be seen nor answered. Without a private runtime folder or setsid the
		// old way is used: ask here on the plain terminal and rely on sudo's ticket.
		var sudo = new bxrig.util.Sudo( variables.inst.proc() );
		var needPassword = sudo.needed();
		if ( needPassword && !sudo.available() ) {
			needPassword = false;
			if ( !sudoReady() ) {
				println( "error: sudo did not accept the password. Your answers are saved; run the install again with: bxrig init --rerun" );
				return new bxrig.util.Exit().precondition();
			}
		}
		var steps = [];
		for ( var st in plan.steps ) steps.append( { id: st.id, title: st.title, argv: commandFor( st ), optional: st.optional ?: false } );
		var log = new bxrig.InitLog();
		var proc = variables.inst.proc();
		var apps = appsSplit( plan );
		var run = new bxrig.InitRun( steps, log, proc, { appsTotal: apps.new.len() } );
		var app = new bxrig.InstallApp( run, {
				keepAlive: function() { proc.exec( [ "sudo", "-n", "-v" ], 10 ); },
				passwordNeeded: needPassword, verify: function( pw ) { return sudo.verify( pw ); }, user: sudo.user()
			} );
		var theme = arguments.answers.theme_name ?: "";
		try {
			new bxrig.TuiRunner().run( app, function( tui ) { return new bxrig.InstallView( tui, theme ); } );
			sudo.cleanup();
			if ( app.cancelled() ) {
				log.line( "==> cancelled before it started: " & ( len( app.message() ) ? app.message() : "no password" ) );
				println( len( app.message() ) ? "error: " & app.message() & ". Your answers are saved; run the install again with: bxrig init --rerun" : "The install was cancelled before it started. Your answers are saved; run it again with: bxrig init --rerun" );
				println( "Log: " & log.file() );
				return len( app.message() ) ? new bxrig.util.Exit().precondition() : 130;
			}
		} catch ( any e ) {
			sudo.cleanup();
			// the screen could not start or broke: the install must not be lost. Say so, and run the rest in the foreground.
			log.error( "install screen", e );
			println( "The install screen stopped (" & e.message & "). The log is " & log.file() );
			if ( !run.finished() ) run.stop();
		}
		var res = run.result();
		for ( var unk in unknown ) log.line( "skipped " & unk & ": not in this system's catalog" );
		var fin = new bxrig.InitFinish();
		for ( var sl in fin.lines( res, unknown, { answers: answersFile(), log: log.file(), pending: plan.pending } ) ) println( sl );
		// the screen's l (log out) and b (reboot), confirmed there, run here once the screen is gone
		if ( structKeyExists( app.advice(), "action" ) && len( app.advice().action ) ) {
			var act = app.advice().action;
			log.line( "==> " & act & " asked on the finish screen" );
			println( act == "reboot" ? "Rebooting…" : "Logging out…" );
			variables.inst.proc().exec( [ variables.inst.proc().selfPath(), "system", act, "--yes" ], 60 );
		}
		return res.code;
	}

	// Reads an answers file for the wizard's import: { ok, answers, ignored, error }. `known` is the set of question ids this version asks.
	function importAnswers( path, known ) {
		var file = arguments.path;
		if ( left( file, 2 ) == "~/" ) file = new bxrig.util.Env().home() & mid( file, 2, len( file ) );
		if ( !fileExists( file ) ) return { ok: false, answers: {}, ignored: [], error: "There is no file " & arguments.path };
		var data = "";
		try { var text = fileRead( file ); data = jsonDeserialize( text ); } catch ( any e ) { return { ok: false, answers: {}, ignored: [], error: arguments.path & " is not a JSON answers file" }; }
		if ( !isStruct( data ) ) return { ok: false, answers: {}, ignored: [], error: arguments.path & " is not an answers file (a JSON object is expected)" };
		var ignored = [];
		for ( var k in structKeyArray( data ) ) if ( !structKeyExists( arguments.known, k ) ) ignored.append( k );
		if ( ignored.len() == structCount( data ) ) return { ok: false, answers: {}, ignored: ignored, error: arguments.path & " has no answer this wizard asks" };
		return { ok: true, answers: data, ignored: ignored, error: "" };
	}

	// The wizard, then the plan. The review screen is the confirmation, so the steps run without a second prompt
	// (unless --dry-run). Needs a terminal.
	function wizard( dryRun, asJson, from = "", mode = "tune", plain = false ) {
		var spec = wizardSpec();
		// the local AI models BxRig would pick for this machine, shown on the AI page (skipped when it cannot be worked out)
		spec = new bxrig.AiHint().inject( spec, variables.inst.proc().selfData( [ "ai", "models", "recommend" ], 30 ) );
		var result = "";
		try {
			// where the answers start: your saved ones, or a file you name (answers exported from another machine)
			var base = loadSaved();
			if ( len( arguments.from ) ) {
				try { base = jsonDeserialize( fileRead( arguments.from ) ); } catch ( any e2 ) { println( "bxrig init: cannot read " & arguments.from & ": " & e2.message ); return new bxrig.util.Exit().precondition(); }
			}
			// tune (default): those answers plus what this machine already has, installed options marked; rerun: those answers only;
			// fresh: the defaults. Nothing the machine has is ever removed.
			var sys = new bxrig.SystemState();
			var found = sys.scan( spec );
			if ( arguments.mode == "tune" ) sys.annotate( spec, found.installed );
			var start = sys.startingAnswers( base, found.answers, arguments.mode );
			// the start screen (new install, import a file, saved answers) shows when you give no flag that already says how to begin
			var withStart = arguments.mode == "tune" && !len( arguments.from );
			var opts = {};
			if ( withStart ) {
				var known = {};
				for ( var pg in spec.pages ) for ( var q in pg.questions ) if ( ( q.id ?: "" ) != "" ) known[ q.id ] = true;
				opts = {
					start: true,
					presets: { new: sys.startingAnswers( {}, found.answers, "fresh" ), saved: sys.startingAnswers( base, found.answers, "rerun" ) },
					importer: function( path ) { return importAnswers( path, known ); }
				};
				// the saved answers are only offered when there are some
				if ( structIsEmpty( base ) ) opts.presets.saved = {};
				start = opts.presets.new;
			}
			result = new bxrig.Wizard( spec, start, opts ).run();
		} catch ( any e ) {
			println( "bxrig init needs a terminal (" & e.message & "). Use --answers FILE to run without one." );
			return new bxrig.util.Exit().precondition();
		}
		if ( result.outcome != "done" ) return 130;
		save( result.answers );
		println( "Saved your answers to " & answersFile() );
		if ( arguments.dryRun || arguments.asJson || arguments.plain ) return run( result.answers, true, arguments.dryRun, arguments.asJson );
		return runScreen( result.answers );
	}
}
