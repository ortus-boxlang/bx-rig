// The install screen's state and keys, with no drawing (InstallView draws it, TuiRunner runs the loop, InitRun does the work).
//   v            the log under the bar: every line the steps print, live
//   Up Down PageUp PageDown Home End   scroll the log (End or scrolling to the bottom follows it again)
//   Ctrl+C       asks to stop; y stops (the running step is killed, the rest is not run), anything else goes on
//   when it is over:  Enter or q leaves,  r runs the failed steps again,  v the log,  l logs out or b reboots (after y) when the steps made it worth it
// outcome() is "running" until the person leaves after the run has finished.
class InstallApp {
	function init( run, opts = {} ) {
		variables.run = arguments.run;
		variables.keepAlive = arguments.opts.keepAlive ?: "";
		variables.keepAliveTicks = arguments.opts.keepAliveTicks ?: 600;   // 30 s at 50 ms a frame
		variables.verbose = arguments.opts.verbose ?: false;
		variables.scroll = 0;            // lines above the bottom of the log; 0 follows the newest line
		variables.confirming = false;
		variables.outcome = "running";
		variables.began = false;
		variables.ticks = 0;
		// sudo password, asked here once when sudo would ask for it (see util.Sudo): the run starts after it is accepted
		variables.verify = arguments.opts.verify ?: "";
		variables.phase = ( arguments.opts.passwordNeeded ?: false ) && !isSimpleValue( variables.verify ) ? "password" : "run";
		variables.password = "";
		variables.message = "";
		variables.tries = 0;
		variables.maxTries = 3;
		variables.cancelled = false;
		variables.user = arguments.opts.user ?: "";
		// what the finish screen offers: log out or reboot (see InitFinish.advice); action is what was chosen and confirmed
		variables.adv = { relogin: false, reboot: false, action: "" };
		variables.advGiven = false;
		variables.asking = "";
		variables.details = false;
		return this;
	}

	function hasTick() { return true; }
	function phase() { return variables.phase; }
	function maskedPassword() { return repeatString( "•", len( variables.password ) ); }
	function message() { return variables.message; }
	function cancelled() { return variables.cancelled; }
	function user() { return variables.user; }
	function run() { return variables.run; }
	function outcome() { return variables.outcome; }
	function verbose() { return variables.verbose; }
	function scroll() { return variables.scroll; }
	function confirming() { return variables.confirming; }
	// The finish screen's offer: { relogin, reboot, action }. Worked out once the run is over, from the steps that were done.
	function advice() {
		if ( !variables.advGiven && variables.run.finished() ) {
			variables.advGiven = true;
			var ids = [];
			for ( var d in variables.run.result().done ) ids.append( d.id );
			var a = new bxrig.InitFinish().advice( ids );
			variables.adv.relogin = a.relogin;
			variables.adv.reboot = a.reboot;
		}
		return variables.adv;
	}
	/** True when the finish screen shows the step list instead of the summary (the d key toggles it). */
	function details() { return variables.details; }

	/**
	 * What the summary page shows once the run is over: the next steps, and the skipped steps sorted into what was already in place,
	 * what needs a decision and what was skipped (each with the command to do it later).
	 * @return { next: [lines], inPlace: [], needsYou: [], skipped: [] }
	 */
	function summary() {
		var fin = new bxrig.InitFinish();
		var res = variables.run.result();
		var done = [];
		for ( var d in res.done ) done.append( d.id );
		var c = fin.classify( res.skipped );
		c.next = fin.advice( done ).next;
		return c;
	}

	// "logout" or "reboot" while its question is on the screen, "" otherwise.
	function asking() { return variables.asking; }

	// Every frame: start the run, let it look at its steps, and keep sudo's ticket fresh so a long step never asks for the password on the screen.
	function onTick( tick ) {
		variables.ticks++;
		if ( variables.phase == "password" ) return this;
		if ( !variables.began ) { variables.began = true; variables.run.begin(); }
		variables.run.tick();
		if ( !variables.run.finished() && !isSimpleValue( variables.keepAlive ) && variables.ticks mod variables.keepAliveTicks == 0 ) {
			try { variables.keepAlive(); } catch ( any e ) {}
		}
		return this;
	}

	// The password box: typed characters are hidden, Enter checks it (up to three tries), Escape or Ctrl+C gives up.
	function passwordKey( k ) {
		if ( k == "Escape" || k == "Ctrl+c" ) { variables.cancelled = true; variables.outcome = "done"; return this; }
		if ( k == "Backspace" ) { variables.password = len( variables.password ) > 1 ? left( variables.password, len( variables.password ) - 1 ) : ""; return this; }
		if ( k == "Ctrl+u" ) { variables.password = ""; return this; }
		if ( len( k ) == 1 ) { variables.password &= k; variables.message = ""; return this; }
		if ( k == "Enter" && len( variables.password ) ) {
			var r = variables.verify( variables.password );
			variables.password = "";
			if ( r.ok ) {
				variables.run.setAskpass( r.askpass );
				variables.phase = "run";
				variables.message = "";
			} else {
				variables.tries++;
				if ( variables.tries >= variables.maxTries ) { variables.cancelled = true; variables.outcome = "done"; variables.message = "sudo did not accept the password"; }
				else variables.message = ( r.error == "wrong password" ? "That password was not accepted" : r.error ) & " (" & variables.tries & " of " & variables.maxTries & "). Try again.";
			}
		}
		return this;
	}

	function onKey( key ) {
		var k = arguments.key;
		if ( variables.phase == "password" ) return passwordKey( k );
		if ( len( variables.asking ) ) {
			if ( k == "y" || k == "Y" ) { variables.adv.action = variables.asking; variables.outcome = "done"; }
			variables.asking = "";
			return this;
		}
		if ( variables.confirming ) {
			if ( k == "y" || k == "Y" ) variables.run.stop();
			variables.confirming = false;
			return this;
		}
		if ( k == "Ctrl+c" ) {
			if ( variables.run.finished() ) variables.outcome = "done";
			else variables.confirming = true;
			return this;
		}
		if ( k == "v" ) { variables.verbose = !variables.verbose; variables.scroll = 0; return this; }
		if ( k == "d" && variables.run.finished() ) { variables.details = !variables.details; return this; }
		if ( variables.run.finished() ) {
			if ( k == "Enter" || k == "q" || k == "Escape" ) { variables.outcome = "done"; return this; }
			if ( k == "r" ) { variables.run.retry(); return this; }
			// log out when the session, groups or keys changed; reboot only when the boot, the login screen or a driver did
			if ( k == "l" && advice().relogin && !advice().reboot ) { variables.asking = "logout"; return this; }
			if ( k == "b" && advice().reboot ) { variables.asking = "reboot"; return this; }
		}
		if ( variables.verbose ) {
			switch ( k ) {
				case "Up": case "k":         variables.scroll++; break;
				case "Down": case "j":       variables.scroll = max( 0, variables.scroll - 1 ); break;
				case "PageUp":               variables.scroll += 10; break;
				case "PageDown":             variables.scroll = max( 0, variables.scroll - 10 ); break;
				case "Home":                 variables.scroll = 100000; break;
				case "End":                  variables.scroll = 0; break;
			}
		}
		return this;
	}

	function onScroll( direction ) {
		if ( !variables.verbose ) return this;
		if ( arguments.direction == "up" ) variables.scroll += 3;
		else variables.scroll = max( 0, variables.scroll - 3 );
		return this;
	}

	// The install screen has nothing to click.
	function act( hit ) { return this; }
}
