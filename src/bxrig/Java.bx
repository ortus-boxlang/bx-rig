/**
 * `bxrig java`: your Java versions in one place. jenv switches between them; the JDKs come from SDKMAN (when installed) or a Temurin download.
 *   bxrig java setup [--versions=25,17] [--yes] [--dry-run]   installs jenv, its shell snippet, JDK 21 (mandatory) plus the versions you list, and makes 21 the global one
 *   bxrig java status [--json]                jenv, the global version, what is installed
 *   bxrig java list [--json]                  every home: id, version, vendor, source; marks the global one and the one this shell uses
 *   bxrig java available [--json]             the Temurin releases you can install (long-term support ones are marked)
 *   bxrig java install MAJOR|IDENTIFIER [--yes] [--dry-run]   installs the newest Temurin of that major (SDKMAN when installed, else a download into ~/.local/share/bxrig/java) and registers it with jenv
 *   bxrig java global ID|MAJOR [--yes]        the version every new shell uses (`jenv global`); "default" is the old name
 *   bxrig java local ID|MAJOR [--yes]         the version for the current folder (`jenv local`, writes .java-version)
 *   bxrig java remove ID [--yes] [--dry-run]  deletes a home that BxRig or SDKMAN installed here (never the system's) and forgets it in jenv
 * An id is the folder name: "temurin-21.0.13_9". A major number (21) picks the newest home of that major.
 * Overrides for tests: BXRIG_JAVA_DIR, BXRIG_JAVA_SYSTEM_DIR (default /usr/lib/jvm), BXRIG_SDKMAN_DIR (default ~/.sdkman), BXRIG_JENV_DIR (default ~/.jenv),
 * BXRIG_JENV_REPO, BXRIG_ADOPTIUM_API, BXRIG_JAVA_DOWNLOAD_URL (replaces the download link, may be file://).
 * Exit: 0 ok, 2 a plan was shown without --yes (or bad usage), 4 unknown home or release or a home that cannot be removed, 6 download or unpack failed.
 */
class Java {

	/**
	 * @cli The command line context of this run.
	 * @runner Optional fake process runner for tests.
	 */
	function init( cli, runner = "" ) {
		variables.environ = new bxrig.util.Env();
		variables.cli = arguments.cli;
		variables.out = new bxrig.util.Out( variables.cli, "java" );
		variables.proc = new bxrig.util.Proc( arguments.runner );
		variables.http = new bxrig.util.Http( variables.proc );
		variables.config = new bxrig.ConfigService().quiet( true );
		variables.jenv = new bxrig.Jenv( variables.cli, arguments.runner );
		return this;
	}

	/** Where BxRig's own Temurin downloads live. */
	function dataDir() { return variables.environ.named( "javaDir", variables.environ.xdgData( "bxrig/java" ) ); }

	/** The system JDK folder. */
	function sysDir() { return variables.environ.named( "javaSystemDir", "/usr/lib/jvm" ); }

	/** SDKMAN's Java candidates folder. */
	function sdkDir() { return variables.environ.named( "sdkmanDir", variables.environ.home() & "/.sdkman" ) & "/candidates/java"; }

	/** The Adoptium API root. */
	function api() { return variables.environ.named( "adoptiumApi", "https://api.adoptium.net" ); }

	/** The files an older BxRig wrote (java.sh, java.fish). jenv replaces them, setup removes them. */
	function oldFiles() {
		var d = variables.config.cfgHome() & "/bxrig";
		return [ d & "/java.sh", d & "/java.fish" ];
	}

	// ---- reading homes ----
	/**
	 * The value of KEY="..." in a JDK's `release` file, or "".
	 * @dir The JDK folder.
	 * @key The key, like JAVA_VERSION.
	 */
	function releaseValue( dir, key ) {
		var f = arguments.dir & "/release";
		if ( !fileExists( f ) ) return "";
		for ( var l in listToArray( fileRead( f ), chr( 10 ) ) ) if ( left( l, len( arguments.key ) + 1 ) == arguments.key & "=" ) return replace( trim( mid( l, len( arguments.key ) + 2, 200 ) ), chr( 34 ), "", "all" );
		return "";
	}

	/**
	 * Describes a JDK folder, or an empty struct when it is not a JDK.
	 * @dir The JDK folder.
	 * @source bxrig, sdkman or system.
	 * @id The id to show.
	 */
	function homeFrom( dir, source, id ) {
		var v = releaseValue( arguments.dir, "JAVA_VERSION" );
		if ( !len( v ) || !fileExists( arguments.dir & "/bin/java" ) ) return {};
		var major = listFirst( v, "." );
		if ( major == "1" ) major = listGetAt( v, 2, "." );
		var vendor = releaseValue( arguments.dir, "IMPLEMENTOR" );
		return { id: arguments.id, major: int( val( major ) ), version: v, vendor: vendor, source: arguments.source, path: arguments.dir, default: false, active: false, removable: arguments.source == "bxrig" || arguments.source == "sdkman" };
	}

	/**
	 * Every JDK folder under a root.
	 * @root The folder holding the JDKs.
	 * @source bxrig, sdkman or system.
	 * @prefix Put before each folder name to make the id.
	 */
	function scan( root, source, prefix ) {
		var out = [];
		if ( !directoryExists( arguments.root ) ) return out;
		for ( var n in directoryList( arguments.root, false, "name" ) ) {
			if ( n == "current" ) continue;
			var h = homeFrom( arguments.root & "/" & n, arguments.source, arguments.prefix & n );
			if ( structCount( h ) ) out.append( h );
		}
		return out;
	}

	/**
	 * Every Java home, newest first, with the global one (from jenv) and the one this shell uses marked.
	 */
	function homes() {
		var all = scan( dataDir(), "bxrig", "" );
		for ( var h in scan( sdkDir(), "sdkman", "sdkman-" ) ) all.append( h );
		for ( var s in scan( sysDir(), "system", "system-" ) ) all.append( s );
		var glob = variables.jenv.globalVersion();
		var cur = variables.environ.named( "javaHome", "" );
		for ( var x in all ) {
			x.default = len( glob ) && variables.jenv.nameFor( x ) == glob;
			x.active = len( cur ) && x.path == cur;
		}
		arraySort( all, function( a, b ) { return b.major - a.major != 0 ? b.major - a.major : compare( b.id, a.id ); } );
		return all;
	}

	/**
	 * The home that an id or a major number names, or an empty struct.
	 * @ref An id like temurin-21.0.13_9 or a major like 21.
	 */
	function find( ref ) {
		var r = arguments.ref;
		var best = {};
		for ( var h in homes() ) {
			if ( h.id == r ) return h;
			if ( isNumeric( r ) && h.major == int( val( r ) ) && !structCount( best ) ) best = h;
		}
		return best;
	}

	// ---- releases ----
	/**
	 * The Temurin releases Adoptium offers: { ok, releases, lts, latest } or { ok: false, error }.
	 */
	function releases() {
		var r = variables.http.get( api() & "/v3/info/available_releases", 20 );
		if ( !r.ok ) return { ok: false, error: "could not reach " & api() };
		try {
			var j = jsonDeserialize( r.output );
			return { ok: true, releases: j.available_releases, lts: j.available_lts_releases, latest: j.most_recent_feature_release };
		} catch ( any e ) { return { ok: false, error: "unexpected answer from " & api() }; }
	}

	/**
	 * The download link of the latest Temurin JDK of a major.
	 * @major The Java major.
	 */
	function downloadUrl( major ) {
		var forced = variables.environ.named( "javaDownloadUrl", "" );
		if ( len( forced ) ) return forced;
		return api() & "/v3/binary/latest/" & arguments.major & "/ga/linux/x64/jdk/hotspot/normal/eclipse";
	}

	// ---- jenv bookkeeping ----
	/**
	 * Registers every home with jenv that it does not know yet. Does nothing when jenv is not installed.
	 * @return The number of homes added.
	 */
	function sync() {
		if ( !variables.jenv.installed() ) return 0;
		var n = 0;
		for ( var h in homes() ) if ( !len( variables.jenv.nameFor( h ) ) ) { variables.jenv.add( h.path ); n++; }
		return n;
	}

	/**
	 * The failure answer for commands that need jenv when it is not installed.
	 * @asJson True for JSON output.
	 */
	function needJenv( asJson ) {
		return variables.out.fail( "precondition", "jenv is not installed. Run: bxrig java setup --yes", arguments.asJson );
	}

	// ---- commands ----
	/**
	 * Lists every home.
	 * @asJson True for JSON output.
	 */
	function list( asJson ) {
		var hs = homes();
		var lines = [];
		for ( var h in hs ) lines.append( ( h.default ? "*" : " " ) & ( h.active ? ">" : " " ) & " " & left( h.id & repeatString( " ", 28 ), 28 ) & left( h.version & repeatString( " ", 12 ), 12 ) & left( h.source & repeatString( " ", 8 ), 8 ) & h.vendor );
		if ( !hs.len() ) lines.append( "No Java found. Set it up: bxrig java setup --yes" );
		else lines.append( "* global (jenv)   > this shell" );
		return variables.out.say( "ok", { homes: hs, global: variables.jenv.globalVersion() }, arguments.asJson, lines );
	}

	/**
	 * jenv, the global version and what is installed.
	 * @asJson True for JSON output.
	 */
	function status( asJson ) {
		var hs = homes();
		var glob = variables.jenv.globalVersion();
		var majors = [];
		for ( var h in hs ) if ( !arrayFind( majors, h.major ) ) majors.append( h.major );
		var lines = [
			"jenv:     " & ( variables.jenv.installed() ? "installed in " & variables.jenv.root() : "not installed (bxrig java setup --yes)" ),
			"global:   " & ( len( glob ) ? glob : "not set" ),
			"versions: " & ( majors.len() ? majors.toList( ", " ) : "none" )
		];
		return variables.out.say( "ok", { jenv: variables.jenv.installed(), root: variables.jenv.root(), global: glob, majors: majors }, arguments.asJson, lines );
	}

	/**
	 * Lists the Temurin releases Adoptium offers.
	 * @asJson True for JSON output.
	 */
	function available( asJson ) {
		var r = releases();
		if ( !r.ok ) return variables.out.fail( "failed", r.error, arguments.asJson );
		var lines = [];
		var rows = [];
		for ( var m in r.releases ) { var lts = arrayFind( r.lts, m ) > 0; rows.append( { major: m, lts: lts } ); lines.append( "Java " & m & ( lts ? "  (long-term support)" : "" ) ); }
		return variables.out.say( "ok", { releases: rows, latest: r.latest }, arguments.asJson, lines );
	}

	/**
	 * Downloads and unpacks the latest Temurin JDK of a major into BxRig's folder. Prints nothing.
	 * @major The Java major.
	 * @return { ok, error, id, path, version, already }
	 */
	function fetchTemurin( major ) {
		var m = int( val( arguments.major ) );
		var tmp = dataDir() & "/.download-" & m;
		directoryCreate( tmp, true, true );
		var tar = tmp & "/jdk.tar.gz";
		var d = variables.http.download( downloadUrl( m ), tar, 900 );
		if ( !d.ok || !fileExists( tar ) ) { try { directoryDelete( tmp, true ); } catch ( any e ) {} return { ok: false, error: "download failed: " & trim( d.output ) }; }
		var stage = tmp & "/x";
		directoryCreate( stage, true, true );
		var x = systemExecute( "tar", [ "-xzf", tar, "-C", stage, "--strip-components=1" ], 600, true );
		var probe = homeFrom( stage, "bxrig", "" );
		if ( x.exitCode != 0 || !structCount( probe ) ) { try { directoryDelete( tmp, true ); } catch ( any e ) {} return { ok: false, error: "the download is not a JDK" }; }
		var sem = releaseValue( stage, "SEMANTIC_VERSION" );
		var id = "temurin-" & replace( len( sem ) ? sem : probe.version, "+", "_", "all" );
		var dest = dataDir() & "/" & id;
		if ( directoryExists( dest ) ) { try { directoryDelete( tmp, true ); } catch ( any e ) {} return { ok: true, id: id, path: dest, version: probe.version, already: true }; }
		directoryRename( stage, dest );
		try { directoryDelete( tmp, true ); } catch ( any e ) {}
		return { ok: true, id: id, path: dest, version: probe.version, already: false };
	}

	/**
	 * Makes sure a Java major is installed (through SDKMAN when it is there, else a Temurin download) and returns the result. Prints nothing.
	 * @major The Java major.
	 * @return { ok, error, already }
	 */
	function ensureMajor( major ) {
		if ( structCount( find( arguments.major ) ) && find( arguments.major ).major == int( val( arguments.major ) ) ) return { ok: true, already: true };
		var sdk = new bxrig.Sdk( variables.cli );
		if ( sdk.installed() ) {
			var id = sdk.temurinFor( arguments.major );
			if ( !len( id ) ) return { ok: false, error: "SDKMAN has no Temurin " & arguments.major };
			var r = sdk.runSdk( "install", "java", id );
			return r.exitCode == 0 ? { ok: true, already: false } : { ok: false, error: "sdk install failed: " & trim( right( r.output, 300 ) ) };
		}
		var f = fetchTemurin( arguments.major );
		return f.ok ? { ok: true, already: f.already } : f;
	}

	/**
	 * Installs a JDK and registers it with jenv.
	 * @major A major like 21, or a SDKMAN identifier like 21.0.13.0+9-tem.
	 * @yes Apply (without it, only the plan is shown).
	 * @dry Show the plan and change nothing.
	 * @asJson True for JSON output.
	 */
	function install( major, yes, dry, asJson ) {
		var sdk = new bxrig.Sdk( variables.cli );
		if ( sdk.installed() && len( arguments.major ) ) {
			var id = isNumeric( arguments.major ) ? sdk.temurinFor( arguments.major ) : arguments.major;
			if ( !len( id ) ) return variables.out.fail( "precondition", "SDKMAN has no Temurin " & arguments.major & ". See: bxrig sdk available java", arguments.asJson );
			var res = sdk.act( "install", "java", id, arguments.yes, arguments.dry, arguments.asJson );
			if ( arguments.yes && !arguments.dry ) sync();
			return res;
		}
		if ( len( arguments.major ) && !isNumeric( arguments.major ) ) return variables.out.fail( "precondition", "An identifier like " & arguments.major & " needs SDKMAN. Install it with: bxrig sdk setup --yes", arguments.asJson );
		if ( !isNumeric( arguments.major ) ) return variables.out.say( "usage", { error: "usage" }, arguments.asJson, [ new bxrig.CommandSpec().usage( "java install" ) ] );
		var m = int( val( arguments.major ) );
		var rel = releases();
		if ( rel.ok && !arrayFind( rel.releases, m ) ) return variables.out.fail( "precondition", "Temurin has no Java " & m & " release. See: bxrig java available", arguments.asJson );
		var planTitle = "download the latest Temurin JDK " & m & " from " & api() & " and unpack it into " & dataDir() & "/ (a folder named after its version).";
		var plan = [ "It is registered with jenv (when installed). Make it global with: bxrig java global " & m ];
		var data = { major: m, dir: dataDir() };
		if ( !arguments.yes || arguments.dry ) return variables.out.plan( planTitle, data, arguments.asJson, arguments.dry, plan, "Add --yes to install." );
		var f = fetchTemurin( m );
		if ( !f.ok ) return variables.out.fail( "failed", f.error, arguments.asJson );
		if ( f.already ) return variables.out.say( "ok", { id: f.id, path: f.path, already: true }, arguments.asJson, [ f.id & " is already installed." ] );
		sync();
		data.id = f.id; data.path = f.path; data.version = f.version;
		return variables.out.say( "ok", data, arguments.asJson, [ "Installed " & f.id & " in " & f.path, "Make it global: bxrig java global " & f.id & " --yes" ] );
	}

	/**
	 * Installs jenv, writes its shell snippet, installs JDK 21 plus the extra majors, registers them and makes 21 global.
	 * @extra Extra majors, like [ 25, 17 ]. 21 is always installed.
	 * @yes Apply (without it, only the plan is shown).
	 * @dry Show the plan and change nothing.
	 * @asJson True for JSON output.
	 */
	function setup( extra, yes, dry, asJson ) {
		var majors = [ 21 ];
		for ( var e in arguments.extra ) if ( isNumeric( e ) && !arrayFind( majors, int( val( e ) ) ) ) majors.append( int( val( e ) ) );
		var planTitle = "set up Java: jenv in " & variables.jenv.root() & ", JDK " & majors.toList( ", " ) & ", and 21 as the global version.";
		var plan = [
			"Clones jenv (" & variables.jenv.repo() & ") and enables its export, maven and gradle plugins.",
			"Writes " & variables.jenv.shFile() & " and " & variables.jenv.fishFile() & "; the shell starters source them (your own shell files are not edited).",
			"Installs SDKMAN when it is missing (needs curl, zip, unzip; otherwise Temurin comes straight from Adoptium), then JDK " & majors.toList( ", " ) & " (skipped when already there). Needs git."
		];
		var data = { majors: majors, jenv: variables.jenv.root() };
		if ( !variables.proc.has( "git" ) && !variables.jenv.installed() ) return variables.out.fail( "precondition", "git is missing. Install it: bxrig pkg install git", arguments.asJson );
		if ( !arguments.yes || arguments.dry ) return variables.out.plan( planTitle, data, arguments.asJson, arguments.dry, plan, "Add --yes to set up." );
		var inst = variables.jenv.install();
		if ( inst.exitCode != 0 || !variables.jenv.installed() ) return variables.out.fail( "failed", "jenv could not be installed: " & variables.proc.why( inst ), arguments.asJson );
		var notes = [];
		var bad = variables.jenv.enablePlugins();
		if ( bad.len() ) notes.append( "jenv plugins not enabled: " & bad.toList( ", " ) );
		variables.jenv.writeShell();
		for ( var f in oldFiles() ) if ( fileExists( f ) ) fileDelete( f );
		var failed = [];
		var sdk = new bxrig.Sdk( variables.cli );
		if ( !sdk.installed() ) {
			var bs = sdk.bootstrap();
			if ( !bs.ok ) notes.append( "SDKMAN was not installed (" & bs.error & "); using Temurin downloads instead." );
		}
		for ( var m in majors ) {
			var r = ensureMajor( m );
			if ( !r.ok ) { failed.append( m ); notes.append( "Java " & m & ": " & r.error ); }
		}
		sync();
		var h = find( 21 );
		if ( structCount( h ) && h.major == 21 ) {
			var nm = variables.jenv.nameFor( h );
			if ( len( nm ) ) variables.jenv.setGlobal( nm );
		}
		data.failed = failed;
		data.global = variables.jenv.globalVersion();
		var lines = [ "jenv is ready in " & variables.jenv.root() & ". Global Java: " & ( len( data.global ) ? data.global : "not set" ) ];
		for ( var n in notes ) lines.append( n );
		lines.append( "Open a new terminal (or log in again) so the shell loads jenv." );
		if ( failed.contains( 21 ) ) return variables.out.fail( "failed", "Java 21 could not be installed. " & arrayToList( notes, " " ), arguments.asJson );
		return variables.out.say( "ok", data, arguments.asJson, lines );
	}

	/**
	 * Makes a version global (every new shell) or local (this folder) through jenv.
	 * @scope global or local.
	 * @ref An id or a major.
	 * @yes Apply (without it, only the plan is shown).
	 * @dry Show the plan and change nothing.
	 * @asJson True for JSON output.
	 */
	function choose( scope, ref, yes, dry, asJson ) {
		if ( !variables.jenv.installed() ) return needJenv( arguments.asJson );
		var h = find( arguments.ref );
		if ( !structCount( h ) ) return variables.out.fail( "precondition", "no Java home matches " & arguments.ref & ". See: bxrig java list", arguments.asJson );
		var planTitle = ( arguments.scope == "global" ? "every new shell uses " : "this folder (" & variables.environ.named( "pwd", "." ) & ") uses " ) & h.id & " (Java " & h.version & ").";
		var plan = [ arguments.scope == "global" ? "Runs: jenv global. Open a new terminal to see it." : "Runs: jenv local (writes .java-version here)." ];
		var data = { id: h.id, path: h.path, version: h.version, scope: arguments.scope };
		if ( !arguments.yes || arguments.dry ) return variables.out.plan( planTitle, data, arguments.asJson, arguments.dry, plan );
		sync();
		var nm = variables.jenv.nameFor( h );
		if ( !len( nm ) ) return variables.out.fail( "failed", "jenv does not know " & h.id & " (jenv add " & h.path & " failed)", arguments.asJson );
		var r = arguments.scope == "global" ? variables.jenv.setGlobal( nm ) : variables.jenv.setLocal( nm );
		if ( r.exitCode != 0 ) return variables.out.fail( "failed", "jenv " & arguments.scope & " failed: " & trim( right( r.output, 300 ) ), arguments.asJson );
		return variables.out.say( "ok", data, arguments.asJson, [ ( arguments.scope == "global" ? "Global Java is now " : "This folder uses " ) & h.id & " (" & h.version & ")." ] );
	}

	/**
	 * Deletes a JDK that BxRig or SDKMAN installed and forgets it in jenv.
	 * @ref An id or a major.
	 * @yes Apply (without it, only the plan is shown).
	 * @dry Show the plan and change nothing.
	 * @asJson True for JSON output.
	 */
	function remove( ref, yes, dry, asJson ) {
		var h = find( arguments.ref );
		if ( !structCount( h ) ) return variables.out.fail( "precondition", "no Java home matches " & arguments.ref, arguments.asJson );
		if ( !h.removable ) return variables.out.fail( "precondition", h.id & " came from " & h.source & ", so BxRig will not delete it. Remove it with that tool.", arguments.asJson );
		var nm = variables.jenv.nameFor( h );
		if ( h.source == "sdkman" ) {
			var res = new bxrig.Sdk( variables.cli ).act( "remove", "java", listLast( h.path, "/" ), arguments.yes, arguments.dry, arguments.asJson );
			if ( arguments.yes && !arguments.dry && len( nm ) ) variables.jenv.forget( nm );
			return res;
		}
		var planTitle = "delete " & h.path & " (" & h.id & ").";
		var plan = [];
		if ( h.default ) plan.append( "It is the global Java; jenv will have no global version afterwards. Pick another: bxrig java global 21 --yes" );
		if ( !arguments.yes || arguments.dry ) return variables.out.plan( planTitle, { id: h.id }, arguments.asJson, arguments.dry, plan, "Add --yes to delete." );
		if ( len( nm ) ) variables.jenv.forget( nm );
		directoryDelete( h.path, true );
		return variables.out.say( "ok", { id: h.id, removed: true }, arguments.asJson, [ "Removed " & h.id ] );
	}

	/**
	 * Runs a `bxrig java` subcommand.
	 * @words The words after `java`.
	 * @opts The options (versions).
	 * @yes Apply changes.
	 * @dry Show plans only.
	 * @asJson True for JSON output.
	 */
	function run( words, opts, yes, dry, asJson ) {
		var sub = arguments.words.len() ? arguments.words[ 1 ] : "list";
		var ref = arguments.words.len() >= 2 ? arguments.words[ 2 ] : "";
		if ( sub == "list" ) return list( arguments.asJson );
		if ( sub == "status" ) return status( arguments.asJson );
		if ( sub == "available" ) return available( arguments.asJson );
		if ( sub == "install" ) return install( ref, arguments.yes, arguments.dry, arguments.asJson );
		if ( sub == "setup" ) return setup( listToArray( arguments.opts.versions ?: "", ", " ), arguments.yes, arguments.dry, arguments.asJson );
		if ( sub == "global" || sub == "default" || sub == "local" ) {
			if ( !len( ref ) ) return variables.out.say( "usage", { error: "usage" }, arguments.asJson, [ new bxrig.CommandSpec().usage( "java" ) ] );
			return choose( sub == "local" ? "local" : "global", ref, arguments.yes, arguments.dry, arguments.asJson );
		}
		if ( sub == "remove" ) { if ( !len( ref ) ) return variables.out.say( "usage", { error: "usage" }, arguments.asJson, [ new bxrig.CommandSpec().usage( "java remove" ) ] ); return remove( ref, arguments.yes, arguments.dry, arguments.asJson ); }
		return variables.out.say( "usage", { error: "usage" }, arguments.asJson, [ new bxrig.CommandSpec().usage( "java" ) ] );
	}
}
