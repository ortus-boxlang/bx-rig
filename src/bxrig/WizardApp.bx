// The setup wizard's state and behaviour, with no drawing: which screen is showing, the answers so far, and what each key
// or click does. WizardView draws it, Wizard runs the loop. Because nothing here touches the terminal it is unit tested.
//
// The pages come from a spec struct (see assets/wizard/pages-demo.json): { title, tagline, pages: [ { id, title,
// intro, questions: [ { type: choice|multi|text|number|confirm|info, id, label, help, ... } ] } ] }.
// Answers are a flat struct id -> value (string, array of strings, number or boolean).
//
// Screens: "welcome", "start" (how to begin: a new install, an imported file, saved answers; only when opts.start), "page" (page number
// pageIndex(), 1 based) and "review". outcome() is "running", "done" or "cancelled".
class WizardApp {
	// opts (all optional): start (true: a start screen follows the welcome), presets ({ new, saved }: the starting answers of each choice),
	// importer (function( path ) -> { ok, answers, ignored, error }: reads an answers file).
	function init( spec, preset = {}, opts = {} ) {
		variables.spec = arguments.spec;
		variables.start = arguments.opts.start ?: false;
		variables.presets = arguments.opts.presets ?: {};
		variables.importer = arguments.opts.importer ?: "";
		variables.startIndex = 1;
		variables.importing = false;
		variables.importPath = "";
		variables.importError = "";
		variables.notice = "";
		variables.spec.version = new bxrig.util.Version().current();   // the one source of the version (box.json via gen-version.sh); the page files carry none
		variables.screen = "welcome";
		variables.page = 1;
		variables.reviewScroll = 0;
		variables.reviewMax = 0;
		variables.furthest = 0;   // the highest step reached: pages 1..n, then n + 1 for the review
		variables.focus = 1;      // index into rows() of the focused row on the current page
		variables.outcome = "running";
		variables.answers = {};
		resetAnswers( arguments.preset );
		return this;
	}

	// Every answer back to its default, then the preset on top.
	function resetAnswers( preset ) {
		variables.answers = {};
		for ( var pg in variables.spec.pages ) {
			for ( var q in pg.questions ) {
				if ( q.type == "info" ) continue;
				variables.answers[ q.id ] = defaultFor( q );
			}
		}
		for ( var id in structKeyArray( arguments.preset ) ) {
			if ( variables.answers.keyExists( id ) ) variables.answers[ id ] = coerce( id, arguments.preset[ id ] );
		}
		return this;
	}

	// An imported value in the shape its question wants (a list question given one string, a choice given a list).
	function coerce( id, value ) {
		for ( var pg in variables.spec.pages ) for ( var q in pg.questions ) {
			if ( ( q.id ?: "" ) != arguments.id ) continue;
			if ( q.type == "multi" && !isArray( arguments.value ) ) return len( toString( arguments.value ) ) && toString( arguments.value ) != "none" ? [ toString( arguments.value ) ] : [];
			if ( q.type == "choice" && isArray( arguments.value ) ) return arguments.value.len() ? arguments.value[ 1 ] : "";
		}
		return arguments.value;
	}

	// ---- the start screen: how to begin ----

	// The ways to begin: the whole wizard, answers imported from a file, and (when there are some) the answers saved last time.
	function startChoices() {
		var out = [
			{ id: "new", label: "New install", help: "Answer the whole wizard from the defaults." },
			{ id: "import", label: "Import answers from a file", help: "From a file made with: bxrig init --export" }
		];
		var saved = variables.presets.saved ?: {};
		if ( isStruct( saved ) && structCount( saved ) ) out.append( { id: "saved", label: "Use my saved answers", help: "Exactly what you chose last time. Review, change, go." } );
		return out;
	}

	function startIndex()   { return variables.startIndex; }
	function importing()    { return variables.importing; }
	function importPath()   { return variables.importPath; }
	function importError()  { return variables.importError; }
	function notice()       { return variables.notice; }

	function chooseStart() {
		var c = startChoices()[ variables.startIndex ];
		if ( c.id == "new" ) { resetAnswers( variables.presets.new ?: {} ); variables.notice = ""; gotoPage( nextVisible( 0 ) ); }
		else if ( c.id == "saved" ) { resetAnswers( variables.presets.saved ); variables.notice = "Your saved answers"; gotoReview(); }
		else { variables.importing = true; variables.importError = ""; }
		return this;
	}

	// Reads the file with the importer: its answers go on top of the new-install defaults and the review follows.
	function doImport() {
		var path = trim( variables.importPath );
		if ( !len( path ) ) { variables.importError = "Type the path of your answers file."; return this; }
		if ( isSimpleValue( variables.importer ) ) { variables.importError = "Importing is not available here."; return this; }
		var r = variables.importer( path );
		if ( !r.ok ) { variables.importError = r.error; return this; }
		var merged = {};
		for ( var k in structKeyArray( variables.presets.new ?: {} ) ) merged[ k ] = variables.presets.new[ k ];
		for ( var k2 in structKeyArray( r.answers ) ) merged[ k2 ] = r.answers[ k2 ];
		resetAnswers( merged );
		var used = 0;
		for ( var k3 in structKeyArray( r.answers ) ) if ( variables.answers.keyExists( k3 ) ) used++;
		variables.notice = "Imported " & used & " answers from " & path & ( r.ignored.len() ? " (" & r.ignored.len() & " not used by this version)" : "" );
		variables.importing = false;
		variables.importError = "";
		gotoReview();
		return this;
	}

	function startKey( key ) {
		if ( variables.importing ) {
			if ( arguments.key == "Escape" ) { variables.importing = false; variables.importError = ""; }
			else if ( arguments.key == "Enter" ) doImport();
			else if ( arguments.key == "Backspace" ) variables.importPath = len( variables.importPath ) > 1 ? left( variables.importPath, len( variables.importPath ) - 1 ) : "";
			else if ( arguments.key == "Ctrl+u" ) variables.importPath = "";
			else if ( len( arguments.key ) == 1 ) { variables.importPath &= arguments.key; variables.importError = ""; }
			return this;
		}
		var n = startChoices().len();
		switch ( arguments.key ) {
			case "Up": case "k":            variables.startIndex = max( 1, variables.startIndex - 1 ); break;
			case "Down": case "j":          variables.startIndex = min( n, variables.startIndex + 1 ); break;
			case "Enter": case " ":         chooseStart(); break;
			case "Escape": case "Left": case "BackTab": variables.screen = "welcome"; break;
		}
		return this;
	}

	// Whether a question (or a page) is shown: no `when`, or the answer to when.id is one of when.in, equals when.equals, or (a list answer) contains when.has; `when.any` is a list of such conditions (one is enough) and a question with `hidden: true` is never shown.
	// Hidden questions have no rows, are left out of the review and out of finalAnswers().
	function isVisible( q ) {
		// `hidden: true` holds a value the wizard never asks for (what the system detected) that other questions' `when` can read
		if ( structKeyExists( arguments.q, "hidden" ) && arguments.q.hidden ) return false;
		if ( !structKeyExists( arguments.q, "when" ) ) return true;
		var w = arguments.q.when;
		// `any`: a list of conditions, shown when one of them holds
		if ( structKeyExists( w, "any" ) ) {
			for ( var c in w.any ) if ( isVisible( { when: c } ) ) return true;
			return false;
		}
		var current = answerString( w.id );
		if ( structKeyExists( w, "nonempty" ) ) return answerList( w.id ).len() > 0;
		if ( structKeyExists( w, "has" ) ) return arrayFind( answerList( w.id ), w.has ) > 0;
		if ( structKeyExists( w, "in" ) ) return arrayFind( w.in, current ) > 0;
		if ( structKeyExists( w, "equals" ) ) return current == w.equals;
		return true;
	}

	// The answers of the questions that are shown (what the caller acts on).
	function finalAnswers() {
		var out = {};
		for ( var pg in variables.spec.pages ) {
			if ( !isVisible( pg ) ) continue;
			for ( var q in pg.questions ) if ( q.type != "info" && isVisible( q ) ) out[ q.id ] = variables.answers[ q.id ];
		}
		return out;
	}

	// Whether page n is shown: a page may carry `when` like a question (the app pages appear only for "customize").
	function pageVisible( n ) { return arguments.n >= 1 && arguments.n <= pageCount() && isVisible( variables.spec.pages[ arguments.n ] ); }

	// The numbers of the pages that are shown, in order.
	function visiblePages() {
		var out = [];
		for ( var i = 1; i <= pageCount(); i++ ) if ( pageVisible( i ) ) out.append( i );
		return out;
	}

	// Steps in the progress display: the shown pages plus the review.
	function stepCount() { return visiblePages().len() + 1; }

	// The 1-based step of a page number among the shown pages (0 when it is hidden).
	function stepOf( n ) {
		var v = visiblePages();
		for ( var i = 1; i <= v.len(); i++ ) if ( v[ i ] == arguments.n ) return i;
		return 0;
	}

	function nextVisible( from ) {
		for ( var i = arguments.from + 1; i <= pageCount(); i++ ) if ( pageVisible( i ) ) return i;
		return 0;
	}

	function prevVisible( from ) {
		for ( var i = arguments.from - 1; i >= 1; i-- ) if ( pageVisible( i ) ) return i;
		return 0;
	}

	// What a question starts as: its default, else the first option (choice), none (multi), empty, its default number, no.
	function defaultFor( q ) {
		switch ( q.type ) {
			case "choice":  return q.keyExists( "default" ) ? q.default : ( q.options.len() ? q.options[ 1 ].value : "" );
			case "multi":   return q.keyExists( "default" ) ? q.default : [];
			case "text":    return q.keyExists( "default" ) ? q.default : "";
			case "number":  return q.keyExists( "default" ) ? q.default : q.min;
			case "confirm": return q.keyExists( "default" ) ? q.default : false;
		}
		return "";
	}

	function spec()      { return variables.spec; }
	function screen()    { return variables.screen; }
	function pageIndex() { return variables.page; }
	function furthest()  { return variables.furthest; }
	function focus()     { return variables.focus; }
	function outcome()   { return variables.outcome; }
	function answers()   { return variables.answers; }
	function pageCount() { return variables.spec.pages.len(); }

	// The rows of a page, in order: { kind: heading|group|opt|field|info|space, q, i, group }.
	// q is the question number and i the option number (both 1 based) where they apply.
	function rowsOf( pg ) {
		var out = [];
		var qn = 0;
		for ( var q in arguments.pg.questions ) {
			qn++;
			if ( !isVisible( q ) ) continue;
			if ( out.len() ) out.append( { kind: "space", q: 0, i: 0, group: "" } );
			if ( q.type == "info" ) {
				out.append( { kind: "info", q: qn, i: 0, group: "" } );
			} else if ( q.type == "choice" || q.type == "multi" ) {
				out.append( { kind: "heading", q: qn, i: 0, group: "" } );
				var group = "";
				var oi = 0;
				for ( var o in q.options ) {
					oi++;
					var og = o.keyExists( "group" ) ? o.group : "";
					if ( og != group ) {
						group = og;
						if ( len( group ) ) out.append( { kind: "group", q: qn, i: 0, group: group } );
					}
					out.append( { kind: "opt", q: qn, i: oi, group: "" } );
				}
				// a picture of what the choice does (the app grid styles) sits under the options
				if ( q.type == "choice" && ( q.preview ?: "" ) == "appgrid" ) out.append( { kind: "preview", q: qn, i: 0, group: "" } );
			} else {
				out.append( { kind: "heading", q: qn, i: 0, group: "" } );
				out.append( { kind: "field", q: qn, i: 0, group: "" } );
			}
		}
		return out;
	}

	// The rows of the current page ([] on other screens).
	function rows() {
		return variables.screen == "page" ? rowsOf( variables.spec.pages[ variables.page ] ) : [];
	}

	function isFocusable( row ) {
		return row.kind == "opt" || row.kind == "field";
	}

	// Typed accessors for answers.
	function answerString( id ) { return variables.answers.keyExists( arguments.id ) ? toString( variables.answers[ arguments.id ] ) : ""; }
	function answerList( id )   { return variables.answers.keyExists( arguments.id ) ? variables.answers[ arguments.id ] : []; }
	function answerNumber( id ) { return variables.answers.keyExists( arguments.id ) ? variables.answers[ arguments.id ] : 0; }
	function answerBool( id )   { return variables.answers.keyExists( arguments.id ) ? variables.answers[ arguments.id ] == true : false; }

	/** How many rows the review is scrolled down. */
	function reviewScroll() { return variables.reviewScroll; }

	/**
	 * Tells the app how far the review can scroll (the view works it out from the room it has).
	 * @max The largest scroll offset.
	 */
	function setReviewMax( max ) {
		variables.reviewMax = arguments.max;
		variables.reviewScroll = min( variables.reviewScroll, arguments.max );
		return this;
	}

	/**
	 * Scrolls the review by some rows, within 0 and the maximum the view reported.
	 * @by Rows, negative for up.
	 */
	function scrollReview( by ) {
		variables.reviewScroll = max( 0, min( variables.reviewMax, variables.reviewScroll + arguments.by ) );
		return this;
	}

	// A readable value for the review screen.
	function display( q ) {
		switch ( arguments.q.type ) {
			case "choice":
				var v = answerString( arguments.q.id );
				for ( var o in arguments.q.options ) if ( o.value == v ) return o.label & ( structKeyExists( arguments.q, "notes" ) && structKeyExists( arguments.q.notes, v ) ? " (" & arguments.q.notes[ v ] & ")" : "" );
				return v;
			case "multi":
				var names = [];
				for ( var v in answerList( arguments.q.id ) ) {
				var shown = v;
				for ( var o in arguments.q.options ) if ( o.value == v ) { shown = o.label; break; }
				names.append( shown );
			}
				return names.len() ? names.toList( ", " ) : "none";
			case "text":
				var t = answerString( arguments.q.id );
				return len( t ) ? t : "not set";
			case "number":
				return toString( answerNumber( arguments.q.id ) );
			case "confirm":
				return answerBool( arguments.q.id ) ? "yes" : "no";
		}
		return "";
	}

	// The row to focus first on a page: its first focusable one, or, when that is an option of a single choice, the option that is the answer now
	// (so Enter keeps the default instead of picking the first option).
	function firstFocus( pg ) {
		var rs = rowsOf( arguments.pg );
		for ( var i = 1; i <= rs.len(); i++ ) {
			if ( !isFocusable( rs[ i ] ) ) continue;
			if ( rs[ i ].kind == "opt" && arguments.pg.questions[ rs[ i ].q ].type == "choice" ) {
				var q = arguments.pg.questions[ rs[ i ].q ];
				for ( var j = i; j <= rs.len() && rs[ j ].q == rs[ i ].q; j++ ) if ( rs[ j ].kind == "opt" && q.options[ rs[ j ].i ].value == answerString( q.id ) ) return j;
			}
			return i;
		}
		return 1;
	}

	function gotoPage( n ) {
		if ( !pageVisible( arguments.n ) ) return this;
		variables.screen = "page";
		variables.page = arguments.n;
		variables.furthest = max( variables.furthest, arguments.n );
		variables.focus = firstFocus( variables.spec.pages[ arguments.n ] );
		return this;
	}

	function gotoReview() {
		variables.furthest = pageCount() + 1;
		variables.screen = "review";
		variables.reviewScroll = 0;
		return this;
	}

	function nextPage() {
		if ( variables.screen == "welcome" ) { if ( variables.start ) variables.screen = "start"; else gotoPage( nextVisible( 0 ) ); }
		else if ( variables.screen == "page" ) { var nx = nextVisible( variables.page ); if ( nx ) gotoPage( nx ); else gotoReview(); }
		else variables.outcome = "done";
		return this;
	}

	function prevPage() {
		if ( variables.screen == "page" ) { var pv = prevVisible( variables.page ); if ( pv ) gotoPage( pv ); else variables.screen = variables.start ? "start" : "welcome"; }
		else if ( variables.screen == "review" ) gotoPage( prevVisible( pageCount() + 1 ) );
		return this;
	}

	function moveFocus( down ) {
		var rs = rows();
		var i = variables.focus;
		while ( true ) {
			i += arguments.down ? 1 : -1;
			if ( i < 1 || i > rs.len() ) return this;
			if ( isFocusable( rs[ i ] ) ) { variables.focus = i; followFocus(); return this; }
		}
	}

	// A choice marked `live` (the pages that preview what they pick: top bar layout, app grid, theme) selects whatever has focus, so the arrow
	// keys change the preview at once.
	function followFocus() {
		var row = focusedRow();
		if ( row.kind != "opt" ) return this;
		var q = variables.spec.pages[ variables.page ].questions[ row.q ];
		if ( q.type == "choice" && ( q.live ?: false ) == true ) variables.answers[ q.id ] = q.options[ row.i ].value;
		return this;
	}

	function focusedRow() {
		var rs = rows();
		return variables.focus >= 1 && variables.focus <= rs.len() ? rs[ variables.focus ] : { kind: "space", q: 0, i: 0, group: "" };
	}

	// Select or toggle whatever has focus (space, or a click).
	function activate() {
		if ( variables.screen != "page" ) return this;
		var pg = variables.spec.pages[ variables.page ];
		var row = focusedRow();
		if ( row.kind == "opt" ) {
			var q = pg.questions[ row.q ];
			var value = q.options[ row.i ].value;
			if ( q.type == "choice" ) {
				variables.answers[ q.id ] = value;
			} else {
				var current = answerList( q.id );
				var kept = current.filter( function( x ) { return x != value; } );
				variables.answers[ q.id ] = kept.len() == current.len() ? current.append( value ) : kept;
			}
		} else if ( row.kind == "field" ) {
			var q = pg.questions[ row.q ];
			if ( q.type == "confirm" ) variables.answers[ q.id ] = !answerBool( q.id );
		}
		var rs = rows();
		if ( variables.focus > rs.len() || !isFocusable( rs[ variables.focus ] ) ) variables.focus = firstFocus( pg );
		return this;
	}

	// Enter: finish this question and go to the next one, or to the next page after the last.
	function advance() {
		if ( variables.screen != "page" ) return nextPage();
		var pg = variables.spec.pages[ variables.page ];
		var rs = rowsOf( pg );
		var row = focusedRow();
		if ( !isFocusable( row ) ) return nextPage();
		if ( pg.questions[ row.q ].type == "choice" ) activate();
		for ( var i = variables.focus + 1; i <= rs.len(); i++ ) {
			if ( isFocusable( rs[ i ] ) && rs[ i ].q != row.q ) { variables.focus = i; return this; }
		}
		return nextPage();
	}

	function adjustNumber( delta ) {
		var row = focusedRow();
		if ( row.kind != "field" ) return this;
		var q = variables.spec.pages[ variables.page ].questions[ row.q ];
		if ( q.type != "number" ) return this;
		variables.answers[ q.id ] = min( q.max, max( q.min, answerNumber( q.id ) + arguments.delta ) );
		return this;
	}

	// The id of the text question that has focus, or "".
	function textFieldId() {
		if ( variables.screen != "page" ) return "";
		var row = focusedRow();
		if ( row.kind != "field" ) return "";
		var q = variables.spec.pages[ variables.page ].questions[ row.q ];
		return q.type == "text" ? q.id : "";
	}

	// A key event from poll_event: { key, ctrl, alt, shift }. Single characters are typed text or shortcuts; named keys
	// (Enter, Escape, Tab, Up...) are longer than one character.
	function onKey( key ) {
		if ( arguments.key == "Ctrl+c" ) { variables.outcome = "cancelled"; return this; }
		if ( variables.screen == "welcome" ) {
			if ( arguments.key == "Enter" || arguments.key == " " ) nextPage();
			else if ( arguments.key == "Escape" || arguments.key == "q" ) variables.outcome = "cancelled";
			return this;
		}
		if ( variables.screen == "start" ) return startKey( arguments.key );
		if ( variables.screen == "review" ) {
			if ( arguments.key == "Enter" ) variables.outcome = "done";
			else if ( arguments.key == "Escape" || arguments.key == "Left" || arguments.key == "BackTab" ) prevPage();
			else if ( arguments.key == "Up" || arguments.key == "k" ) scrollReview( -1 );
			else if ( arguments.key == "Down" || arguments.key == "j" ) scrollReview( 1 );
			else if ( arguments.key == "PageUp" ) scrollReview( -10 );
			else if ( arguments.key == "PageDown" ) scrollReview( 10 );
			else if ( arguments.key == "Home" ) variables.reviewScroll = 0;
			else if ( arguments.key == "End" ) variables.reviewScroll = variables.reviewMax;
			return this;
		}
		var tid = textFieldId();
		if ( len( tid ) ) {
			if ( len( arguments.key ) == 1 ) { variables.answers[ tid ] = answerString( tid ) & arguments.key; return this; }
			if ( arguments.key == "Backspace" ) { var s = answerString( tid ); variables.answers[ tid ] = len( s ) > 1 ? left( s, len( s ) - 1 ) : ""; return this; }
			if ( arguments.key == "Ctrl+u" ) { variables.answers[ tid ] = ""; return this; }
		}
		switch ( arguments.key ) {
			case "Up": case "k":                      moveFocus( false ); break;
			case "Down": case "j":                    moveFocus( true ); break;
			case " ":                                  activate(); break;
			case "Enter":                              advance(); break;
			case "Left": case "-":                     adjustNumber( -1 ); break;
			case "Right": case "+":                    adjustNumber( 1 ); break;
			case "Tab": case "PageDown":               nextPage(); break;
			case "BackTab": case "PageUp": case "Escape": prevPage(); break;
		}
		return this;
	}

	// A click on something the view drew: { kind: page|review|focus, n }. Sidebar entries only work once reached.
	function act( action ) {
		if ( arguments.action.kind == "page" && arguments.action.n <= variables.furthest ) gotoPage( arguments.action.n );
		else if ( arguments.action.kind == "review" && variables.furthest >= pageCount() + 1 ) variables.screen = "review";
		else if ( arguments.action.kind == "focus" ) { variables.focus = arguments.action.n; activate(); }
		return this;
	}

	// The mouse wheel moves focus.
	function onScroll( direction ) {
		if ( variables.screen == "page" ) moveFocus( arguments.direction == "down" );
		return this;
	}

	// The answers as pretty JSON.
	function answersJson() {
		return jsonSerialize( finalAnswers() );
	}
}
