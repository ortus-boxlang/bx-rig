// Storage: this computer's disk (space used and the last disk speed test, `system speedtest last`), then NAS shares and cloud remotes with
// their mount state (`nas list`, `cloud status`). t on the disk row runs `system speedtest disk`; on a share it tests the share.
class StorageProvider {
	function init( demo = false ) { variables.demo = arguments.demo; variables.proc = new bxrig.util.Proc(); return this; }
	function id() { return "storage"; }
	function icon() { return new bxrig.ControlCenterPages().icon( "storage" ); }
	function title() { return "Storage"; }
	function hint() { return "This computer, NAS and cloud"; }
	function emptyText() { return "No NAS or cloud yet. Add a NAS: bxrig nas add NAME --host=HOST"; }
	function columns() { return [ { key: "mark", label: "", w: 3 }, { key: "name", label: "name", w: 22 }, { key: "kind", label: "kind", w: 10 }, { key: "state", label: "state", w: 14 }, { key: "where", label: "where", w: 0 } ]; }
	function style( r ) { return r.kind == "disk" ? "" : ( r.state == "mounted" ? "ok" : "dim" ); }
	function detail( r ) {
		if ( r.kind == "disk" ) return [ "This computer: " & r.state & ( len( r.where ) ? ", " & r.where : "" ), "t tests the disk speed (writes and reads 1 GiB in ~/.cache)." ];
		return [ r.name & " (" & r.kind & ") " & r.where, r.state == "mounted" ? "Mounted. Press u to unmount." : "Not mounted. Press m to mount." ];
	}

	function actions() {
		return [
			{ key: "m", label: "mount", run: function( r ) { return r.kind == "disk" ? {} : r.kind == "cloud" ? { action: "cli", title: "Mount " & r.name, args: [ "cloud", "mount", r.name ] } : { action: "cli", title: "Mount " & r.name, args: [ "nas", "mount", r.nas, r.share ] }; } },
			{ key: "u", label: "unmount", run: function( r ) { return r.kind == "disk" ? {} : r.kind == "cloud" ? { action: "cli", title: "Unmount " & r.name, args: [ "cloud", "unmount", r.name ] } : { action: "cli", title: "Unmount " & r.name, args: [ "nas", "unmount", r.nas, r.share ] }; } },
			{ key: "t", label: "test", run: function( r ) { return r.kind == "disk" ? { action: "show", title: "Disk speed (up to a minute)", args: [ "system", "speedtest", "disk" ] } : { action: "show", title: "Test " & r.name, args: r.kind == "cloud" ? [ "cloud", "status" ] : [ "nas", "test", r.nas, r.share ] }; } }
		];
	}

	// The first row: this computer's disk, from df and the last disk speed test (pure for tests: give the numbers).
	function diskRow( total, used, last ) {
		var gb = function( b ) { return numberFormat( arguments.b / 1000000000, "0" ); };
		var speed = structKeyExists( arguments.last, "write" ) ? "write " & arguments.last.write & " · read " & ( arguments.last.read ?: "" ) : "speed not tested yet (t)";
		return { mark: "◆", name: "This computer", kind: "disk", state: arguments.total > 0 ? gb( arguments.used ) & " of " & gb( arguments.total ) & " GB" : "", where: speed, nas: "", share: "" };
	}

	function load( q = "" ) {
		if ( variables.demo ) return [ diskRow( 512000000000, 312000000000, { write: "712 MB/s", read: "4.3 GB/s" } ), { mark: "●", name: "syno/backups", kind: "smb", state: "mounted", where: "/mnt/nas/backups", nas: "syno", share: "backups" }, { mark: "●", name: "syno/media", kind: "nfs", state: "mounted", where: "/mnt/nas/media", nas: "syno", share: "media" }, { mark: "○", name: "syno/photos", kind: "smb", state: "not mounted", where: "/mnt/nas/photos", nas: "syno", share: "photos" }, { mark: "●", name: "gdrive", kind: "cloud", state: "mounted", where: "~/Cloud/gdrive", nas: "", share: "" } ];
		var rows = [];
		for ( var n in ( variables.proc.selfData( [ "nas", "list" ] ).nas ?: [] ) ) {
			var shares = n.shares ?: {};
			for ( var sh in structKeyArray( shares ) ) rows.append( { mark: "○", name: n.name & "/" & sh, kind: n.protocol ?: "nas", state: ( shares[ sh ].mounted ?: false ) ? "mounted" : "not mounted", where: shares[ sh ].mountpoint ?: "", nas: n.name, share: sh } );
		}
		for ( var c in ( variables.proc.selfData( [ "cloud", "status" ] ).mounts ?: [] ) ) rows.append( { mark: "●", name: c.name ?: "", kind: "cloud", state: ( c.mounted ?: false ) ? "mounted" : "not mounted", where: c.path ?: "", nas: "", share: "" } );
		for ( var r in rows ) r.mark = r.state == "mounted" ? "●" : "○";
		var du = new bxrig.DashboardData().diskInfo();
		rows.prepend( diskRow( du.total ?: 0, du.used ?: 0, variables.proc.selfData( [ "system", "speedtest", "last" ] ).disk ?: {} ) );
		return rows;
	}
}
