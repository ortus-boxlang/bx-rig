// Draws the setup wizard on MatchBox's terminal canvas (docs/tui.md in the MatchBox repo): the welcome splash, the pages
// with a step sidebar, and the review. Catppuccin Frappe neutrals with the Ortus brand gradient (cyan #00DBFF to green
// #00FF78) until a theme is chosen: the wizard then follows the color theme answer (`theme_name`), so every screen is drawn in the
// highlighted theme's colours while the Theme page is open. Every screen shows "Powered by BoxLang / www.boxlang.io".
//
// A choice may carry `preview`: "bar" (every option shows its top bar under it), "appgrid" (a preview of both grids under the options) or
// "theme" (a swatch on every row and a pane with the highlighted theme's palette beside the list); an info row with preview "dock" draws the dock.
//
// paint( app, tick, width, height ) records the frame's drawing commands without painting the terminal, so a test can read
// it back with tui.render_to_string( width, height ); the run loop calls tui.end_frame() afterwards. paint() also records
// what a click on each region does, read with hitAt( x, y ).
class WizardView {
	function init( tui ) {
		variables.tui = arguments.tui;
		variables.data = new bxrig.WizardData();
		// the brand wordmark: BXRIG in the DOS Rebel font, the same as `bxrig ascii` and the logo everywhere else
		variables.wordmark = new bxrig.Brand().large();
		variables.kit = new bxrig.TuiKit( arguments.tui );
		variables.look = new bxrig.LookPreview( variables.kit );
		variables.bl = new bxrig.BarLayouts();
		variables.palettes = {};
		variables.themeColors = {};
		variables.paletteName = "";
		variables.gridRows = 2;   // rows of apps in the app grid previews: 2, or 1 when the page is short
		syncShades();
		variables.shownKey = "";
		variables.changedAt = 0;
		variables.stars = [];
		variables.starsFor = "";
		return this;
	}

	// ---------------------------------------------------------------- colour and drawing helpers (the shared kit does the work)

	// The shade variables the drawing code reads, from the kit's palette.
	function syncShades() {
		for ( var shade in [ "BASE", "MANTLE", "CRUST", "SURFACE0", "SURFACE1", "OVERLAY", "TEXT", "SUB", "GREEN", "CYAN", "YELLOW", "RED" ] ) variables[ shade ] = variables.kit.color( shade );
	}

	// The parsed colours of a theme, kept after the first read (the Theme page asks again on every frame).
	function colorsOf( name ) {
		if ( !structKeyExists( variables.themeColors, arguments.name ) ) variables.themeColors[ arguments.name ] = new bxrig.Palette().colorsOf( arguments.name );
		return variables.themeColors[ arguments.name ];
	}

	// The palette follows the color theme answer: the wizard is drawn in the theme that is highlighted.
	function followTheme( app ) {
		var name = arguments.app.answerString( "theme_name" );
		if ( name == variables.paletteName ) return;
		variables.paletteName = name;
		if ( !structKeyExists( variables.palettes, name ) ) variables.palettes[ name ] = new bxrig.Palette().forTheme( name );
		variables.kit.setPalette( variables.palettes[ name ] );
		syncShades();
	}


	// Pixel art (an array of rows) in the brand gradient with a shimmer, one gradient per few cells.
	function artBlock( x, y, lines, phase ) {
		var w = 1;
		for ( var l in arguments.lines ) w = max( w, len( l ) );
		var h = arguments.lines.len();
		var dy = 0;
		for ( var line in arguments.lines ) {
			var pos = 0;
			while ( pos < len( line ) ) {
				var piece = mid( line, pos + 1, 6 );
				if ( len( trim( piece ) ) ) {
					var t0 = ( pos + dy * 0.6 ) / ( w + h * 0.6 );
					var t1 = ( pos + len( piece ) + dy * 0.6 ) / ( w + h * 0.6 );
					variables.tui.gradient( arguments.x + pos, arguments.y + dy, piece, variables.kit.c( variables.kit.shimmer( t0 * w, w, arguments.phase ) ), variables.kit.c( variables.kit.shimmer( t1 * w, w, arguments.phase ) ), { bg: variables.kit.c( variables.BASE ) } );
				}
				pos += len( piece );
			}
			dy++;
		}
	}

	// "Powered by BoxLang" with the address under it, centred on column cx.
	function poweredBy( cx, y, phase, bg, dim, faint ) {
		var line = "Powered by ";
		var x = arguments.cx - int( ( len( line ) + 7 ) / 2 );
		variables.kit.put( x, arguments.y, line, arguments.dim, arguments.bg );
		variables.kit.gtext( x + len( line ), arguments.y, "BoxLang", true, arguments.phase, arguments.bg );
		variables.kit.put( arguments.cx - 7, arguments.y + 1, "www.boxlang.io", arguments.faint, arguments.bg );
	}

	// ---------------------------------------------------------------- the frame

	// What a click at x, y does: a { kind, n } struct, kind "" when it hits nothing.
	function hitAt( x, y ) { var h = variables.kit.hitAt( arguments.x, arguments.y ); return { kind: h.kind, n: h.n }; }

	// The drawing kit (a test reads the palette the wizard is drawn in).
	function kit() { return variables.kit; }

	function paint( app, tick, width, height ) {
		variables.kit.clearHits();
		followTheme( arguments.app );
		var key = app.screen() & ":" & app.pageIndex();
		if ( key != variables.shownKey ) { variables.shownKey = key; variables.changedAt = arguments.tick; }
		var age = ( arguments.tick - variables.changedAt ) / 7;
		variables.kit.setFade( age >= 1 ? 1 : age * age * ( 3 - 2 * age ) );
		variables.tui.begin_frame();
		variables.tui.fill( 0, 0, arguments.width, arguments.height, { bg: variables.BASE } );
		if ( arguments.width < 76 || arguments.height < 24 ) {
			var msg = "Make the window a little bigger (76 x 24)";
			variables.kit.put( int( ( arguments.width - len( msg ) ) / 2 ), int( arguments.height / 2 ), msg, variables.YELLOW, variables.BASE );
			return this;
		}
		var phase = ( arguments.tick mod 90 ) / 90 * 1.4 - 0.2;
		if ( app.screen() == "welcome" ) welcome( app, arguments.tick, arguments.width, arguments.height, phase );
		else if ( app.screen() == "start" ) startScreen( app, arguments.tick, arguments.width, arguments.height, phase );
		else pages( app, arguments.tick, arguments.width, arguments.height, phase );
		return this;
	}

	// Twinkling dots behind the welcome art. Positions come from a small fixed generator and are cached per size.
	function starfield( width, height, avoid, tick ) {
		var sizeKey = arguments.width & "x" & arguments.height;
		if ( sizeKey != variables.starsFor ) {
			variables.starsFor = sizeKey;
			variables.stars = variables.kit.starPositions( 46, arguments.width, arguments.height, arguments.avoid );
		}
		for ( var s in variables.stars ) {
			var tw = ( sin( arguments.tick / 14 + s.i * 1.7 ) * 0.5 + 0.5 ) * 0.85;
			variables.kit.put( s.x, s.y, s.i mod 7 == 0 ? "+" : "·", variables.kit.mix( variables.BASE, s.i mod 3 == 0 ? variables.CYAN : variables.SUB, tw * 0.8 ), variables.BASE );
		}
	}

	// How to begin: a new install, answers imported from a file, or the saved ones. The import asks for the path right here.
	function startScreen( app, tick, width, height, phase ) {
		var choices = app.startChoices();
		var w = min( 78, arguments.width - 4 );
		var fieldRows = app.importing() ? 5 : 0;
		var h = 8 + choices.len() * 2 + fieldRows;
		var top = 1;
		var cx = int( arguments.width / 2 );
		// the wordmark above when the window is tall enough (DOS Rebel, 8 rows)
		if ( arguments.height >= h + 14 ) {
			var big = new bxrig.Brand().large();
			var bw = 0; for ( var l in big ) bw = max( bw, len( l ) );
			top += variables.kit.logo( cx - int( bw / 2 ), top, "large", arguments.phase, variables.BASE ) + 1;
		} else top = max( 1, int( ( arguments.height - h ) / 2 ) );
		var x = cx - int( w / 2 );
		variables.kit.fillRect( x, top, w, h, variables.MANTLE );
		variables.kit.panel( x, top, w, h, "How do you want to start?", true, arguments.phase );
		var ix = x + 3; var iw = w - 6; var ry = top + 2;
		for ( var i = 1; i <= choices.len(); i++ ) {
			var sel = i == app.startIndex();
			var marker = sel ? "●" : "○";
			var col = sel ? variables.GREEN : variables.TEXT;
			variables.kit.put( ix, ry, marker & "  " & choices[ i ].label, col, variables.MANTLE, sel );
			variables.kit.put( ix + 3, ry + 1, variables.kit.trunc( choices[ i ].help, iw - 3 ), sel ? variables.SUB : variables.OVERLAY, variables.MANTLE );
			ry += 2;
		}
		if ( app.importing() ) {
			ry++;
			variables.kit.put( ix, ry, "Path of your answers file:", variables.SUB, variables.MANTLE );
			var fw = iw;
			variables.kit.fillRect( ix, ry + 1, fw, 1, variables.SURFACE0 );
			var path = app.importPath();
			if ( len( path ) ) variables.kit.put( ix + 1, ry + 1, right( path, fw - 3 ), variables.GREEN, variables.SURFACE0, true );
			else variables.kit.put( ix + 1, ry + 1, "for example ~/answers.json", variables.OVERLAY, variables.SURFACE0 );
			if ( ( arguments.tick \ 6 ) mod 2 == 0 ) variables.kit.put( ix + 1 + min( len( path ), fw - 3 ), ry + 1, "▏", variables.GREEN, variables.SURFACE0 );
			if ( len( app.importError() ) ) variables.kit.put( ix, ry + 3, variables.kit.trunc( app.importError(), iw ), variables.YELLOW, variables.MANTLE );
		}
		variables.kit.keybar( 0, arguments.height - 1, arguments.width, app.importing() ? [ [ "enter", "import" ], [ "esc", "back" ] ] : [ [ "↑↓", "choose" ], [ "enter", "continue" ], [ "esc", "back" ], [ "ctrl-c", "quit" ] ] );
	}

	function welcome( app, tick, width, height, phase ) {
		var markW = 0; for ( var l in variables.wordmark ) markW = max( markW, len( l ) );
		// the laptop: the largest size that leaves room for the wordmark, tagline and the footer
		var brand = new bxrig.Brand();
		var art = {}; var artH = 0;
		for ( var sz in [ "large", "medium", "small" ] ) {
			var cand = brand.laptop( sz );
			var rowsNeeded = int( cand.rows.len() / 2 );
			if ( rowsNeeded + 1 + variables.wordmark.len() + 4 + 10 <= arguments.height && cand.w + 2 <= arguments.width ) { art = cand; artH = rowsNeeded; break; }
		}
		var totalH = artH + ( artH ? 1 : 0 ) + variables.wordmark.len() + 4;
		var top = max( 1, int( ( arguments.height - totalH ) / 2 ) );
		var cx = int( arguments.width / 2 );
		var boxW = max( markW, structKeyExists( art, "w" ) ? art.w : 0 );
		starfield( arguments.width, arguments.height, { x: max( 0, cx - int( boxW / 2 ) - 1 ), y: top, w: boxW + 2, h: totalH + 1 }, arguments.tick );
		if ( artH ) variables.kit.pixelArt( cx - int( art.w / 2 ), top, art, variables.BASE );
		var y = top + artH + ( artH ? 1 : 0 );
		if ( markW < arguments.width - 2 ) artBlock( cx - int( markW / 2 ), y, variables.wordmark, arguments.phase );
		else variables.kit.gtext( cx - 3, y, "BXRIG", true, arguments.phase, variables.BASE );
		y += variables.wordmark.len() + 1;
		var tag = len( app.spec().tagline ) ? app.spec().tagline : new bxrig.Brand().tagline();
		variables.kit.put( cx - int( len( tag ) / 2 ), y, tag, variables.SUB, variables.BASE );
		var prompt = "press  enter  to begin";
		var pulse = ( sin( arguments.tick / 8 ) * 0.5 + 0.5 ) * 0.7 + 0.3;
		variables.kit.put( cx - int( len( prompt ) / 2 ), y + 2, prompt, variables.kit.mix( variables.OVERLAY, variables.GREEN, pulse ), variables.BASE );
		poweredBy( cx, arguments.height - 4, arguments.phase, variables.BASE, variables.SUB, variables.OVERLAY );
		if ( len( app.spec().version ) ) {
			var v = "v" & app.spec().version;
			variables.kit.put( cx - int( len( v ) / 2 ), arguments.height - 2, v, variables.OVERLAY, variables.BASE );
		}
	}

	function pages( app, tick, width, height, phase ) {
		var n = app.stepCount() - 1;
		var step = app.screen() == "page" ? app.stepOf( app.pageIndex() ) : n + 1;
		variables.kit.gtext( 3, 1, "◆ BxRig", true, arguments.phase, variables.BASE );
		variables.kit.put( 13, 1, "setup", variables.SUB, variables.BASE );
		// without the step list (under 92 columns) the notice goes in the header, as much of it as fits before the progress bar
		var barW = arguments.width < 92 ? 12 : 24;
		if ( arguments.width < 92 ) variables.kit.put( 20, 1, arguments.width >= 99 ? "· Powered by BoxLang · www.boxlang.io" : ( arguments.width >= 80 ? "· Powered by BoxLang" : "" ), variables.OVERLAY, variables.BASE );
		var label = "step " & step & " of " & ( n + 1 );
		var barX = arguments.width - barW - 3;
		variables.kit.put( barX - len( label ) - 2, 1, label, variables.SUB, variables.BASE );
		for ( var i = 0; i < barW; i++ ) {
			var filled = ( i + 1 ) / barW <= step / ( n + 1 );
			variables.kit.put( barX + i, 1, filled ? "━" : "─", filled ? variables.kit.brand( i / barW ) : variables.SURFACE0, variables.BASE );
		}
		for ( var x = 2; x < arguments.width - 2; x++ ) variables.kit.put( x, 2, "─", variables.kit.mix( variables.SURFACE1, variables.kit.shimmer( x, arguments.width, arguments.phase ), 0.25 ), variables.BASE );
		var hints = [ [ "↑↓", "move" ], [ "space", "select" ], [ "enter", "next" ], [ "tab", "next page" ], [ "esc", "back" ], [ "ctrl-c", "cancel" ] ];
		var hx = 3;
		for ( var hint in hints ) {
			hx = variables.kit.put( hx, arguments.height - 1, hint[ 1 ], variables.CYAN, variables.BASE ) + 1;
			hx = variables.kit.put( hx, arguments.height - 1, hint[ 2 ], variables.OVERLAY, variables.BASE ) + 3;
		}
		var bx = 2; var by = 3; var bw = arguments.width - 4; var bh = arguments.height - 4;
		var sideW = arguments.width >= 92 ? 28 : 0;
		if ( sideW > 0 ) sidebar( app, bx, by, sideW, bh, arguments.phase );
		var mx = bx + sideW + ( sideW > 0 ? 1 : 0 );
		var mw = bw - sideW - ( sideW > 0 ? 1 : 0 );
		if ( app.screen() == "review" ) review( app, arguments.tick, mx, by, mw, bh, arguments.phase );
		else page( app, arguments.tick, mx, by, mw, bh, arguments.phase );
	}

	/**
	 * A small BxRig laptop (the About logo, sampled down to 13 columns and 4 rows), drawn when the sidebar has room.
	 * @x Column of the left edge.
	 * @y Row of the top edge.
	 * @bg Background colour under it.
	 */
	function miniLaptop( x, y, bg ) {
		var logo = new bxrig.AboutLogo();
		var pal = logo.palette( {} );
		for ( var r = 0; r < 4; r++ ) {
			for ( var c = 0; c < 13; c++ ) {
				var px = 1 + c * 3;
				var top = logo.pixelColour( pal, px, 1 + r * 7 );
				var low = logo.pixelColour( pal, px, 1 + r * 7 + 3 );
				if ( !len( top ) && !len( low ) ) continue;
				if ( len( top ) && len( low ) ) variables.kit.put( arguments.x + c, arguments.y + r, "▀", variables.kit.c( top ), variables.kit.c( low ) );
				else if ( len( top ) ) variables.kit.put( arguments.x + c, arguments.y + r, "▀", variables.kit.c( top ), arguments.bg );
				else variables.kit.put( arguments.x + c, arguments.y + r, "▄", variables.kit.c( low ), arguments.bg );
			}
		}
	}

	function sidebar( app, x, y, w, h, phase ) {
		variables.kit.panel( arguments.x, arguments.y, arguments.w, arguments.h, "Steps", false, arguments.phase );
		var cx = arguments.x + int( arguments.w / 2 );
		poweredBy( cx, arguments.y + arguments.h - 4, arguments.phase, variables.MANTLE, variables.OVERLAY, variables.SURFACE1 );
		var vis = app.visiblePages();
		// the laptop sits bottom left, above Powered by BoxLang, when the step list leaves room for it
		if ( vis.len() + 3 < arguments.h - 11 && arguments.w >= 17 ) miniLaptop( arguments.x + 3, arguments.y + arguments.h - 9, variables.MANTLE );
		var n = app.pageCount();
		var current = app.screen() == "page" ? app.pageIndex() : 0;
		var steps = [];
		for ( var vp in vis ) steps.append( vp );
		steps.append( n + 1 );
		var row = 0;
		for ( var i in steps ) {
			row++;
			var ry = arguments.y + 1 + row;
			if ( ry >= arguments.y + arguments.h - 4 ) break;
			var isReview = i == n + 1;
			var title = isReview ? "Review" : app.spec().pages[ i ].title;
			var here = isReview ? app.screen() == "review" : current == i;
			var reached = i <= app.furthest();
			var done = i < app.furthest() && !here;
			var bg = here ? variables.SURFACE0 : variables.MANTLE;
			if ( here ) {
				variables.kit.fillRect( arguments.x + 1, ry, arguments.w - 2, 1, variables.SURFACE0 );
				variables.kit.put( arguments.x + 1, ry, "▌", variables.GREEN, variables.SURFACE0 );
			}
			var mark = ( done || here || reached ) ? "●" : "○";
			var col = done ? variables.GREEN : ( here ? variables.CYAN : ( reached ? variables.SUB : variables.OVERLAY ) );
			variables.kit.put( arguments.x + 3, ry, mark, col, bg );
			if ( here ) variables.kit.gtext( arguments.x + 6, ry, left( title, arguments.w - 9 ), true, arguments.phase, bg );
			else variables.kit.put( arguments.x + 6, ry, left( title, arguments.w - 9 ), reached ? variables.TEXT : variables.OVERLAY, bg );
			if ( reached ) variables.kit.hit( isReview ? "review" : "page", arguments.x + 1, ry, arguments.w - 2, 1, i );
		}
	}

	// The previews a page carries: the preview kind of its first choice that has one ("bar", "appgrid" or "theme"), "" for none.
	function previewKind( pg ) {
		for ( var q in arguments.pg.questions ) if ( q.type == "choice" && len( q.preview ?: "" ) ) return q.preview;
		return "";
	}

	// Whether the Theme page draws its palette pane beside the list (room for a list of 34 and a pane of 22 or more).
	function sideBySide( iw ) { return arguments.iw >= 58; }
	function themeListWidth( iw ) { return sideBySide( arguments.iw ) ? 34 : arguments.iw; }

	// The row number of option `i` of question `q`.
	function optionRow( rws, q, i ) {
		for ( var n = 1; n <= arguments.rws.len(); n++ ) if ( arguments.rws[ n ].kind == "opt" && arguments.rws[ n ].q == arguments.q && arguments.rws[ n ].i == arguments.i ) return n;
		return 0;
	}

	/**
	 * Draws one line of help text where `backticked` words are code: drawn in the accent colour on a darker strip, without the backticks.
	 * @x Column.
	 * @y Row.
	 * @line The text.
	 * @col Colour of the normal text.
	 * @bg Background colour.
	 * @inCode True when the previous line ended inside a code span.
	 * @return True when this line ends inside a code span.
	 */
	function rich( x, y, line, col, bg, inCode ) {
		var cx = arguments.x;
		var code = arguments.inCode;
		for ( var part in listToArray( arguments.line, chr( 96 ), true ) ) {
			if ( len( part ) ) cx = code ? variables.kit.put( cx, arguments.y, " " & part & " ", variables.CYAN, variables.CRUST ) : variables.kit.put( cx, arguments.y, part, arguments.col, arguments.bg );
			code = !code;
		}
		// the toggle ran once per piece, one more than the number of backticks
		return !code;
	}

	// Lines a row takes on the page.
	function rowHeight( pg, row, width ) {
		if ( row.kind == "heading" ) return 2 + variables.kit.wrap( pg.questions[ row.q ].help ?: "", width ).len();
		if ( row.kind == "info" ) {
			var q = pg.questions[ row.q ];
			return 2 + variables.kit.wrap( q.help ?: "", width ).len() + ( ( q.preview ?: "" ) == "dock" ? 1 : 0 );
		}
		if ( row.kind == "preview" ) return 1 + variables.look.gridHeight( variables.gridRows );
		if ( row.kind == "opt" && ( pg.questions[ row.q ].preview ?: "" ) == "bar" ) {
			var key = pg.questions[ row.q ].options[ row.i ].value;
			return 1 + variables.bl.height( key, width - 5 ) + variables.kit.wrap( variables.bl.layout( key ).desc, width - 5 ).len() + 1;
		}
		return 1;
	}

	function page( app, tick, x, y, w, h, phase ) {
		var pg = app.spec().pages[ app.pageIndex() ];
		var rws = app.rows();
		var kind = previewKind( pg );
		variables.kit.panel( arguments.x, arguments.y, arguments.w, arguments.h, pg.title, true, arguments.phase );
		var ix = arguments.x + 4; var iy = arguments.y + 1; var iw = arguments.w - 8; var ih = arguments.h - 2;
		var cy = iy + 1;
		if ( len( pg.intro ?: "" ) ) {
			var inCode = false;
			for ( var line in variables.kit.wrap( pg.intro, iw ) ) { inCode = rich( ix, cy, line, variables.SUB, variables.MANTLE, inCode ); cy++; }
			cy++;
		}
		var listTop = cy;
		var listBottom = iy + ih - 4;
		var rowW = kind == "theme" ? themeListWidth( iw ) : iw;
		variables.gridRows = listBottom - listTop >= 21 ? 2 : 1;
		var tops = [];
		var total = 0;
		var ww = kind == "theme" ? rowW : iw;   // headings and notes wrap to the list, not under the palette pane
		for ( var row in rws ) { tops.append( total ); total += rowHeight( pg, row, ww ); }
		var avail = max( 1, listBottom - listTop );
		var f = app.focus();
		var fTop = f <= tops.len() ? tops[ f ] : 0;
		var fH = f <= rws.len() ? rowHeight( pg, rws[ f ], ww ) : 1;
		var scroll = fTop + fH > avail ? fTop + fH - avail : 0;
		// a picture under the options is kept in view when the room allows: the options above it scroll away first
		for ( var idx = 1; idx <= rws.len(); idx++ ) {
			var row = rws[ idx ];
			var rh = rowHeight( pg, row, ww );
			var ry = listTop + tops[ idx ] - scroll;
			if ( ry < listTop || ry + rh > listBottom ) continue;
			var focused = idx == f;
			var bg = focused ? variables.SURFACE0 : variables.MANTLE;
			if ( row.kind == "heading" ) {
				var qn = pg.questions[ row.q ];
				variables.kit.put( ix, ry, qn.label, variables.TEXT, variables.MANTLE, true );
				// a long help text wraps under the question instead of running past the panel
				var hk = 1;
				var hc = false;
				for ( var hline in variables.kit.wrap( qn.help ?: "", ww ) ) { hc = rich( ix, ry + hk, hline, variables.OVERLAY, variables.MANTLE, hc ); hk++; }
			} else if ( row.kind == "group" ) {
				variables.kit.put( ix + 2, ry, ucase( row.group ), variables.OVERLAY, variables.MANTLE, true );
			} else if ( row.kind == "info" ) {
				var qn = pg.questions[ row.q ];
				variables.kit.put( ix, ry, qn.label, variables.TEXT, variables.MANTLE, true );
				var k = 0;
				var ic = false;
				for ( var line in variables.kit.wrap( qn.help ?: "", iw ) ) { ic = rich( ix, ry + 1 + k, line, variables.SUB, variables.MANTLE, ic ); k++; }
				if ( ( qn.preview ?: "" ) == "dock" ) variables.look.dock( ix, ry + 1 + k, min( iw, 44 ), true );
			} else if ( row.kind == "preview" ) {
				drawGrids( app, rws, row, pg, ix, ry, iw );
			} else if ( row.kind == "opt" ) {
				var qn = pg.questions[ row.q ];
				var opt = qn.options[ row.i ];
				var multi = qn.type == "multi";
				var selected = multi ? arrayFind( app.answerList( qn.id ), opt.value ) > 0 : app.answerString( qn.id ) == opt.value;
				if ( focused ) {
					variables.kit.fillRect( ix, ry, rowW, 1, variables.SURFACE0 );
					variables.kit.put( ix, ry, "▌", variables.kit.brand( 0.5 ), variables.SURFACE0 );
				}
				var mark = multi ? ( selected ? "◆" : "◇" ) : ( selected ? "●" : "○" );
				variables.kit.put( ix + 2, ry, mark, selected ? variables.GREEN : variables.OVERLAY, bg );
				variables.kit.put( ix + 5, ry, opt.label, selected ? variables.GREEN : variables.TEXT, bg, selected );
				// an option the machine already has is marked (the wizard never removes anything)
				if ( opt.installed ?: false ) variables.kit.put( ix + 5 + len( opt.label ) + 2, ry, "✓ installed", variables.OVERLAY, bg );
				if ( kind == "bar" ) {
					var lay = variables.bl.layout( opt.value );
					if ( len( lay.tag ) ) variables.kit.put( ix + 5 + len( opt.label ) + 2, ry, lay.tag, variables.OVERLAY, bg );
					var sh = variables.look.strip( ix + 5, ry + 1, iw - 5, opt.value, selected );
					var dn = 0;
					for ( var dl in variables.kit.wrap( lay.desc, iw - 5 ) ) { variables.kit.put( ix + 5, ry + 1 + sh + dn, dl, selected ? variables.SUB : variables.OVERLAY, variables.MANTLE ); dn++; }
				} else if ( kind == "theme" ) {
					if ( opt.value == "bxrig" ) variables.kit.put( ix + 5 + len( opt.label ) + 2, ry, "default", variables.OVERLAY, bg );
					var tcol = colorsOf( opt.value );
					if ( rowW >= 30 && !structIsEmpty( tcol ) ) variables.look.themeSwatch( ix + rowW - 10, ry, bg, tcol );
				}
				variables.kit.hit( "focus", ix, ry, rowW, rh, idx );
			} else if ( row.kind == "field" ) {
				var qn = pg.questions[ row.q ];
				if ( qn.type == "text" ) {
					var value = app.answerString( qn.id );
					var boxW = min( iw - 4, 52 );
					var fieldBg = focused ? variables.SURFACE0 : variables.CRUST;
					variables.kit.fillRect( ix + 2, ry, boxW, 1, fieldBg );
					var shown = len( value ) ? value : ( qn.placeholder ?: "" );
					variables.kit.put( ix + 3 + ( len( value ) ? 0 : 1 ), ry, left( shown, boxW - 4 ), len( value ) ? variables.TEXT : variables.OVERLAY, fieldBg );
					if ( focused && ( arguments.tick \ 6 ) mod 2 == 0 ) variables.kit.put( ix + 3 + min( len( value ), boxW - 3 ), ry, "▏", variables.GREEN, variables.SURFACE0 );
					variables.kit.put( ix, ry, focused ? "▌" : " ", variables.kit.brand( 0.5 ), variables.MANTLE );
				} else if ( qn.type == "number" ) {
					var v = app.answerNumber( qn.id );
					if ( focused ) { variables.kit.fillRect( ix, ry, iw, 1, variables.SURFACE0 ); variables.kit.put( ix, ry, "▌", variables.kit.brand( 0.5 ), variables.SURFACE0 ); }
					variables.kit.put( ix + 2, ry, "◀", v > qn.min ? variables.CYAN : variables.SURFACE1, bg );
					variables.kit.put( ix + 5, ry, toString( v ), variables.GREEN, bg, true );
					variables.kit.put( ix + 9, ry, "▶", v < qn.max ? variables.CYAN : variables.SURFACE1, bg );
					variables.kit.put( ix + 12, ry, qn.min & " to " & qn.max, variables.OVERLAY, bg );
				} else if ( qn.type == "confirm" ) {
					var on = app.answerBool( qn.id );
					if ( focused ) { variables.kit.fillRect( ix, ry, iw, 1, variables.SURFACE0 ); variables.kit.put( ix, ry, "▌", variables.kit.brand( 0.5 ), variables.SURFACE0 ); }
					variables.kit.put( ix + 2, ry, " Yes ", on ? variables.CRUST : variables.SUB, on ? variables.GREEN : variables.SURFACE1, true );
					variables.kit.put( ix + 8, ry, " No ", !on ? variables.CRUST : variables.SUB, !on ? variables.RED : variables.SURFACE1, true );
				}
				variables.kit.hit( "focus", ix, ry, iw, 1, idx );
			}
		}
		// the palette pane of the Theme page: the highlighted theme's own colours
		if ( kind == "theme" && sideBySide( iw ) ) {
			var cur = app.answerString( themeQuestionId( pg ) );
			var tc = colorsOf( cur );
			if ( !structIsEmpty( tc ) ) variables.look.themePane( ix + rowW + 2, listTop, iw - rowW - 2, min( avail, 20 ), tc, themeLabel( pg, cur ) );
		}
		if ( scroll > 0 ) variables.kit.put( ix + rowW - 1, listTop, "▲", variables.OVERLAY, variables.MANTLE );
		if ( total - scroll > avail ) variables.kit.put( ix + rowW - 1, listBottom - 1, "▼", variables.OVERLAY, variables.MANTLE );
		// detail strip: what the focused option means
		variables.kit.put( ix, listBottom, repeatString( "┄", iw ), variables.SURFACE1, variables.MANTLE );
		var detail = "";
		if ( f <= rws.len() ) {
			var fr = rws[ f ];
			if ( fr.kind == "opt" ) detail = pg.questions[ fr.q ].options[ fr.i ].description ?: "";
			else if ( fr.kind == "field" ) detail = pg.questions[ fr.q ].help ?: "";
		}
		var k = 0;
		for ( var line in variables.kit.wrap( detail, iw - 4 ) ) {
			if ( k >= 2 ) break;
			if ( k == 0 ) variables.kit.put( ix, listBottom + 1, "▸", variables.CYAN, variables.MANTLE );
			variables.kit.put( ix + 3, listBottom + 1 + k, line, variables.SUB, variables.MANTLE );
			k++;
		}
	}

	function themeQuestionId( pg ) {
		for ( var q in arguments.pg.questions ) if ( q.type == "choice" && ( q.preview ?: "" ) == "theme" ) return q.id;
		return "";
	}

	function themeLabel( pg, value ) {
		for ( var q in arguments.pg.questions ) if ( q.type == "choice" && ( q.preview ?: "" ) == "theme" ) for ( var o in q.options ) if ( o.value == arguments.value ) return o.label;
		return arguments.value;
	}

	// Both app grid styles side by side (or just the chosen one in a narrow window), the chosen one framed in green. Clicking one picks it.
	function drawGrids( app, rws, row, pg, ix, ry, iw ) {
		var q = arguments.pg.questions[ arguments.row.q ];
		var chosen = arguments.app.answerString( q.id );
		var styles = [];
		for ( var o in q.options ) styles.append( o );
		if ( sideBySide( arguments.iw ) || arguments.iw >= 50 ) {
			var pw = int( ( arguments.iw - 2 ) / 2 );
			for ( var n = 1; n <= min( 2, styles.len() ); n++ ) {
				var gx = arguments.ix + ( n - 1 ) * ( pw + 2 );
				var on = styles[ n ].value == chosen;
				variables.kit.put( gx, arguments.ry, styles[ n ].label, on ? variables.GREEN : variables.OVERLAY, variables.MANTLE, on );
				variables.look.appGrid( gx, arguments.ry + 1, pw, styles[ n ].value, on, variables.gridRows );
				variables.kit.hit( "focus", gx, arguments.ry, pw, 1 + variables.look.gridHeight( variables.gridRows ), optionRow( arguments.rws, arguments.row.q, n ) );
			}
		} else {
			var pw1 = min( arguments.iw, 40 );
			for ( var m = 1; m <= styles.len(); m++ ) if ( styles[ m ].value == chosen ) {
				variables.kit.put( arguments.ix, arguments.ry, styles[ m ].label, variables.GREEN, variables.MANTLE, true );
				variables.look.appGrid( arguments.ix, arguments.ry + 1, pw1, chosen, true, variables.gridRows );
			}
		}
	}

	function review( app, tick, x, y, w, h, phase ) {
		variables.kit.panel( arguments.x, arguments.y, arguments.w, arguments.h, "Review", true, arguments.phase );
		var ix = arguments.x + 3; var iy = arguments.y + 1; var iw = arguments.w - 6; var ih = arguments.h - 2;
		variables.kit.put( ix, iy + 1, "Everything look right? Nothing has been changed yet.", variables.SUB, variables.MANTLE );
		if ( len( arguments.app.notice() ) ) variables.kit.put( ix, iy + 2, variables.kit.trunc( arguments.app.notice(), iw ), variables.GREEN, variables.MANTLE );
		var cy = iy + 3;
		var labelW = 20;
		for ( var pg in app.spec().pages ) for ( var q in pg.questions ) if ( q.type != "info" && app.isVisible( q ) ) labelW = max( labelW, len( q.label ) + 3 );
		labelW = min( labelW, max( 20, iw - 30 ) );   // a long question never squeezes its answer out
		var maxY = iy + ih - 3;
		var stop = false;
		for ( var pg in app.spec().pages ) {
			for ( var q in pg.questions ) {
				if ( q.type == "info" || !app.isVisible( q ) ) continue;
				if ( cy > maxY ) { variables.kit.put( ix, cy, "…", variables.OVERLAY, variables.MANTLE ); stop = true; break; }
				variables.kit.put( ix, cy, len( q.label ) > labelW - 2 ? left( q.label, labelW - 3 ) & "…" : q.label, variables.SUB, variables.MANTLE );
				variables.kit.put( ix + labelW, cy, left( app.display( q ), max( 1, iw - labelW - 2 ) ), variables.GREEN, variables.MANTLE );
				cy++;
			}
			if ( stop ) break;
		}
		var pulse = ( sin( arguments.tick / 8 ) * 0.5 + 0.5 ) * 0.6 + 0.4;
		var msg = "  Apply these choices  ";
		var by = iy + ih - 1;
		variables.kit.put( ix, by, msg, variables.CRUST, variables.kit.mix( variables.CYAN, variables.GREEN, pulse ), true );
		variables.kit.put( ix + len( msg ) + 2, by, "press enter    esc to go back", variables.OVERLAY, variables.MANTLE );
	}
}
