// The brand images (logo, icons, boot splash) packed with BxRig (AssetData, resources) and written to the user's disk byte for byte; the wallpapers come from bxrig.Wallpapers.
//
// Exit codes: list 0; install 0 done, 2 without --yes, 4 precondition (root).
class Assets {
	function init( cli, runner = "" ) {
		variables.environ = new bxrig.util.Env();
		variables.cli = arguments.cli;
		variables.inst = new bxrig.Installer( arguments.runner );
		variables.data = new bxrig.AssetData();
		return this;
	}

	// Where each image goes: wallpapers in ~/Pictures/BxRig, the app icon in the user's icon theme (hicolor/SIZExSIZE/apps/bxrig.png and
	// hicolor/scalable/apps/bxrig.svg, under XDG_DATA_HOME), the logo in ~/.local/share/bxrig.
	function target( name ) {
		var home = variables.environ.home();
		if ( left( name, 11 ) == "wallpapers/" ) return home & "/Pictures/BxRig/" & mid( name, 12, len( name ) );
		// the bar plates (logo button and Launchpad grid): ~/.local/share/bxrig/plates/NAME, the paths the Noctalia config points at
		if ( left( name, 13 ) == "icons/plates/" ) return plateDir() & "/" & mid( name, 14, len( name ) );
		if ( left( name, 6 ) == "icons/" ) {
			var data = variables.environ.xdgData();
			if ( name == "icons/bxrig.svg" ) return data & "/icons/hicolor/scalable/apps/bxrig.svg";
			var px = listFirst( mid( name, 7, len( name ) ), "." );
			return data & "/icons/hicolor/" & px & "x" & px & "/apps/bxrig.png";
		}
		return home & "/.local/share/bxrig/" & name;
	}

	// The images `assets install` writes: all but the boot splash's (those go to /usr/share/plymouth, by `setup boot`).
	function userNames() { return variables.data.names().filter( function( n ) { return left( n, 9 ) != "plymouth/"; } ); }

	// The app icon files (every size and the scalable SVG), as embedded names. The bar plates are not app icons.
	function iconNames() { return variables.data.names().filter( function( n ) { return left( n, 6 ) == "icons/" && left( n, 13 ) != "icons/plates/"; } ); }

	function plateDir() { return variables.environ.xdgData() & "/bxrig/plates"; }

	// Where a bar plate is written: plate( "bxrig-menu.svg" ). NoctaliaConfig points the logo button and the dock's grid button at these.
	function plate( file ) { return target( "icons/plates/" & arguments.file ); }

	// The bar plate files (embedded names).
	function plateNames() { return variables.data.names().filter( function( n ) { return left( n, 13 ) == "icons/plates/"; } ); }

	// Writes the bar plates that are missing (no network, nothing else): the bar config points at them. Returns the files written.
	function ensurePlates() {
		var out = [];
		for ( var n in plateNames() ) if ( !fileExists( target( n ) ) ) { decode( n, target( n ) ); out.append( target( n ) ); }
		for ( var f in ensureAppsEntry() ) out.append( f );
		return out;
	}

	/**
	 * Writes the Apps entry the Noctalia dock pins: a desktop entry that opens the BxRig app grid and its icon in the user's icon theme.
	 * Files that exist are left alone, so a changed entry is kept.
	 *
	 * @return Array of the files written.
	 */
	function ensureAppsEntry() {
		var out = [];
		var data = variables.environ.xdgData();
		var icon = data & "/icons/hicolor/scalable/apps/bxrig-apps.svg";
		if ( !fileExists( icon ) ) { decode( "icons/plates/bxrig-grid.svg", icon ); out.append( icon ); }
		var entry = data & "/applications/bxrig-apps.desktop";
		if ( !fileExists( entry ) ) {
			directoryCreate( getDirectoryFromPath( entry ), true, true );
			fileWrite( entry, "[Desktop Entry]" & chr( 10 ) & "Type=Application" & chr( 10 ) & "Name=Apps" & chr( 10 ) & "Comment=All applications (BxRig)" & chr( 10 ) & "Exec=noctalia msg panel-toggle bxrig/launcher:apps" & chr( 10 ) & "Icon=bxrig-apps" & chr( 10 ) & "Terminal=false" & chr( 10 ) & "Categories=Utility;" & chr( 10 ) & "StartupNotify=false" & chr( 10 ) );
			out.append( entry );
		}
		return out;
	}

	// Writes one packed image to a path, byte for byte.
	function decode( name, dest ) {
		directoryCreate( getDirectoryFromPath( dest ), true, true );
		fileWrite( dest, variables.data.binary( name ) );
	}

	// Writes the images that are missing (never overwrites) and returns { written, present }. No output.
	function writeMissing() {
		var missing = userNames().filter( function( n ) { return !fileExists( target( n ) ); } );
		var kept = userNames().filter( function( n ) { return fileExists( target( n ) ); } );
		for ( var n in missing ) decode( n, target( n ) );
		// the theme wallpapers are not embedded: fetched from the install bundle's copy or the release downloads, each checked
		var w = new bxrig.Wallpapers( variables.inst.runner() ).ensureAll();
		for ( var x in w.written ) missing.append( "wallpapers/" & x & ".jpg" );
		for ( var x in w.present ) kept.append( "wallpapers/" & x & ".jpg" );
		return { written: missing, present: kept, failed: w.failed };
	}

	// `assets list`
	function list( asJson ) {
		var rows = userNames().map( function( n ) { return { name: n, target: target( n ), present: fileExists( target( n ) ) }; } );
		if ( asJson ) { println( variables.cli.envelope( "assets list", 0, { assets: rows } ) ); return new bxrig.util.Exit().ok(); }
		for ( var r in rows ) println( r.name & " -> " & r.target & ( r.present ? " (present)" : "" ) );
		return new bxrig.util.Exit().ok();
	}

	// `assets install [--yes] [--dry-run]`: writes the images that are missing; never overwrites a file the user changed.
	function install( yes, dryRun, asJson ) {
		if ( variables.inst.isRoot() ) {
			var msg = "Run as a regular user";
			if ( asJson ) println( variables.cli.envelope( "assets install", 4, { errors: [ msg ] } ) ); else println( "error: " & msg );
			return new bxrig.util.Exit().precondition();
		}
		var plan = userNames().filter( function( n ) { return !fileExists( target( n ) ); } );
		var kept = userNames().filter( function( n ) { return fileExists( target( n ) ); } );
		if ( !yes || dryRun ) {
			var code = dryRun ? 0 : 2;
			if ( asJson ) { println( variables.cli.envelope( "assets install", code, { write: plan, present: kept }, dryRun ) ); return code; }
			for ( var n in plan ) println( "write " & target( n ) );
			for ( var k in kept ) println( "keep  " & target( k ) & " (already there)" );
			println( dryRun ? "Dry run, nothing changed." : "Nothing changed. Pass --yes to proceed." );
			return code;
		}
		var r = writeMissing();
		if ( asJson ) println( variables.cli.envelope( "assets install", 0, { written: r.written, present: r.present, failed: r.failed } ) );
		else {
			println( "Wrote " & r.written.len() & " images, kept " & r.present.len() & "." );
			if ( r.failed.len() ) println( "note: " & r.failed.len() & " theme wallpapers could not be fetched (offline?); `bxrig theme set` fetches each when it is used." );
		}
		return new bxrig.util.Exit().ok();
	}
}
