// Boxy's character, the pure part: the four states, the outfits and which one is worn on a date, the colours from the theme, the SVG of
// each state (concept A, the cube buddy) and the text sprite (concept C, for the terminal and the bar). Nothing here reads a file or runs
// a program; `bxrig boxy` (Boxy.bx) does the rest. The art was chosen by the owner on 2026-11-25: A and C.
//   states   idle, listening (the lid lifts, sound arcs come in), working (a swirl above the head), speaking (the mouth opens, sound arcs go out)
//   outfits  by season (northern hemisphere) when the setting is `auto`: winter beanie, spring flower, summer sunglasses, autumn leaf; holidays
//            only when you turn them on: christmas (santa hat), halloween (pumpkin), newyear and your birthday (party hat)
class BoxyLook {
	function init() {
		variables.hash = chr( 35 );
		variables.digits = "0123456789abcdef";
		return this;
	}

	array function states() { return [ "idle", "listening", "working", "speaking" ]; }

	// Every outfit: id, name, and when it is worn in `auto`: kind season or holiday.
	array function outfits() {
		return [
			{ id: "beanie", name: "winter beanie", kind: "season" },
			{ id: "flower", name: "spring flower", kind: "season" },
			{ id: "sunglasses", name: "summer sunglasses", kind: "season" },
			{ id: "leaf", name: "autumn leaf", kind: "season" },
			{ id: "santa", name: "santa hat", kind: "holiday", holiday: "christmas" },
			{ id: "pumpkin", name: "pumpkin", kind: "holiday", holiday: "halloween" },
			{ id: "party", name: "party hat", kind: "holiday", holiday: "newyear" }
		];
	}

	// The holidays you can turn on.
	array function holidays() { return [ "christmas", "halloween", "newyear", "birthday" ]; }

	array function outfitIds() { return outfits().map( function( o ) { return o.id; } ); }

	// ---- which outfit, by date (pure) ----

	// The outfit id worn on month/day, or "". setting: auto, none or an outfit id. holidays: the ones turned on. birthday: "MM-DD" or "".
	string function outfitFor( required string setting, required array holidays, required string birthday, required numeric month, required numeric day ) {
		if ( arguments.setting == "none" ) return "";
		if ( arguments.setting != "auto" ) return arrayFind( outfitIds(), arguments.setting ) ? arguments.setting : "";
		var m = arguments.month;
		var d = arguments.day;
		var on = arguments.holidays;
		if ( len( arguments.birthday ) == 5 && arguments.birthday == pad2( m ) & "-" & pad2( d ) ) return "party";
		if ( arrayFind( on, "newyear" ) && ( ( m == 12 && d == 31 ) || ( m == 1 && d <= 2 ) ) ) return "party";
		if ( arrayFind( on, "christmas" ) && m == 12 && d >= 20 && d <= 26 ) return "santa";
		if ( arrayFind( on, "halloween" ) && m == 10 && d >= 24 ) return "pumpkin";
		if ( m == 12 || m <= 2 ) return "beanie";
		if ( m <= 5 ) return "flower";
		if ( m <= 8 ) return "sunglasses";
		return "leaf";
	}

	string function pad2( required numeric n ) { return arguments.n < 10 ? "0" & int( arguments.n ) : "" & int( arguments.n ); }

	// ---- colours ----

	// A hex colour with its #.
	string function col( required string c ) { return left( arguments.c, 1 ) == variables.hash ? arguments.c : variables.hash & arguments.c; }

	numeric function byteOf( required string hex2 ) {
		return ( find( lCase( left( arguments.hex2, 1 ) ), variables.digits ) - 1 ) * 16 + find( lCase( right( arguments.hex2, 1 ) ), variables.digits ) - 1;
	}

	string function hexOf( required numeric n ) {
		var v = max( 0, min( 255, round( arguments.n ) ) );
		var hi = int( v / 16 );
		return mid( variables.digits, hi + 1, 1 ) & mid( variables.digits, v - hi * 16 + 1, 1 );
	}

	// `c` blended with `base` (k of c, the rest base): "#rrggbb".
	string function mix( required string c, required numeric k, string base = "1a1d26" ) {
		var a = reReplace( arguments.c, "^##", "" );
		var b = reReplace( arguments.base, "^##", "" );
		var out = variables.hash;
		for ( var i = 1; i <= 5; i += 2 ) out &= hexOf( byteOf( mid( a, i, 2 ) ) * arguments.k + byteOf( mid( b, i, 2 ) ) * ( 1 - arguments.k ) );
		return out;
	}

	boolean function validColor( required string c ) { return reFind( "^##[0-9a-fA-F]{6}$", arguments.c ) > 0; }

	// ---- the SVG (concept A) ----

	string function n( required numeric v ) { return "" & ( round( arguments.v * 10 ) / 10 ); }

	// An Archimedean spiral path with `turns` turns and the outer radius r1, around (cx, cy).
	string function spiral( required numeric cx, required numeric cy, required numeric turns, required numeric r1, numeric steps = 60 ) {
		var pts = [];
		for ( var i = 0; i <= arguments.steps; i++ ) {
			var t = i / arguments.steps;
			var th = arguments.turns * 2 * pi() * t;
			pts.append( n( arguments.cx + arguments.r1 * t * cos( th ) ) & "," & n( arguments.cy + arguments.r1 * t * sin( th ) ) );
		}
		return "M" & pts.toList( " L" );
	}

	// Sound arcs beside the head: side -1 left, 1 right.
	string function arcs( required numeric cx, required numeric cy, required numeric side, required string colour, numeric count = 3, numeric r0 = 14, numeric gap = 11 ) {
		var out = "";
		for ( var i = 0; i < arguments.count; i++ ) {
			var r = arguments.r0 + arguments.gap * i;
			var x = arguments.cx + arguments.side * r * 0.5;
			out &= '<path d="M' & n( x ) & ',' & n( arguments.cy - r * 0.87 ) & ' A' & r & ',' & r & ' 0 0 ' & ( arguments.side > 0 ? 1 : 0 ) & ' ' & n( x ) & ',' & n( arguments.cy + r * 0.87 ) & '" fill="none" stroke="' & arguments.colour & '" stroke-width="3.5" stroke-linecap="round" opacity="' & n( 1 - i * 0.28 ) & '"/>';
		}
		return out;
	}

	string function eyes( required string state, required string fg ) {
		var dark = col( "1a1d26" );
		if ( arguments.state == "working" ) return '<rect x="-34" y="-9" width="22" height="6" rx="3" fill="' & arguments.fg & '"/><rect x="12" y="-9" width="22" height="6" rx="3" fill="' & arguments.fg & '"/>';
		var ry = arguments.state == "listening" ? 12.5 : ( arguments.state == "speaking" ? 8.1 : 9 );
		var rx = arguments.state == "listening" ? 11 : 9;
		return '<ellipse cx="-22" cy="-6" rx="' & rx & '" ry="' & ry & '" fill="' & arguments.fg & '"/><ellipse cx="22" cy="-6" rx="' & rx & '" ry="' & ry & '" fill="' & arguments.fg & '"/>'
		& '<circle cx="-20" cy="-6" r="' & n( rx * 0.45 ) & '" fill="' & dark & '"/><circle cx="24" cy="-6" r="' & n( rx * 0.45 ) & '" fill="' & dark & '"/>';
	}

	string function mouth( required string state, required string fg ) {
		var dark = col( "1a1d26" );
		if ( arguments.state == "listening" ) return '<ellipse cx="0" cy="28" rx="6" ry="6" fill="none" stroke="' & arguments.fg & '" stroke-width="3.5"/>';
		if ( arguments.state == "working" ) return '<path d="M-10,28 L10,28" stroke="' & arguments.fg & '" stroke-width="4.5" stroke-linecap="round"/>';
		if ( arguments.state == "speaking" ) return '<ellipse cx="0" cy="29" rx="10" ry="8" fill="' & dark & '" stroke="' & arguments.fg & '" stroke-width="3.5"/>';
		return '<path d="M-14,24 Q0,36 14,24" fill="none" stroke="' & arguments.fg & '" stroke-width="4.5" stroke-linecap="round"/>';
	}

	// What is worn, drawn on the lid (it moves with it) or on the face.
	string function outfit( required string id, required numeric lid ) {
		var hatTop = '<g transform="translate(0,' & -arguments.lid & ')">';
		var white = col( "f2f4ff" );
		switch ( arguments.id ) {
			case "beanie": return hatTop & '<path d="M-40,-74 Q-40,-114 0,-114 Q40,-114 40,-74 Z" fill="' & col( "8caaee" ) & '" stroke="' & white & '" stroke-width="2"/><rect x="-42" y="-82" width="84" height="12" rx="6" fill="' & white & '"/><circle cx="0" cy="-116" r="8" fill="' & white & '"/></g>';
			case "flower": return hatTop & '<g transform="translate(26,-86)"><circle r="7" fill="' & col( "e5c890" ) & '"/>' & flowerPetals( col( "ca9ee6" ) ) & '</g></g>';
			case "sunglasses": return '<rect x="-40" y="-20" width="34" height="20" rx="8" fill="' & col( "1a1d26" ) & '" stroke="' & col( "c6d0f5" ) & '" stroke-width="2"/><rect x="6" y="-20" width="34" height="20" rx="8" fill="' & col( "1a1d26" ) & '" stroke="' & col( "c6d0f5" ) & '" stroke-width="2"/><path d="M-6,-12 L6,-12" stroke="' & col( "c6d0f5" ) & '" stroke-width="3"/>';
			case "leaf": return hatTop & '<path d="M22,-80 Q40,-104 62,-84 Q44,-62 22,-80 Z" fill="' & col( "e6a58a" ) & '" stroke="' & col( "735245" ) & '" stroke-width="2"/><path d="M26,-78 L56,-84" stroke="' & col( "735245" ) & '" stroke-width="2"/></g>';
			case "santa": return hatTop & '<polygon points="-34,-74 34,-74 4,-124" fill="' & col( "e78284" ) & '" stroke="' & white & '" stroke-width="2"/><rect x="-38" y="-80" width="76" height="12" rx="6" fill="' & white & '"/><circle cx="4" cy="-126" r="9" fill="' & white & '"/></g>';
			case "pumpkin": return hatTop & '<ellipse cx="0" cy="-86" rx="36" ry="24" fill="' & col( "f4a259" ) & '" stroke="' & col( "c8702a" ) & '" stroke-width="2"/><path d="M-14,-108 Q-22,-86 -14,-64 M14,-108 Q22,-86 14,-64 M0,-110 Q0,-86 0,-62" fill="none" stroke="' & col( "c8702a" ) & '" stroke-width="2"/><rect x="-4" y="-120" width="8" height="14" rx="3" fill="' & col( "6aa84f" ) & '"/><path d="M4,-118 Q18,-126 22,-114" fill="none" stroke="' & col( "6aa84f" ) & '" stroke-width="3"/></g>';
			case "party": return hatTop & '<polygon points="-26,-74 26,-74 0,-128" fill="' & col( "e5c890" ) & '" stroke="' & col( "e6a58a" ) & '" stroke-width="2"/><circle cx="0" cy="-130" r="7" fill="' & col( "e78284" ) & '"/><path d="M-16,-90 L16,-90 M-9,-108 L9,-108" stroke="' & col( "e78284" ) & '" stroke-width="4"/></g>';
		}
		return "";
	}

	string function flowerPetals( required string c ) {
		var out = "";
		for ( var i = 0; i < 5; i++ ) {
			var a = i * 2 * pi() / 5;
			out &= '<ellipse cx="' & n( 12 * cos( a ) ) & '" cy="' & n( 12 * sin( a ) ) & '" rx="7" ry="5" fill="' & arguments.c & '" transform="rotate(' & round( a * 57.3 ) & ' ' & n( 12 * cos( a ) ) & ' ' & n( 12 * sin( a ) ) & ')"/>';
		}
		return out;
	}

	// The SVG of one state: accent is the theme's or the colour you chose ("#rrggbb"), outfitId one of outfitIds() or "".
	string function svg( required string state, required string accent, string outfitId = "" ) {
		var acc = col( arguments.accent );
		var fg = col( "c6d0f5" );
		var cyan = col( "00dbff" );
		var lid = arguments.state == "listening" ? 12 : 0;
		var out = '<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256"><g transform="translate(128,146)">';
		if ( arguments.state == "listening" ) out &= arcs( -78, -6, -1, cyan ) & arcs( 78, -6, 1, cyan );
		if ( arguments.state == "speaking" ) out &= arcs( 74, 26, 1, acc, 3, 12, 11 );
		if ( arguments.state == "working" ) out &= '<path d="' & spiral( 0, -104, 2.4, 20 ) & '" fill="none" stroke="' & cyan & '" stroke-width="5" stroke-linecap="round"/>';
		out &= '<rect x="-62" y="-48" width="124" height="112" rx="14" fill="' & mix( acc, 0.22 ) & '" stroke="' & acc & '" stroke-width="5"/>';
		out &= '<g transform="translate(0,' & -lid & ')"><polygon points="-62,-48 62,-48 48,-74 -48,-74" fill="' & mix( acc, 0.45 ) & '" stroke="' & acc & '" stroke-width="4" stroke-linejoin="round"/></g>';
		out &= eyes( arguments.state, fg ) & mouth( arguments.state, fg );
		if ( arguments.state == "working" ) out &= '<path d="M-20,-6 L-30,-6 M20,-6 L30,-6" stroke="' & cyan & '" stroke-width="3" stroke-linecap="round"/>';
		if ( len( arguments.outfitId ) ) out &= outfit( arguments.outfitId, lid );
		return out & '</g></svg>';
	}

	// ---- the text sprite (concept C) ----

	array function spinner() { return [ "⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏" ]; }

	// What sits above the box for an outfit (one character), or "".
	string function hatGlyph( required string id ) {
		var m = { beanie: "⌒", flower: "✿", leaf: "❦", santa: "▲", pumpkin: "◓", party: "▴" };
		return m[ arguments.id ] ?: "";
	}

	// The face and what follows it for a state at animation frame `frame` (0, 1, 2 ...).
	struct function spriteParts( required string state, numeric frame = 0, string outfitId = "" ) {
		var f = arguments.frame;
		var eye = arguments.outfitId == "sunglasses" ? "■" : "";
		if ( arguments.state == "listening" ) return { face: ( len( eye ) ? eye : "◉" ) & "‿" & ( len( eye ) ? eye : "◉" ), tail: " " & repeatString( ")", ( f mod 3 ) + 1 ) };
		if ( arguments.state == "working" ) return { face: ( len( eye ) ? eye : "▸" ) & "_" & ( len( eye ) ? eye : "◂" ), tail: " " & spinner()[ ( f mod 10 ) + 1 ] };
		if ( arguments.state == "speaking" ) return { face: ( len( eye ) ? eye : "•" ) & ( f mod 2 == 0 ? "o" : "O" ) & ( len( eye ) ? eye : "•" ), tail: " " & ( f mod 2 == 0 ? "♪" : "♫" ) };
		return { face: ( len( eye ) ? eye : "•" ) & "‿" & ( len( eye ) ? eye : "•" ), tail: "" };
	}

	// The sprite as lines: a hat line when it wears something with one, then `[ face ] tail`.
	array function sprite( required string state, numeric frame = 0, string outfitId = "" ) {
		var p = spriteParts( arguments.state, arguments.frame, arguments.outfitId );
		var lines = [];
		var hat = hatGlyph( arguments.outfitId );
		if ( len( hat ) ) lines.append( "   " & hat );
		lines.append( "[ " & p.face & " ]" & p.tail );
		return lines;
	}
}
