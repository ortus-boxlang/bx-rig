// The starter Noctalia (v5) configuration: a custom palette and config.toml, rendered as text (pure, no I/O).
// Formats are from the Noctalia docs: config is TOML in ~/.config/noctalia/*.toml (hot reloaded; GUI changes live in
// ~/.local/state/noctalia/settings.toml and win over this file), a custom palette is JSON in ~/.config/noctalia/palettes/.
//   https://docs.noctalia.dev/noctalia/configuration/   https://docs.noctalia.dev/noctalia/theming/palette/
// Look: Ortus brand colours (#00FF78 main, #00DBFF second) on Catppuccin Frappe neutrals (Frappe's base is the brand dark #303446).
class NoctaliaConfig {
	function init() {
		return this;
	}

	// The palette name used in config.toml `custom_palette` and as the file name.
	function paletteName() {
		return "BxRig";
	}

	// One palette variant as JSON text lines (indented two levels deep). The writer lives in ThemeColors, which the theme manager uses too
	// (keeping it there keeps NoctaliaConfig out of ThemeColors, so there is no class cycle through StarterOptions and TerminalConfig).
	function variant( name, c, t ) {
		return new bxrig.ThemeColors().variant( arguments.name, arguments.c, arguments.t );
	}

	// The palette file: dark = Frappe neutrals with the brand greens, light = Latte neutrals with darker greens for contrast.
	function palette() {
		var dark = { primary: "#00FF78", on_primary: "#232634", secondary: "#00DBFF", on_secondary: "#232634", tertiary: "#ca9ee6", error: "#e78284",
			surface: "#303446", on_surface: "#c6d0f5", surface_container: "#414559", on_surface_variant: "#a5adce", outline_variant: "#626880",
			shadow: "#232634", hover: "#51576d" };
		var darkTerm = { normal: { black: "#51576d", red: "#e78284", green: "#a6d189", yellow: "#e5c890", blue: "#8caaee", magenta: "#ca9ee6", cyan: "#81c8be", white: "#b5bfe2" },
			bright: { black: "#626880", red: "#e78284", green: "#00FF78", yellow: "#e5c890", blue: "#8caaee", magenta: "#ca9ee6", cyan: "#00DBFF", white: "#c6d0f5" } };
		var light = { primary: "#00a34d", on_primary: "#eff1f5", secondary: "#0090ad", on_secondary: "#eff1f5", tertiary: "#8839ef", error: "#d20f39",
			surface: "#eff1f5", on_surface: "#4c4f69", surface_container: "#ccd0da", on_surface_variant: "#5c5f77", outline_variant: "#9ca0b0",
			shadow: "#dce0e8", hover: "#bcc0cc" };
		var lightTerm = { normal: { black: "#5c5f77", red: "#d20f39", green: "#40a02b", yellow: "#df8e1d", blue: "#1e66f5", magenta: "#8839ef", cyan: "#179299", white: "#acb0be" },
			bright: { black: "#6c6f85", red: "#d20f39", green: "#00a34d", yellow: "#df8e1d", blue: "#1e66f5", magenta: "#8839ef", cyan: "#0090ad", white: "#bcc0cc" } };
		return '{' & chr( 10 ) & '  "version": 2,' & chr( 10 ) & variant( "dark", dark, darkTerm ) & "," & chr( 10 ) & variant( "light", light, lightTerm ) & chr( 10 ) & '}' & chr( 10 );
	}

	// ---- the bar ----
	// The three bar layouts (DESKTOP-DECISIONS.md, layout v3). Standard is the default.
	function layouts() { return [ "minimal", "standard", "dense" ]; }
	function defaultLayout() { return "standard"; }
	function validLayout( name ) { return arrayFind( layouts(), arguments.name ) > 0; }

	// The words that name each bar widget in descriptions (battery is listed: it appears on a laptop).
	function widgetWords() {
		return { "bxrig-menu": "logo", workspaces: "workspaces", active_window: "active window", launcher: "launcher", "bxrig-clock": "clock", weather: "weather", media: "media",
			"bxrig-agents": "agents", screenshot: "capture", "bxrig-system": "system", "bxrig-dev": "developer", "bxrig-vpn": "VPN", tray: "tray", clipboard: "clipboard",
			network: "network", bluetooth: "bluetooth", volume: "volume", brightness: "brightness", battery: "battery", notifications: "notifications",
			"bxrig-quick": "quick settings", "control-center": "control center" };
	}

	// The one-line description of each layout (the wizard preview and `appearance bar layout status` show it), written from zones() so it cannot drift from the config.
	function describe( layout ) {
		if ( !validLayout( arguments.layout ) ) return "";
		if ( compare( arguments.layout, "dense" ) == 0 ) return "Standard plus weather and brightness (caffeine is a switch in quick settings, not an icon)";
		var z = zones( arguments.layout, { dock: true, battery: true } );
		var w = widgetWords();
		var parts = [];
		for ( var zone in [ "start", "center", "end" ] ) parts.append( z[ zone ].map( function( n ) { return w[ n ]; } ).toList( ", " ) );
		return parts.toList( " | " );
	}

	// The clock reads "Nov 5 - 04:00".
	function defaultTimeFormat() { return "%b %-d - %H:%M"; }

	// The defaults of every bar option (opts overrides any of them):
	//   layout      minimal | standard | dense
	//   dock        true: the dock is on and the Launchpad grid button lives in it; false: the grid button is the widget right after the logo
	//   dockAuto    true: the dock hides itself when the pointer leaves
	//   dockPos     top | bottom | left | right
	//   battery     true on a laptop: the battery widget is written only then (on a desktop `device = auto` would show a gamepad)
	//   percent     the battery shows its percentage
	//   timeFormat  the clock text, Noctalia date format tokens (docs.noctalia.dev/noctalia/configuration/date-format-tokens)
	//   plateDir    folder of the bar plate images (assets/icons/plates, written by `assets install` and by the bar commands)
	function barDefaults( home ) {
		return { layout: "standard", dock: true, dockAuto: false, dockPos: "bottom", battery: false, percent: true,
			timeFormat: defaultTimeFormat(), plateDir: arguments.home & "/.local/share/bxrig/plates" };
	}

	function barOptions( home, opts = {} ) {
		var o = barDefaults( arguments.home );
		for ( var k in arguments.opts ) if ( structKeyExists( o, k ) ) o[ k ] = arguments.opts[ k ];
		if ( !validLayout( o.layout ) ) o.layout = defaultLayout();
		return o;
	}

	// The three bar sections of a layout, as widget names. Control center is always last and quick settings right before it.
	// Only widgets that exist are listed. Planned (they join the layouts when they are built, see the layout v3 mock-up): nothing is planned now. Quick settings is the
	// bxrig-quick plugin (switches and pickers, the theme switcher as its second page). The battery is the built-in widget; its left click opens
	// the bxrig/power panel (a plugin panel without a bar widget), see barLines.
	function zones( layout, opts = {} ) {
		var o = barOptions( "", arguments.opts );
		var start = [ "bxrig-menu" ];
		if ( !o.dock ) start.append( "launcher" );
		start.append( "workspaces" );
		start.append( "active_window" );
		var center = [ "bxrig-clock" ];
		var end = [];
		var l = arguments.layout;
		if ( compare( l, "minimal" ) == 0 ) {
			end = [ "tray", "network", "volume" ];
		} else {
			if ( compare( l, "dense" ) == 0 ) center.append( "weather" );
			center.append( "media" );
			end = [ "bxrig-agents", "screenshot", "bxrig-system", "bxrig-dev", "bxrig-vpn", "tray", "clipboard", "network", "bluetooth", "volume" ];
			if ( compare( l, "dense" ) == 0 ) end.append( "brightness" );
		}
		if ( o.battery ) end.append( "battery" );
		end.append( "notifications" );
		end.append( "bxrig-quick" );
		end.append( "control-center" );
		return { start: start, center: center, end: end };
	}

	// A TOML basic string.
	function tomlString( text ) {
		return '"' & replace( replace( arguments.text, "\", "\\", "all" ), '"', '\"', "all" ) & '"';
	}

	function tomlList( items ) {
		return "[" & arguments.items.map( function( i ) { return '"' & i & '"'; } ).toList( ", " ) & "]";
	}

	// What the logo button runs: the BxRig menu, detached (setsid), with ~/.local/bin on the PATH the way the key binds do.
	function menuAction() {
		return 'exec PATH="$HOME/.local/bin:$PATH" setsid bxrig menu >/dev/null 2>&1 &';
	}

	// The bar, the widgets the layout needs, the dock and the launcher, as lines of config.toml.
	function barLines( opts ) {
		var o = arguments.opts;
		var z = zones( o.layout, o );
		var plateDir = o.plateDir;
		var out = [
			'# Bar layout: ' & o.layout & ' (bxrig appearance bar layout minimal|standard|dense). ' & describe( o.layout ) & '.',
			'# Hybrid icon style: the status widgets are bare glyphs coloured by one palette role; only the logo button and the Launchpad grid carry a plate.',
			'[bar]',
			'order = ["main"]',
			'',
			'[bar.main]',
			'position = "top"',
			'thickness = 38',
			'background_opacity = 0.85',
			'compositor_blur = true',
			'radius = 14',
			'margin_ends = 12',
			'margin_edge = 8',
			'padding = 12',
			'widget_spacing = 8',
			'capsule = false',
			'color = "on_surface"',
			'start = ' & tomlList( z.start ),
			'center = ' & tomlList( z.center ),
			'end = ' & tomlList( z.end ),
			'',
			'# The logo button opens the BxRig menu. Its plate carries its own outline, so it stays visible on dark and Retro bars.',
			'[widget.bxrig-menu]',
			'type = "custom_button"',
			'custom_image = ' & tomlString( plateDir & "/bxrig-menu.svg" ),
			'custom_image_colorize = false',
			'tooltip = "BxRig menu"',
			'scale = 1.5',
			'',
			'[widget.bxrig-menu.actions]',
			'left = ' & tomlString( menuAction() ),
			'',
			'# The clock is one widget (a BxRig plugin): the time as text, a popover with local time, other zones and a Calendar button; right click opens',
			'# the calendar. The text follows the format below (bxrig time format; Noctalia date format tokens).',
			'[widget.bxrig-clock]',
			'type = "bxrig/clock:bar"',
			'',
			'[plugin_settings."bxrig/clock"]',
			'format = ' & tomlString( o.timeFormat ),
			'',
			'# Your coding agents and their limits, and quick settings (switches and pickers; the theme switcher is its second page): BxRig plugins in',
			'# ~/.local/share/noctalia/plugins',
			'[widget.bxrig-agents]',
			'type = "bxrig/agents:bar"',
			'',
			'# System (updates and backups): a glyph with the number of waiting updates; its popover has the Updates and Backups tabs.',
			'[widget.bxrig-system]',
			'type = "bxrig/system:bar"',
			'',
			'[widget.bxrig-quick]',
			'type = "bxrig/quick:bar"',
			'',
			'# Developer: databases, containers and virtual machines (a code glyph with the number running)',
			'[widget.bxrig-dev]',
			'type = "bxrig/dev:bar"',
			'',
			'# VPN: a shield (green while connected), one list of network profiles and VPN apps; the icon hides itself when none is installed',
			'[widget.bxrig-vpn]',
			'type = "bxrig/vpn:bar"',
			'',
			'[plugins]',
			'enabled = ["bxrig/clock", "bxrig/agents", "bxrig/system", "bxrig/quick", "bxrig/dev", "bxrig/power", "bxrig/vpn", "bxrig/launcher"]',
			''
		];
		if ( o.battery ) {
			out.append( '# Battery (written only on a laptop): the charge as a percentage next to the icon. Battery and power are one panel: a left click opens' );
			out.append( '# the BxRig power panel (bxrig/power, no bar widget of its own), a right click the control center Power tab. The separate power_profile' );
			out.append( '# widget is not on the bar.' );
			out.append( '[widget.battery]' );
			out.append( 'type = "battery"' );
			out.append( 'display_mode = "glyph"' );
			out.append( 'show_label = ' & ( o.percent ? "true" : "false" ) );
			out.append( 'label_content = "percent"' );
			out.append( '' );
			out.append( '[widget.battery.actions]' );
			out.append( 'left = "panel-toggle bxrig/power:panel"' );
			out.append( 'right = "panel-toggle control-center power"' );
			out.append( '' );
		}
		if ( o.dock ) {
			out.append( '# The dock is on. The Launchpad grid is its first button, so the launcher widget is not in the bar.' );
			out.append( '[dock]' );
			out.append( 'enabled = true' );
			out.append( 'position = ' & tomlString( o.dockPos ) );
			out.append( 'auto_hide = ' & ( o.dockAuto ? "true" : "false" ) );
			out.append( 'launcher_position = "start"' );
			out.append( 'launcher_custom_image = ' & tomlString( plateDir & "/bxrig-grid.svg" ) );
			out.append( 'launcher_custom_image_colorize = false' );
		} else {
			out.append( '# The dock is off: the Launchpad grid button is the launcher widget, right after the logo.' );
			out.append( '[widget.launcher]' );
			out.append( 'custom_image = ' & tomlString( plateDir & "/bxrig-grid.svg" ) );
			out.append( 'custom_image_colorize = false' );
			out.append( '' );
			out.append( '[dock]' );
			out.append( 'enabled = false' );
		}
		out.append( '' );
		out.append( '# The launcher opens as a grid (Launchpad). The Terminal-style grid is only remembered (bxrig appearance appgrid) until something draws it.' );
		out.append( '[shell]' );
		out.append( '# Noctalia has its own first-run wizard; it would cover the screen, because BxRig sets the shell up itself.' );
		out.append( 'setup_wizard_enabled = false' );
		out.append( '' );
		out.append( '[shell.launcher]' );
		out.append( 'app_grid = true' );
		out.append( '' );
		return out;
	}

	// config.toml. home is the user's home directory (wallpaper paths are absolute). opts: see barDefaults (the bar layout, dock, battery, clock).
	function configToml( home, theme = "dark", wallpaper = "bxrig", opts = {} ) {
		var wpFile = new bxrig.StarterOptions().wallpapers()[ arguments.wallpaper ];
		var pics = arguments.home & "/Pictures/BxRig";
		var o = barOptions( arguments.home, arguments.opts );
		var lines = [
			'# Written by bxrig (starter). Noctalia reloads this file when it changes; edit it freely, then `bxrig config diff noctalia`',
			'# shows how it differs from the starter. Changes made in the Noctalia settings window are stored separately and win over this file.',
			'',
			'[theme]',
			'mode = "' & arguments.theme & '"                 # dark | light | auto',
			'shell_mode = "follow"',
			'source = "custom"',
			'custom_palette = "BxRig"    # ~/.config/noctalia/palettes/BxRig.json',
			''
		];
		for ( var l in barLines( o ) ) lines.append( l );
		var rest = [
			'# Notifications stack by app, newest at the screen edge, follow the theme (the bell in the bar toggles Do Not Disturb).',
			'# Super+Alt+Comma acts on the newest one, Super+Shift+Comma shows them all.',
			'[notification]',
			'position = "top_right"',
			'group_by_app = true',
			'newest_on_edge = true',
			'max_visible = 4',
			'width = 380',
			'border = true',
			'border_color = "primary"',
			'border_width = 1.0',
			'colorize_icons = false',
			'show_actions = true',
			'show_app_name = true',
			'',
			'# Hot corners (bxrig hotcorners set top-left=overview ...): the pointer resting in a corner runs its action',
			new bxrig.HotCorners( "" ).noctaliaToml().toList( chr( 10 ) ),
			'',
			new bxrig.ScreensaverConfig().noctaliaToml().toList( chr( 10 ) ),
			'',
			'[wallpaper]',
			'enabled = true',
			'fill_mode = "crop"',
			'transition = ["fade", "wipe", "zoom"]',
			'transition_duration = 1200',
			'directory = "' & pics & '"',
			'',
			'[wallpaper.default]',
			'path = "' & pics & '/' & wpFile & '"',
			'',
			'[wallpaper.automation]',
			'enabled = false              # true rotates through the folder',
			'interval_seconds = 1800',
			'order = "random"',
			''
		];
		for ( var r in rest ) lines.append( r );
		return lines.toList( chr( 10 ) );
	}

	// The theme mode and the wallpaper id an existing config.toml was written with (the defaults when it has none), so a bar change can
	// rewrite the file and keep both.
	function detect( text ) {
		var out = { theme: "dark", wallpaper: "bxrig" };
		var t = arguments.text;
		var m = reFind( 'mode = "(dark|light|auto)"', t, 1, true );
		if ( m.pos[ 1 ] > 0 ) out.theme = mid( t, m.pos[ 2 ], m.len[ 2 ] );
		var w = reFind( 'path = "[^"]*/([A-Za-z0-9_-]+)[.]jpg"', t, 1, true );
		if ( w.pos[ 1 ] > 0 && structKeyExists( new bxrig.StarterOptions().wallpapers(), mid( t, w.pos[ 2 ], w.len[ 2 ] ) ) ) out.wallpaper = mid( t, w.pos[ 2 ], w.len[ 2 ] );
		return out;
	}

	// The files bxrig manages for Noctalia, in the config service entry shape (name, target, mode, content).
	function entries( cfgHome, home, theme = "dark", wallpaper = "bxrig", opts = {} ) {
		return [
			{ name: "noctalia", target: arguments.cfgHome & "/noctalia/config.toml", mode: "644", content: configToml( arguments.home, arguments.theme, arguments.wallpaper, arguments.opts ) },
			{ name: "noctalia-palette", target: arguments.cfgHome & "/noctalia/palettes/" & paletteName() & ".json", mode: "644", content: palette() }
		];
	}
}
