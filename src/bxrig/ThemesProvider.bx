// The rows of the Themes page: the bundled themes (and your own). Reads `theme list`. The page itself is ThemesPage.
class ThemesProvider {
	function init( demo = false ) { variables.demo = arguments.demo; variables.proc = new bxrig.util.Proc(); return this; }
	function id() { return "themes"; }
	function icon() { return new bxrig.ControlCenterPages().icon( "themes" ); }
	function title() { return "Themes"; }
	function hint() { return "Enter applies a theme"; }
	function emptyText() { return "No themes found."; }
	function columns() { return [ { key: "mark", label: "", w: 3 }, { key: "name", label: "name", w: 24 }, { key: "mode", label: "mode", w: 8 }, { key: "origin", label: "from", w: 10 }, { key: "swatch", label: "", w: 0 } ]; }
	function style( r ) { return r.current ? "ok" : ""; }
	function detail( r ) { return [ r.name & " (" & r.origin & ", " & r.mode & ")", r.current ? "The current theme." : "Enter applies it to the bar, terminals, GTK and Qt apps, Neovim and more." ]; }

	function actions() {
		return [
			{ key: "Enter", label: "apply", run: function( r ) { return { action: "cli", title: "Apply theme " & r.name, args: [ "theme", "set", r.name ] }; } },
			{ key: "m", label: "auto mode", run: function( r ) { return { action: "cli", title: "Theme mode auto", args: [ "theme", "mode", "auto" ] }; } },
			{ key: "v", label: "VS Code", run: function( r ) { return { action: "cli", title: "VS Code colours", args: [ "theme", "vscode" ] }; } }
		];
	}

	function load( q = "" ) {
		var d = variables.demo ? { themes: [ { name: "bxrig", light: false, current: true, origin: "bundled" }, { name: "bxrig-retro", light: false, current: false, origin: "bundled", font: "sharetech" }, { name: "bxrig-light", light: true, current: false, origin: "bundled" }, { name: "catppuccin", light: false, current: false, origin: "bundled" }, { name: "tokyo-night", light: false, current: false, origin: "bundled" }, { name: "bxrig-contrast-dark", light: false, current: false, origin: "bundled" }, { name: "bxrig-contrast-light", light: true, current: false, origin: "bundled" }, { name: "bxrig-colorblind", light: false, current: false, origin: "bundled" } ] } : variables.proc.selfData( [ "theme", "list" ] );
		var rows = [];
		var namer = new bxrig.Theme( "" );
		for ( var t in ( d.themes ?: [] ) ) rows.append( { mark: t.current ? "●" : " ", name: t.name, label: t.label ?: namer.label( t.name ), mode: t.light ? "light" : "dark", origin: t.origin, current: t.current, wallpaper: t.wallpaper ?: "", font: t.font ?: "", swatch: "" } );
		return rows;
	}
}
