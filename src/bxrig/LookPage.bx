// The Look page of the Control Center: how the desktop looks, as one list of settings with a picture of the bar on top.
//   Bar     top bar layout (Minimal, Standard, Dense), battery percentage, clock format, the key that hides the bar
//   Colors  the color theme (Enter opens the Themes page, the bigger selector)
//   Apps    app grid style (Launchpad or Terminal-style) and the dock
//   Screen  the screensaver on or off, and when it starts and the screen locks
//   Fonts   the coding font (terminals), the interface font (bar, panels, GTK apps) and how text is drawn
// Up and Down pick a setting, + and Right (or Space, or Enter) change it to the next value and - to the previous one (a text setting asks, a link opens its page). A change is a
// bxrig command like any other in the Control Center: the plan (the command with --dry-run) first, then a y runs it. Values come from LookData.
//   id() title() icon() load() state() keys() paint( kit, x, y, w, h, tick, phase ) onKey( key ) act( hit ) onScroll( dir ) usesLeft()
class LookPage {
	function init( demo = false, palette = "" ) {
		variables.palette = isSimpleValue( arguments.palette ) ? new bxrig.Palette() : arguments.palette;   // a Palette made with an Env: tests
		variables.data = new bxrig.LookData( arguments.demo );
		variables.demo = arguments.demo;
		variables.look = {};
		variables.cursor = 1;
		variables.loaded = false;
		variables.bl = new bxrig.BarLayouts();
		return this;
	}

	function id() { return "look"; }
	function title() { return "Look"; }
	function icon() { return new bxrig.ControlCenterPages().icon( "look" ); }
	function usesLeft() { return false; }

	function load() {
		variables.look = variables.data.load();
		variables.loaded = true;
		return this;
	}

	// The settings, in order: { group, id, label, kind: choice|toggle|text|link, value (what is shown), hint, desc, cmd (what a change runs) }.
	function rows() {
		var l = variables.loaded ? variables.look : variables.data.defaults();
		var theme = new bxrig.Theme( "" ).label( l.theme );
		var fl = new bxrig.Fonts();
		return [
			{ group: "Bar", id: "layout", label: "Top bar layout", kind: "choice", value: variables.bl.layout( l.layout ).name, hint: "Minimal, Standard, Dense", desc: variables.bl.layout( l.layout ).detail, cmd: "bxrig appearance bar layout " & l.layout },
			{ group: "Bar", id: "battery", label: "Battery percentage", kind: "toggle", value: l.battery_percent, hint: l.battery_found ? "next to the battery icon" : "laptops only (no battery found)", desc: "Shows 78% next to the battery icon. Ignored on a desktop with no battery.", cmd: "bxrig appearance battery-percent " & l.battery_percent },
			{ group: "Bar", id: "clock", label: "Clock format", kind: "text", value: l.clock_sample, hint: l.clock_format, desc: "The bar clock's text, in Noctalia date format tokens. Enter asks for a format; the default is %b %-d - %H:%M.", cmd: "bxrig time format " & l.clock_format },
			{ group: "Bar", id: "toggle", label: "Bar toggle shortcut", kind: "link", value: l.bar_toggle_keys, hint: "hides or shows the bar", desc: "This key runs bxrig appearance bar toggle. Enter opens the Shortcuts page to change it.", cmd: "bxrig appearance bar toggle" },
			{ group: "Colors", id: "theme", label: "Color theme", kind: "link", value: theme, hint: "Enter opens the Themes page", desc: "Colors the shell, terminals, borders, lock screen and wallpaper. Choosing a theme has its own page, with a preview of each.", cmd: "bxrig theme set " & l.theme },
			{ group: "Apps", id: "appgrid", label: "App grid style", kind: "choice", value: l.appgrid == "terminal" ? "Terminal-style grid" : "Launchpad grid", hint: "Launchpad or Terminal-style", desc: "The grid of every installed app, opened from the first button of the dock. Same apps and search, a different look.", cmd: "bxrig appearance appgrid " & l.appgrid },
			{ group: "Apps", id: "dock", label: "Dock", kind: "toggle", value: l.dock ? "on" : "off", hint: "bottom of the screen", desc: "A dock of your apps. When it is on, the grid button is its first button and leaves the bar.", cmd: "bxrig appearance dock " & ( l.dock ? "on" : "off" ) },
			{ group: "Screen", id: "screensaver", label: "Screensaver", kind: "toggle", value: l.screensaver ? "on" : "off", hint: "terminal art on every monitor", desc: "After a while idle, BXRIG art in the theme's colours on every monitor; any key or mouse move closes it. bxrig screensaver preview shows it.", cmd: "bxrig screensaver " & ( l.screensaver ? "on" : "off" ) },
			{ group: "Screen", id: "screensaver-time", label: "Screensaver, then lock", kind: "choice", value: timingLabel( l.screensaver_seconds, l.lock_seconds ), hint: "after this long idle", desc: "When the screensaver starts and when the screen locks, both counted from the start of idle.", cmd: "bxrig screensaver set screensaver=" & l.screensaver_seconds & " lock=" & l.lock_seconds },
			{ group: "Fonts", id: "font", label: "Coding font", kind: "choice", value: fontLabel( l.font, fl.list() ), hint: "terminals and editors", desc: "The monospaced font of the terminals. A font that is not installed asks to install it: bxrig appearance font install ID.", cmd: "bxrig appearance font " & fontId( l.font, fl.list() ) },
			{ group: "Fonts", id: "ui-font", label: "Interface font", kind: "choice", value: len( l.ui_font ) ? fontLabel( l.ui_font, fl.uiList() ) : "follows the coding font", hint: "bar, panels, GTK apps", desc: "The font of the bar, the panels and GTK apps. Inter is made for screens; until you pick one the shell uses the coding font.", cmd: "bxrig appearance ui-font " & ( len( l.ui_font ) ? fontId( l.ui_font, fl.uiList() ) : "list" ) },
			{ group: "Fonts", id: "rendering", label: "Font rendering", kind: "choice", value: ( fl.renderings()[ l.rendering ] ?: fl.renderings().default ).label, hint: "how text is drawn", desc: ( fl.renderings()[ l.rendering ] ?: fl.renderings().default ).detail, cmd: "bxrig appearance font-rendering " & l.rendering }
		];
	}

	function state() {
		var items = rows().map( function( r ) { return { group: r.group, id: r.id, label: r.label, kind: r.kind, value: r.value }; } );
		return { rows: items.len(), items: items, cursor: variables.cursor, look: variables.loaded ? variables.look : variables.data.defaults() };
	}

	function keyMap() {
		// Left is the Control Center's own (it goes to the sidebar), so the previous value is on - and the next on + and Right
		return new bxrig.KeyMap().bind( "↑↓", [ "Up", "k" ], "move", "up" ).bind( "", [ "Down", "j" ], "", "down" ).bind( "-+", "-", "previous", "prev" ).bind( "", [ "+", "Right" ], "", "next" )
		.bind( "Enter", [ "Enter", " " ], "change", "do" ).bind( "r", "r", "refresh", "refresh" );
	}

	function keys() { return keyMap().hints(); }

	// The command for the next (d = 1) or previous (d = -1) value of a setting, as an intent the Control Center runs after the plan box.
	function change( d ) {
		var l = variables.loaded ? variables.look : variables.data.defaults();
		var r = rows()[ variables.cursor ];
		if ( r.id == "layout" ) {
			var all = variables.bl.order();
			var i = arrayFind( all, l.layout );
			var want = all[ ( ( i - 1 + arguments.d + all.len() ) mod all.len() ) + 1 ];
			return { action: "cli", title: "Top bar layout: " & variables.bl.layout( want ).name, args: [ "appearance", "bar", "layout", want ] };
		}
		if ( r.id == "appgrid" ) {
			var want2 = l.appgrid == "terminal" ? "launchpad" : "terminal";
			return { action: "cli", title: "App grid style: " & ( want2 == "terminal" ? "Terminal-style" : "Launchpad" ), args: [ "appearance", "appgrid", want2 ] };
		}
		if ( r.id == "dock" ) { var d2 = l.dock ? "off" : "on"; return { action: "cli", title: "Dock " & d2, args: [ "appearance", "dock", d2 ] }; }
		if ( r.id == "battery" ) { var b = l.battery_percent == "on" ? "off" : "on"; return { action: "cli", title: "Battery percentage " & b, args: [ "appearance", "battery-percent", b ] }; }
		if ( r.id == "clock" ) {
			return { action: "ask", title: "Clock format", prompt: "Format for the bar clock (now " & l.clock_format & "). Type default to go back to the default.", make: function( value ) {
					return { action: "cli", title: "Clock format " & value, args: [ "time", "format", value ] };
				} };
		}
		if ( r.id == "screensaver" ) { var s2 = l.screensaver ? "off" : "on"; return { action: "cli", title: "Screensaver " & s2, args: [ "screensaver", s2 ] }; }
		if ( r.id == "screensaver-time" ) {
			var ts = timings();
			var at = 0;
			for ( var ti = 1; ti <= ts.len(); ti++ ) if ( ts[ ti ][ 1 ] == l.screensaver_seconds && ts[ ti ][ 2 ] == l.lock_seconds ) at = ti;
			var nt = at == 0 ? ( arguments.d > 0 ? 1 : ts.len() ) : ( ( at - 1 + arguments.d + ts.len() ) mod ts.len() ) + 1;
			return { action: "cli", title: "Screensaver, then lock: " & timingLabel( ts[ nt ][ 1 ], ts[ nt ][ 2 ] ), args: [ "screensaver", "set", "screensaver=" & ts[ nt ][ 1 ], "lock=" & ts[ nt ][ 2 ] ] };
		}
		if ( r.id == "font" || r.id == "ui-font" ) {
			var fl = new bxrig.Fonts();
			var list = r.id == "font" ? fl.list() : fl.uiList();
			var at2 = 0;
			for ( var fi = 1; fi <= list.len(); fi++ ) if ( list[ fi ].family == ( r.id == "font" ? l.font : l.ui_font ) ) at2 = fi;
			var nf = at2 == 0 ? ( arguments.d > 0 ? 1 : list.len() ) : ( ( at2 - 1 + arguments.d + list.len() ) mod list.len() ) + 1;
			return { action: "cli", title: ( r.id == "font" ? "Coding font: " : "Interface font: " ) & list[ nf ].label, args: [ "appearance", r.id, list[ nf ].id ] };
		}
		if ( r.id == "rendering" ) {
			var ro = new bxrig.Fonts().renderingOrder();
			var ri = max( 1, arrayFind( ro, l.rendering ) );
			var nr = ro[ ( ( ri - 1 + arguments.d + ro.len() ) mod ro.len() ) + 1 ];
			return { action: "cli", title: "Font rendering: " & new bxrig.Fonts().renderings()[ nr ].label, args: [ "appearance", "font-rendering", nr ] };
		}
		if ( r.id == "toggle" ) return { action: "goto", page: "shortcuts" };
		if ( r.id == "theme" ) return { action: "goto", page: "themes" };
		return {};
	}

	// The label (or the family itself) and id of a font family in a list.
	function fontLabel( family, list ) { for ( var f in arguments.list ) if ( f.family == arguments.family ) return f.label; return arguments.family; }
	function fontId( family, list ) { for ( var f in arguments.list ) if ( f.family == arguments.family ) return f.id; return arguments.family; }

	// The screensaver timings the page steps through: [ screensaver, lock ] seconds.
	function timings() { return [ [ 150, 300 ], [ 300, 600 ], [ 600, 1200 ], [ 900, 1800 ] ]; }
	function minutes( n ) { return arguments.n == 0 ? "never" : ( arguments.n / 60 ) & " min"; }
	function timingLabel( screensaver, lock ) { return minutes( arguments.screensaver ) & ", lock " & minutes( arguments.lock ); }

	function onKey( key ) {
		var what = keyMap().match( arguments.key );
		var n = rows().len();
		if ( what == "up" ) { variables.cursor = max( 1, variables.cursor - 1 ); return {}; }
		if ( what == "down" ) { variables.cursor = min( n, variables.cursor + 1 ); return {}; }
		if ( what == "refresh" ) { load(); return {}; }
		if ( what == "prev" ) return change( -1 );
		if ( what == "next" || what == "do" ) return change( 1 );
		return {};
	}

	function act( hit ) {
		if ( arguments.hit.kind == "row" ) { variables.cursor = arguments.hit.n; return {}; }
		if ( arguments.hit.kind == "do" ) { variables.cursor = arguments.hit.n; return change( 1 ); }
		return {};
	}

	function onScroll( dir ) { return onKey( arguments.dir == "up" ? "Up" : "Down" ); }

	// ---------------------------------------------------------------- drawing

	function paint( kit, x, y, w, h, tick, phase ) {
		var k = arguments.kit;
		var C = function( n ) { return k.color( n ); };
		var pv = new bxrig.LookPreview( k );
		// the theme can change under the page (applied from the Themes page): look again once a second
		if ( variables.loaded && !variables.demo && arguments.tick mod 20 == 0 ) {
			var applied = variables.palette.activeName();
			if ( len( applied ) ) variables.look.theme = applied;
		}
		var l = variables.loaded ? variables.look : variables.data.defaults();
		var ico = k.icon( icon() );
		if ( len( ico ) ) k.put( arguments.x + 1, arguments.y, ico, C( "GREEN" ), C( "BASE" ) );
		var tx = arguments.x + 1 + ( len( ico ) ? 2 : 0 );
		k.put( tx, arguments.y, "Look", C( "TEXT" ), C( "BASE" ), true );
		k.put( tx + 6, arguments.y, k.trunc( "Layout, theme, fonts, app grid, dock and screensaver. A change shows its plan first.", arguments.w - 12 ), C( "OVERLAY" ), C( "BASE" ) );
		var px = arguments.x + 1;
		var pw = arguments.w - 2;
		var cy = arguments.y + 2;
		var bottom = arguments.y + arguments.h;
		// the picture: the bar in the layout you have, and the dock under it
		var bh = variables.bl.height( l.layout, pw - 4, l.battery_percent == "on" );
		var ph = bh + 4;
		if ( cy + ph <= bottom ) {
			k.panel( px, cy, pw, ph, "Preview", false, arguments.phase );
			k.fillRect( px + 1, cy + 1, pw - 2, ph - 2, C( "MANTLE" ) );
			pv.strip( px + 2, cy + 1, pw - 4, l.layout, true, l.battery_percent == "on" );
			if ( l.dock ) pv.dock( px + 2, cy + 2 + bh, min( pw - 4, 40 ), true );
			else k.put( px + 2, cy + 2 + bh, k.trunc( "dock off: the grid button moves to the start of the bar", pw - 6 ), C( "OVERLAY" ), C( "MANTLE" ) );
			cy += ph;
		}
		var rws = rows();
		var groups = [ "Bar", "Colors", "Apps", "Screen", "Fonts" ];
		var idx = 0;
		var labelW = 22;
		for ( var g in groups ) {
			var members = [];
			for ( var r in rws ) if ( r.group == g ) members.append( r );
			var gh = members.len() + 2;
			if ( cy + gh > bottom - 5 && cy + gh > bottom ) break;
			k.panel( px, cy, pw, gh, g, false, arguments.phase );
			k.fillRect( px + 1, cy + 1, pw - 2, gh - 2, C( "MANTLE" ) );
			var i = 0;
			for ( var m in members ) {
				idx++;
				i++;
				var yy = cy + i;
				var on = idx == variables.cursor;
				var bg = on ? C( "SURFACE0" ) : C( "MANTLE" );
				if ( on ) { k.fillRect( px + 1, yy, pw - 2, 1, C( "SURFACE0" ) ); k.put( px + 1, yy, "▌", C( "GREEN" ), C( "SURFACE0" ) ); }
				k.put( px + 3, yy, m.label, on ? C( "TEXT" ) : C( "SUB" ), bg, on );
				var vx = px + 3 + labelW;
				var ex = vx;
				if ( m.kind == "choice" ) {
					ex = k.put( vx, yy, "‹ ", on ? C( "CYAN" ) : C( "OVERLAY" ), bg );
					ex = k.put( ex, yy, m.value, C( "GREEN" ), bg, true );
					ex = k.put( ex, yy, " ›", on ? C( "CYAN" ) : C( "OVERLAY" ), bg );
				} else if ( m.kind == "toggle" ) {
					var isOn = m.value == "on";
					ex = k.put( vx, yy, " On ", isOn ? C( "CRUST" ) : C( "OVERLAY" ), isOn ? C( "GREEN" ) : C( "SURFACE1" ), isOn );
					ex = k.put( ex, yy, " Off ", !isOn ? C( "CRUST" ) : C( "OVERLAY" ), !isOn ? C( "RED" ) : C( "SURFACE1" ), !isOn );
				} else ex = k.put( vx, yy, m.value, C( "GREEN" ), bg, true );
				if ( ex + len( m.hint ) + 3 < px + pw - 2 ) k.put( ex + 2, yy, m.hint, C( "OVERLAY" ), bg );
				k.hit( "row", px + 1, yy, pw - 2, 1, idx );
				k.hit( "do", vx, yy, max( 1, ex - vx ), 1, idx );
			}
			cy += gh;
		}
		// the selected setting: what it does (two lines at most) and the command behind it
		var cur = rws[ variables.cursor ];
		var dl = k.wrap( cur.desc, pw - 6 );
		var shown = min( 2, dl.len() );
		var sh = 4 + shown;
		if ( cy + sh <= bottom ) {
			k.panel( px, cy, pw, sh, "Selected", false, arguments.phase );
			k.fillRect( px + 1, cy + 1, pw - 2, sh - 2, C( "MANTLE" ) );
			k.put( px + 2, cy + 1, cur.label, C( "TEXT" ), C( "MANTLE" ), true );
			for ( var n = 1; n <= shown; n++ ) k.put( px + 2, cy + 1 + n, dl[ n ], C( "SUB" ), C( "MANTLE" ) );
			var kx = k.put( px + 2, cy + 2 + shown, " $ ", C( "CRUST" ), C( "GREEN" ), true );
			k.put( kx + 1, cy + 2 + shown, k.trunc( cur.cmd, pw - 10 ), C( "TEXT" ), C( "MANTLE" ) );
		} else if ( cy + 1 <= bottom ) {
			k.put( px + 2, cy, k.trunc( cur.desc, pw - 4 ), C( "SUB" ), C( "BASE" ) );
		}
	}
}
