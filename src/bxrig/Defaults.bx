// `bxrig default browser|terminal|filemanager|editor|show`: make an installed app your default web browser, terminal, file manager or editor.
//   editor    `xdg-mime default <app>.desktop` for text files, and EDITOR/VISUAL in ~/.config/environment.d/50-bxrig-editor.conf (next login)
//   browser   `xdg-settings set default-web-browser <app>.desktop` (works for Hyprland sessions and KDE alike)
//   filemanager  `xdg-mime default <app>.desktop inode/directory` (Strata or Dolphin)
//   terminal  ~/.config/xdg-terminals.list (the xdg-terminal-exec list, written through the config service, kept if you edited it)
//             and, when kwriteconfig6 is there, KDE's own default terminal (kdeglobals [General] TerminalApplication/TerminalService)
// An app must be installed first (its desktop file must exist). Exit: 0 done, 2 plan without --yes, 4 precondition, 6 the command failed.
class Defaults {
	function init( cli, runner = "" ) {
		variables.cli = arguments.cli;
		variables.inst = new bxrig.Installer( arguments.runner );
		variables.proc = variables.inst.proc();
		variables.config = new bxrig.ConfigService();
		return this;
	}

	// Desktop entry ids of the browsers the catalog offers. firefox and chromium were read from the Arch packages; the others are the
	// vendors' standard names (not verified here), and browsers not listed have no known entry: set those in your system settings.
	function browserDesktop( id ) {
		var m = { firefox: "firefox.desktop", chromium: "chromium.desktop", brave: "brave-browser.desktop", "google-chrome": "google-chrome.desktop", edge: "microsoft-edge.desktop" };
		return structKeyExists( m, arguments.id ) ? m[ arguments.id ] : "";
	}

	function appDirs() {
		var home = new bxrig.util.Env().named( "home", "" );
		return listToArray( new bxrig.util.Env().named( "appsDirs", "/usr/share/applications:" & home & "/.local/share/applications:/var/lib/flatpak/exports/share/applications" ), ":" );
	}

	function desktopInstalled( file ) {
		for ( var d in appDirs() ) if ( fileExists( d & "/" & arguments.file ) ) return true;
		return false;
	}


	// `default browser ID`
	function browser( id, yes, dryRun, asJson ) {
		var cmd = "default browser";
		var file = browserDesktop( arguments.id );
		if ( !len( file ) ) return variables.cli.say( cmd, "precondition", { error: "No known desktop entry for " & arguments.id }, arguments.asJson, [ "error: no known desktop entry for " & arguments.id & ". Known: firefox, chromium, brave, google-chrome, edge. Set others in your system settings." ] );
		if ( !desktopInstalled( file ) ) return variables.cli.say( cmd, "precondition", { error: arguments.id & " is not installed" }, arguments.asJson, [ "error: " & arguments.id & " is not installed (" & file & " not found). Install it first: bxrig install " & arguments.id ] );
		if ( !variables.proc.has( "xdg-settings" ) ) return variables.cli.say( cmd, "precondition", { error: "xdg-settings was not found" }, arguments.asJson, [ "error: xdg-settings was not found (install xdg-utils)" ] );
		var data = { browser: arguments.id, desktop: file };
		if ( !arguments.yes || arguments.dryRun ) return variables.cli.scoped( cmd ).plan( "make " & arguments.id & " (" & file & ") your default web browser", data, arguments.asJson, arguments.dryRun );
		var r = variables.inst.proc().exec( [ "xdg-settings", "set", "default-web-browser", file ], 30 );
		if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
		return variables.cli.say( cmd, "ok", data, arguments.asJson, [ arguments.id & " is now your default web browser." ] );
	}

	// `default terminal ID`
	function terminal( id, yes, dryRun, asJson ) {
		var cmd = "default terminal";
		var tc = new bxrig.TerminalConfig();
		var t = tc.find( arguments.id );
		if ( structIsEmpty( t ) ) return variables.cli.say( cmd, "precondition", { error: "Unknown terminal: " & arguments.id }, arguments.asJson, [ "error: unknown terminal: " & arguments.id & " (use " & tc.ids().toList( ", " ) & ")" ] );
		var file = tc.desktopId( arguments.id );
		if ( !desktopInstalled( file ) ) return variables.cli.say( cmd, "precondition", { error: arguments.id & " is not installed" }, arguments.asJson, [ "error: " & arguments.id & " is not installed (" & file & " not found). Install it first: bxrig setup terminal --default=" & arguments.id ] );
		var entry = { name: "xdg-terminals", target: variables.config.cfgHome() & "/xdg-terminals.list", mode: "644", content: file & chr( 10 ) };
		var state = variables.config.configState( entry );
		var kde = variables.proc.has( "kwriteconfig6" );
		var data = { terminal: arguments.id, desktop: file, list: entry.target, kde: kde, list_kept: state == "drifted" || state == "blocked" };
		if ( !arguments.yes || arguments.dryRun ) return variables.cli.scoped( cmd ).plan( "make " & arguments.id & " your default terminal (" & entry.target & ( kde ? " and KDE's setting" : "" ) & ")", data, arguments.asJson, arguments.dryRun );
		var notes = [];
		if ( state == "drifted" || state == "blocked" ) notes.append( entry.target & " was changed by you, so it was kept" );
		else if ( variables.config.configWrite( entry, entry.content, "apply", true, false ) != 0 ) return variables.cli.say( cmd, "failed", { error: "Could not write " & entry.target }, arguments.asJson, [ "error: could not write " & entry.target ] );
		if ( kde ) {
			variables.inst.proc().exec( [ "kwriteconfig6", "--file", "kdeglobals", "--group", "General", "--key", "TerminalApplication", t.cmd ], 20 );
			variables.inst.proc().exec( [ "kwriteconfig6", "--file", "kdeglobals", "--group", "General", "--key", "TerminalService", file ], 20 );
		}
		var lines = [ arguments.id & " is now your default terminal." ];
		for ( var n in notes ) lines.append( "note: " & n );
		return variables.cli.say( cmd, "ok", data, arguments.asJson, lines );
	}

	// Desktop entry ids of the file managers the catalog offers (Strata's is its application id).
	function fileManagerDesktop( id ) {
		var m = { strata: "io.github.lgse.Strata.desktop", dolphin: "org.kde.dolphin.desktop" };
		return structKeyExists( m, arguments.id ) ? m[ arguments.id ] : "";
	}

	// `default filemanager ID`: the folder handler (`xdg-mime default <app>.desktop inode/directory`).
	function filemanager( id, yes, dryRun, asJson ) {
		var cmd = "default filemanager";
		var file = fileManagerDesktop( arguments.id );
		if ( !len( file ) ) return variables.cli.say( cmd, "precondition", { error: "Unknown file manager " & arguments.id }, arguments.asJson, [ "error: unknown file manager " & arguments.id & ". Known: strata, dolphin." ] );
		if ( !desktopInstalled( file ) ) return variables.cli.say( cmd, "precondition", { error: arguments.id & " is not installed" }, arguments.asJson, [ "error: " & arguments.id & " is not installed (" & file & " not found). Install it first: bxrig install " & arguments.id ] );
		if ( !variables.proc.has( "xdg-mime" ) ) return variables.cli.say( cmd, "precondition", { error: "xdg-mime was not found" }, arguments.asJson, [ "error: xdg-mime was not found (install xdg-utils)" ] );
		var data = { filemanager: arguments.id, desktop: file };
		if ( !arguments.yes || arguments.dryRun ) return variables.cli.scoped( cmd ).plan( "make " & arguments.id & " (" & file & ") your default file manager", data, arguments.asJson, arguments.dryRun );
		var r = variables.inst.proc().exec( [ "xdg-mime", "default", file, "inode/directory" ], 30 );
		if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
		return variables.cli.say( cmd, "ok", data, arguments.asJson, [ arguments.id & " is now your default file manager." ] );
	}

	// The editors `default editor` knows: the command, its desktop entry, and what EDITOR and VISUAL get (a GUI editor waits for its window).
	function editors() {
		return {
			neovim: { cmd: "nvim", desktop: "nvim.desktop", env: "nvim", install: "bxrig install neovim" },
			vscode: { cmd: "code", desktop: "code.desktop", env: "code --wait", install: "bxrig install vscode" },
			zed: { cmd: "zeditor", desktop: "dev.zed.Zed.desktop", env: "zeditor --wait", install: "bxrig install zed" },
			kate: { cmd: "kate", desktop: "org.kde.kate.desktop", env: "kate --block", install: "bxrig pkg install kate" }
		};
	}

	// The text files the editor opens from a file manager or a browser download.
	function knownEditors() { var ks = structKeyArray( editors() ); arraySort( ks, "textnocase" ); return ks.toList( ", " ); }

	function editorTypes() { return [ "text/plain", "text/markdown", "application/json", "application/x-shellscript", "text/x-python", "application/xml", "text/x-csrc" ]; }

	function editorEnvFile() { return new bxrig.util.Env().xdgConfig( "environment.d/50-bxrig-editor.conf" ); }

	// `default editor ID`: the app that opens text files (xdg-mime) and EDITOR/VISUAL for every new login (~/.config/environment.d).
	function editor( id, yes, dryRun, asJson ) {
		var cmd = "default editor";
		var all = editors();
		if ( !structKeyExists( all, arguments.id ) ) return variables.cli.say( cmd, "precondition", { error: "Unknown editor " & arguments.id }, arguments.asJson, [ "error: unknown editor " & arguments.id & ". Known: " & knownEditors() & "." ] );
		var e = all[ arguments.id ];
		if ( !variables.proc.has( e.cmd ) ) return variables.cli.say( cmd, "precondition", { error: arguments.id & " is not installed" }, arguments.asJson, [ "error: " & arguments.id & " is not installed (" & e.cmd & " not found). Install it first: " & e.install ] );
		if ( !variables.proc.has( "xdg-mime" ) ) return variables.cli.say( cmd, "precondition", { error: "xdg-mime was not found" }, arguments.asJson, [ "error: xdg-mime was not found (install xdg-utils)" ] );
		var envFile = editorEnvFile();
		var content = "## Written by `bxrig default editor`" & chr( 10 ) & "EDITOR=" & e.env & chr( 10 ) & "VISUAL=" & e.env & chr( 10 );
		var data = { editor: arguments.id, desktop: e.desktop, env: e.env, file: envFile, types: editorTypes(), opensFiles: desktopInstalled( e.desktop ) };
		if ( !arguments.yes || arguments.dryRun ) return variables.cli.scoped( cmd ).plan( "make " & arguments.id & " your editor: EDITOR and VISUAL in " & envFile & ( data.opensFiles ? ", and the app for text files (" & e.desktop & ")" : "" ), data, arguments.asJson, arguments.dryRun );
		if ( data.opensFiles ) {
			var argv = [ "xdg-mime", "default", e.desktop ];
			for ( var t in editorTypes() ) argv.append( t );
			var r = variables.inst.proc().exec( argv, 30 );
			if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: " & trim( r.output ) ] );
		}
		directoryCreate( getDirectoryFromPath( envFile ), true, true );
		fileWrite( envFile, content );
		var lines = [ arguments.id & " is now your editor (EDITOR and VISUAL from your next login" & ( data.opensFiles ? "; text files open in it now" : "" ) & ")." ];
		if ( !data.opensFiles ) lines.append( "note: " & e.desktop & " was not found, so text files keep their current app" );
		return variables.cli.say( cmd, "ok", data, arguments.asJson, lines );
	}

	// `default show`
	function show( asJson ) {
		var b = "";
		if ( variables.proc.has( "xdg-settings" ) ) b = trim( variables.inst.proc().exec( [ "xdg-settings", "get", "default-web-browser" ], 20 ).output );
		var listFile = variables.config.cfgHome() & "/xdg-terminals.list";
		var t = fileExists( listFile ) ? trim( fileRead( listFile ) ) : "";
		var fm = "";
		if ( variables.proc.has( "xdg-mime" ) ) fm = trim( variables.inst.proc().exec( [ "xdg-mime", "query", "default", "inode/directory" ], 20 ).output );
		var ed = "";
		if ( fileExists( editorEnvFile() ) ) for ( var l in listToArray( fileRead( editorEnvFile() ), chr( 10 ) ) ) if ( left( l, 7 ) == "EDITOR=" ) ed = mid( l, 8, len( l ) );
		return variables.cli.say( "default show", "ok", { browser: b, terminal: t, filemanager: fm, editor: ed }, arguments.asJson, [ "Default browser:  " & ( len( b ) ? b : "not set" ), "Default terminal: " & ( len( t ) ? t : "not set (" & listFile & ")" ), "Default file manager: " & ( len( fm ) ? fm : "not set" ), "Default editor:   " & ( len( ed ) ? ed : "not set (bxrig default editor neovim)" ) ] );
	}
}
