// The one shortcut table shared by Hyprland, KDE Plasma and xremap (docs/architecture/COMMAND-CONTRACT.md section 13.4, SHORTCUTS-DECISIONS.md).
// Every key BxRig binds is a row here, with one key per style (Traditional, Mac); the renderers only read the table. The only I/O is reading your
// overrides (~/.config/bxrig/shortcuts.json, written by `keys set`) and the style (~/.config/bxrig/keystyle.json, see KeyStyle).
// `render( target )` turns the table into the text each target needs:
//   xremap   YAML for the Cmd-style keys, plus the Alt/Win swap for the Mac style on a PC keyboard (one file, read by both xremap builds)
//   hyprland the Hyprland Lua module: autostart, every binding, the optional theme, look and monitor files
//   plasma   kglobalshortcutsrc lines for the keys that are not remaps
class Shortcuts {
	// overrides: { rowId: "Super+Alt+K" } (read from the config file unless given; tests pass a struct).
	// style: "traditional" | "mac" | a KeyStyle struct { style, keyboard, swap } (read from the config file unless given).
	function init( overrides = "", style = "" ) {
		variables.overrides = isStruct( arguments.overrides ) ? arguments.overrides : loadOverrides();
		var st = isStruct( arguments.style ) ? arguments.style : ( len( arguments.style ) ? { style: arguments.style, keyboard: "pc", swap: true } : new bxrig.KeyStyle().read() );
		variables.keyStyle = { style: st.style, keyboard: st.keyboard ?: "pc", swap: st.swap ?: true };
		return this;
	}

	// The style that is on: { style, keyboard, swap }.
	function style() { return variables.keyStyle; }

	function overridesFile() { return new bxrig.util.Env().config( "shortcuts.json" ); }

	function loadOverrides() {
		return new bxrig.util.JsonStore().read( overridesFile() );
	}

	// ---- key combos ----
	// Valid key names besides single letters and digits.
	function namedKeys() {
		var out = [ "Space", "Tab", "Return", "Escape", "grave", "comma", "period", "slash", "minus", "equal", "Left", "Right", "Up", "Down",
			"Delete", "Home", "End", "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12", "mouse_down", "mouse_up", "mouse:272", "mouse:273" ];
		for ( var b in bareKeys() ) out.append( b );
		return out;
	}

	// Keys that need no modifier (media and hardware keys, Print).
	function bareKeys() {
		return [ "Print", "XF86AudioRaiseVolume", "XF86AudioLowerVolume", "XF86AudioMute", "XF86AudioMicMute", "XF86MonBrightnessUp", "XF86MonBrightnessDown", "XF86PowerOff",
			"XF86AudioPlay", "XF86AudioPause", "XF86AudioNext", "XF86AudioPrev", "XF86KbdBrightnessUp", "XF86KbdBrightnessDown" ];
	}

	// Parses "Super+Shift+V" into { ok, mods (SUPER, SHIFT, ALT, CTRL; sorted), key, error }. "`" and "Enter" are accepted spellings.
	function parseKeys( keys ) {
		var parts = listToArray( arguments.keys, "+", true );
		if ( parts.len() == 1 && arrayFindNoCase( bareKeys(), trim( parts[ 1 ] ) ) > 0 ) return { ok: true, error: "", mods: [], key: bareKeys()[ arrayFindNoCase( bareKeys(), trim( parts[ 1 ] ) ) ] };
		if ( parts.len() < 2 ) return { ok: false, error: "use at least one modifier and a key, like Super+Shift+V", mods: [], key: "" };
		var map = { super: "SUPER", meta: "SUPER", win: "SUPER", shift: "SHIFT", alt: "ALT", ctrl: "CTRL", control: "CTRL" };
		var mods = [];
		for ( var i = 1; i < parts.len(); i++ ) {
			var m = lcase( trim( parts[ i ] ) );
			if ( !structKeyExists( map, m ) ) return { ok: false, error: "unknown modifier " & parts[ i ] & " (Super, Shift, Alt, Ctrl)", mods: [], key: "" };
			if ( !arrayFind( mods, map[ m ] ) ) mods.append( map[ m ] );
		}
		var raw = trim( parts[ parts.len() ] );
		var key = raw == "`" ? "grave" : ( lcase( raw ) == "enter" ? "Return" : raw );
		if ( len( key ) == 1 && reFind( "[A-Za-z]", key ) ) key = ucase( key );
		var okKey = ( len( key ) == 1 && reFind( "[A-Z0-9]", key ) ) || arrayFindNoCase( namedKeys(), key ) > 0;
		if ( !okKey ) return { ok: false, error: "unknown key " & raw & " (a letter, a digit, or one of: " & namedKeys().toList( ", " ) & ")", mods: [], key: "" };
		if ( arrayFindNoCase( namedKeys(), key ) > 0 ) key = namedKeys()[ arrayFindNoCase( namedKeys(), key ) ];
		return { ok: true, error: "", mods: mods.sort( "text" ), key: key };
	}

	// The same combo as one comparable string, e.g. "ALT+SHIFT+SUPER+V".
	function normalize( keys ) {
		var k = parseKeys( arguments.keys );
		return k.ok ? k.mods.toList( "+" ) & "+" & ucase( k.key ) : "";
	}

	// The first argument of Hyprland's hl.bind for a combo: mainMod .. " + SHIFT + V".
	function hyprExpr( keys ) {
		var k = parseKeys( arguments.keys );
		var rest = [];
		for ( var m in [ "CTRL", "ALT", "SHIFT" ] ) if ( arrayFind( k.mods, m ) ) rest.append( m );
		rest.append( k.key );
		return arrayFind( k.mods, "SUPER" ) ? 'mainMod .. " + ' & rest.toList( " + " ) & '"' : '"' & rest.toList( " + " ) & '"';
	}

	// Qt's spelling for kglobalshortcutsrc: Meta+Shift+Q.
	function qtKeys( keys ) {
		var k = parseKeys( arguments.keys );
		var out = [];
		for ( var m in [ "SUPER", "CTRL", "ALT", "SHIFT" ] ) if ( arrayFind( k.mods, m ) ) out.append( m == "SUPER" ? "Meta" : ( m == "CTRL" ? "Ctrl" : ( m == "ALT" ? "Alt" : "Shift" ) ) );
		out.append( k.key == "grave" ? "`" : k.key );
		return out.toList( "+" );
	}

	// exec_cmd for a bxrig command (PATH gets ~/.local/bin so the binary is found from a shortcut).
	function execBxrig( words ) {
		return 'hl.dsp.exec_cmd([[sh -c ''PATH="$HOME/.local/bin:$PATH"; bxrig ' & arguments.words & ''']])';
	}

	// A bind line for a row.
	function bindLine( r ) {
		return "hl.bind(" & hyprExpr( r.keys ) & ", " & r.dispatch & ( len( r.opts ) ? ", " & r.opts : "" ) & ")";
	}

	// Terminal window classes: in these, Cmd+C/V send Ctrl+Shift+C/V because plain Ctrl+C interrupts the running program.
	function terminals() {
		return [ "kitty", "Alacritty", "foot", "org.wezfurlong.wezterm", "com.mitchellh.ghostty", "org.kde.konsole", "konsole" ];
	}

	// ---- the table ----
	// One row per action. keysBy has the keys of each style ("" = no key in that style); `keys` is the one of the style that is on.
	//   kind remap      xremap rewrites the key before the compositor sees it (to, termTo: what it sends, in terminals)
	//   kind bind       Hyprland and Plasma (Plasma: group, key, tail)
	//   kind hypr-bind  Hyprland only
	// A bind has `dispatch` (Lua) and, when it runs a bxrig command, `words` (`keys run ID` runs them); `opts` is the Lua options table or "".
	function row( id, group, action, trad, mac, kind, dispatch = "", words = "", opts = "" ) {
		return { id: arguments.id, group: arguments.group, action: arguments.action, keysBy: { traditional: arguments.trad, mac: arguments.mac }, kind: arguments.kind, dispatch: arguments.dispatch, words: arguments.words, opts: arguments.opts };
	}

	// A Hyprland binding that runs `bxrig WORDS`.
	function bx( id, group, action, trad, mac, words ) {
		return row( arguments.id, arguments.group, arguments.action, arguments.trad, arguments.mac, "hypr-bind", execBxrig( arguments.words ), arguments.words );
	}

	// A Cmd-style remap. universal: also on in the Traditional style (copy, paste, cut, select all).
	function remap( id, action, src, to, termTo, universal = false ) {
		var r = row( arguments.id, "Editing", arguments.action, arguments.universal ? arguments.src : "", arguments.src, "remap" );
		r.to = arguments.to;
		r.termTo = arguments.termTo;
		return r;
	}

	function rawRows() {
		var G = { menu: "Menus and launchers", apps: "Apps", cap: "Capture and recording", note: "Notifications and panels", win: "Windows", ws: "Workspaces", hw: "Hardware and keys", edit: "Editing" };
		var rows = [
			// Cmd-style keys (xremap). Copy, paste, cut and select all are on in both styles; the rest only in the Mac style.
			remap( "copy", "Copy", "Super+C", "Ctrl-c", "Ctrl-Shift-c", true ),
			remap( "paste", "Paste", "Super+V", "Ctrl-v", "Ctrl-Shift-v", true ),
			remap( "mac-x", "Cut", "Super+X", "Ctrl-x", "Super-x", true ),
			remap( "mac-a", "Select all", "Super+A", "Ctrl-a", "Super-a", true ),
			remap( "mac-z", "Undo", "Super+Z", "Ctrl-z", "Super-z" ),
			remap( "mac-s", "Save", "Super+S", "Ctrl-s", "Super-s" ),
			remap( "mac-f", "Find", "Super+F", "Ctrl-f", "Ctrl-Shift-f" ),
			remap( "mac-t", "New tab", "Super+T", "Ctrl-t", "Ctrl-Shift-t" ),
			remap( "mac-n", "New window", "Super+N", "Ctrl-n", "Ctrl-Shift-n" ),
			remap( "mac-o", "Open", "Super+O", "Ctrl-o", "Super-o" ),
			remap( "mac-p", "Print", "Super+P", "Ctrl-p", "Super-p" ),
			remap( "mac-r", "Reload", "Super+R", "Ctrl-r", "Super-r" ),
			remap( "mac-w", "Close tab", "Super+W", "Ctrl-w", "Ctrl-Shift-w" ),
			remap( "mac-l", "Address bar", "Super+L", "Ctrl-l", "Super-l" ),
			remap( "mac-b", "Bold", "Super+B", "Ctrl-b", "Super-b" ),
			remap( "mac-i", "Italic", "Super+I", "Ctrl-i", "Super-i" ),
			remap( "mac-u", "Underline", "Super+U", "Ctrl-u", "Super-u" ),
			remap( "mac-comma", "Preferences", "Super+Comma", "Ctrl-comma", "Super-comma" ),
			remap( "switch-windows", "Switch windows", "Super+Tab", "Alt-Tab", "" ),
			// menus and launchers
			bx( "menu", G.menu, "BxRig menu (the runner: AI, databases, settings)", "Super+Space", "Super+Space", "menu" ),
			row( "launcher", G.menu, "Launch apps (the launcher you chose; Noctalia if it cannot run)", "Super+Alt+Space", "Super+Alt+Space", "hypr-bind",
				'hl.dsp.exec_cmd([[sh -c ''PATH="$HOME/.local/bin:$PATH"; bxrig runner launch || noctalia msg panel-toggle launcher'']])', "runner launch" ),
			bx( "key-sheet", G.menu, "Shortcut cheat sheet", "Super+K", "Super+K", "keys sheet" ),
			bx( "menu-system", G.menu, "System menu", "Super+Escape", "Super+Escape", "menu open system" ),
			bx( "menu-hardware", G.menu, "Hardware menu", "Super+Ctrl+H", "Super+Ctrl+H", "menu open hardware" ),
			bx( "menu-capture", G.menu, "Capture menu", "Super+Ctrl+C", "Super+Ctrl+C", "menu open capture" ),
			bx( "menu-toggle", G.menu, "Toggle menu", "Super+Ctrl+O", "Super+Ctrl+O", "menu open toggle" ),
			bx( "agent-picker", G.menu, "Agent picker", "Super+Shift+Ctrl+A", "Super+Shift+Ctrl+A", "menu open agent" ),
			row( "menu-power", G.menu, "System menu (power key)", "XF86PowerOff", "XF86PowerOff", "hypr-bind", execBxrig( "menu open system" ), "menu open system", "{ locked = true }" ),
			// apps
			row( "terminal", G.apps, "Terminal", "Super+Return", "Super+Return", "hypr-bind", "hl.dsp.exec_cmd(terminal)" ),
			row( "browser", G.apps, "Browser", "Super+B", "Super+Shift+Return", "hypr-bind", "hl.dsp.exec_cmd(browser)" ),
			row( "browser-alt", G.apps, "Browser (Omarchy's key)", "Super+Shift+Return", "", "hypr-bind", "hl.dsp.exec_cmd(browser)" ),
			bx( "browser-private", G.apps, "Private browser window (your default browser)", "Super+Alt+Shift+B", "Super+Shift+N", "browser private" ),
			row( "file-manager", G.apps, "File manager", "Super+Shift+F", "Super+E", "hypr-bind", "hl.dsp.exec_cmd(fileManager)" ),
			bx( "files-here", G.apps, "File manager in the current folder (of the focused window)", "Super+Alt+Shift+F", "Super+Alt+Shift+F", "files here" ),
			bx( "ai-shell", G.apps, "Pull-down AI shell", "Super+Grave", "Super+Grave", "ai shell" ),
			// capture and recording
			bx( "emoji", G.cap, "Emoji picker", "Super+Ctrl+E", "Super+Ctrl+E", "emoji" ),
			bx( "clipboard-history", G.cap, "Clipboard history", "Super+Ctrl+V", "Super+Ctrl+V", "clipboard pick" ),
			bx( "screenshot-screen", G.cap, "Screenshot: the whole screen", "", "Super+Shift+3", "screenshot screen" ),
			bx( "screenshot-region", G.cap, "Screenshot: a region", "", "Super+Shift+4", "screenshot region" ),
			bx( "screenshot-menu", G.cap, "Screenshot menu (region, window, OCR, QR, record)", "", "Super+Shift+5", "screenshot menu" ),
			bx( "screenshot-print", G.cap, "Screenshot: a region (Print key)", "Print", "Print", "screenshot region" ),
			bx( "color-picker", G.cap, "Color picker", "Super+Print", "Super+Print", "screenshot color" ),
			bx( "screen-record", G.cap, "Start or stop a screen recording", "Super+Shift+R", "Super+Shift+R", "record toggle" ),
			bx( "screen-record-region", G.cap, "Record a region of the screen", "Super+Alt+Shift+R", "Super+Alt+Shift+R", "record toggle --region" ),
			bx( "screen-record-audio", G.cap, "Start or stop a screen recording with desktop audio", "Alt+Print", "Alt+Print", "record toggle --audio=desktop" ),
			bx( "webcam", G.cap, "Webcam preview on or off", "Super+Ctrl+Alt+V", "Super+Ctrl+Alt+V", "webcam toggle" ),
			bx( "dictation-toggle", G.cap, "Dictation on or off", "Alt+Space", "Alt+Space", "dictation toggle" ),
			// notifications and panels
			bx( "dnd", G.note, "Do Not Disturb on or off", "Super+Ctrl+Alt+Comma", "Super+Ctrl+Alt+Comma", "notify dnd toggle" ),
			bx( "notify-time", G.note, "Show the time", "Super+Ctrl+Alt+T", "Super+Ctrl+Alt+T", "notify time" ),
			bx( "notify-battery", G.note, "Show the battery", "Super+Ctrl+Alt+B", "Super+Ctrl+Alt+B", "notify battery" ),
			bx( "notify-weather", G.note, "Show the weather", "Super+Ctrl+Alt+W", "Super+Ctrl+Alt+W", "notify weather" ),
			row( "control-center-panel", G.note, "Noctalia control center panel", "Super+Alt+C", "Super+Alt+C", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "panel-toggle control-center")' ),
			// Omarchy's panel keys all open the Noctalia control center panel (decision 1)
			row( "panel-audio", G.note, "Audio panel (the control center panel)", "Super+Ctrl+A", "Super+Ctrl+A", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "panel-toggle control-center")' ),
			row( "panel-bluetooth", G.note, "Bluetooth panel (the control center panel)", "Super+Ctrl+B", "Super+Ctrl+B", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "panel-toggle control-center")' ),
			row( "panel-network", G.note, "Network panel (the control center panel)", "Super+Ctrl+N", "Super+Ctrl+N", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "panel-toggle control-center")' ),
			row( "panel-power", G.note, "Power panel (the control center panel)", "Super+Ctrl+P", "Super+Ctrl+P", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "panel-toggle control-center")' ),
			row( "panel-display", G.note, "Display panel (the control center panel)", "Super+Ctrl+D", "Super+Ctrl+D", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "panel-toggle control-center")' ),
			bx( "fullscreen-desktop", G.win, "Full screen desktop (hide or show the bar)", "Super+Ctrl+Alt+F", "Super+Ctrl+Alt+F", "appearance bar toggle" ),
			bx( "bar-toggle", G.win, "Toggle top bar (show or hide)", "Super+Shift+Space", "Super+Shift+Space", "appearance bar toggle" ),
			bx( "fullscreen-tiled", G.win, "Tiled full screen (the app goes full screen inside its tile)", "Super+Ctrl+F", "Super+Ctrl+Shift+F", "window tiled-fullscreen" ),
			bx( "close-all", G.win, "Close every window", "Ctrl+Alt+Delete", "Ctrl+Alt+Delete", "window close-all" ),
			row( "resize-narrower", G.win, "Floating window: narrower", "Super+Ctrl+Alt+Minus", "Super+Ctrl+Alt+Minus", "hypr-bind", 'hl.dsp.window.resize({ x = -100, y = 0, relative = true })', "", "{ repeating = true }" ),
			row( "resize-wider", G.win, "Floating window: wider", "Super+Ctrl+Alt+Equal", "Super+Ctrl+Alt+Equal", "hypr-bind", 'hl.dsp.window.resize({ x = 100, y = 0, relative = true })', "", "{ repeating = true }" ),
			row( "resize-shorter", G.win, "Floating window: shorter", "Super+Alt+Shift+Minus", "Super+Alt+Shift+Minus", "hypr-bind", 'hl.dsp.window.resize({ x = 0, y = -100, relative = true })', "", "{ repeating = true }" ),
			row( "resize-taller", G.win, "Floating window: taller", "Super+Alt+Shift+Equal", "Super+Alt+Shift+Equal", "hypr-bind", 'hl.dsp.window.resize({ x = 0, y = 100, relative = true })', "", "{ repeating = true }" ),
			row( "group-toggle", G.win, "Group windows into tabs (or ungroup)", "Super+G", "Super+G", "hypr-bind", "hl.dsp.group.toggle()" ),
			row( "group-leave", G.win, "Take the window out of its group", "Super+Alt+G", "Super+Alt+G", "hypr-bind", "hl.dsp.window.move({ out_of_group = true })" ),
			row( "group-next", G.win, "Next window in the group", "Super+Alt+Tab", "Super+Alt+Tab", "hypr-bind", "hl.dsp.group.next()" ),
			row( "group-prev", G.win, "Previous window in the group", "Super+Alt+Shift+Tab", "Super+Alt+Shift+Tab", "hypr-bind", "hl.dsp.group.prev()" ),
			row( "scratchpad", G.ws, "Scratchpad: show or hide", "Super+Ctrl+S", "Super+Ctrl+S", "hypr-bind", 'hl.dsp.workspace.toggle_special("scratchpad")' ),
			row( "scratchpad-send", G.ws, "Send the window to the scratchpad", "Super+Ctrl+Alt+S", "Super+Ctrl+Alt+S", "hypr-bind", 'hl.dsp.window.move({ workspace = "special:scratchpad" })' ),
			// Zoom as on a Mac (Option+Cmd+8, Option+Cmd+=, Option+Cmd+-: Alt is Option, Super is Cmd). The keys do nothing until
			// `bxrig accessibility zoom on`: while zoom is off they only say how to turn it on.
			bx( "zoom-toggle", G.win, "Zoom: on or off (turn zoom on first: Accessibility)", "Super+Alt+8", "Super+Alt+8", "accessibility zoom toggle" ),
			bx( "zoom-in", G.win, "Zoom in on the screen (again for more)", "Super+Alt+Equal", "Super+Alt+Equal", "accessibility zoom in" ),
			bx( "zoom-out", G.win, "Zoom out", "Super+Alt+Minus", "Super+Alt+Minus", "accessibility zoom out" ),
			bx( "dock-toggle", G.win, "Toggle the dock (show or hide)", "Super+Alt+D", "Super+Alt+D", "appearance dock toggle" ),
			row( "noctalia-settings", G.note, "Noctalia settings window", "Super+Ctrl+Comma", "Super+Ctrl+Comma", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "settings-toggle")' ),
			row( "notify-latest", G.note, "Notifications: act on the newest (open it or press its button)", "Super+Alt+Comma", "Super+Alt+Comma", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "notification-invoke-latest")' ),
			row( "notify-all", G.note, "Notifications: all of them, to read and act on", "Super+Shift+Comma", "Super+Shift+Comma", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "panel-toggle control-center notifications")' ),
			bx( "notify-clear", G.note, "Notifications: dismiss them all", "Super+Ctrl+Shift+Comma", "Super+Ctrl+Shift+Comma", "notify clear" ),
			row( "world-clock", G.note, "World clock", "Super+Alt+W", "Super+Alt+W", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "panel-toggle bxrig/clock:panel")' ),
			row( "agents-panel", G.note, "Coding agents: launch one, see its limits", "Super+Alt+A", "Super+Alt+A", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "panel-toggle bxrig/agents:panel")' ),
			row( "theme-switcher", G.note, "Theme switcher (search, preview, Enter applies)", "Super+Ctrl+Shift+Space", "Super+Ctrl+Shift+Space", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "panel-toggle bxrig/quick:themes")' ),
			// windows
			row( "close", G.win, "Close the window", "Super+Q", "Super+Q", "hypr-bind", "hl.dsp.window.close()" ),
			row( "close-alt", G.win, "Close the window (Omarchy's key)", "Super+W", "", "hypr-bind", "hl.dsp.window.close()" ),
			row( "fullscreen", G.win, "Full screen", "Super+F", "Super+Ctrl+F", "hypr-bind", 'hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" })' ),
			row( "float", G.win, "Float or tile the window", "Super+T", "Super+Alt+T", "hypr-bind", 'hl.dsp.window.float({ action = "toggle" })' ),
			row( "toggle-split", G.win, "Toggle split", "Super+J", "Super+J", "hypr-bind", 'hl.dsp.layout("togglesplit")' ),
			row( "maximize", G.win, "Maximize or restore the window (the bar stays)", "Super+M", "Super+M", "hypr-bind", 'hl.dsp.window.fullscreen({ mode = "maximized", action = "toggle" })' ),
			row( "minimize", G.win, "Minimize the window", "Super+H", "Super+H", "hypr-bind", 'hl.dsp.window.move({ workspace = "special:minimized", follow = false })', "window minimize" ),
			row( "unminimize", G.win, "Show the minimized windows", "Super+Shift+H", "Super+Shift+H", "hypr-bind", 'hl.dsp.workspace.toggle_special("minimized")', "window restore" ),
			row( "layout-next", G.win, "Next layout on this workspace (dwindle, master, columns, scrolling, monocle)", "Super+Shift+J", "Super+Shift+J", "hypr-bind", "bxrigNextLayout" ),
			row( "column-narrower", G.win, "Make the window's column narrower (scrolling: 1/3, 1/2, 2/3, full)", "Super+Minus", "Super+Minus", "hypr-bind", 'function() bxrigResize("-") end' ),
			row( "column-wider", G.win, "Make the window's column wider (scrolling: 1/3, 1/2, 2/3, full)", "Super+Equal", "Super+Equal", "hypr-bind", 'function() bxrigResize("+") end' ),
			bx( "snap-left", G.win, "Snap the window to the left half", "Super+Alt+Left", "Super+Alt+Left", "window snap left" ),
			bx( "snap-right", G.win, "Snap the window to the right half", "Super+Alt+Right", "Super+Alt+Right", "window snap right" ),
			bx( "snap-top", G.win, "Snap the window to the top half", "Super+Alt+Up", "Super+Alt+Up", "window snap top" ),
			bx( "snap-bottom", G.win, "Snap the window to the bottom half", "Super+Alt+Down", "Super+Alt+Down", "window snap bottom" ),
			row( "center", G.win, "Center the floating window", "Super+Alt+Shift+C", "Super+Alt+Shift+C", "hypr-bind", "hl.dsp.window.center()" ),
			bx( "quake-toggle", G.win, "Quake console (show or hide)", "Super+Shift+Grave", "Super+Shift+Grave", "window quake" ),
			bx( "quake-send", G.win, "Send the window to the quake console", "Super+Ctrl+Grave", "Super+Ctrl+Grave", "window quake send" ),
			bx( "force-quit", G.win, "Force quit a window", "Super+Alt+Escape", "Super+Alt+Escape", "forcequit" ),
			bx( "overview", G.win, "Overview of all windows (Mission Control)", "Super+Ctrl+Up", "Super+Ctrl+Up", "overview" ),
			row( "window-switcher", G.win, "Window switcher (Noctalia; Super+Tab sends Alt+Tab in the Mac style)", "Alt+Tab", "Alt+Tab", "hypr-bind", 'hl.dsp.exec_cmd(ipc .. "window-switcher hold")' ),
			row( "mouse-ws-next", G.ws, "Next workspace (Super+scroll)", "Super+mouse_down", "Super+mouse_down", "hypr-bind", 'hl.dsp.focus({ workspace = "e+1" })' ),
			row( "mouse-ws-prev", G.ws, "Previous workspace (Super+scroll)", "Super+mouse_up", "Super+mouse_up", "hypr-bind", 'hl.dsp.focus({ workspace = "e-1" })' ),
			row( "mouse-move", G.win, "Move a window with the mouse", "Super+mouse:272", "Super+mouse:272", "hypr-bind", "hl.dsp.window.drag()", "", "{ mouse = true }" ),
			row( "mouse-resize", G.win, "Resize a window with the mouse", "Super+mouse:273", "Super+mouse:273", "hypr-bind", "hl.dsp.window.resize()", "", "{ mouse = true }" ),
			// hardware and keys
			bx( "lock", G.hw, "Lock the screen", "Super+Ctrl+L", "Super+Ctrl+L", "system lock" ),
			row( "logout", G.hw, "Log out to the login screen", "Super+Shift+Q", "Super+Shift+Q", "bind", 'hl.dsp.exec_cmd("uwsm stop")' ),
			row( "input-language", G.hw, "Next input language", "Super+I", "Super+Alt+I", "hypr-bind", 'hl.dsp.exec_cmd("hyprctl switchxkblayout all next")' ),
			row( "input-language-prev", G.hw, "Previous input language", "Super+Shift+I", "Super+Alt+Shift+I", "hypr-bind", 'hl.dsp.exec_cmd("hyprctl switchxkblayout all prev")' ),
			row( "volume-up", G.hw, "Volume up", "XF86AudioRaiseVolume", "XF86AudioRaiseVolume", "hypr-bind", 'hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+")', "", "{ locked = true, repeating = true }" ),
			row( "volume-down", G.hw, "Volume down", "XF86AudioLowerVolume", "XF86AudioLowerVolume", "hypr-bind", 'hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-")', "", "{ locked = true, repeating = true }" ),
			row( "volume-mute", G.hw, "Mute", "XF86AudioMute", "XF86AudioMute", "hypr-bind", 'hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle")', "", "{ locked = true, repeating = true }" ),
			row( "mic-mute", G.hw, "Mute the microphone", "XF86AudioMicMute", "XF86AudioMicMute", "hypr-bind", 'hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle")', "", "{ locked = true, repeating = true }" ),
			row( "brightness-up", G.hw, "Brightness up", "XF86MonBrightnessUp", "XF86MonBrightnessUp", "hypr-bind", 'hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+")', "", "{ locked = true, repeating = true }" ),
			row( "brightness-down", G.hw, "Brightness down", "XF86MonBrightnessDown", "XF86MonBrightnessDown", "hypr-bind", 'hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-")', "", "{ locked = true, repeating = true }" ),
			row( "kbd-backlight-up", G.hw, "Keyboard backlight up", "XF86KbdBrightnessUp", "XF86KbdBrightnessUp", "hypr-bind", 'hl.dsp.exec_cmd("brightnessctl -d *::kbd_backlight set 33%+")', "", "{ locked = true, repeating = true }" ),
			row( "kbd-backlight-down", G.hw, "Keyboard backlight down", "XF86KbdBrightnessDown", "XF86KbdBrightnessDown", "hypr-bind", 'hl.dsp.exec_cmd("brightnessctl -d *::kbd_backlight set 33%-")', "", "{ locked = true, repeating = true }" ),
			row( "media-play", G.hw, "Play or pause", "XF86AudioPlay", "XF86AudioPlay", "hypr-bind", 'hl.dsp.exec_cmd("playerctl play-pause")', "", "{ locked = true }" ),
			row( "media-pause", G.hw, "Pause", "XF86AudioPause", "XF86AudioPause", "hypr-bind", 'hl.dsp.exec_cmd("playerctl pause")', "", "{ locked = true }" ),
			row( "media-next", G.hw, "Next track", "XF86AudioNext", "XF86AudioNext", "hypr-bind", 'hl.dsp.exec_cmd("playerctl next")', "", "{ locked = true }" ),
			row( "media-prev", G.hw, "Previous track", "XF86AudioPrev", "XF86AudioPrev", "hypr-bind", 'hl.dsp.exec_cmd("playerctl previous")', "", "{ locked = true }" )
		];
		// focus and move with the arrow keys
		for ( var d in [ "Left", "Right", "Up", "Down" ] ) {
			rows.append( row( "focus-" & lcase( d ), G.win, "Focus the window to the " & lcase( d ), "Super+" & d, "Super+" & d, "hypr-bind", 'hl.dsp.focus({ direction = "' & lcase( d ) & '" })' ) );
			rows.append( row( "move-" & lcase( d ), G.win, "Move the window " & lcase( d ), "Super+Shift+" & d, "Super+Shift+" & d, "hypr-bind", 'hl.dsp.window.move({ direction = "' & lcase( d ) & '" })' ) );
		}
		// the workspace before or after this one (r: on this monitor, empty ones included); with Alt the window goes along
		for ( var wd in [ { k: "Left", n: "previous", s: "-1" }, { k: "Right", n: "next", s: "+1" } ] ) {
			rows.append( row( "ws-" & wd.n, G.ws, "Go to the " & wd.n & " workspace", "Super+Ctrl+" & wd.k, "Super+Ctrl+" & wd.k, "hypr-bind", 'hl.dsp.focus({ workspace = "r' & wd.s & '" })' ) );
			rows.append( row( "ws-move-" & wd.n, G.ws, "Take the window to the " & wd.n & " workspace", "Super+Ctrl+Alt+" & wd.k, "Super+Ctrl+Alt+" & wd.k, "hypr-bind", 'hl.dsp.window.move({ workspace = "r' & wd.s & '" })' ) );
		}
		// back to the workspace you were on (Omarchy's key)
		rows.append( row( "ws-last", G.ws, "Back to the last workspace", "Super+Ctrl+Tab", "Super+Ctrl+Tab", "hypr-bind", 'hl.dsp.focus({ workspace = "previous_per_monitor" })' ) );
		// monitors (Omarchy's keys): the window or the whole workspace to the monitor in that direction, focus the next or previous monitor
		for ( var md in [ { k: "Left", d: "l", n: "left" }, { k: "Right", d: "r", n: "right" }, { k: "Up", d: "u", n: "upper" }, { k: "Down", d: "d", n: "lower" } ] ) {
			rows.append( row( "monitor-window-" & md.n, G.ws, "Move the window to the " & md.n & " monitor", "Super+Ctrl+Shift+" & md.k, "Super+Ctrl+Shift+" & md.k, "hypr-bind", 'hl.dsp.window.move({ monitor = "' & md.d & '" })' ) );
			rows.append( row( "monitor-workspace-" & md.n, G.ws, "Move the workspace to the " & md.n & " monitor", "Super+Alt+Shift+" & md.k, "Super+Alt+Shift+" & md.k, "hypr-bind", 'hl.dsp.workspace.move({ monitor = "' & md.d & '" })' ) );
		}
		rows.append( row( "monitor-next", G.ws, "Focus the next monitor", "Ctrl+Alt+Tab", "Ctrl+Alt+Tab", "hypr-bind", 'hl.dsp.focus({ monitor = "+1" })' ) );
		rows.append( row( "monitor-previous", G.ws, "Focus the previous monitor", "Ctrl+Alt+Shift+Tab", "Ctrl+Alt+Shift+Tab", "hypr-bind", 'hl.dsp.focus({ monitor = "-1" })' ) );
		// workspaces 1 to 10: Super+1..0 switches, Super+Shift+1..0 sends the window there
		for ( var i = 1; i <= 10; i++ ) {
			var k = i % 10;
			rows.append( row( "ws-" & i, G.ws, "Go to workspace " & i, "Super+" & k, "Super+" & k, "hypr-bind", "hl.dsp.focus({ workspace = " & i & " })" ) );
			// Mac style: Super+Shift+3, 4 and 5 are the screenshot keys, so sending a window to workspaces 3 to 5 is Super+Alt+Shift+N there
			var mm = i >= 3 && i <= 5 ? "Super+Alt+Shift+" & k : "Super+Shift+" & k;
			rows.append( row( "ws-move-" & i, G.ws, "Send the window to workspace " & i, "Super+Shift+" & k, mm, "hypr-bind", "hl.dsp.window.move({ workspace = " & i & " })" ) );
		}
		// one unbound row per Control Center page (bind it in the keys editor): it opens that page alone in a terminal
		for ( var pg in new bxrig.ControlCenterPages().list() ) rows.append( bx( "tui-" & pg.id, "Control Center pages", "BxRig " & pg.title & " (Control Center page)", "", "", "tui " & pg.id ) );
		return rows;
	}

	// The rows of the style that is on: `keys` is that style's key, with your overrides laid over it (only bindings can be changed; remaps are xremap's).
	function table() {
		if ( structKeyExists( variables, "cache" ) ) return variables.cache;
		var rows = rawRows();
		for ( var r in rows ) {
			r.keys = r.keysBy[ variables.keyStyle.style ];
			if ( r.kind != "remap" && structKeyExists( variables.overrides, r.id ) && parseKeys( variables.overrides[ r.id ] ).ok ) r.keys = variables.overrides[ r.id ];
			if ( r.kind == "bind" ) {
				r.plasma = { group: "ksmserver", key: "Log Out", value: qtKeys( r.keys ) & ",Ctrl+Alt+Del,Log Out" };
			}
		}
		variables.cache = rows;
		return rows;
	}

	// The bxrig argv a row runs, or [] when it is a Lua dispatch.
	function argvOf( id ) {
		for ( var r in table() ) if ( compare( r.id, arguments.id ) == 0 ) return len( r.words ) ? listToArray( r.words, " " ) : [];
		return [];
	}

	// The rows you may change with `keys set`.
	function editable() { return table().filter( function( r ) { return r.kind != "remap"; } ); }

	// The table as text lines for `keys show`.
	function show() {
		return table().map( function( r ) {
				return { id: r.id, group: r.group, keys: r.keys, custom: r.kind != "remap" && structKeyExists( variables.overrides, r.id ), action: r.action, how: r.kind == "remap" ? "xremap" : ( r.kind == "hypr-bind" ? "Hyprland binding" : "desktop binding" ), runs: len( r.words ) > 0 };
			} );
	}

	// Double use of a combo: { within: [ { combo, ids } ], remapShadows: [ { id, combo, remap } ], user: [ { id, combo, file, line } ] }.
	//   within         two bindings of this style share a combo
	//   remapShadows   a binding on a key that xremap rewrites first, so it can never fire (remaps count only in the styles that have them)
	//   user           a `hl.bind` line of your own files (userBinds: [ { combo, file, line } ], see KeysEditor) on a combo the table or a remap uses
	function conflicts( userBinds = [] ) {
		var byCombo = {};
		var remapBy = {};
		for ( var r in table() ) {
			if ( !len( r.keys ) ) continue;
			var c = normalize( r.keys );
			if ( r.kind == "remap" ) { remapBy[ c ] = r.id; continue; }
			if ( !structKeyExists( byCombo, c ) ) byCombo[ c ] = [];
			byCombo[ c ].append( r.id );
		}
		var within = [];
		var shadows = [];
		for ( var c2 in structKeyArray( byCombo ) ) {
			if ( byCombo[ c2 ].len() > 1 ) within.append( { combo: c2, ids: byCombo[ c2 ] } );
			if ( structKeyExists( remapBy, c2 ) ) for ( var id in byCombo[ c2 ] ) shadows.append( { id: id, combo: c2, remap: remapBy[ c2 ] } );
		}
		var user = [];
		for ( var ub in arguments.userBinds ) {
			if ( structKeyExists( byCombo, ub.combo ) ) for ( var id2 in byCombo[ ub.combo ] ) user.append( { id: id2, combo: ub.combo, file: ub.file, line: ub.line } );
			else if ( structKeyExists( remapBy, ub.combo ) ) user.append( { id: remapBy[ ub.combo ], combo: ub.combo, file: ub.file, line: ub.line } );
		}
		return { within: within, remapShadows: shadows, user: user };
	}

	// True for the render targets.
	function targets() {
		return [ "xremap", "hyprland", "plasma" ];
	}

	// Rendered text for one target.
	function render( target ) {
		if ( target == "xremap" ) return xremap();
		if ( target == "hyprland" ) return hyprland();
		if ( target == "plasma" ) return plasma();
		throw( type = "Shortcuts.target", message = "Unknown target: " & target );
	}

	// The key a remap row listens for, in xremap's spelling: Super+C is Super-c.
	function xremapKey( r ) {
		var k = parseKeys( r.keys );
		var out = [];
		for ( var m in [ "SUPER", "CTRL", "ALT", "SHIFT" ] ) if ( arrayFind( k.mods, m ) ) out.append( m == "SUPER" ? "Super" : ( m == "CTRL" ? "Ctrl" : ( m == "ALT" ? "Alt" : "Shift" ) ) );
		out.append( lcase( k.key ) );
		return out.toList( "-" );
	}

	// xremap YAML: the Alt and Win swap first (Mac style on a PC keyboard), then terminal rules (only), then the general rules (not terminals).
	function xremap() {
		var remaps = table().filter( function( r ) { return r.kind == "remap" && len( r.keys ) > 0; } );
		var termList = terminals().map( function( c ) { return "'" & c & "'"; } ).toList( ", " );
		var out = [ "# Written by bxrig (keys). Cmd-style keys, same on Hyprland and Plasma." ];
		if ( new bxrig.KeyStyle().swapActive( variables.keyStyle ) ) {
			out.append( "# Mac style on a PC keyboard: Alt acts as Cmd and Win as Option (left keys only; Right Alt stays AltGr)." );
			out.append( "modmap:" );
			out.append( "  - name: Alt and Win swapped" );
			out.append( "    remap:" );
			out.append( "      Alt_L: Super_L" );
			out.append( "      Super_L: Alt_L" );
		}
		out.append( "keymap:" );
		out.append( "  - name: Cmd keys in terminals" );
		out.append( "    application:" );
		out.append( "      only: [" & termList & "]" );
		out.append( "    remap:" );
		for ( var r in remaps ) out.append( "      " & xremapKey( r ) & ": " & ( structKeyExists( r, "termTo" ) ? r.termTo : r.to ) );
		out.append( "  - name: Cmd keys everywhere else" );
		out.append( "    application:" );
		out.append( "      not: [" & termList & "]" );
		out.append( "    remap:" );
		for ( var r2 in remaps ) out.append( "      " & xremapKey( r2 ) & ": " & r2.to );
		return out.toList( chr( 10 ) ) & chr( 10 );
	}

	// The Hyprland Lua module (Hyprland 0.55+ reads hyprland.lua; Noctalia's docs use the same API).
	// Written to ~/.config/hypr/bxrig.lua; hyprland.lua loads it with `require("bxrig")` (see hyprlandLoadLine).
	// Lines come from the Noctalia v5 Hyprland docs: https://docs.noctalia.dev/noctalia/v5.4.0/compositor-settings/hyprland/
	function hyprland() {
		var lua = new bxrig.LuaModule();
		var out = [
			'-- Written by bxrig (keys). Edit with `bxrig keys apply`, not by hand.',
			'-- Style: ' & variables.keyStyle.style & '. Every binding below is a row of `bxrig keys show`; change one with `bxrig keys set`.',
			'local mainMod = "SUPER"',
			'local ipc = "noctalia msg "',
			'-- The programs your hyprland.lua chose (it sets BXRIG_PROGRAMS before it loads this file)',
			'local programs = rawget(_G, "BXRIG_PROGRAMS") or {}',
			'local terminal = programs.terminal or "kitty"',
			'local browser = programs.browser or "brave"',
			'local fileManager = programs.fileManager or "dolphin"',
			'',
			'-- Window layouts per workspace (bxrig HyprLayout). Super+Shift+J cycles them with workspace rules (wiki: code-snippets,',
			'-- "Cycle layout for current workspace"); columns is the master layout centred at a third of the width.',
			'local bxrigLayouts = { ' & layoutListLua() & ' }',
			'local bxrigChosen = {}',
			'local function bxrigWorkspace()',
			'  return hl.get_active_special_workspace() or hl.get_active_workspace()',
			'end',
			'function bxrigNextLayout()',
			'  local ws = bxrigWorkspace()',
			'  if not ws then return end',
			'  local key = tostring(ws.name)',
			'  local current = bxrigChosen[key] or ws.tiled_layout',
			'  local nextName = bxrigLayouts[1]',
			'  for i = 1, #bxrigLayouts do',
			'    if bxrigLayouts[i] == current then nextName = bxrigLayouts[(i % #bxrigLayouts) + 1] break end',
			'  end',
			'  local sel = ws.special and key or ("name:" .. key)',
			'  if nextName == "columns" then',
			'    hl.workspace_rule({ workspace = sel, layout = "master", layout_opts = { orientation = "center" } })',
			'    hl.dispatch(hl.dsp.layout("mfact exact 0.34"))',
			'  elseif nextName == "master" then',
			'    hl.workspace_rule({ workspace = sel, layout = "master", layout_opts = { orientation = "left" } })',
			'    hl.dispatch(hl.dsp.layout("mfact exact 0.55"))',
			'  else',
			'    hl.workspace_rule({ workspace = sel, layout = nextName })',
			'  end',
			'  bxrigChosen[key] = nextName',
			'  hl.dispatch(hl.dsp.exec_cmd("notify-send -t 1500 -a BxRig Layout " .. nextName))',
			'end',
			'-- Super+Minus and Super+Equal: the split (dwindle), the master width (master, columns) or the column width (scrolling)',
			'function bxrigResize(sign)',
			'  local ws = bxrigWorkspace()',
			'  if not ws then return end',
			'  local l = ws.tiled_layout',
			'  if l == "scrolling" then hl.dispatch(hl.dsp.layout("colresize " .. sign .. "conf"))',
			'  elseif l == "master" then hl.dispatch(hl.dsp.layout("mfact " .. sign .. "0.05"))',
			'  elseif l == "dwindle" then hl.dispatch(hl.dsp.layout("splitratio " .. sign .. "0.1"))',
			'  end',
			'end',
			'',
			'-- Floating windows snap to the screen edges and to each other (`bxrig appearance windows snap off` turns it off)',
			'hl.config({ general = { snap = { enabled = true, respect_gaps = true } } })',
			'',
			'-- Noctalia starts with the session',
			'hl.on("hyprland.start", function()',
			'  hl.exec_cmd("noctalia")',
			'  -- clipboard history (cliphist stores what wl-paste sees; pick it with the clipboard key)',
			'  hl.exec_cmd("wl-paste --type text --watch cliphist store")',
			'  hl.exec_cmd("wl-paste --type image --watch cliphist store")',
			'end)',
			'',
			'-- Bindings from the bxrig table (the Super+Tab switcher key is remapped to Alt+Tab by xremap in the Mac style)'
		];
		for ( var r in table() ) if ( ( r.kind == "bind" || r.kind == "hypr-bind" ) && len( r.keys ) ) out.append( bindLine( r ) );
		out.append( '' );
		out.append( '-- Theme accent: `bxrig theme set` writes ~/.config/bxrig/theme/hypr.lua (the focused and unfocused border colours)' );
		for ( var l1 in lua.optional( "hypr", "accent", "hl.config({ general = { col = { active_border = accent.active, inactive_border = accent.inactive } } })" ) ) out.append( l1 );
		out.append( '' );
		out.append( '-- Look settings: `bxrig appearance` writes ~/.config/bxrig/theme/look.lua (gaps, corners, opacity, animations, layout, one-window ratio)' );
		for ( var l2 in lua.optional( "look", "look", "hl.config(look)" ) ) out.append( l2 );
		out.append( '' );
		out.append( '-- Monitors: `bxrig display` writes ~/.config/bxrig/theme/monitors.lua (scale, rotation, position, mirror, laptop panel)' );
		for ( var l3 in lua.optional( "monitors", "mons", "for _, m in ipairs(mons) do hl.monitor(m) end" ) ) out.append( l3 );
		out.append( '' );
		out.append( '-- The pull-down AI shell (bxrig ai shell) lives on the special workspace "ai"; its window class is set by the terminal it starts' );
		out.append( 'hl.window_rule({ name = "bxrig-ai", match = { class = "^com.bxrig.ai$" }, workspace = "special:ai", float = true })' );
		out.append( '' );
		out.append( '-- The webcam preview (bxrig webcam toggle) floats at a small size' );
		out.append( 'hl.window_rule({ name = "bxrig-webcam", match = { class = "^bxrig-webcam$" }, float = true, size = { 360, 270 } })' );
		out.append( '' );
		out.append( '-- The webcam bubble of a screen recording (bxrig record start --webcam): pinned in a corner, sized from the monitor height, never focused' );
		for ( var wr in new bxrig.Webcam( "" ).overlayRules() ) out.append( wr );
		out.append( '' );
		out.append( '-- The screensaver (bxrig screensaver start) is a full-screen terminal per monitor, without animation, border or corners' );
		out.append( 'hl.window_rule({ name = "bxrig-screensaver", match = { class = "^bxrig-screensaver$" }, fullscreen = true, no_anim = true, border_size = 0, rounding = 0, no_shadow = true, no_blur = true })' );
		out.append( '' );
		out.append( '-- Noctalia settings window floats; its panels get blur and no layer animation' );
		out.append( 'hl.window_rule({ match = { class = "dev.noctalia.Noctalia" }, float = true, size = { 1080, 920 } })' );
		out.append( 'hl.layer_rule({ name = "noctalia", match = { namespace = "^noctalia-(bar-.+|notification|dock|panel|attached-panel|osd|window-switcher)$" }, no_anim = true, ignore_alpha = 0.5, blur = true, blur_popups = true })' );
		return out.toList( chr( 10 ) ) & chr( 10 );
	}

	// The cycle of layouts as Lua strings: "dwindle", "master", ...
	function layoutListLua() {
		var q = [];
		for ( var n in new bxrig.HyprLayout().cycle() ) q.append( '"' & n & '"' );
		return q.toList( ", " );
	}

	// The one line hyprland.lua needs to load the module above.
	function hyprlandLoadLine() {
		return 'require("bxrig")';
	}

	// kglobalshortcutsrc fragment for Plasma.
	function plasma() {
		var out = [ "# Written by bxrig (keys)." ];
		for ( var r in table() ) if ( r.kind == "bind" ) {
			out.append( "[" & r.plasma.group & "]" );
			out.append( r.plasma.key & "=" & r.plasma.value );
		}
		return out.toList( chr( 10 ) ) & chr( 10 );
	}

	// The files bxrig manages for the shortcuts, in the config service entry shape (name, target, mode, content).
	// They join `config list|diff|apply|restore`. The Hyprland file still has to be `source`d from hyprland.conf.
	function entries( cfgHome ) {
		return [
			{ name: "xremap", target: cfgHome & "/xremap/config.yml", mode: "644", content: xremap() },
			{ name: "hypr-keys", target: cfgHome & "/hypr/bxrig.lua", mode: "644", content: hyprland() },
			{ name: "xremap-service", target: cfgHome & "/systemd/user/xremap.service", mode: "644", content: xremapService() }
		];
	}

	// Plasma settings written with kwriteconfig6 into kglobalshortcutsrc: [ { group, key, value } ].
	function plasmaSettings() {
		return table().filter( function( r ) { return r.kind == "bind"; } ).map( function( r ) { return r.plasma; } );
	}

	// The systemd user unit that runs xremap with the shared config. Enabled by `setup xremap`.
	function xremapService() {
		return new bxrig.util.SystemdUnit().render( [
				{ name: "Unit", lines: [ "Description=xremap key remapper (bxrig)", "PartOf=graphical-session.target", "After=graphical-session.target" ] },
				{ name: "Service", lines: [ "ExecStart=/usr/bin/xremap %h/.config/xremap/config.yml", "Restart=on-failure" ] },
				{ name: "Install", lines: [ "WantedBy=graphical-session.target" ] }
			], "Written by bxrig (keys)." );
	}
}
