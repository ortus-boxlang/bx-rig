// `bxrig init`: turns the wizard's answers into an ordered list of ordinary commands. Pure (no files, no processes), so it
// is unit tested. Every answer is optional: a missing answer adds no step, and nothing runs that the user did not choose.
//
// A step is { id, title, argv }. argv is an argument array; argv[1] "bxrig" means this program (the executor swaps in its own
// path and adds --yes). Answers that no command applies yet are listed in `pending`, so nothing is silently dropped.
class InitPlan {
	// Answer keys that are saved but have no command behind them yet.
	function pendingKeys() {
		return [];
	}

	// Answers that shape the Hyprland starter (applied by `setup hyprland`; pending when Hyprland is not being set up).
	function hyprlandKeys() {
		return [ "workspaces", "natural_scroll", "layouts", "theme", "wallpaper", "bar_position", "dock", "bar_layout", "appgrid_style" ];
	}

	// The value of an answer, or a fallback when it was not answered.
	function pick( answers, key, fallback = "" ) {
		return structKeyExists( arguments.answers, arguments.key ) ? arguments.answers[ arguments.key ] : arguments.fallback;
	}

	// A truthy "set" answer: a non-empty array, a non-empty string other than "none", or true.
	function isSet( value ) {
		if ( isArray( arguments.value ) ) return arguments.value.len() > 0;
		var text = toString( arguments.value );
		return len( text ) > 0 && text != "none" && text != "false" && text != "no" && text != "0";
	}

	// The session the login screen should preselect: follows the desktop choice, and `both` uses login_session.
	function session( answers ) {
		var desktops = pick( arguments.answers, "desktops" );
		if ( desktops == "hyprland" ) return "hyprland";
		if ( desktops == "plasma" ) return "plasma";
		if ( desktops == "both" ) return pick( arguments.answers, "login_session", "hyprland" );
		return "";
	}

	// Whether an app may be installed for the chosen desktop(s): apps with a `shells` list are for those desktops only. shellMap is
	// id -> shells array (from the catalog); an unknown id or empty list means any desktop.
	function shellOk( id, desktops, shellMap ) {
		if ( !structKeyExists( arguments.shellMap, arguments.id ) || !arguments.shellMap[ arguments.id ].len() ) return true;
		if ( arguments.desktops == "hyprland" ) return arrayFind( arguments.shellMap[ arguments.id ], "hyprland" ) > 0;
		if ( arguments.desktops == "plasma" ) return arrayFind( arguments.shellMap[ arguments.id ], "plasma" ) > 0;
		return true;
	}

	// The top bar layouts and app grid styles `bxrig appearance` knows (the wizard's Top bar layout and App grid style pages).
	function barLayouts() { return new bxrig.BarLayouts().order(); }
	function gridStyles() { return [ "launchpad", "terminal" ]; }

	// The plan: { steps, pending, errors }. shellMap (optional): catalog app id -> its shells, to keep desktop-specific apps off
	// the other desktop when "customize" picked them. current (optional): what the machine has now, { theme }: the theme that is applied
	// already, so choosing the default theme again (back from another) still runs `theme set`.
	function plan( answers, shellMap = {}, current = {} ) {
		var a = arguments.answers;
		var out = { steps: [], pending: [], errors: [] };
		var desktops = pick( a, "desktops" );
		if ( len( desktops ) && !arrayFind( [ "hyprland", "plasma", "both" ], desktops ) ) out.errors.append( "desktops: unknown value " & desktops );
		var terminal = pick( a, "terminal" );
		var layout = pick( a, "layout" );
		// the colour theme (a Dark/Light answer of Light with the default theme picks the light BxRig theme); its wallpaper is the starting one
		var themeName = pick( a, "theme_name" );
		if ( themeName == "bxrig" && pick( a, "theme" ) == "light" ) themeName = "bxrig-light";
		var walls = new bxrig.StarterOptions().wallpapers();
		var wallpaper = structKeyExists( walls, pick( a, "wallpaper" ) ) ? a.wallpaper : ( structKeyExists( walls, themeName ) ? themeName : "" );
		var wantsHypr = desktops == "hyprland" || desktops == "both";
		var wantsPlasma = desktops == "plasma" || desktops == "both";
		// the key style goes first: the setup steps below write the shortcut files, which read it
		if ( isSet( pick( a, "mac_keys", false ) ) ) {
			var kb = pick( a, "keyboard_type" ) == "apple" ? "apple" : "pc";
			out.steps.append( { id: "key-style", title: "Mac-style keys on a " & ( kb == "apple" ? "Apple keyboard (no Alt and Win swap)" : "PC keyboard (Alt acts as Cmd, Win as Option)" ), argv: [ "bxrig", "keys", "style", "mac", "--keyboard=" & kb ] } );
		}
		if ( wantsHypr ) {
			var argv = [ "bxrig", "setup", "hyprland" ];
			if ( len( terminal ) ) argv.append( "--terminal=" & terminal );
			if ( len( layout ) ) argv.append( "--layout=" & layout );
			if ( structKeyExists( a, "workspaces" ) ) argv.append( "--workspaces=" & a.workspaces );
			if ( isSet( pick( a, "natural_scroll", false ) ) ) argv.append( "--natural-scroll" );
			if ( pick( a, "layouts", [] ).len() ) argv.append( "--layouts=" & a.layouts.toList( "," ) );
			if ( len( pick( a, "theme" ) ) ) argv.append( "--theme=" & a.theme );
			if ( len( wallpaper ) ) argv.append( "--wallpaper=" & wallpaper );
			out.steps.append( { id: "hyprland", title: "set up Hyprland + Noctalia" & ( len( terminal ) ? " (" & terminal & " on Super+Enter" & ( len( layout ) ? ", " & layout & " layout" : "" ) & ")" : "" ), argv: argv } );
		}
		if ( wantsPlasma ) out.steps.append( { id: "plasma", title: "set up KDE Plasma tiling (HyprKwin)", argv: [ "bxrig", "setup", "plasma" ] } );
		var extras = pick( a, "terminals_extra", [] );
		if ( len( terminal ) || extras.len() ) {
			var targv = [ "bxrig", "setup", "terminal" ];
			if ( len( terminal ) ) targv.append( "--default=" & terminal );
			if ( extras.len() ) targv.append( "--also=" & extras.toList( "," ) );
			out.steps.append( { id: "terminal", title: "install and configure terminals (" & ( len( terminal ) ? terminal : "default" ) & ( extras.len() ? " and " & extras.toList( ", " ) : "" ) & ")", argv: targv } );
		}
		// the colour theme goes after the terminals, so their starter configs and the generated theme files exist.
		// Optional: the desktop may not be running during the install.
		// a chosen launcher or menu program is themed too (the rofi, fuzzel and wofi files are part of `theme set`), so it is never stock after setup,
		// even with the default BxRig theme
		var runnerChosen = len( pick( a, "launcher" ) ) > 0 || len( pick( a, "menu" ) ) > 0;
		var themeNow = structKeyExists( arguments.current, "theme" ) ? arguments.current.theme : "";
		if ( ( wantsHypr || wantsPlasma || runnerChosen ) && len( themeName ) && ( themeName != "bxrig" || runnerChosen || ( len( themeNow ) && themeNow != themeName ) ) ) {
			var thargv = [ "bxrig", "theme", "set", themeName ];
			if ( pick( a, "theme" ) == "auto" ) thargv.append( "--mode=auto" );
			out.steps.append( { id: "theme", title: "apply the " & themeName & " colour theme", argv: thargv, optional: true } );
		}
		// the icon set (not asked in the wizard): the BxRig theme over Papirus-Dark; `bxrig appearance icons papirus` switches to Papirus alone later
		if ( wantsHypr || wantsPlasma ) out.steps.append( { id: "icons", title: "icon set: BxRig icons over Papirus-Dark", argv: [ "bxrig", "appearance", "icons", "bxrig" ], optional: true } );
		// the bar and the dock (Noctalia, so Hyprland only); optional: Noctalia may not be running during the install
		if ( wantsHypr && len( pick( a, "bar_position" ) ) ) out.steps.append( { id: "bar", title: "put the bar at the " & a.bar_position, argv: [ "bxrig", "appearance", "bar", "position", a.bar_position ], optional: true } );
		if ( wantsHypr && structKeyExists( a, "dock" ) ) out.steps.append( { id: "dock", title: "dock " & ( isSet( a.dock ) ? "on" : "off" ), argv: [ "bxrig", "appearance", "dock", isSet( a.dock ) ? "on" : "off" ], optional: true } );
		// the top bar layout and the app grid style (Noctalia, so Hyprland only), after the bar and the dock
		var layoutPick = pick( a, "bar_layout" );
		if ( len( layoutPick ) && !arrayFind( barLayouts(), layoutPick ) ) out.errors.append( "bar_layout: unknown value " & layoutPick );
		else if ( wantsHypr && len( layoutPick ) ) out.steps.append( { id: "bar-layout", title: "top bar layout: " & new bxrig.BarLayouts().layout( layoutPick ).name, argv: [ "bxrig", "appearance", "bar", "layout", layoutPick ], optional: true } );
		var gridPick = pick( a, "appgrid_style" );
		if ( len( gridPick ) && !arrayFind( gridStyles(), gridPick ) ) out.errors.append( "appgrid_style: unknown value " & gridPick );
		else if ( wantsHypr && len( gridPick ) ) out.steps.append( { id: "appgrid", title: "app grid style: " & ( gridPick == "terminal" ? "Terminal-style" : "Launchpad" ), argv: [ "bxrig", "appearance", "appgrid", gridPick ], optional: true } );
		// world clock: the globe and the zones you follow, or off
		if ( structKeyExists( a, "world_clock" ) ) {
			var zones = pick( a, "world_clock_zones", [] );
			if ( isSet( a.world_clock ) && zones.len() ) out.steps.append( { id: "world-clock", title: "world clock: " & zones.toList( ", " ), argv: [ "bxrig", "time", "world", "set", zones.toList( "," ) ], optional: true } );
			else if ( !isSet( a.world_clock ) ) out.steps.append( { id: "world-clock", title: "no world clock", argv: [ "bxrig", "time", "world", "off" ], optional: true } );
		}
		// the screensaver: when it starts (the lock comes at twice that), or off with the lock kept at 5 minutes (Noctalia, so Hyprland only)
		var ssPick = pick( a, "screensaver" );
		if ( len( ssPick ) && ssPick != "off" && !arrayFind( [ "150", "300", "600" ], ssPick ) ) out.errors.append( "screensaver: unknown value " & ssPick );
		else if ( wantsHypr && ssPick == "off" ) out.steps.append( { id: "screensaver", title: "no screensaver", argv: [ "bxrig", "screensaver", "off" ], optional: true } );
		else if ( wantsHypr && len( ssPick ) ) out.steps.append( { id: "screensaver", title: "screensaver after " & ( ssPick / 60 ) & " min, lock after " & ( ssPick / 30 ) & " min", argv: [ "bxrig", "screensaver", "set", "screensaver=" & ssPick, "lock=" & ( ssPick * 2 ) ], optional: true } );
		// hot corners: one action per corner
		var corners = [];
		for ( var c in [ { k: "hot_corner_tl", n: "top-left" }, { k: "hot_corner_tr", n: "top-right" }, { k: "hot_corner_bl", n: "bottom-left" }, { k: "hot_corner_br", n: "bottom-right" } ] ) {
			if ( len( pick( a, c.k ) ) ) corners.append( c.n & "=" & a[ c.k ] );
		}
		if ( corners.len() ) {
			var hargv = [ "bxrig", "hotcorners", "set" ];
			for ( var hc in corners ) hargv.append( hc );
			out.steps.append( { id: "hot-corners", title: "hot corners: " & corners.toList( ", " ), argv: hargv, optional: true } );
		}
		var shell = pick( a, "shell" );
		if ( len( shell ) ) out.steps.append( { id: "shell", title: "set up " & shell & " with the Starship prompt", argv: [ "bxrig", "setup", "shell", "--shell=" & shell ] } );
		// xremap is always set up: copy, paste, cut and select all are remaps in both styles
		if ( wantsHypr || wantsPlasma ) {
			var build = desktops == "plasma" ? "kde" : "hypr";
			out.steps.append( { id: "xremap", title: "Cmd-style keys (xremap, " & build & ")", argv: [ "bxrig", "setup", "xremap", "--build=" & build ], optional: true } );
		}
		// toolchains: one catalog profile each (java is the jvm profile: JDK 21, Maven, Gradle); Laravel's installer comes from Composer
		var profiles = { java: "jvm", php: "php", python: "python", go: "go" };
		var chosen = pick( a, "toolchains", [] );
		var jsApps = [];
		for ( var tc in [ "java", "php", "python", "go", "rust", "javascript" ] ) {
			if ( !arrayFind( chosen, tc ) ) continue;
			if ( tc == "rust" ) {
				// rustup itself comes with the install; this picks the stable toolchain (a failure is skipped, the plan goes on)
				out.steps.append( { id: "toolchain-rust", title: "set up Rust (rustup, stable toolchain)", argv: [ "rustup", "default", "stable" ], optional: true } );
				continue;
			}
			if ( tc == "javascript" ) {
				// runtimes: Node comes through nvm (`toolchain node`); Bun and Deno are catalog apps
				for ( var rt in pick( a, "js_runtimes", [ "node" ] ) ) {
					if ( rt == "node" ) out.steps.append( { id: "toolchain-node", title: "install Node.js with nvm", argv: [ "bxrig", "toolchain", "node" ] } );
					else if ( rt == "bun" || rt == "deno" ) jsApps.append( rt );
				}
				continue;
			}
			out.steps.append( { id: "toolchain-" & tc, title: "install the " & tc & " toolchain", argv: [ "bxrig", "profile-install", profiles[ tc ] ] } );
			if ( tc == "php" ) out.steps.append( { id: "laravel", title: "install the Laravel installer (composer global)", argv: [ "composer", "global", "require", "laravel/installer" ] } );
		}
		// BoxLang itself comes first when a later step runs it (the VS Code extension, the scheduler); `boxlang update` installs it when it is missing
		if ( pick( a, "boxlang_vscode", false ) == true || pick( a, "scheduler", false ) == true ) {
			out.steps.append( { id: "jdk", title: "install Java 21 (BoxLang needs it)", argv: [ "bxrig", "install", "jdk21" ], optional: true } );
			out.steps.append( { id: "boxlang", title: "install BoxLang (the steps after this one use it)", argv: [ "sh", "-c", "command -v boxlang >/dev/null 2>&1 && exit 0; command -v bvm >/dev/null 2>&1 || curl -fsSL " & new bxrig.util.Urls().bvm() & " | bash; bvm install latest && bvm use latest" ], optional: true } );
		}
		// agent skills (optional: needs the skills hub for boxlang and matchbox; a failure is skipped)
		var skillPick = pick( a, "agent_skills", [] );
		if ( skillPick.len() ) {
			var skArgv = [ "bxrig", "skills", "install" ];
			for ( var sk in skillPick ) skArgv.append( sk );
			out.steps.append( { id: "agent-skills", title: "give your coding agents skills (" & skillPick.toList( ", " ) & ")", argv: skArgv, optional: true } );
		}
		// the BoxLang extension for VS Code (optional: a failure is skipped, the plan goes on)
		if ( pick( a, "boxlang_vscode", false ) ) out.steps.append( { id: "boxlang-vscode", title: "add the BoxLang extension to VS Code", argv: [ "bxrig", "boxlang", "vscode" ], optional: true } );
		// containers: Podman is the engine the containers profile is built around; Docker is one extra package
		var engine = pick( a, "container_engine" );
		var vmWin = pick( a, "vm_windows" );
		var vmLin = pick( a, "vm_linux" );
		var vmWanted = ( len( vmWin ) && vmWin != "none" ) || ( len( vmLin ) && vmLin != "none" );
		if ( engine == "podman" || ( !len( engine ) && vmWanted ) ) out.steps.append( { id: "containers", title: "install Podman and its tools", argv: [ "bxrig", "profile-install", "containers" ] } );
		if ( engine == "podman" && pick( a, "docker_compat", false ) == true ) out.steps.append( { id: "docker-compat", title: "make docker and docker compose run on Podman (podman-docker, podman-compose)", argv: [ "bxrig", "containers", "docker-compat" ], optional: true } );
		if ( pick( a, "gaming" ) == "bundle" ) out.steps.append( { id: "gaming", title: "install the CachyOS gaming bundle", argv: [ "bxrig", "profile-install", "gaming" ] } );
		// apps: Basic installs the catalog's recommended set for the chosen desktop(s); Customize installs what was ticked
		var mode = pick( a, "app_mode" );
		var chosenApps = [];
		if ( mode == "defaults" ) {
			var shellFlag = desktops == "hyprland" ? "--shell=hyprland" : ( desktops == "plasma" ? "--shell=plasma" : ( desktops == "both" ? "--shell=all" : "" ) );
			var bargv = [ "bxrig", "install" ];
			if ( len( shellFlag ) ) bargv.append( shellFlag );
			out.steps.append( { id: "apps-basic", title: "install the recommended apps (the catalog's default set)", argv: bargv } );
		} else if ( mode == "custom" ) {
			for ( var cid in new bxrig.AppPages().selected( a ) ) if ( shellOk( cid, desktops, arguments.shellMap ) ) chosenApps.append( cid );
		}
		var fileManager = pick( a, "file_manager" );
		if ( len( fileManager ) && !arrayFind( chosenApps, fileManager ) ) chosenApps.append( fileManager );
		for ( var wbBundle in pick( a, "web_bundles", [] ) ) out.steps.append( { id: "web-" & wbBundle, title: "add all the " & wbBundle & " web apps", argv: [ "bxrig", "web", "install", wbBundle ], optional: true } );
		var dictation = pick( a, "dictation" );
		if ( dictation == "superwhisper" ) { if ( !arrayFind( chosenApps, "superwhisper" ) ) chosenApps.append( "superwhisper" ); }
		else if ( dictation == "voxtype" ) { for ( var dapp in [ "voxtype", "wtype" ] ) if ( !arrayFind( chosenApps, dapp ) ) chosenApps.append( dapp ); }
		var presentations = pick( a, "presentations" );
		if ( arrayFind( [ "hype", "onlyoffice" ], presentations ) && !arrayFind( chosenApps, presentations ) ) chosenApps.append( presentations );
		var browser = pick( a, "default_browser" );
		if ( len( browser ) && !arrayFind( chosenApps, browser ) ) chosenApps.append( browser );
		// everything else that is one package each goes in a single install
		var apps = [];
		for ( var ca in chosenApps ) apps.append( ca );
		for ( var id in jsApps ) apps.append( id );
		for ( var id in pick( a, "ai_orchestrators", [] ) ) apps.append( id );
		// the coding agents: the ticked ones, plus the default agent if it was not ticked (it has to be there to be the default)
		var agentLib = new bxrig.AiAgents();
		var agentIds = [];
		for ( var id in pick( a, "ai_agents", [] ) ) agentIds.append( id );
		var aiDefault = pick( a, "ai_default" );
		if ( isSet( aiDefault ) ) {
			if ( structIsEmpty( agentLib.find( aiDefault ) ) ) out.errors.append( "ai_default: unknown agent " & aiDefault );
			else if ( !arrayFind( agentIds, aiDefault ) ) agentIds.append( aiDefault );
		}
		for ( var id in agentIds ) apps.append( id );
		// agent sessions that survive closing the terminal are tmux sessions
		if ( agentIds.len() ) apps.append( "tmux" );
		// the pull-down AI shell on Plasma is Yakuake (Hyprland needs nothing extra)
		if ( agentIds.len() && wantsPlasma ) apps.append( "yakuake" );
		if ( pick( a, "night_shift", false ) && wantsHypr ) apps.append( "wlsunset" );
		if ( wantsHypr && pick( a, "gestures", false ) ) { apps.append( "libinput-gestures" ); apps.append( "bluez" ); }
		if ( pick( a, "airplay", false ) ) apps.append( "uxplay" );
		// the Plasma panel layout needs its widgets installed
		var panelsOn = wantsPlasma && pick( a, "plasma_panels" ) == "bxrig";
		if ( panelsOn ) {
			for ( var pw in [ "panel-colorizer", "panel-colorizer-islands", "window-title", "kvitals" ] ) apps.append( pw );
			if ( pick( a, "plasma_weather", true ) ) apps.append( "kdeplasma-addons" );
			if ( pick( a, "plasma_agenda", false ) ) apps.append( "event-calendar" );
		}
		// local model apps you ticked (BxRig's own local AI is the ai-setup step below)
		for ( var id in pick( a, "ai_local", [] ) ) apps.append( id );
		if ( pick( a, "cloud_storage", false ) == true ) { apps.append( "rclone" ); apps.append( "fuse3" ); }
		for ( var id in pick( a, "remote_desktop", [] ) ) if ( !arrayFind( apps, id ) ) apps.append( id );
		for ( var id in pick( a, "desktop_utilities", [] ) ) if ( !arrayFind( apps, id ) ) apps.append( id );
		if ( engine == "docker" ) apps.append( "docker" );
		var vpnIds = { tailscale: "tailscale", wireguard: "wireguard", openvpn: "openvpn", mullvad: "mullvad", proton: "proton-vpn", nordvpn: "nordvpn", nordlayer: "nordlayer" };
		// the VPNs you ticked (an older answers file has one name as a string)
		var vpns = pick( a, "vpn", [] );
		if ( !isArray( vpns ) ) vpns = len( toString( vpns ) ) ? [ toString( vpns ) ] : [];
		for ( var vp in vpns ) if ( structKeyExists( vpnIds, vp ) && !arrayFind( apps, vpnIds[ vp ] ) ) apps.append( vpnIds[ vp ] );
		var pm = pick( a, "password_manager" );
		if ( len( pm ) && pm != "none" ) apps.append( pm );
		if ( pick( a, "gaming" ) == "steam" ) apps.append( "steam" );
		// launcher and menu providers: install the one that needs a package; the choice itself is recorded by `runner`
		var rn = new bxrig.Runner();
		for ( var pv in [ pick( a, "launcher" ), pick( a, "menu" ) ] ) {
			var rid = len( pv ) ? rn.catalogId( pv ) : "";
			if ( len( rid ) && !arrayFind( apps, rid ) ) apps.append( rid );
		}
		for ( var id in pick( a, "backups", [] ) ) { apps.append( id ); if ( id == "snapper" ) apps.append( "snap-pac" ); }
		if ( arrayFind( pick( a, "backup_layers", [] ), "data" ) > 0 && !arrayFind( apps, "restic" ) ) apps.append( "restic" );
		if ( apps.len() ) {
			var iargv = [ "bxrig", "install" ];
			for ( var id in apps ) iargv.append( id );
			out.steps.append( { id: "apps", title: "install " & apps.toList( ", " ), argv: iargv } );
		}
		if ( pick( a, "editor_starter" ) == "lazyvim" ) out.steps.append( { id: "editor-lazyvim", title: "install the LazyVim starter for Neovim with the BxRig layer and BoxLang syntax (an existing ~/.config/nvim is left alone)", argv: [ "bxrig", "editor", "lazyvim" ], optional: true } );
		// NordVPN needs its service and your group after the install (sudo; optional so a missing password prompt never stops the plan)
		if ( arrayFind( vpns, "nordvpn" ) ) out.steps.append( { id: "vpn-nordvpn", title: "enable the NordVPN service and add you to the nordvpn group (sudo)", argv: [ "bxrig", "vpn", "nordvpn", "setup" ], optional: true } );
		// defaults: the browser and the terminal you picked (both are installed by now)
		if ( len( fileManager ) ) out.steps.append( { id: "default-filemanager", title: "make " & fileManager & " your default file manager", argv: [ "bxrig", "default", "filemanager", fileManager ] } );
		if ( fileManager == "strata" ) out.steps.append( { id: "strata-integrations", title: "add Strata's LocalSend and KDE Connect Send to providers", argv: [ "bxrig", "strata", "integrations" ], optional: true } );
		if ( len( browser ) ) out.steps.append( { id: "default-browser", title: "make " & browser & " your default browser", argv: [ "bxrig", "default", "browser", browser ] } );
		// file types: Gwenview opens images and Okular opens PDFs (both are default-tier apps; with Customize only when ticked). The desktop
		// ids org.kde.gwenview.desktop and org.kde.okular.desktop were read from the Arch package file lists. One xdg-mime call each, optional so a
		// failed install never stops the plan; nothing is undone (xdg-mime has no undo and the old default is not recorded).
		if ( mode == "defaults" || arrayFind( chosenApps, "gwenview" ) ) out.steps.append( { id: "default-images", title: "open images with Gwenview", argv: [ "xdg-mime", "default", "org.kde.gwenview.desktop", "image/png", "image/jpeg", "image/gif", "image/webp", "image/bmp", "image/tiff", "image/svg+xml", "image/avif", "image/heif", "image/jxl" ], optional: true } );
		if ( mode == "defaults" || arrayFind( chosenApps, "okular" ) ) out.steps.append( { id: "default-pdf", title: "open PDFs with Okular", argv: [ "xdg-mime", "default", "org.kde.okular.desktop", "application/pdf" ], optional: true } );
		if ( len( terminal ) ) out.steps.append( { id: "default-terminal", title: "make " & terminal & " your default terminal", argv: [ "bxrig", "default", "terminal", terminal ] } );
		// databases: remember the container engine, then start each chosen service (nothing is started unless it was picked)
		var dbs = pick( a, "databases", [] );
		if ( dbs.len() || pick( a, "container_engine" ) == "docker" ) {
			if ( arrayFind( [ "podman", "docker" ], pick( a, "container_engine" ) ) ) out.steps.append( { id: "db-engine", title: "run databases with " & a.container_engine, argv: [ "bxrig", "db", "engine", a.container_engine ] } );
		}
		for ( var db in dbs ) {
			var dargv = [ "bxrig", "db", "start", db ];
			// asking for a password needs a terminal; the answer is typed at the prompt, never saved in answers.json or put on a command line
			if ( pick( a, "database_passwords" ) == "ask" && !arrayFind( [ "redis", "couchbase", "chroma", "qdrant", "weaviate" ], db ) ) dargv.append( "--ask-password" );
			out.steps.append( { id: "db-" & db, title: "start " & db & " (local container, 127.0.0.1 only)" & ( dargv.len() > 4 ? ", asking for its password" : "" ), argv: dargv } );
		}
		// the mail catcher (a development inbox in a container): optional, so a missing container engine never stops the plan
		if ( pick( a, "mail_catcher", false ) ) out.steps.append( { id: "mail-start", title: "start the mail catcher (SMTP 127.0.0.1:1025, inbox http://127.0.0.1:8025)", argv: [ "bxrig", "mail", "start", "--yes" ], optional: true } );
		// virtual machines (containers): Windows with the version you chose, a Linux desktop called "desktop"; optional steps, so a missing KVM never stops the plan
		if ( len( vmWin ) && vmWin != "none" ) out.steps.append( { id: "vm-windows", title: "create a Windows VM (" & vmWin & "; it installs itself on the first start)", argv: [ "bxrig", "vm", "create", "windows", "--version=" & vmWin ], optional: true } );
		if ( len( vmLin ) && vmLin != "none" ) out.steps.append( { id: "vm-linux", title: "create a Linux desktop in a container (" & vmLin & ")", argv: [ "bxrig", "vm", "create", "linux", "desktop", "--tag=" & vmLin ], optional: true } );
		// AI: a keyring for the API keys, the keys you chose to type now (optional steps: skipping one never stops the plan), the
		// keys you chose to export to every shell, and the default agent
		if ( agentIds.len() ) out.steps.append( { id: "secrets-setup", title: "check for a keyring for your API keys (installs one, with libsecret and age, only if none is found)", argv: [ "bxrig", "secrets", "setup" ] } );
		// keys to type: the key of every single-provider agent you chose, plus the providers you ticked (OpenCode and others take many)
		var keyEnvs = [];
		if ( pick( a, "ai_keys" ) == "now" ) {
			var provLib = new bxrig.AiProviders();
			for ( var id in agentIds ) {
				var ag = agentLib.find( id );
				if ( !structIsEmpty( ag ) && ag.providers.len() == 1 ) { var env1 = provLib.find( ag.providers[ 1 ] ).env; if ( !arrayFind( keyEnvs, env1 ) ) keyEnvs.append( env1 ); }
			}
			for ( var pid in pick( a, "ai_providers", [] ) ) {
				var pv = provLib.find( pid );
				if ( structIsEmpty( pv ) ) out.errors.append( "ai_providers: unknown provider " & pid );
				else if ( !arrayFind( keyEnvs, pv.env ) ) keyEnvs.append( pv.env );
			}
			for ( var env in keyEnvs ) out.steps.append( { id: "key-" & env, title: "store your " & provLib.byEnv( env ).name & " API key (typed hidden; you can skip it)", argv: [ "bxrig", "secrets", "set", env ], optional: true } );
			for ( var gk in pick( a, "ai_global_keys", [] ) ) {
				if ( arrayFind( keyEnvs, gk ) ) out.steps.append( { id: "global-" & gk, title: "export " & gk & " to every shell (you chose this; every program can read it)", argv: [ "bxrig", "secrets", "global", "on", gk ], optional: true } );
			}
		}
		if ( isSet( aiDefault ) && !structIsEmpty( agentLib.find( aiDefault ) ) ) out.steps.append( { id: "ai-default", title: "make " & aiDefault & " your default coding agent", argv: [ "bxrig", "ai", "default", aiDefault ] } );
		// Local AI on llama.cpp: now (the engine, the picked models, the server, the answer check, the tune if asked) or later with
		// bxrig ai setup. Optional: a failed download never stops the plan.
		if ( pick( a, "ai_local_setup", "later" ) == "now" ) {
			var aiArgv = [ "bxrig", "ai", "setup", "--yes" ];
			if ( pick( a, "ai_local_picks", "balanced" ) == "all" ) aiArgv.append( "--picks=all" );
			if ( pick( a, "ai_local_tune", false ) == true ) aiArgv.append( "--tune" );
			out.steps.append( { id: "ai-setup", title: "set up local AI: llama.cpp, " & ( arrayFind( aiArgv, "--picks=all" ) ? "the three models picked for this machine" : "the model picked for this machine" ) & " and an embedding model (several GB; you can skip it)", argv: aiArgv, optional: true } );
		}
		// Boxy: bx-agents for BoxLang at the OS level, then the assistant itself (after the local AI, so its profile has a model).
		if ( pick( a, "boxy", "later" ) == "now" ) {
			out.steps.append( { id: "bx-agents", title: "install bx-agents for BoxLang (the agent framework Boxy is built with)", argv: [ "bxrig", "ai", "agents", "install", "--yes" ], optional: true } );
			out.steps.append( { id: "boxy", title: "make Boxy, your desktop assistant, in ~/Agents/Boxy and start it (Super+Period opens its chat)", argv: [ "bxrig", "ai", "agents", "setup", "--yes" ], optional: true } );
		}
		// Android apps with Waydroid: only when asked for (the wizard's answer defaults to no). Optional: a kernel without binder or an X11
		// session stops it with a reason, and never stops the plan.
		if ( pick( a, "android", "no" ) == "yes" ) out.steps.append( { id: "android", title: "set up Android apps with Waydroid (Google Play; downloads about 1.2 GB)", argv: [ "bxrig", "android", "setup", "--yes" ], optional: true } );
		// Vicinae also gets its theme, BxRig's actions and file search, and its server. `launcher setup` makes Vicinae the launcher and the menu,
		// so it runs first and the choices below are recorded after it (a mixed choice, such as Vicinae for menus only, keeps what you picked)
		if ( pick( a, "launcher" ) == "vicinae" || pick( a, "menu" ) == "vicinae" ) out.steps.append( { id: "launcher-setup", title: "set up Vicinae: your theme, BxRig's actions and file search", argv: [ "bxrig", "launcher", "setup" ], optional: true } );
		if ( len( pick( a, "launcher" ) ) ) out.steps.append( { id: "launcher", title: "use " & a.launcher & " as the app launcher (no shortcut is changed)", argv: [ "bxrig", "runner", "set", a.launcher ] } );
		if ( len( pick( a, "menu" ) ) ) out.steps.append( { id: "menu", title: "use " & a.menu & " for BxRig menus", argv: [ "bxrig", "runner", "menu-set", a.menu ] } );
		var gname = pick( a, "git_name" );
		var gmail = pick( a, "git_email" );
		if ( len( gname ) ) out.steps.append( { id: "git-name", title: "git user.name", argv: [ "git", "config", "--global", "user.name", gname ] } );
		if ( len( gmail ) ) out.steps.append( { id: "git-email", title: "git user.email", argv: [ "git", "config", "--global", "user.email", gmail ] } );
		// an SSH key (ssh-keygen asks for the passphrase on the terminal, so it is optional: skipping it never stops the plan)
		if ( pick( a, "ssh_key", false ) == true ) {
			var skArgv = [ "bxrig", "ssh", "key" ];
			if ( len( gmail ) ) skArgv.append( "--email=" & gmail );
			out.steps.append( { id: "ssh-key", title: "create an SSH key (ed25519; an existing key is kept; you type a passphrase or leave it empty)", argv: skArgv, optional: true } );
		}
		// the BoxLang scheduler: the update check, backups and BoxLang checks as tasks (optional: it needs BoxLang, which the toolchain step installs)
		if ( pick( a, "scheduler", false ) == true ) out.steps.append( { id: "scheduler", title: "run BxRig's timed jobs on the BoxLang scheduler (bxrig scheduler install)", argv: [ "bxrig", "scheduler", "install", "--yes" ], optional: true } );
		// sign commits and tags with that key (optional: it needs the key and git user.email, which the steps above make)
		if ( pick( a, "git_signing", false ) == true ) out.steps.append( { id: "git-signing", title: "sign your commits and tags with your SSH key (git signing on)", argv: [ "bxrig", "git", "signing", "on", "--yes" ], optional: true } );
		// the Plasma window layout of the workspace you are on (optional: it needs a running Plasma session; other workspaces start
		// with HyprKwin's own default, set in System Settings)
		if ( wantsPlasma && len( pick( a, "plasma_layout" ) ) ) {
			if ( !arrayFind( [ "dwindle", "master", "monocle", "scrolling", "stage" ], a.plasma_layout ) ) out.errors.append( "plasma_layout: unknown layout " & a.plasma_layout );
			else out.steps.append( { id: "plasma-layout", title: "use the " & a.plasma_layout & " window layout on this Plasma workspace (needs a running Plasma session)", argv: [ "bxrig", "tiling", "layout", a.plasma_layout ], optional: true } );
		}
		// NAS, remote backup targets and the backup layers (the NAS, Remote backups and Backups pages). Passwords and keys are typed in the terminal
		// by the commands themselves (--ask-password, --ask-keys), so nothing secret is in the answers; each step is optional so a missing
		// network or a wrong password never stops the rest of the plan.
		var bkTargets = [];
		if ( pick( a, "nas_use", false ) == true ) {
			var nn = lCase( trim( pick( a, "nas_name" ) ) );
			if ( !len( nn ) ) nn = "nas";
			var nhost = trim( pick( a, "nas_host" ) );
			var nproto = pick( a, "nas_protocol", "smb" );
			var nuser = trim( pick( a, "nas_user" ) );
			var nshare = trim( pick( a, "nas_share" ) );
			if ( !len( nshare ) ) nshare = "backups";
			if ( !reFind( "^[a-z][a-z0-9-]{0,30}$", nn ) ) out.errors.append( "nas_name: lower case letters, digits and dashes" );
			else if ( !len( nhost ) ) out.errors.append( "nas_host: the address of the NAS is needed" );
			else if ( nproto == "smb" && !len( nuser ) ) out.errors.append( "nas_user: SMB needs a user name" );
			else {
				out.steps.append( { id: "nas-setup", title: "install the NAS tools (cifs-utils, nfs-utils, smbclient, avahi, rsync)", argv: [ "bxrig", "nas", "setup", "--yes" ], optional: true } );
				var addArgv = [ "bxrig", "nas", "add", nn, "--host=" & nhost, "--protocol=" & nproto ];
				if ( nproto == "smb" ) { addArgv.append( "--user=" & nuser ); addArgv.append( "--ask-password" ); }
				out.steps.append( { id: "nas-add", title: "save the NAS " & nn & ( nproto == "smb" ? " (you type its password; it goes to your keyring)" : "" ), argv: addArgv, optional: true } );
				out.steps.append( { id: "nas-mount", title: "mount " & nshare & " from " & nn, argv: [ "bxrig", "nas", "mount", nn, nshare, "--yes" ], optional: true } );
				if ( pick( a, "nas_auto", true ) ) out.steps.append( { id: "nas-auto", title: "mount it by itself when something opens it", argv: [ "bxrig", "nas", "auto", "on", nn, nshare, "--yes" ], optional: true } );
				out.steps.append( { id: "nas-use", title: "use " & nn & "/" & nshare & " as a backup place", argv: [ "bxrig", "nas", "use", nn, nshare ] } );
				bkTargets.append( "nas-" & nn );
			}
		}
		var rtype = pick( a, "remote_type", "none" );
		if ( rtype != "none" ) {
			var rn2 = lCase( trim( pick( a, "remote_name" ) ) );
			if ( !len( rn2 ) ) rn2 = "cloud";
			var tArgv = [ "bxrig", "backup", "data", "target", "add", rn2, "--type=" & rtype ];
			var need = { s3: [ "bucket" ], b2: [ "bucket" ], azure: [ "container" ], gs: [ "bucket", "project", "credentials" ], sftp: [ "host", "user" ], rclone: [ "remote" ], local: [] };
			var missingRemote = "";
			for ( var f in need[ rtype ] ) {
				var rv = trim( pick( a, "remote_" & f ) );
				if ( !len( rv ) ) missingRemote = f; else tArgv.append( "--" & f & "=" & rv );
			}
			for ( var o in [ "endpoint", "region", "path" ] ) {
				var ov = trim( pick( a, "remote_" & o ) );
				if ( len( ov ) && !( o == "endpoint" && rtype != "s3" ) && !( o == "region" && rtype != "s3" ) ) tArgv.append( "--" & o & "=" & ov );
			}
			if ( rtype == "local" && !len( trim( pick( a, "remote_path" ) ) ) ) missingRemote = "path";
			if ( !reFind( "^[a-z][a-z0-9-]{0,30}$", rn2 ) ) out.errors.append( "remote_name: lower case letters, digits and dashes" );
			else if ( len( missingRemote ) ) out.errors.append( "remote_" & missingRemote & ": needed for " & rtype );
			else {
				if ( arrayFind( [ "s3", "b2", "azure" ], rtype ) ) tArgv.append( "--ask-keys" );
				out.steps.append( { id: "backup-remote", title: "add the backup place " & rn2 & " (" & rtype & ")" & ( arrayFind( [ "s3", "b2", "azure" ], rtype ) ? "; you type the access keys, they go to your keyring" : "" ), argv: tArgv, optional: true } );
				bkTargets.append( rn2 );
			}
		}
		var layers = pick( a, "backup_layers", [] );
		if ( arrayFind( layers, "data" ) > 0 ) {
			if ( !bkTargets.len() ) out.pending.append( "backup_layers: files are chosen but there is no NAS or remote place yet; add one with bxrig nas use or bxrig backup data target add" );
			for ( var bt in bkTargets ) out.steps.append( { id: "backup-init-" & bt, title: "create the encrypted backup repository on " & bt, argv: [ "bxrig", "backup", "data", "init", bt, "--yes" ], optional: true } );
			if ( bkTargets.len() ) out.steps.append( { id: "backup-default", title: "make " & bkTargets[ 1 ] & " the default backup place", argv: [ "bxrig", "backup", "data", "default", bkTargets[ 1 ] ], optional: true } );
			var sched = pick( a, "backup_schedule", "daily" );
			if ( sched != "off" && bkTargets.len() ) out.steps.append( { id: "backup-schedule", title: "back up my files " & sched, argv: [ "bxrig", "backup", "data", "schedule", sched, "--yes" ], optional: true } );
		}
		if ( arrayFind( layers, "snapshots" ) > 0 ) out.steps.append( { id: "backup-snapshots", title: "set up system snapshots (snapper on Btrfs, Timeshift elsewhere)", argv: [ "bxrig", "backup", "snapshots", "setup", "--yes" ], optional: true } );
		if ( structKeyExists( a, "backup_layers" ) && arrayFind( layers, "config" ) == 0 ) out.steps.append( { id: "backup-config-off", title: "do not take a config snapshot before updates", argv: [ "bxrig", "backup", "config", "auto", "off" ] } );
		// laptop power tools (power-profiles-daemon, upower): `power setup` does nothing on a machine without a battery, so this is safe everywhere
		if ( pick( a, "power_setup", false ) ) out.steps.append( { id: "power-setup", title: "set up laptop power tools (only when a battery is found)", argv: [ "bxrig", "power", "setup" ], optional: true } );
		// update channel and the daily update notification
		if ( len( pick( a, "update_channel" ) ) ) out.steps.append( { id: "update-channel", title: "use the " & a.update_channel & " update channel", argv: [ "bxrig", "update", "channel", a.update_channel ] } );
		if ( pick( a, "update_notifications", false ) ) out.steps.append( { id: "update-notifications", title: "check for updates daily and notify", argv: [ "bxrig", "update", "notifications", "on" ], optional: true } );
		// night shift, trackpad gestures and the AirPlay receiver (optional: a failure is skipped)
		if ( pick( a, "night_shift", false ) ) out.steps.append( { id: "night-shift", title: "turn on night shift (sunset and sunrise from your time zone)", argv: [ "bxrig", "nightshift", "on" ], optional: true } );
		// Apple Magic and Logitech helpers (solaar, upower, libinput-gestures): `input offer` does nothing when `detect` finds no device; no answer means none
		var inputChoice = pick( a, "input_devices", "none" );
		if ( arrayFind( [ "detect", "apple", "logitech", "both" ], inputChoice ) ) out.steps.append( { id: "input-devices", title: "install helpers for " & ( inputChoice == "detect" ? "the Apple and Logitech devices found (Solaar, upower, trackpad gestures)" : inputChoice == "both" ? "Apple and Logitech devices" : inputChoice & " devices" ), argv: [ "bxrig", "input", "offer", "--for=" & inputChoice ], optional: true } );
		if ( wantsHypr && pick( a, "gestures", false ) ) out.steps.append( { id: "gestures", title: "set up three-finger trackpad gestures", argv: [ "bxrig", "input", "gestures" ], optional: true } );
		if ( pick( a, "airplay", false ) ) out.steps.append( { id: "airplay", title: "start the AirPlay receiver", argv: [ "bxrig", "airplay", "on" ], optional: true } );
		// the Plasma panel layout (optional: it is applied now when Plasma is running, else at your next Plasma login) and the desktop count
		if ( wantsPlasma && len( pick( a, "plasma_panels" ) ) ) {
			var deskCount = pick( a, "workspaces", 4 );
			if ( a.plasma_panels == "bxrig" ) {
				var ppArgv = [ "bxrig", "plasma", "panels", "apply", "--desktops=" & deskCount ];
				if ( !pick( a, "plasma_weather", true ) ) ppArgv.append( "--without-weather" );
				if ( pick( a, "plasma_agenda", false ) ) ppArgv.append( "--agenda" );
				out.steps.append( { id: "plasma-panels", title: "apply the BxRig Plasma panel layout (backed up first; at your next Plasma login if Plasma is not running)", argv: ppArgv, optional: true } );
			} else out.steps.append( { id: "plasma-desktops", title: "use " & deskCount & " virtual desktops", argv: [ "bxrig", "plasma", "desktops", deskCount ], optional: true } );
		}
		// keyboard layouts for Plasma (Hyprland takes them through `setup hyprland --layouts`)
		if ( wantsPlasma && pick( a, "layouts", [] ).len() ) out.steps.append( { id: "plasma-keyboard", title: "set the Plasma keyboard layouts (" & a.layouts.toList( ", " ) & "; takes effect at your next login)", argv: [ "bxrig", "setup", "keyboard", "--layouts=" & a.layouts.toList( "," ) ] } );
		var sess = session( a );
		if ( len( sess ) ) out.steps.append( { id: "session", title: "start on " & ( sess == "hyprland" ? "Hyprland" : "KDE Plasma" ) & " at the login screen", argv: [ "bxrig", "session", "set", sess ], optional: true } );
		if ( !wantsHypr ) for ( var key in hyprlandKeys() ) {
			if ( key == "layouts" && wantsPlasma ) continue;
			if ( structKeyExists( a, key ) && isSet( a[ key ] ) ) out.pending.append( key );
		}
		// your own dotfiles go last so they win over the starter configs; replacing a file you have is asked at the prompt
		if ( len( pick( a, "dotfiles_repo" ) ) ) out.steps.append( { id: "dotfiles", title: "apply your dotfiles from " & a.dotfiles_repo & " (method detected; you are asked before any existing file is replaced)", argv: [ "bxrig", "dotfiles", "apply", a.dotfiles_repo ] } );
		for ( var key in pendingKeys() ) {
			if ( structKeyExists( a, key ) && isSet( a[ key ] ) ) out.pending.append( key );
		}
		return out;
	}
}
