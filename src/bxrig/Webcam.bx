// `bxrig webcam toggle|status`: a small live preview of your webcam (mpv on /dev/video0), started or ended by one key.
//   toggle   start the preview, or end it when it runs. The window class is bxrig-webcam; the Hyprland module floats and sizes it.
//   status   whether the preview runs
// Acts at once and changes no file (no --yes). --dry-run prints the argv and starts nothing.
// Exit: 0 done, 4 precondition (mpv missing, no /dev/video0), 6 the preview did not start or stop.
class Webcam {
	function init( cli, runner = "", device = "/dev/video0" ) {
		variables.cli = arguments.cli;
		variables.proc = new bxrig.util.Proc( arguments.runner );
		variables.device = arguments.device;
		return this;
	}

	function windowClass() { return "bxrig-webcam"; }

	// The preview command (an argv array).
	function argv() {
		return [ "mpv", "--wayland-app-id=" & windowClass(), "--title=" & windowClass(), "--profile=low-latency", "--untimed", "--no-audio", "--no-osc", "av://v4l2:" & variables.device ];
	}

	// ---- the bubble in a screen recording ----
	function corners() { return [ "bottom-right", "bottom-left", "top-right", "top-left" ]; }
	function sizes() { return [ "small", "medium", "large" ]; }
	function overlayTitle() { return "bxrig-webcam-overlay"; }
	function overlayClass( corner, size ) { return "bxrig-webcam-" & arguments.corner & "-" & arguments.size; }

	// Width and height (4:3) as Hyprland expressions, a share of the monitor height so it looks the same on any screen.
	function overlaySize( size ) {
		if ( arguments.size == "small" ) return { w: "(monitor_h*4/15)", h: "(monitor_h/5)" };
		if ( arguments.size == "large" ) return { w: "(monitor_h*4/9)", h: "(monitor_h/3)" };
		return { w: "(monitor_h*16/45)", h: "(monitor_h*4/15)" };
	}

	// One Hyprland window rule per corner and size (written into the BxRig Hyprland module), 40 px from the edges.
	function overlayRules() {
		var out = [];
		for ( var c in corners() ) for ( var z in sizes() ) {
			var sz = overlaySize( z );
			var x = find( "right", c ) ? '"(monitor_w-' & mid( sz.w, 2, len( sz.w ) - 2 ) & '-40)"' : "40";
			var y = find( "bottom", c ) ? '"(monitor_h-' & mid( sz.h, 2, len( sz.h ) - 2 ) & '-40)"' : "40";
			out.append( 'hl.window_rule({ name = "' & overlayClass( c, z ) & '", match = { class = "^' & overlayClass( c, z ) & '$" }, float = true, pin = true, no_initial_focus = true, no_dim = true, size = { "' & sz.w & '", "' & sz.h & '" }, move = { ' & x & ', ' & y & ' } })' );
		}
		return out;
	}

	// The bubble: mpv without a border, its app id choosing the corner and size rule.
	function overlayArgv( corner, size ) {
		return [ "mpv", "--wayland-app-id=" & overlayClass( arguments.corner, arguments.size ), "--title=" & overlayTitle(), "--profile=low-latency", "--untimed", "--no-audio", "--no-osc", "--no-border", "--osd-level=0", "av://v4l2:" & variables.device ];
	}

	function overlayPattern() { return "mpv .*--title=" & overlayTitle(); }

	// The pattern pgrep and pkill match against the command line.
	function pattern() { return "mpv .*--title=" & windowClass(); }

	function running() { return variables.proc.exec( [ "pgrep", "-f", "--", pattern() ], 10 ).exitCode == 0; }

	function toggle( dryRun, asJson ) {
		var cmd = "webcam toggle";
		if ( running() ) {
			if ( arguments.dryRun ) return variables.cli.say( cmd, "ok", { running: true, command: [ "pkill", "-f", "--", pattern() ] }, arguments.asJson, [ "Dry run: the preview would be ended.", "Nothing was stopped." ], true );
			var k = variables.proc.exec( [ "pkill", "-f", "--", pattern() ], 10 );
			if ( k.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: "could not end the preview" }, arguments.asJson, [ "error: could not end the webcam preview" ] );
			return variables.cli.say( cmd, "ok", { running: false, stopped: true }, arguments.asJson, [ "The webcam preview was ended." ] );
		}
		if ( !variables.proc.has( "mpv" ) ) return variables.cli.say( cmd, "precondition", { error: "mpv is not installed" }, arguments.asJson, [ "error: mpv is not installed. Install: bxrig install mpv" ] );
		if ( !fileExists( variables.device ) ) return variables.cli.say( cmd, "precondition", { error: "no webcam at " & variables.device }, arguments.asJson, [ "error: no webcam found at " & variables.device ] );
		var data = { running: true, command: argv() };
		if ( arguments.dryRun ) return variables.cli.say( cmd, "ok", data, arguments.asJson, [ "Dry run: " & argv().toList( " " ), "Nothing was started." ], true );
		var r = variables.proc.detach( argv() );
		if ( r.exitCode != 0 ) return variables.cli.say( cmd, "failed", { error: trim( r.output ) }, arguments.asJson, [ "error: could not start the webcam preview" ] );
		return variables.cli.say( cmd, "ok", data, arguments.asJson, [ "The webcam preview is on. Press the key again to end it." ] );
	}

	function status( asJson ) {
		var on = running();
		return variables.cli.say( "webcam status", "ok", { running: on }, arguments.asJson, [ on ? "The webcam preview is on." : "The webcam preview is off." ] );
	}
}
