// Where things live: the one answer for every environment variable and directory (docs/reference/config-files.md).
// Precedence everywhere: BXRIG_*_HOME (tests and power users), then XDG_*_HOME, then the default under $HOME.
// Two kinds of method: the XDG base directories (xdgConfig, xdgData, xdgState, xdgCache: shared with other programs, e.g. ~/.config/hypr)
// and BxRig's own folders inside them (config, data, state, cache). `sub` is appended with a slash when given.
// `new bxrig.util.Env( { HOME: "/h", BXRIG_CONFIG_HOME: "/c" } )` replaces the real environment in tests.
class Env {
	function init( over = {} ) {
		variables.over = arguments.over ?: {};
		return this;
	}

	// One variable, or the fallback when it is unset or empty.
	function get( name, fallback = "" ) {
		var v = structKeyExists( variables.over, arguments.name ) ? variables.over[ arguments.name ] : getSystemSetting( arguments.name, "" );
		return len( v ) ? v : arguments.fallback;
	}

	// Every environment variable BxRig reads, by the short name the code uses (Env.named( "powerDir" )). One list, so a typo cannot read a variable nobody sets.
	// BXRIG_* ones are test and power-user seams; the rest belong to the system.
	function names() {
		var n = {};
		n.adoptiumApi = "BXRIG_ADOPTIUM_API";
		n.aiCatalog = "BXRIG_AI_CATALOG";
		n.hfUrl = "BXRIG_HF_URL";
		n.appsDirs = "BXRIG_APPS_DIRS";
		n.aurUrl = "BXRIG_AUR_URL";
		n.baseUrl = "BXRIG_BASE_URL";
		n.bootloader = "BXRIG_BOOTLOADER";
		n.cacheHome = "BXRIG_CACHE_HOME";
		n.cmdline = "BXRIG_CMDLINE";
		n.configHome = "BXRIG_CONFIG_HOME";
		n.dashboardFile = "BXRIG_DASHBOARD_FILE";
		n.dataHome = "BXRIG_DATA_HOME";
		n.distro = "BXRIG_DISTRO";
		n.desktop = "BXRIG_DESKTOP";
		n.desktopDirs = "BXRIG_DESKTOP_DIRS";
		n.driDir = "BXRIG_DRI_DIR";
		n.etc = "BXRIG_ETC";
		n.geoclueDir = "BXRIG_GEOCLUE_DIR";
		n.hidDrivers = "BXRIG_HID_DRIVERS";
		n.icons = "BXRIG_ICONS";
		n.iconTheme = "BXRIG_ICON_THEME";
		n.images = "BXRIG_IMAGES";
		n.imageAllowHttp = "BXRIG_IMAGE_ALLOW_HTTP";
		n.imageCapKb = "BXRIG_IMAGE_CAP_KB";
		n.imageMaxTime = "BXRIG_IMAGE_MAX_TIME";
		n.ipv6Dir = "BXRIG_IPV6_DIR";
		n.javaDir = "BXRIG_JAVA_DIR";
		n.javaDownloadUrl = "BXRIG_JAVA_DOWNLOAD_URL";
		n.javaSystemDir = "BXRIG_JAVA_SYSTEM_DIR";
		n.kvmDevice = "BXRIG_KVM_DEVICE";
		n.lockdown = "BXRIG_LOCKDOWN";
		n.logindDir = "BXRIG_LOGIND_DIR";
		n.mailApi = "BXRIG_MAIL_API";
		n.maxMapCountFile = "BXRIG_MAX_MAP_COUNT_FILE";
		n.meminfo = "BXRIG_MEMINFO";
		n.meminfoFile = "BXRIG_MEMINFO_FILE";
		n.modprobeDir = "BXRIG_MODPROBE_DIR";
		n.modulesDir = "BXRIG_MODULES_DIR";
		n.nasCredDir = "BXRIG_NAS_CRED_DIR";
		n.nasHome = "BXRIG_NAS_HOME";
		n.nasReach = "BXRIG_NAS_REACH";
		n.nowEpoch = "BXRIG_NOW_EPOCH";
		n.menuFacts = "BXRIG_MENU_FACTS";
		n.osRelease = "BXRIG_OS_RELEASE";
		n.pciDevices = "BXRIG_PCI_DEVICES";
		n.pacmanLog = "BXRIG_PACMAN_LOG";
		n.pamDir = "BXRIG_PAM_DIR";
		n.powerDir = "BXRIG_POWER_DIR";
		n.pubkeyFile = "BXRIG_PUBKEY_FILE";
		n.rootFs = "BXRIG_ROOT_FS";
		n.sddmState = "BXRIG_SDDM_STATE";
		n.sdkmanApi = "BXRIG_SDKMAN_API";
		n.sdkmanDir = "BXRIG_SDKMAN_DIR";
		n.sdkmanInstaller = "BXRIG_SDKMAN_INSTALLER";
		n.self = "BXRIG_SELF";
		n.sessionDirs = "BXRIG_SESSION_DIRS";
		n.shareDir = "BXRIG_SHARE_DIR";
		n.skillsDir = "BXRIG_SKILLS_DIR";
		n.skillsUrl = "BXRIG_SKILLS_URL";
		n.stateHome = "BXRIG_STATE_HOME";
		n.swaps = "BXRIG_SWAPS";
		n.sysHid = "BXRIG_SYS_HID";
		n.sysInput = "BXRIG_SYS_INPUT";
		n.sysModule = "BXRIG_SYS_MODULE";
		n.sysPower = "BXRIG_SYS_POWER";
		n.sudoersDir = "BXRIG_SUDOERS_DIR";
		n.systemdDir = "BXRIG_SYSTEMD_DIR";
		n.systemdRunDir = "BXRIG_SYSTEMD_RUN_DIR";
		n.timelineFile = "BXRIG_TIMELINE_FILE";
		n.ttyIn = "BXRIG_TTY_IN";
		n.u2fFile = "BXRIG_U2F_FILE";
		n.udevDir = "BXRIG_UDEV_DIR";
		n.userUnitDir = "BXRIG_USER_UNIT_DIR";
		n.videos = "BXRIG_VIDEOS";
		n.vmNoWait = "BXRIG_VM_NO_WAIT";
		n.vmSkipKvmCheck = "BXRIG_VM_SKIP_KVM_CHECK";
		n.zoneinfo = "BXRIG_ZONEINFO";
		n.home = "HOME";
		n.hyprlandInstanceSignature = "HYPRLAND_INSTANCE_SIGNATURE";
		n.javaHome = "JAVA_HOME";
		n.boxlangHome = "BOXLANG_HOME";
		n.matchboxHome = "MATCHBOX_HOME";
		n.noColor = "NO_COLOR";
		n.nvmDir = "NVM_DIR";
		n.pwd = "PWD";
		n.shell = "SHELL";
		n.tz = "TZ";
		n.user = "USER";
		n.xdgCacheHome = "XDG_CACHE_HOME";
		n.xdgConfigDirs = "XDG_CONFIG_DIRS";
		n.xdgConfigHome = "XDG_CONFIG_HOME";
		n.xdgCurrentDesktop = "XDG_CURRENT_DESKTOP";
		n.xdgDataHome = "XDG_DATA_HOME";
		n.xdgMenuPrefix = "XDG_MENU_PREFIX";
		n.xdgRuntimeDir = "XDG_RUNTIME_DIR";
		n.xdgSessionId = "XDG_SESSION_ID";
		n.xdgSessionType = "XDG_SESSION_TYPE";
		n.xdgStateHome = "XDG_STATE_HOME";
		return n;
	}

	// The variable name of a short name; an unknown short name throws.
	function nameOf( id ) {
		var n = names();
		if ( !structKeyExists( n, arguments.id ) ) throw( type = "Env.name", message = "Unknown environment variable id: " & arguments.id );
		return n[ arguments.id ];
	}

	// One variable by short name, or the fallback when it is unset or empty.
	function named( id, fallback = "" ) {
		return get( nameOf( arguments.id ), arguments.fallback );
	}

	function home() {
		return get( "HOME", "" );
	}

	// The path of BxRig itself (BXRIG_SELF), as Proc.selfPath().
	function self() {
		return get( "BXRIG_SELF", "bxrig" );
	}

	function join( base, sub ) {
		return len( arguments.sub ) ? arguments.base & "/" & arguments.sub : arguments.base;
	}

	// ~/.config (BXRIG_CONFIG_HOME, then XDG_CONFIG_HOME): where hypr, nvim, systemd and the rest keep files.
	function xdgConfig( sub = "" ) {
		return join( get( "BXRIG_CONFIG_HOME", get( "XDG_CONFIG_HOME", home() & "/.config" ) ), arguments.sub );
	}

	// ~/.local/share (XDG_DATA_HOME): desktop entries, icons. BXRIG_DATA_HOME does not apply here; it names BxRig's own folder (data()).
	function xdgData( sub = "" ) {
		return join( get( "XDG_DATA_HOME", home() & "/.local/share" ), arguments.sub );
	}

	// ~/.local/state (BXRIG_STATE_HOME, then XDG_STATE_HOME). BxRig's own folder is state().
	function xdgState( sub = "" ) {
		return join( get( "BXRIG_STATE_HOME", get( "XDG_STATE_HOME", home() & "/.local/state" ) ), arguments.sub );
	}

	// ~/.cache (XDG_CACHE_HOME). BxRig's own folder is cache().
	function xdgCache( sub = "" ) {
		return join( get( "XDG_CACHE_HOME", home() & "/.cache" ), arguments.sub );
	}

	// BxRig's own settings folder: ~/.config/bxrig
	function config( sub = "" ) {
		return join( xdgConfig( "bxrig" ), arguments.sub );
	}

	// BxRig's own data folder: BXRIG_DATA_HOME, else ~/.local/share/bxrig (databases, VMs, secrets files, dotfile clones).
	function data( sub = "" ) {
		return join( get( "BXRIG_DATA_HOME", home() & "/.local/share/bxrig" ), arguments.sub );
	}

	// BxRig's own state folder: ~/.local/state/bxrig (journal, backups)
	function state( sub = "" ) {
		return join( xdgState( "bxrig" ), arguments.sub );
	}

	// BxRig's own cache folder: BXRIG_CACHE_HOME, else $XDG_CACHE_HOME/bxrig, else ~/.cache/bxrig
	function cache( sub = "" ) {
		return join( get( "BXRIG_CACHE_HOME", len( get( "XDG_CACHE_HOME", "" ) ) ? get( "XDG_CACHE_HOME", "" ) & "/bxrig" : home() & "/.cache/bxrig" ), arguments.sub );
	}
}
