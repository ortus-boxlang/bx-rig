// Small string and struct helpers that used to be copied into many classes. No state.
class Text {
	// A new struct with the keys of `base`, then those of `extra` (extra wins).
	function merge( base, extra ) {
		var out = {};
		for ( var k in structKeyArray( arguments.base ) ) out[ k ] = arguments.base[ k ];
		for ( var k in structKeyArray( arguments.extra ) ) out[ k ] = arguments.extra[ k ];
		return out;
	}

	// `s` cut or padded with spaces to exactly `w` columns; text that does not fit loses its last column to a space.
	function pad( s, w ) {
		var t = arguments.s & "";
		return len( t ) >= arguments.w ? left( t, max( 0, arguments.w - 1 ) ) & " " : t & repeatString( " ", arguments.w - len( t ) );
	}

	// `s` right-aligned in `w` columns (never cut).
	function padLeft( s, w ) {
		var t = arguments.s & "";
		return len( t ) >= arguments.w ? t : repeatString( " ", arguments.w - len( t ) ) & t;
	}

	// The lines of a text (split on newlines, empty lines kept), trimmed of a trailing carriage return.
	function lines( s ) {
		var out = [];
		for ( var l in listToArray( arguments.s, chr( 10 ), true ) ) out.append( reReplace( l, chr( 13 ) & "$", "" ) );
		return out;
	}

	// The last `n` non-empty lines of a command's output, trimmed, joined with newlines and cut to the last `maxChars` characters: the real error text of a failed step.
	function tail( s, n = 5, maxChars = 800 ) {
		var keep = [];
		for ( var l in lines( arguments.s ) ) if ( len( trim( l ) ) ) keep.append( trim( l ) );
		var from = max( 1, keep.len() - arguments.n + 1 );
		var out = [];
		for ( var i = from; i <= keep.len(); i++ ) out.append( keep[ i ] );
		var t = out.toList( chr( 10 ) );
		return len( t ) > arguments.maxChars ? "..." & right( t, arguments.maxChars ) : t;
	}

	// The line that says why a command failed: the first line that starts with "error", "fatal" or "E:" (any case), else the last line that is
	// not empty. "" for no text; at most 220 characters.
	function reason( s ) {
		var pick = "";
		var last = "";
		for ( var l in lines( arguments.s ) ) {
			var t = trim( l );
			if ( !len( t ) ) continue;
			last = t;
			if ( !len( pick ) && reFindNoCase( "^(error|fatal|E:)", t ) ) pick = t;
		}
		var r = len( pick ) ? pick : last;
		return len( r ) > 220 ? left( r, 219 ) & "…" : r;
	}

	function nl() {
		return chr( 10 );
	}
}
