// Running programs: the one place that starts a process. Argument arrays only, never a shell string (COMMAND-CONTRACT rule 9).
// An injected runner (a function( argv, timeout )) replaces the real process in tests; share it with `proc.runner()`.
class Proc {
	function init( runner = "" ) {
		variables.custom = arguments.runner ?: "";
		return this;
	}

	// The injected runner, or "" when commands run for real.
	function runner() {
		return variables.custom;
	}

	// Runs one argv (the first word is the program) and may throw when it cannot start. Prefer exec().
	function raw( argv, timeout = 30 ) {
		if ( !isSimpleValue( variables.custom ) ) return variables.custom( arguments.argv, arguments.timeout );
		var rest = [];
		for ( var i = 2; i <= arguments.argv.len(); i++ ) rest.append( arguments.argv[ i ] );
		return systemExecute( arguments.argv[ 1 ], rest, arguments.timeout, true );
	}

	// Runs one argv and never throws: { exitCode, output, timeout }. A program that cannot start gives exit 127 and the reason as output.
	function exec( argv, timeout = 30 ) {
		try {
			return raw( arguments.argv, arguments.timeout );
		} catch ( any e ) {
			return { exitCode: 127, timeout: false, output: e.message };
		}
	}

	// Why a run failed, for people: the last lines of what it printed, then of its error stream (the real error text; a custom runner may have no error stream).
	function why( r ) {
		var text = ( structKeyExists( arguments.r, "output" ) ? arguments.r.output & "" : "" ) & chr( 10 ) & ( structKeyExists( arguments.r, "error" ) ? arguments.r.error & "" : "" );
		return new bxrig.util.Text().tail( text );
	}

	// True when `name` is on the PATH (`command -v`, with the name passed as an argument, not pasted into a shell string).
	function has( name ) {
		return exec( [ "sh", "-c", 'command -v "$1"', "_", arguments.name ], 10 ).exitCode == 0;
	}

	// True when `name --version` runs and exits 0. Only for the places that really ask whether a tool works; "installed" is has().
	function works( name ) {
		return exec( [ arguments.name, "--version" ], 10 ).exitCode == 0;
	}

	// Starts one argv in the background, detached from this process (setsid, output discarded). Returns the result of the starter, not of the program.
	function detach( argv ) {
		var run = [ "sh", "-c", 'setsid "$@" >/dev/null 2>&1 &', "_" ];
		for ( var p in arguments.argv ) run.append( p );
		return exec( run, 10 );
	}

	// True when the effective user is root (uid 0).
	function isRoot() {
		var r = exec( [ "id", "-u" ], 10 );
		return r.exitCode == 0 && trim( r.output ) == "0";
	}

	// Runs a program with arguments: { exitCode, output, timeout }. Never throws.
	function run( program, args = [], timeout = 30 ) {
		var argv = [ arguments.program ];
		for ( var a in arguments.args ) argv.append( a );
		return exec( argv, arguments.timeout );
	}

	// `bxrig ARGS --json` -> its `data` struct, or {} when it fails or does not answer with JSON.
	function selfData( args = [], timeout = 120 ) {
		var a = [];
		for ( var x in arguments.args ) a.append( x );
		a.append( "--json" );
		try {
			var j = jsonDeserialize( self( a, arguments.timeout ).output );
			return structKeyExists( j, "data" ) && isStruct( j.data ) ? j.data : {};
		} catch ( any e ) { return {}; }
	}

	// The path or name used to run BxRig itself (BXRIG_SELF, else `bxrig` from the PATH).
	function selfPath() {
		return new bxrig.util.Env().named( "self", "bxrig" );
	}

	// Runs BxRig itself with the given arguments (an array). Never throws.
	function self( args = [], timeout = 1800 ) {
		var argv = [ selfPath() ];
		for ( var a in arguments.args ) argv.append( a );
		return exec( argv, arguments.timeout );
	}

	// Starts one argv in the background without a new session (so `sudo` keeps the ticket you just made): its output is added to logFile, its
	// stdin is closed, its exit code is written to statusFile when it ends, and pidFile gets the pid of the runner. Returns the starter's result.
	// With `askpass` (the path of a helper script) the command runs in a new session with no terminal and SUDO_ASKPASS set: a `sudo` inside it then
	// reads its password from the helper instead of the terminal, so it never prompts on a screen that owns the terminal (see util.Sudo).
	function startTo( argv, logFile, statusFile, pidFile, askpass = "" ) {
		var run = [ "sh", "-c", 'log=$1; st=$2; pf=$3; ap=$4; shift 4; if [ -n "$ap" ]; then export SUDO_ASKPASS="$ap"; set -- setsid -w "$@"; fi; ( "$@" </dev/null >>"$log" 2>&1; echo $? >"$st.tmp"; mv -f "$st.tmp" "$st" ) </dev/null >/dev/null 2>&1 & echo $! >"$pf"', "_", arguments.logFile, arguments.statusFile, arguments.pidFile, arguments.askpass ];
		for ( var p in arguments.argv ) run.append( p );
		return exec( run, 15 );
	}

	// Stops a process and everything it started (TERM, children first). Never throws.
	function killTree( pid ) {
		return exec( [ "sh", "-c", 'kt() { for c in $(pgrep -P "$1" 2>/dev/null); do kt "$c"; done; kill -TERM "$1" 2>/dev/null; }; kt "$1"', "_", toString( arguments.pid ) ], 10 );
	}

	// The command line of the deepest child of a process (what it is really doing now: pacman, makepkg, curl, a sudo waiting for a password), "" if it is gone.
	function leafCommand( pid ) {
		var r = exec( [ "sh", "-c", 'p=$1; while c=$(pgrep -P "$p" 2>/dev/null | head -n 1); [ -n "$c" ]; do p=$c; done; tr "\\0" " " < /proc/$p/cmdline 2>/dev/null', "_", toString( arguments.pid ) ], 10 );
		return r.exitCode == 0 ? trim( r.output ) : "";
	}

	// True when a process is still running.
	function alive( pid ) {
		return exec( [ "kill", "-0", toString( arguments.pid ) ], 5 ).exitCode == 0;
	}
}
