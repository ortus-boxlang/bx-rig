// `bxrig keys check|apply`: puts the shared shortcut table on this machine.
// Files (xremap config, Hyprland binds) go through the config service (backup, journal, drift).
// Plasma's Log Out shortcut is a kglobalshortcutsrc setting, so it is read and written with kreadconfig6/kwriteconfig6.
//
// Exit codes: check 0 all in place, 1 something missing or drifted; apply 0 done, 2 no --yes, 4 precondition, 8 drift without --force, 9 write failed.
class KeysService {
	function init( cli, runner = "", quiet = false ) {
		variables.cli = arguments.cli;
		variables.quiet = arguments.quiet;
		variables.inst = new bxrig.Installer( arguments.runner );
		variables.config = new bxrig.ConfigService().quiet( arguments.quiet );
		variables.sc = new bxrig.Shortcuts();
		return this;
	}

	// Reads one kglobalshortcutsrc value, or "" when unset or the tool is missing.
	function plasmaValue( s ) {
		try {
			var r = variables.inst.proc().exec( [ "kreadconfig6", "--file", "kglobalshortcutsrc", "--group", s.group, "--key", s.key ], 15 );
			return r.exitCode == 0 ? trim( r.output ) : "";
		} catch ( any e ) {
			return "";
		}
	}

	// State of every managed piece: [ { name, target, state } ]. state: clean, missing, outdated, drifted, blocked; Plasma: clean|missing|drifted|skipped (no kwriteconfig6).
	function states() {
		var out = [];
		for ( var e in variables.sc.entries( variables.config.cfgHome() ) ) out.append( { name: e.name, target: e.target, state: variables.config.configState( e ) } );
		out.append( hyprlandLoad() );
		for ( var s in variables.sc.plasmaSettings() ) {
			var st = "skipped";
			if ( variables.inst.hasCommand( "kreadconfig6" ) ) {
				var v = plasmaValue( s );
				st = !len( v ) ? "missing" : ( v == s.value ? "clean" : "drifted" );
			}
			out.append( { name: "plasma:" & s.key, target: "kglobalshortcutsrc [" & s.group & "]", state: st } );
		}
		return out;
	}

	// Whether the user's hyprland.lua loads the managed module: clean, not-loaded, or skipped (no hyprland.lua, e.g. a Plasma-only machine).
	// `keys apply --yes` adds the one line when it is missing (hyprlandAdd); the rest of the file is never touched. A commented line does not count.
	function hyprlandLoad() {
		var file = variables.config.cfgHome() & "/hypr/hyprland.lua";
		var st = "skipped";
		if ( fileExists( file ) ) {
			st = "not-loaded";
			for ( var line in listToArray( fileRead( file ), chr( 10 ), true ) ) {
				var t = trim( line );
				if ( t == variables.sc.hyprlandLoadLine() || t == replace( variables.sc.hyprlandLoadLine(), '"', "'", "all" ) ) { st = "clean"; break; }
			}
		}
		return { name: "hyprland.lua", target: file, state: st };
	}

	// Adds the load line to the end of the user's hyprland.lua, once, with a comment saying where it came from. The file is backed up first
	// (~/.local/state/bxrig/backups/hyprland.lua) and written as it was, byte for byte, plus the block. Returns an exit code.
	function hyprlandAdd( yes, dryRun ) {
		var hl = hyprlandLoad();
		var text = fileRead( hl.target );
		var block = "-- BxRig: loads ~/.config/hypr/bxrig.lua (shortcuts, the Noctalia bar and rules). Added by `bxrig keys apply`; delete these two lines to stop." & chr( 10 ) & variables.sc.hyprlandLoadLine() & chr( 10 );
		var content = text & ( len( text ) && right( text, 1 ) != chr( 10 ) ? chr( 10 ) : "" ) & ( len( text ) ? chr( 10 ) : "" ) & block;
		var entry = { name: "hyprland.lua", target: hl.target, mode: variables.config.modeOf( hl.target ), content: content, rc: true };
		return variables.config.configWrite( entry, content, "add the load line to", yes, dryRun );
	}

	// `keys check`
	function check( asJson ) {
		var rows = states();
		var bad = rows.filter( function( r ) { return r.state != "clean" && r.state != "skipped"; } );
		var code = bad.len() ? 1 : 0;
		if ( asJson ) { println( variables.cli.envelope( "keys check", code, { items: rows } ) ); return code; }
		for ( var r in rows ) println( r.name & ": " & r.state & " (" & r.target & ")" );
		return code;
	}

	// `keys apply`
	function apply( yes, dryRun, force, asJson ) {
		if ( variables.inst.isRoot() ) {
			if ( asJson ) println( variables.cli.envelope( "keys apply", 4, { errors: [ "Run as a regular user" ] } ) );
			else progress( "error: Run as a regular user" );
			return new bxrig.util.Exit().precondition();
		}
		if ( asJson ) { variables.quiet = true; variables.config.quiet( true ); }
		// With no keystyle.json the style is read from whether the xremap unit exists (an old install had the Mac keys
		// then). This apply writes that unit, so the style in effect now is saved first; otherwise the next run would read
		// Mac and find every file it just wrote outdated.
		var keyStyle = new bxrig.KeyStyle();
		if ( yes && !dryRun && !fileExists( keyStyle.file() ) ) keyStyle.write( {} );
		var worst = 0;
		var changed = false;
		for ( var e in variables.sc.entries( variables.config.cfgHome() ) ) {
			if ( variables.config.configState( e ) != "clean" ) changed = true;
			var c = variables.config.configApply( e, yes, dryRun, force );
			if ( c != 0 ) worst = max( worst, c );
		}
		if ( variables.inst.hasCommand( "kwriteconfig6" ) ) {
			for ( var s in variables.sc.plasmaSettings() ) {
				if ( plasmaValue( s ) == s.value ) { progress( "plasma:" & s.key & ": unchanged" ); continue; }
				progress( "set plasma:" & s.key & " -> " & s.value );
				if ( !yes ) { worst = max( worst, 2 ); continue; }
				if ( dryRun ) continue;
				var r = variables.inst.proc().exec( [ "kwriteconfig6", "--file", "kglobalshortcutsrc", "--group", s.group, "--key", s.key, s.value ], 15 );
				if ( r.exitCode != 0 ) { progress( "plasma:" & s.key & ": kwriteconfig6 failed" ); worst = max( worst, 9 ); }
			}
		} else progress( "plasma: kwriteconfig6 not found, skipped (not a Plasma machine)" );
		if ( worst == 2 ) progress( "Nothing changed. Pass --yes to proceed." );
		if ( hyprlandLoad().state == "not-loaded" ) {
			var hc = hyprlandAdd( yes, dryRun );
			if ( hc != 0 ) worst = max( worst, hc );
		}
		// a running xremap reads its config only at start: when a key file changed, restart it so the keys (and the Alt and Win swap) take effect now
		if ( worst == 0 && yes && !dryRun && changed ) {
			var sd = new bxrig.util.Systemd( variables.inst.proc() );
			if ( sd.isActive( "xremap", true ) ) {
				var rr = variables.inst.proc().exec( sd.argv( "restart", [ "xremap.service" ], true ), 30 );
				progress( rr.exitCode == 0 ? "xremap restarted: the new keys are live" : "xremap did not restart (systemctl --user restart xremap)" );
			}
		}
		if ( worst == 0 && yes && !dryRun ) progress( "Note: xremap and the desktop pick the new keys up at their next restart or login. Hyprland loads the module through the line in hyprland.lua (reload it: hyprctl reload)." );
		if ( asJson ) println( variables.cli.envelope( "keys apply", worst, { applied: worst == 0 }, dryRun ) );
		return worst;
	}

	// Prints one progress line unless the caller asked for quiet.
	function progress( text ) {
		if ( !variables.quiet ) println( arguments.text );
	}
}
