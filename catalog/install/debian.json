	"repos": [
		{
			"check": "apt/sources.list.d/debian-backports.sources",
			"commands": [
				[
					"sudo",
					"install",
					"-m",
					"0644",
					"{work}/debian-backports.sources",
					"/etc/apt/sources.list.d/debian-backports.sources"
				]
			],
			"file": {
				"content": "Types: deb\nURIs: https://deb.debian.org/debian\nSuites: trixie-backports\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n",
				"path": "{work}/debian-backports.sources"
			},
			"for": [
				"hyprland",
				"hypridle",
				"hyprlock",
				"uwsm",
				"xdg-desktop-portal-hyprland",
				"hyprpolkitagent",
				"hyprpicker",
				"hyprsunset",
				"hyprpaper",
				"hyprlauncher",
				"quickshell"
			],
			"id": "backports",
			"title": "Debian backports (trixie-backports: Hyprland and its tools)",
			"release": "trixie-backports",
			"check_text": "trixie-backports"
		},
		{
			"check": "apt/sources.list.d/noctalia-trixie.sources",
			"commands": [
				[
					"curl",
					"-fsSLo",
					"{work}/nickh-archive-keyring.deb",
					"https://pkg.noctalia.dev/deb/nickh-archive-keyring.deb"
				],
				[
					"sudo",
					"dpkg",
					"-i",
					"{work}/nickh-archive-keyring.deb"
				],
				[
					"sudo",
					"curl",
					"-fsSLo",
					"/etc/apt/sources.list.d/noctalia-trixie.sources",
					"https://pkg.noctalia.dev/deb/noctalia-trixie.sources"
				]
			],
			"for": [
				"noctalia"
			],
			"id": "noctalia",
			"title": "Noctalia's apt repository (pkg.noctalia.dev, Debian Trixie)"
		}
	],
