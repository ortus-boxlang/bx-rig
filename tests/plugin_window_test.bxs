// Window mode of the BxRig bar panels: every bar popup has a floating "panel-window" twin of the same script, the header buttons come from
// the shared bxrig.luau, and that file is the same in every plugin. Run from src/: (cd src && matchbox ../tests/plugin_window_test.bxs)
// Reads the files as text (no Luau interpreter in CI).
testkit = new lib.Check( "window mode" );
root = expandPath( "../templates/noctalia-plugins" );
function textOf( rel ) { return fileRead( root & "/" & rel ); }

plugins = [
	{ name: "system", id: "bxrig/system", tui: "dashboard" },
	{ name: "agents", id: "bxrig/agents", tui: "ai-agents" },
	{ name: "clock", id: "bxrig/clock", tui: "" },
	{ name: "power", id: "bxrig/power", tui: "" },
	{ name: "vpn", id: "bxrig/vpn", tui: "" },
	{ name: "dev", id: "bxrig/dev", tui: "" },
	{ name: "quick", id: "bxrig/quick", tui: "" }
];
shared = textOf( "agents/bxrig.luau" );
testkit.check( "bxrig.luau has isWindow, swapWindow and windowButtons", find( "function M.isWindow()", shared ) > 0 && find( "function M.swapWindow(plugin, panelId)", shared ) > 0 && find( "function M.windowButtons(opts)", shared ) > 0 );
testkit.check( "the window buttons are Detach or Dock, and a terminal button only for a tui page", find( '"Detach into a window"', shared ) > 0 && find( '"Dock back to the bar"', shared ) > 0 && find( "if opts.tui ~= nil then", shared ) > 0 && find( '" tui " .. shellQuote(opts.tui)', shared ) > 0 );
same = true;
for ( p in [ "agents", "clock", "dev", "launcher", "power", "quick", "system", "vpn" ] ) if ( textOf( p & "/bxrig.luau" ) != shared ) { same = false; println( "  differs: " & p ); }
testkit.check( "the shared bxrig.luau is the same in every plugin", same );

for ( p in plugins ) {
	manifest = textOf( p.name & "/plugin.toml" );
	panelTxt = textOf( p.name & "/panel.luau" );
	testkit.check( p.name & ": a floating, centered panel-window entry of panel.luau that stays open when you click away", find( 'id = "panel-window"', manifest ) > 0 && find( 'entry = "panel.luau"', manifest ) > 0 && find( 'placement = "floating"', manifest ) > 0 && find( 'position = "center"', manifest ) > 0 && find( "dismiss_on_outside_click = false", manifest ) > 0 );
	testkit.check( p.name & ": the window setting is true in the window entry and false in the popup", find( 'key = "window"', manifest ) > 0 && find( "default = true", manifest ) > 0 && find( "default = false", manifest ) > 0 );
	testkit.check( p.name & ": the header uses windowButtons for " & p.id, find( 'bxrig.windowButtons({ plugin = "' & p.id & '"', panelTxt ) > 0 );
	if ( len( p.tui ) ) testkit.check( p.name & ": the terminal button opens tui " & p.tui, find( 'tui = "' & p.tui & '"', panelTxt ) > 0 );
	tr = textOf( p.name & "/translations/en.json" );
	testkit.check( p.name & ": the window setting has a label in en.json", find( '"window"', tr ) > 0 );
}
themes = textOf( "quick/themes.luau" );
quick = textOf( "quick/plugin.toml" );
testkit.check( "quick: themes has a themes-window twin and a terminal button for tui themes", find( 'id = "themes-window"', quick ) > 0 && find( 'panel = "themes", tui = "themes"', themes ) > 0 && find( "bxrig.isWindow() and 540 or 420", themes ) > 0 );

// the panel kit: one file, the same in every plugin, with the pieces the panels share
kitText = textOf( "agents/kit.luau" );
sameKit = true;
for ( p in [ "agents", "clock", "dev", "launcher", "power", "quick", "system", "vpn" ] ) if ( textOf( p & "/kit.luau" ) != kitText ) { sameKit = false; println( "  kit differs: " & p ); }
testkit.check( "kit.luau is the same in every plugin", sameKit );
pieces = [ "function M.str(v)", "function M.sequence()", "function M.once(ms)", "function M.clamp(index, delta, count)", "function M.searchRow(opts)", "function M.tabRow(opts)", "function M.footer(opts)", "function M.grid(opts)", "function M.screenSize()", "function M.windowButton(plugin, panelId)", "function M.swap(plugin, panelId)" ];
okKit = true;
for ( pc in pieces ) if ( find( pc, kitText ) == 0 ) { okKit = false; println( "  kit lacks " & pc ); }
testkit.check( "the kit has its pieces: str, sequence, once, clamp, searchRow, tabRow, footer, grid, screenSize, windowButton, swap", okKit );
users = [ "launcher/emoji", "launcher/apps", "launcher/keys", "launcher/clipboard", "launcher/menu", "launcher/aitext", "launcher/panel", "quick/themes" ];
okUse = true;
for ( u in users ) { t = textOf( u & ".luau" ); if ( find( 'require("./kit.luau")', t ) == 0 || find( "local function str(v)", t ) > 0 || find( "lastSubmitMs", t ) > 0 ) { okUse = false; println( "  not on the kit: " & u ); } }
testkit.check( "the launcher panels and the theme switcher use the kit: no own str(), no own double-Enter guard", okUse );

// the panel framework: one file, the same in every plugin; panels built on it
fwText = textOf( "agents/framework.luau" );
sameFw = true;
for ( p in [ "agents", "clock", "dev", "launcher", "power", "quick", "system", "vpn" ] ) if ( textOf( p & "/framework.luau" ) != fwText ) { sameFw = false; println( "  framework differs: " & p ); }
testkit.check( "framework.luau is the same in every plugin", sameFw );
fwPieces = [ "function M.panel(def)", "function Panel:open(context)", "function Panel:render()", "function Panel:set(patch)", "function Panel:fetch(args, onData, opts)", "function Panel:run(args, onDone, timeout)", "function Panel:move(delta, count)", "function Panel:submitOnce(fn)", "function Panel:swap()", "function Panel:close()", "function Panel:windowButton()", "function Panel:key(chord, pressed)", "function Panel:submit()", "function M.stack(children)", "function M.body(height, scrollOpts, children)" ];
okFw = true;
for ( pc in fwPieces ) if ( find( pc, fwText ) == 0 ) { okFw = false; println( "  framework lacks " & pc ); }
testkit.check( "the framework has its pieces: panel, open, render, set, fetch, run, move, submitOnce, swap, close, windowButton, key, submit, stack, body", okFw );
testkit.check( "the framework fetch adds --json, guards late answers per channel, and drives state.loading and state.error only on the main channel", find( 'table.insert(full, "--json")', fwText ) > 0 && find( "channel.isCurrent(mine)", fwText ) > 0 && find( "if isMain then", fwText ) > 0 );
for ( fp in [ "launcher/emoji", "launcher/clipboard" ] ) {
	t = textOf( fp & ".luau" );
	testkit.check( fp & ": built on framework.panel with the host globals onOpen and onKey bound to it", find( "framework.panel({", t ) > 0 && find( "function onOpen(context)", t ) > 0 && find( "P:open(context)", t ) > 0 && find( "function onKey(chord, pressed)", t ) > 0 && find( "P:key(chord, pressed)", t ) > 0 );
}
clockText = textOf( "clock/panel.luau" );
testkit.check( "backgrounds: the theme switcher and quick settings open the Noctalia wallpaper panel, and the key does too", find( '"panel-open", "wallpaper"', textOf( "quick/themes.luau" ) ) > 0 && find( '"panel-open", "wallpaper"', textOf( "quick/panel.luau" ) ) > 0 && find( "panel-toggle wallpaper", fileRead( "../src/bxrig/Shortcuts.bx" ) ) > 0 );
testkit.check( "clock: on the framework with two icon tabs (Clocks, Reminders), opens on Reminders from the context, and the key opens it there", find( "framework.panel({", clockText ) > 0 && find( '{ "clocks", "Clocks", "clock" }', clockText ) > 0 && find( '{ "reminders"', clockText ) > 0 && find( 'context == "reminders"', clockText ) > 0 && find( "panel-open bxrig/clock:panel reminders", fileRead( "../src/bxrig/Shortcuts.bx" ) ) > 0 );
testkit.done( "all passed" );
