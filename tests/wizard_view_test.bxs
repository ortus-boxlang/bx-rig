// WizardView: what each screen shows, read back with render_to_string (needs MatchBox built with bif-tui).
// Run from src/: (cd src && matchbox ../tests/wizard_view_test.bxs)
testkit = new lib.Check( "wizard view" );
tui = createObject( "rust", "tui.TUI" );
view = new bxrig.WizardView( tui );
app = new bxrig.WizardApp( jsonDeserialize( new bxrig.WizardData().demoPages() ) );
function shot( w = 120, h = 36, tick = 100 ) { view.paint( app, tick, w, h ); return tui.render_to_string( w, h ); }

s = shot();
testkit.check( "welcome: powered by BoxLang and the address", find( "Powered by BoxLang", s ) > 0 && find( "www.boxlang.io", s ) > 0 );
testkit.check( "welcome: the laptop (half blocks) sits above the wordmark", find( "▀", s ) > 0 );
testkit.check( "welcome: the BXRIG wordmark in DOS Rebel (the brand font), tagline and prompt", find( "░░███░░░░░███░░███ ░░███ ░░███░░░░░███", s ) > 0 && find( "███", s ) > 0 && find( "Beautiful by default", s ) > 0 && find( "press  enter  to begin", s ) > 0 );

app.onKey( "Enter" );
s = shot();
testkit.check( "page: title, options, selected marker", find( "Desktop", s ) > 0 && find( "Hyprland + Noctalia", s ) > 0 && find( "●  Hyprland + Noctalia (recommended)", s ) > 0 );
testkit.check( "page: the sidebar lists the steps and Powered by BoxLang", find( "Steps", s ) > 0 && find( "Review", s ) > 0 && find( "Powered by BoxLang", s ) > 0 && find( "step 1 of 17", s ) > 0 );
testkit.check( "page: footer key hints", find( "ctrl-c", s ) > 0 && find( "space", s ) > 0 );
testkit.check( "page: the focused option shows its description", find( "A fast tiling desktop", s ) > 0 );
testkit.check( "page: number field shows its range", find( "1 to 10", s ) > 0 );

app.onKey( "Down" ); app.onKey( " " );
s = shot();
testkit.check( "selecting moves the marker", find( "●  Both: Hyprland + Noctalia", s ) > 0 );

testkit.check( "a click on a sidebar row is a page action only once reached", view.hitAt( 6, 5 ).kind == "page" && view.hitAt( 6, 5 ).n == 1 );
shot( 120, 36 );
lines = listToArray( tui.render_to_string( 120, 36 ), chr( 10 ), true );
optY = 0; for ( i = 1; i <= lines.len(); i++ ) if ( find( "KDE Plasma with BxRig tiling only", lines[ i ] ) ) { optY = i - 1; break; }
testkit.check( "a click on an option is a focus action", optY > 0 && view.hitAt( 40, optY ).kind == "focus" );
testkit.check( "a click on nothing does nothing", view.hitAt( 0, 0 ).kind == "" );

app.gotoPage( 7 );
s = shot();
testkit.check( "text fields show their placeholder", find( "Luis Majano", s ) > 0 );
for ( c in [ "L", "u", "i", "s" ] ) app.onKey( c );
s = shot();
testkit.check( "and what is typed", find( "Luis", s ) > 0 );

app.gotoPage( 6 );
s = shot();
testkit.check( "multi choice marks selected with a filled diamond", find( "◆", s ) > 0 && find( "◇", s ) > 0 );

app.gotoReview();
s = shot();
testkit.check( "review: apply button and readable values", find( "Apply these choices", s ) > 0 && find( "Everything look right", s ) > 0 && find( "Both: Hyprland", s ) > 0 );
testkit.check( "review: Powered by BoxLang in the sidebar", find( "Powered by BoxLang", s ) > 0 );

small = shot( 60, 20 );
testkit.check( "a window that is too small asks for a bigger one", find( "Make the window a little bigger", small ) > 0 );

app = new bxrig.WizardApp( jsonDeserialize( new bxrig.WizardData().demoPages() ) );
a1 = shot( 120, 36, 100 ); app.onKey( "Enter" ); b1 = shot( 120, 36, 100 );
testkit.check( "a new screen fades in (first frame is dimmer, same text)", find( "Desktop", b1 ) > 0 );

// ---- the Customize pages: hidden in Basic mode, shown (and counted) in Customize mode ----
spec2 = new bxrig.AppPages().inject( jsonDeserialize( new bxrig.WizardData().demoPages() ), new bxrig.Catalog().load() );
app = new bxrig.WizardApp( spec2 ); app.onKey( "Enter" );
t = ""; view.paint( app, 100, 120, 36 ); t = tui.render_to_string( 120, 36 );
testkit.check( "Basic mode: 16 pages and the review, no app group pages in the sidebar", find( "step 1 of 17", t ) > 0 && find( "Everyday", t ) == 0 );
app = new bxrig.WizardApp( spec2, { app_mode: "custom" } ); app.onKey( "Enter" );
view.paint( app, 100, 120, 36 ); t = tui.render_to_string( 120, 36 );
testkit.check( "Customize mode: 27 pages and the review, with the group pages in the sidebar", find( "step 1 of 28", t ) > 0 && find( "Everyday", t ) > 0 && find( "Development", t ) > 0 );
app.gotoPage( 14 );
view.paint( app, 100, 120, 36 ); t = tui.render_to_string( 120, 36 );
testkit.check( "a generated page lists a category with ticked defaults and descriptions", find( "Development", t ) > 0 && find( "◆", t ) > 0 && find( "◇", t ) > 0 && find( "▸", t ) > 0 );

// ---- a long help text wraps under its question (it used to run past the panel edge) ----
app = new bxrig.WizardApp( spec2 ); app.onKey( "Enter" ); for ( i = 1; i <= 13; i++ ) app.onKey( "Tab" );
// the AI page lists every agent twice (to tick, and the default), so the keys question is far down: move to it
for ( i = 1; i <= 33; i++ ) app.onKey( "Down" );
view.paint( app, 100, 100, 44 ); t = tui.render_to_string( 100, 44 );
testkit.check( "the API keys help wraps: its last words are on screen at 100 columns", find( "Stored in your desktop keyring", t ) > 0 && find( "shell history", t ) > 0 );

// ---- the review keeps room for the answer when a question label is long (the answers used to shrink to two characters) ----
longSpec = jsonDeserialize( '{"title":"T","pages":[{"id":"a","title":"A","questions":[{"type":"choice","id":"c","label":"Event Calendar with an agenda instead of the plain clock in the top panel","default":"red","options":[{"value":"red","label":"Crimson answer"}]}]}]}' );
app = new bxrig.WizardApp( longSpec ); app.gotoReview();
view.paint( app, 100, 100, 36 ); t = tui.render_to_string( 100, 36 );
testkit.check( "a long review label is cut and its answer is shown whole", find( "Crimson answer", t ) > 0 );

// ---- the Look pages: top bar layout, app grid style, theme ----
function pageShot( app, w = 120, h = 36 ) { view.paint( app, 100, w, h ); return tui.render_to_string( w, h ); }
spec3 = jsonDeserialize( new bxrig.WizardData().demoPages() );
app = new bxrig.WizardApp( spec3 ); app.onKey( "Enter" ); app.gotoPage( 3 );
t = pageShot( app );
testkit.check( "bar page: the three layouts, each with its bar", find( "Minimal", t ) > 0 && find( "Standard", t ) > 0 && find( "Dense", t ) > 0 && find( "recommended, default", t ) > 0 && find( "Nov 5 - 04:00", t ) > 0 && find( "☁ 11°", t ) > 0 );
testkit.check( "bar page: the dock line with the grid button first", find( "Dock", t ) > 0 && find( "▦", t ) > 0 && find( "step 3 of 17", t ) > 0 );
testkit.check( "bar page: the focused option's description is in the detail strip", find( "Standard: the recommended bar", t ) > 0 && find( "bxrig appearance bar layout standard", t ) > 0 );
app.onKey( "Down" );
t = pageShot( app );
testkit.check( "bar page: Down moves the marker and the detail to Dense", find( "●  Dense", t ) > 0 && find( "Dense: for developers", t ) > 0 && find( "●  Standard", t ) == 0 );
testkit.check( "bar page: a click on an option's bar picks it", view.hitAt( 40, 12 ).kind == "focus" );

app = new bxrig.WizardApp( spec3 ); app.onKey( "Enter" ); app.gotoPage( 4 );
t = pageShot( app );
testkit.check( "grid page: both styles drawn side by side, Launchpad chosen", find( "Launchpad grid", t ) > 0 && find( "Terminal-style grid", t ) > 0 && find( "Search apps...", t ) > 0 && find( "/ search apps", t ) > 0 && find( "●  Launchpad grid", t ) > 0 );
app.onKey( "Down" );
t = pageShot( app );
testkit.check( "grid page: Down chooses Terminal-style", find( "●  Terminal-style grid", t ) > 0 && find( "square card", t ) > 0 );
testkit.check( "grid page: a click on a preview picks that style", view.hitAt( 45, 18 ).kind == "focus" && view.hitAt( 45, 18 ).n > 0 );
n3 = pageShot( app, 100, 30 );
testkit.check( "grid page: still readable at 100 x 30, with the previews (one row of apps each when the page is short)", find( "Terminal-style grid", n3 ) > 0 && find( "Search apps...", n3 ) > 0 && find( "/ search apps", n3 ) > 0 );
n92 = pageShot( app, 92, 30 );
testkit.check( "grid page: and at 92 x 30", find( "Search apps...", n92 ) > 0 );
head76 = pageShot( app, 76, 24 );
testkit.check( "76 columns: the header notice and the step counter no longer overlap", find( "step 4 of 17", head76 ) > 0 && find( "Powered by Bo", head76 ) == 0 );
head90 = pageShot( app, 90, 30 );
testkit.check( "90 columns: Powered by BoxLang fits beside the progress", find( "Powered by BoxLang", head90 ) > 0 && find( "step 4 of 17", head90 ) > 0 );
tiny = pageShot( app, 76, 24 );
testkit.check( "grid page: and at the smallest size, with no preview cut mid-way", find( "App grid style", tiny ) > 0 && find( "Terminal-style grid", tiny ) > 0 );

app = new bxrig.WizardApp( spec3 ); app.onKey( "Enter" ); app.gotoPage( 5 );
t = pageShot( app );
testkit.check( "theme page: every theme on a row with dark or light and four swatches, BxRig marked default", find( "BxRig", t ) > 0 && find( "default", t ) > 0 && find( "dark ████", t ) > 0 && find( "light████", t ) > 0 );
testkit.check( "theme page: the pane shows the palette read from colors.toml", find( "Preview: BxRig", t ) > 0 && find( "#303446", t ) > 0 && find( "selected row", t ) > 0 );
app.onKey( "Down" );
t = pageShot( app );
midnight = new bxrig.Palette().colorsOf( "bxrig-midnight" );
testkit.check( "theme page: Down previews the next theme (its own background value)", find( "Preview: BxRig Midnight", t ) > 0 && find( midnight.background, t ) > 0 );
testkit.check( "theme page: the wizard itself is drawn in the highlighted theme (palette follows the answer)", view.kit().color( "BASE" ) == midnight.background && view.kit().color( "GREEN" ) == midnight.accent );
app.onKey( "Up" ); pageShot( app );
testkit.check( "theme page: back on BxRig the palette is the default again", view.kit().color( "BASE" ) == "##303446" );
narrowT = pageShot( app, 100, 30 );
testkit.check( "theme page at 100 columns: the palette pane is still beside the list", find( "Preview: BxRig", narrowT ) > 0 || find( "dark ████", narrowT ) > 0 );
tinyT = pageShot( app, 76, 24 );
testkit.check( "theme page at 76 x 24 (no sidebar): the list and a narrow pane", find( "dark ████", tinyT ) > 0 && find( "Preview: BxRig", tinyT ) > 0 );
midT = pageShot( app, 92, 30 );
testkit.check( "theme page at 92 columns (sidebar, little room): the list with swatches and no pane", find( "dark ████", midT ) > 0 && find( "Preview:", midT ) == 0 );

app = new bxrig.WizardApp( spec3, { bar_layout: "dense", appgrid_style: "terminal", theme_name: "nord" } ); app.gotoReview();
t = pageShot( app, 120, 44 );
testkit.check( "review: the three new answers in words", find( "Top bar layout", t ) > 0 && find( "Dense", t ) > 0 && find( "App grid style", t ) > 0 && find( "Terminal-style grid", t ) > 0 && find( "Color theme", t ) > 0 && find( "Nord", t ) > 0 );
// a wizard that starts with a theme answer is drawn in that theme from the first frame
app = new bxrig.WizardApp( spec3, { theme_name: "nord" } ); view2 = new bxrig.WizardView( tui ); view2.paint( app, 100, 120, 36 );
testkit.check( "a saved theme answer colours the wizard from the welcome screen", view2.kit().color( "BASE" ) == new bxrig.Palette().colorsOf( "nord" ).background );

testkit.done( "all passed" );

// ---- the start screen ----
startSpec = jsonDeserialize( new bxrig.WizardData().demoPages() );
sapp = new bxrig.WizardApp( startSpec, {}, { start: true, presets: { new: {}, saved: { shell: "fish" } }, importer: function( p ) { return { ok: false, answers: {}, ignored: [], error: "There is no file " & p }; } } );
sapp.onKey( "Enter" );
view.paint( sapp, 100, 120, 44 ); s = tui.render_to_string( 120, 44 );
testkit.check( "start: the question, the three ways to begin and the help of the focused one", find( "How do you want to start?", s ) > 0 && find( "New install", s ) > 0 && find( "Import answers from a file", s ) > 0 && find( "Use my saved answers", s ) > 0 && find( "starting from the defaults", s ) > 0 );
testkit.check( "start: the brand wordmark is above it in a tall window", find( "░░███░░░░░███░░███", s ) > 0 );
testkit.check( "start: the key hints", find( "choose", s ) > 0 && find( "continue", s ) > 0 );
sapp.onKey( "Down" ); sapp.onKey( "Enter" );
for ( ch in [ "/", "x", ".", "j" ] ) sapp.onKey( ch );
view.paint( sapp, 100, 100, 30 ); s = tui.render_to_string( 100, 30 );
testkit.check( "start: the path field shows what is typed", find( "Path of your answers file:", s ) > 0 && find( "/x.j", s ) > 0 );
sapp.onKey( "Enter" );
view.paint( sapp, 100, 100, 30 ); s = tui.render_to_string( 100, 30 );
testkit.check( "start: an error from the file shows under the field", find( "There is no file /x.j", s ) > 0 );
sapp2 = new bxrig.WizardApp( startSpec, {}, { start: true, presets: { new: {}, saved: { shell: "fish" } } } );
sapp2.onKey( "Enter" ); sapp2.onKey( "Down" ); sapp2.onKey( "Down" ); sapp2.onKey( "Enter" );
view.paint( sapp2, 100, 120, 36 ); s = tui.render_to_string( 120, 36 );
testkit.check( "the review says where the answers came from", find( "Your saved answers", s ) > 0 && find( "Everything look right?", s ) > 0 );
view.paint( sapp, 100, 80, 24 ); s = tui.render_to_string( 80, 24 );
testkit.check( "start: a small window shows the choices without the wordmark", find( "How do you want to start?", s ) > 0 );
