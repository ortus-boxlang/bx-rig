// WizardApp: state and key handling, no terminal. Run from src/: (cd src && matchbox ../tests/wizard_app_test.bxs)
testkit = new lib.Check( "wizard app" );
function mk( preset = {} ) { return new bxrig.WizardApp( jsonDeserialize( new bxrig.WizardData().demoPages() ), preset ); }
function started() { var a = mk(); a.onKey( "Enter" ); return a; }

a = mk();
testkit.check( "defaults come from the pages", a.answerString( "desktops" ) == "hyprland" && a.answerNumber( "workspaces" ) == 4 && !a.answerBool( "natural_scroll" ) && a.answerList( "layouts" ).toList() == "us-intl,es" );
b = mk( { desktops: "plasma", not_a_question: "x" } );
testkit.check( "presets override defaults, unknown ids are ignored", b.answerString( "desktops" ) == "plasma" && !b.answers().keyExists( "not_a_question" ) );

a = started();
testkit.check( "enter leaves the welcome screen and focuses the first option", a.screen() == "page" && a.pageIndex() == 1 && a.isFocusable( a.rows()[ a.focus() ] ) );

a = started();
a.onKey( "Down" ); a.onKey( " " );
testkit.check( "space selects a choice", a.answerString( "desktops" ) == "both" );
before = a.focus();
a.onKey( "Enter" );
testkit.check( "enter moves to the next question", a.focus() > before && a.rows()[ a.focus() ].q == 2 );

a = started(); a.gotoPage( 6 );
a.onKey( "Down" ); a.onKey( " " );
testkit.check( "a multi choice toggles on", arrayFind( a.answerList( "layouts" ), "us" ) > 0 );
a.onKey( " " );
testkit.check( "and off again", arrayFind( a.answerList( "layouts" ), "us" ) == 0 );

a = started();
for ( i = 1; i <= a.rows().len(); i++ ) if ( a.rows()[ i ].kind == "field" ) { a.gotoPage( 1 ); break; }
idx = 0; rs = a.rows(); for ( i = 1; i <= rs.len(); i++ ) if ( rs[ i ].kind == "field" ) { idx = i; break; }
a.act( { kind: "focus", n: idx } );
for ( i = 1; i <= 30; i++ ) a.onKey( "Right" );
testkit.check( "numbers stop at their maximum", a.answerNumber( "workspaces" ) == 10 );
for ( i = 1; i <= 30; i++ ) a.onKey( "Left" );
testkit.check( "and at their minimum", a.answerNumber( "workspaces" ) == 1 );

a = started(); a.gotoPage( 7 );
for ( c in [ "L", "u", "i", "s" ] ) a.onKey( c );
testkit.check( "text fields take typing", a.answerString( "git_name" ) == "Luis" );
a.onKey( "Backspace" );
testkit.check( "backspace deletes", a.answerString( "git_name" ) == "Lui" );
a.onKey( "j" );
testkit.check( "j is typed, not a move", a.answerString( "git_name" ) == "Luij" );
a.onKey( "Ctrl+u" );
testkit.check( "ctrl-u clears", a.answerString( "git_name" ) == "" );

a = started(); a.gotoPage( a.pageCount() ); a.nextPage();
testkit.check( "the last page leads to review", a.screen() == "review" && a.furthest() == a.pageCount() + 1 );
a.onKey( "Enter" );
testkit.check( "enter on review finishes with answers as JSON", a.outcome() == "done" && jsonDeserialize( a.answersJson() ).desktops == "hyprland" );

a = started(); a.onKey( "Ctrl+c" );
testkit.check( "ctrl-c cancels", a.outcome() == "cancelled" );
a = mk(); a.onKey( "q" );
testkit.check( "q cancels on the welcome screen", a.outcome() == "cancelled" );
a = started(); a.onKey( "Escape" );
testkit.check( "escape on the first page returns to the welcome screen", a.screen() == "welcome" );

a = started();
testkit.check( "review shows readable values", a.display( a.spec().pages[ 1 ].questions[ 1 ] ) == "Hyprland + Noctalia (recommended)" );

a = started(); a.act( { kind: "page", n: 5 } );
testkit.check( "sidebar clicks only reach pages already visited", a.pageIndex() == 1 );
a.gotoPage( 3 ); a.gotoPage( 1 ); a.act( { kind: "page", n: 3 } );
testkit.check( "and work for visited ones", a.pageIndex() == 3 );

a = mk();
testkit.check( "the shell defaults to zsh and the terminal to Ghostty, no extra terminals", a.answerString( "shell" ) == "zsh" && a.answerString( "terminal" ) == "ghostty" && a.answerList( "terminals_extra" ).len() == 0 );

testkit.check( "AI orchestration defaults to Pane", a.answerList( "ai_orchestrators" ).toList() == "pane" );

a = started();
hasLogin = function( app ) { for ( var r in app.rows() ) if ( r.kind == "heading" && app.spec().pages[ 1 ].questions[ r.q ].id == "login_session" ) return true; return false; };
testkit.check( "login session is not asked for Hyprland only", !hasLogin( a ) && !a.finalAnswers().keyExists( "login_session" ) && a.answers().keyExists( "login_session" ) );
a.onKey( "Down" ); a.onKey( " " );
testkit.check( "choosing Both asks which session starts at login", a.answerString( "desktops" ) == "both" && hasLogin( a ) && a.finalAnswers().keyExists( "login_session" ) );
a.onKey( "Up" ); a.onKey( " " );
testkit.check( "and not again once Hyprland only is chosen", !hasLogin( a ) && !a.finalAnswers().keyExists( "login_session" ) );
a = mk( { desktops: "plasma" } );
testkit.check( "KDE only does not ask either", !a.finalAnswers().keyExists( "login_session" ) && a.finalAnswers().desktops == "plasma" );
a = started(); a.onKey( "Down" ); a.onKey( " " ); a.gotoReview();
testkit.check( "answers JSON for Both includes the login session", jsonDeserialize( a.answersJson() ).login_session == "hyprland" );

a = started();
hasLayout = function( app ) { for ( var r in app.rows() ) if ( r.kind == "heading" && app.spec().pages[ 1 ].questions[ r.q ].id == "layout" ) return true; return false; };
testkit.check( "the window layout defaults to tiling (dwindle) and is asked for Hyprland", a.answerString( "layout" ) == "dwindle" && hasLayout( a ) );
a = mk( { desktops: "plasma" } );
testkit.check( "KDE only is not asked for a Hyprland layout", !a.finalAnswers().keyExists( "layout" ) );

a = mk();
testkit.check( "JavaScript runtimes are hidden until JavaScript is chosen, and default to Node", !a.finalAnswers().keyExists( "js_runtimes" ) && a.answerList( "js_runtimes" ).toList() == "node" );
a = mk( { toolchains: [ "java", "javascript" ] } );
testkit.check( "and asked once it is", a.finalAnswers().keyExists( "js_runtimes" ) );
testkit.check( "the toolchains page says BoxLang is always installed", find( "BoxLang", a.spec().pages[ 8 ].intro ) > 0 && a.spec().pages[ 8 ].questions[ 1 ].type == "info" );

a = mk();
testkit.check( "the launcher and the menu default to Vicinae; the launcher is for Hyprland only", a.answerString( "launcher" ) == "vicinae" && a.answerString( "menu" ) == "vicinae" && a.finalAnswers().keyExists( "launcher" ) && !mk( { desktops: "plasma" } ).finalAnswers().keyExists( "launcher" ) );

a = mk();
testkit.check( "no database is preselected", a.answerList( "databases" ).len() == 0 );

a = mk();
testkit.check( "the password question appears only once a database is picked", !a.finalAnswers().keyExists( "database_passwords" ) && mk( { databases: [ "postgres" ] } ).finalAnswers().keyExists( "database_passwords" ) && mk().answerString( "database_passwords" ) == "generate" );

// ---- pages that appear only for some answers ----
function withPages() {
	var spec = jsonDeserialize( new bxrig.WizardData().demoPages() );
	var extra = { id: "extra", title: "Extra", intro: "", when: { id: "app_mode", equals: "custom" }, questions: [ { type: "multi", id: "extra_pick", label: "Pick", default: [ "a" ], options: [ { value: "a", label: "A", description: "" }, { value: "b", label: "B", description: "" } ] } ] };
	var pages = [];
	for ( var i = 1; i <= spec.pages.len(); i++ ) { pages.append( spec.pages[ i ] ); if ( i == 1 ) pages.append( extra ); }
	spec.pages = pages;
	return spec;
}
a = new bxrig.WizardApp( withPages() );
inp = mk( { mac_keys: false, input_detected: "none" } );
qi = {}; for ( pg in inp.spec().pages ) for ( q in pg.questions ) if ( q.id == "input_devices" ) qi = q;
hq = {}; for ( pg in inp.spec().pages ) for ( q in pg.questions ) if ( q.id == "input_detected" ) hq = q;
testkit.check( "the input question needs a device found or the Mac keys on (`when.any`)", !inp.isVisible( qi ) && mk( { mac_keys: false, input_detected: "logitech" } ).isVisible( qi ) && mk( { mac_keys: true, input_detected: "none" } ).isVisible( qi ) && mk( { mac_keys: false, input_detected: "both" } ).isVisible( qi ) );
testkit.check( "a `hidden` question is never shown and never answered by the user", !inp.isVisible( hq ) && !mk( { input_detected: "both" } ).finalAnswers().keyExists( "input_detected" ) && mk( { mac_keys: true } ).finalAnswers().input_devices == "detect" );
testkit.check( "a page with `when` is hidden until its answer matches", !a.pageVisible( 2 ) && a.visiblePages().len() == a.pageCount() - 1 && a.stepCount() == a.pageCount() );
testkit.check( "answers on a hidden page are not in the result", !a.finalAnswers().keyExists( "extra_pick" ) );
a.onKey( "Enter" ); a.gotoPage( 1 ); a.nextPage();
testkit.check( "next skips the hidden page", a.pageIndex() == 3 );
a.prevPage();
testkit.check( "and so does back", a.pageIndex() == 1 );
a = new bxrig.WizardApp( withPages(), { app_mode: "custom" } );
testkit.check( "the page shows once the answer matches, counts as a step and its answers are returned", a.pageVisible( 2 ) && a.stepCount() == a.pageCount() + 1 && a.finalAnswers().keyExists( "extra_pick" ) );
a.onKey( "Enter" ); a.gotoPage( 1 ); a.nextPage();
testkit.check( "next lands on it", a.pageIndex() == 2 && a.stepOf( 2 ) == 2 );

a = mk();
testkit.check( "the welcome version is the program version, not a number in the page file", a.spec().version == new bxrig.util.Version().current() && !jsonDeserialize( new bxrig.WizardData().demoPages() ).keyExists( "version" ) );

// ---- the Look pages: top bar layout, app grid style and the theme chooser, each after Look, each its own page ----
a = mk();
ids = a.spec().pages.map( function( pg ) { return pg.id; } ).toList( "," );
testkit.check( "pages after Look: top bar layout, app grid style, theme, then Input", find( "look,top_bar,app_grid,theme_page,input,", ids ) > 0 );
lookIds = a.spec().pages[ 2 ].questions.map( function( q ) { return q.id; } );
testkit.check( "the Look page has no color theme list (dark, light or auto stays)", !arrayFind( lookIds, "theme_name" ) && arrayFind( lookIds, "theme" ) && arrayFind( lookIds, "dock" ) && arrayFind( lookIds, "bar_position" ) );
testkit.check( "defaults: Standard bar, Launchpad grid, the BxRig theme", a.answerString( "bar_layout" ) == "standard" && a.answerString( "appgrid_style" ) == "launchpad" && a.answerString( "theme_name" ) == "bxrig" );
barPage = a.spec().pages[ 3 ]; gridPage = a.spec().pages[ 4 ]; themePage = a.spec().pages[ 5 ];
testkit.check( "the bar layout choices are Minimal, Standard and Dense", barPage.questions[ 1 ].options.map( function( o ) { return o.value; } ).toList( "," ) == "minimal,standard,dense" && barPage.questions[ 1 ].live == true );
testkit.check( "the app grid choices are Launchpad and Terminal-style", gridPage.questions[ 1 ].options.map( function( o ) { return o.value; } ).toList( "," ) == "launchpad,terminal" );
themeValues = themePage.questions[ 1 ].options.map( function( o ) { return o.value; } );
bundled = new bxrig.ThemeData().names();
testkit.check( "the Theme page lists every theme in themes/ (" & bundled.len() & ")", themeValues.len() == bundled.len() && bundled.filter( function( n ) { return arrayFind( themeValues, n ) > 0; } ).len() == bundled.len() );
testkit.check( "the Theme page asks no icon set: the theme, then the optional wallpaper packs", themePage.questions.len() == 2 && themePage.questions[ 1 ].id == "theme_name" && themePage.questions[ 2 ].id == "wallpaper_packs" );

a = started(); a.gotoPage( 3 );
testkit.check( "the page opens on the chosen option (Standard), so Enter keeps it", a.rows()[ a.focus() ].kind == "opt" && a.rows()[ a.focus() ].i == 2 );
a.onKey( "Enter" );
testkit.check( "Enter on the first screen of the page keeps the default and goes on", a.answerString( "bar_layout" ) == "standard" );
a = started(); a.gotoPage( 3 ); a.onKey( "Down" );
testkit.check( "Down changes the preview at once: Dense, no space needed", a.answerString( "bar_layout" ) == "dense" );
a.onKey( "Up" ); a.onKey( "Up" );
testkit.check( "Up twice: Minimal", a.answerString( "bar_layout" ) == "minimal" );
a.onKey( "k" ); testkit.check( "the choice stops at the first option", a.answerString( "bar_layout" ) == "minimal" );
a = started(); a.gotoPage( 4 ); a.onKey( "Down" );
testkit.check( "app grid: Down is Terminal-style", a.answerString( "appgrid_style" ) == "terminal" && a.rows().filter( function( r ) { return r.kind == "preview"; } ).len() == 1 );
a = started(); a.gotoPage( 5 ); a.onKey( "j" ); a.onKey( "j" );
testkit.check( "theme: the highlighted theme is the answer (the third one)", a.answerString( "theme_name" ) == themeValues[ 3 ] );
a = started(); a.gotoPage( 2 ); a.onKey( "Down" ); a.onKey( "Down" );
testkit.check( "choices that are not live still need space (the Look mode)", a.answerString( "theme" ) == "dark" );

// the bar and the grid are Noctalia's: asked for Hyprland and Both, not for KDE Plasma alone; the theme is for every desktop
a = mk( { desktops: "plasma" } );
testkit.check( "KDE only: no top bar or app grid page, the theme page stays", !a.pageVisible( 3 ) && !a.pageVisible( 4 ) && a.pageVisible( 5 ) && !a.finalAnswers().keyExists( "bar_layout" ) && a.finalAnswers().keyExists( "theme_name" ) );
a = mk( { desktops: "both" } );
testkit.check( "Both: all three pages", a.pageVisible( 3 ) && a.pageVisible( 4 ) && a.pageVisible( 5 ) && a.finalAnswers().bar_layout == "standard" && a.finalAnswers().appgrid_style == "launchpad" );
a = mk( { bar_layout: "dense", appgrid_style: "terminal", theme_name: "nord" } );
testkit.check( "review words: Dense, Terminal-style grid, Nord", a.display( barPage.questions[ 1 ] ) == "Dense" && a.display( gridPage.questions[ 1 ] ) == "Terminal-style grid" && a.display( themePage.questions[ 1 ] ) == "Nord" );

testkit.done( "all passed" );

// ---- the start screen: new install, import a file, saved answers ----
function startApp( withSaved = true ) {
	var spec = jsonDeserialize( new bxrig.WizardData().demoPages() );
	var importer = function( path ) {
		if ( path == "/no/such.json" ) return { ok: false, answers: {}, ignored: [], error: "There is no file /no/such.json" };
		if ( path == "/mine.json" ) return { ok: true, answers: { terminal: "kitty", vpn: "wireguard", not_a_question: 1 }, ignored: [ "not_a_question" ], error: "" };
		return { ok: false, answers: {}, ignored: [], error: "not an answers file" };
	};
	var presets = { new: {}, saved: withSaved ? { shell: "fish" } : {} };
	return new bxrig.WizardApp( spec, {}, { start: true, presets: presets, importer: importer } );
}
function typeText( app, text ) { for ( var i = 1; i <= len( text ); i++ ) app.onKey( mid( text, i, 1 ) ); }
sa = startApp();
sa.onKey( "Enter" );
testkit.check( "start: Enter on the welcome opens the start screen with three ways to begin", sa.screen() == "start" && sa.startChoices().map( function( c ) { return c.id; } ).toList( "," ) == "new,import,saved" );
testkit.check( "start: no saved answers, no third choice", startApp( false ).onKey( "Enter" ).startChoices().len() == 2 );
sa.onKey( "Enter" );
testkit.check( "start: New install goes to the first page with the defaults", sa.screen() == "page" && sa.pageIndex() == 1 && sa.notice() == "" );
sa.onKey( "Escape" );
testkit.check( "start: Escape on the first page goes back to the start screen", sa.screen() == "start" );
sa.onKey( "Down" ); sa.onKey( "Down" ); sa.onKey( "Up" );
testkit.check( "start: arrows move and stop at the ends", sa.startIndex() == 2 );
sa.onKey( "Enter" );
testkit.check( "start: Import asks for the path", sa.importing() && sa.screen() == "start" );
typeText( sa, "/no/such.json" ); sa.onKey( "Enter" );
testkit.check( "start: a file that is not there is an error on the screen and the path stays", sa.importing() && find( "There is no file", sa.importError() ) > 0 && sa.screen() == "start" );
sa.onKey( "Ctrl+u" ); typeText( sa, "/mine.json" ); sa.onKey( "Backspace" ); typeText( sa, "x" );
sa.onKey( "Enter" );
testkit.check( "start: a mistyped path is an error, no change of screen", sa.importing() && len( sa.importError() ) > 0 );
sa.onKey( "Backspace" ); typeText( sa, "n" ); sa.onKey( "Enter" );
testkit.check( "start: the file is imported and the review follows", sa.screen() == "review" && !sa.importing() && sa.furthest() == sa.pageCount() + 1 );
testkit.check( "start: the imported answers are in, a list question given one string becomes a list", sa.answerString( "terminal" ) == "kitty" && sa.answers().vpn.toList() == "wireguard" );
testkit.check( "start: the notice counts the imported answers and the ones this version does not use", find( "Imported 2 answers from /mine.json", sa.notice() ) > 0 && find( "1 not used", sa.notice() ) > 0 );
sa.onKey( "Enter" );
testkit.check( "start: Enter on the review is done, and finalAnswers has the imported ones", sa.outcome() == "done" && sa.finalAnswers().terminal == "kitty" );
sb = startApp(); sb.onKey( "Enter" ); sb.onKey( "Down" ); sb.onKey( "Enter" ); sb.onKey( "Escape" );
testkit.check( "start: Escape while typing the path goes back to the choices", sb.screen() == "start" && !sb.importing() );
sb.onKey( "Down" ); sb.onKey( "Enter" );
testkit.check( "start: Use my saved answers goes straight to the review", sb.screen() == "review" && sb.answerString( "shell" ) == "fish" && sb.notice() == "Your saved answers" );
sb.onKey( "Escape" );
testkit.check( "start: Escape on the review goes back to the last page, and the way back leads to the start screen", sb.screen() == "page" );
sc = startApp(); sc.onKey( "Escape" );
testkit.check( "start: Escape on the welcome still quits", sc.outcome() == "cancelled" );
sd = startApp(); sd.onKey( "Enter" ); sd.onKey( "Escape" );
testkit.check( "start: Escape on the start screen goes back to the welcome", sd.screen() == "welcome" );
se = new bxrig.WizardApp( jsonDeserialize( new bxrig.WizardData().demoPages() ) ); se.onKey( "Enter" );
testkit.check( "no start option (--fresh, --rerun, --from, scripts): Enter goes straight to the first page, as before", se.screen() == "page" );
