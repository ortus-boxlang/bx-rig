// Installer.execLive: a command's output is echoed while it runs (not after), its exit code and output come back, a timeout kills it, and
// a test runner still works as before. Real tiny commands (sh). Run from src/: (cd src && matchbox ../tests/install_live_test.bxs)
testkit = new lib.Check( "install live" );
inst = new bxrig.Installer();
seen = [];
t0 = getTickCount();
echo = function( text ) { seen.append( { at: getTickCount() - t0, text: text } ); };
r = inst.execLive( [ "sh", "-c", "echo first; sleep 2; echo second; echo oops 1>&2; exit 3" ], 30, echo );
total = getTickCount() - t0;
testkit.check( "the exit code and the whole output come back", r.exitCode == 3 && !r.timeout && find( "first", r.output ) > 0 && find( "second", r.output ) > 0 && find( "oops", r.output ) > 0 );
testkit.check( "the first line is echoed while the command is still running (not after it ends)", seen.len() >= 2 && find( "first", seen[ 1 ].text ) > 0 && seen[ 1 ].at < total - 1000 );
testkit.check( "every line is echoed once, newline ended, errors too", seen.map( function( s ) { return s.text; } ).toList( "" ) == "first" & chr( 10 ) & "second" & chr( 10 ) & "oops" & chr( 10 ) );
r2 = inst.execLive( [ "sh", "-c", "echo start; sleep 30" ], 2, function( t ) {} );
testkit.check( "a timeout kills the command and says so (124)", r2.timeout && r2.exitCode == 124 );
sleep( 300 );
testkit.check( "the killed command is gone", new bxrig.util.Proc().exec( [ "sh", "-c", "pgrep -f '[s]leep 30' | wc -l" ] ).output.trim() == "0" );
r3 = inst.execLive( [ "/nonexistent/program-xyz" ], 10, function( t ) {} );
testkit.check( "a program that does not exist fails", r3.exitCode != 0 );
fake = new bxrig.Installer( function( argv, timeout ) { return { exitCode: 0, output: "faked", timeout: false }; } );
testkit.check( "an injected test runner is used as before", fake.execLive( [ "anything" ], 5 ).output == "faked" );
// what a quiet step is running
pr = new bxrig.util.Proc();
pr.startTo( [ "sh", "-c", "sleep 5" ], "/tmp/bxl-test.out", "/tmp/bxl-test.exit", "/tmp/bxl-test.pid" );
sleep( 600 );
leaf = pr.leafCommand( trim( fileRead( "/tmp/bxl-test.pid" ) ) );
testkit.check( "leafCommand: the deepest child's command line", find( "sleep 5", leaf ) > 0 );
pr.killTree( trim( fileRead( "/tmp/bxl-test.pid" ) ) );
for ( f in [ "/tmp/bxl-test.out", "/tmp/bxl-test.exit", "/tmp/bxl-test.pid" ] ) if ( fileExists( f ) ) fileDelete( f );
testkit.done();
