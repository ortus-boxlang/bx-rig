// SetupPlan: facts and request to steps. Run from src/: (cd src && matchbox ../tests/setup_plan_test.bxs)
testkit = new lib.Check( "setup plan" );
plan = new bxrig.SetupPlan();
function facts( over = {} ) {
	f = { isRoot: false, hasSudo: true, kwinVersion: "6.6.2", desktop: "KDE", sessionType: "wayland", installed: { git: true, kpackage: true, "python-dbus": true, "python-gobject": true, "qt6-tools": true, swayidle: true }, hyprkwinInstalled: false, workDir: "/tmp/hk", os: "cachyos", arch: "x86_64", hasPacman: true, hyprlandAdded: [], bluetoothEnabled: true };
	for ( k in over ) f[k] = over[k];
	return f;
}
ids = function( p ) { return p.steps.map( function( s ) { return s.id; } ).toList( "," ); };

testkit.check( "pins: a full commit", reFind( "^[0-9a-f]{40}$", plan.pins().hyprkwin.commit ) > 0 );
testkit.check( "support: 6.6 and 6.8 tested, 6.7 untested, 6.5 and 5.27 not", plan.plasmaSupport( "6.6.2" ) == "tested" && plan.plasmaSupport( "6.8.0" ) == "tested" && plan.plasmaSupport( "6.7.1" ) == "untested" && plan.plasmaSupport( "6.5.4" ) == "unsupported" && plan.plasmaSupport( "5.27.9" ) == "unsupported" );

p = plan.plasma( facts(), {} );
testkit.check( "fresh install: fetch then install, no keys step", p.errors.len() == 0 && ids( p ) == "fetch,install" );
testkit.check( "fetch clones the repo and checks out the pinned commit", p.steps[1].commands[1][2] == "clone" && p.steps[1].commands[2][6] == plan.pins().hyprkwin.commit && p.steps[1].commands[2][3] == "/tmp/hk" );
testkit.check( "install runs tools/install.sh inside the checkout, as the user (no sudo)", p.steps[2].commands[1].toList( " " ) == "env -C /tmp/hk tools/install.sh" );
testkit.check( "keys stay off by default and the notes say how to enable them", find( "--keys", p.notes.toList( " " ) ) > 0 && find( "Log out", p.notes.toList( " " ) ) > 0 );

p = plan.plasma( facts( { installed: { git: true } } ), {} );
testkit.check( "missing packages: one sudo pacman step first", ids( p ) == "packages,fetch,install" && p.steps[1].commands[1].toList( " " ) == "sudo pacman -S --needed --noconfirm kpackage python-dbus python-gobject qt6-tools swayidle" );
p = plan.plasma( facts( { installed: {}, hasSudo: false } ), {} );
testkit.check( "missing packages without sudo is an error", p.errors.len() == 1 && p.steps.len() == 0 );

p = plan.plasma( facts(), { keys: true } );
testkit.check( "--keys adds the apply step after the install", ids( p ) == "fetch,install,keys-apply" && p.steps[3].commands[1].toList( " " ) == "env -C /tmp/hk python3 tools/hyprkwin-shortcuts.py apply" && p.notes.len() == 1 );
p = plan.plasma( facts( { hyprkwinInstalled: true } ), { undoKeys: true } );
testkit.check( "--undo-keys: fetch then restore, no install", ids( p ) == "fetch,keys-restore" && p.steps[2].commands[1][6] == "restore" );
p = plan.plasma( facts(), { undoKeys: true } );
testkit.check( "--undo-keys without HyprKwin is an error", p.errors.len() == 1 && find( "not installed", p.errors[1] ) > 0 );
p = plan.plasma( facts(), { keys: true, undoKeys: true } );
testkit.check( "--keys with --undo-keys is an error", find( "not both", p.errors.toList( " " ) ) > 0 );
p = plan.plasma( facts( { hyprkwinInstalled: true } ), {} );
testkit.check( "already installed: an update step, no logout note", ids( p ) == "fetch,install" && find( "update HyprKwin", p.steps[2].title ) > 0 && find( "Log out", p.notes.toList( " " ) ) == 0 );

p = plan.plasma( facts( { isRoot: true } ), {} );
testkit.check( "root is refused", p.errors.len() == 1 && p.steps.len() == 0 );
p = plan.plasma( facts( { kwinVersion: "" } ), {} );
testkit.check( "no Plasma is refused", find( "not installed", p.errors[1] ) > 0 );
p = plan.plasma( facts( { kwinVersion: "6.4.0" } ), {} );
testkit.check( "an unsupported Plasma is refused", find( "6.6 and 6.8", p.errors[1] ) > 0 );
p = plan.plasma( facts( { kwinVersion: "6.7.1" } ), {} );
testkit.check( "Plasma 6.7 runs with a warning", p.errors.len() == 0 && p.warnings.len() == 1 );
p = plan.plasma( facts( { sessionType: "x11" } ), {} );
testkit.check( "an X11 Plasma session is refused", find( "Wayland", p.errors[1] ) > 0 );
p = plan.plasma( facts( { desktop: "Hyprland", sessionType: "wayland" } ), {} );
testkit.check( "running it from another desktop is fine", p.errors.len() == 0 );

p = plan.undoPlasma( facts( { hyprkwinInstalled: true } ) );
testkit.check( "undo: fetch then uninstall", ids( p ) == "fetch,uninstall" && p.steps[2].commands[1].toList( " " ) == "env -C /tmp/hk tools/uninstall.sh" );
p = plan.undoPlasma( facts() );
testkit.check( "undo without HyprKwin is an error", p.errors.len() == 1 );

// ---- hyprland
pk = plan.hyprlandPackages();
testkit.check( "hyprland packages: native noctalia, no meta-package, no quickshell variant", arrayFind( pk, "noctalia" ) > 0 && !arrayFind( pk, "cachyos-hypr-noctalia" ) && !arrayFind( pk, "noctalia-shell" ) && !arrayFind( pk, "noctalia-qs" ) && arrayFind( pk, "hyprland" ) > 0 && arrayFind( pk, "uwsm" ) > 0 );
p = plan.hyprland( facts( { installed: {} } ), {} );
testkit.check( "hyprland: one sudo pacman call with every package", p.errors.len() == 0 && ids( p ) == "packages,images,starter,keys" && p.steps[1].commands[1].len() == 5 + pk.len() && p.steps[1].commands[1][1] == "sudo" && p.steps[1].commands[1][2] == "pacman" && p.added.len() == pk.len() );
have = {}; for ( x in pk ) have[x] = true;
p = plan.hyprland( facts( { installed: have } ), {} );
testkit.check( "hyprland: everything installed means no package step, a note, and still the config steps", ids( p ) == "images,starter,keys" && p.errors.len() == 0 && find( "already installed", p.notes[1] ) > 0 && p.added.len() == 0 );
testkit.check( "hyprland: the config steps run no commands (they are executed in process)", p.steps[1].kind == "assets" && p.steps[2].kind == "starter" && p.steps[3].kind == "keys" && p.steps[2].commands.len() == 0 );
part = {}; part["hyprland"] = true; part["ghostty"] = true;
p = plan.hyprland( facts( { installed: part } ), {} );
testkit.check( "hyprland: only the missing packages are installed", p.added.len() == pk.len() - 2 && !arrayFind( p.added, "hyprland" ) && !arrayFind( p.added, "ghostty" ) && arrayFind( p.added, "noctalia" ) > 0 );
// plasma: the Bluetooth service on this path too
plHave = { git: true, kpackage: true, "python-dbus": true, "python-gobject": true, "qt6-tools": true, swayidle: true };
p = plan.plasma( facts( { bluetoothEnabled: false } ), {} );
testkit.check( "plasma: service off and bluez missing means bluez packages, then the service step, then the checkout", ids( p ) == "packages,bluetooth,fetch,install" && arrayFind( p.steps[1].commands[1], "bluez" ) > 0 && arrayFind( p.steps[1].commands[1], "bluez-utils" ) > 0 && p.steps[2].kind == "systemd" && p.steps[2].commands[1].toList( " " ) == "sudo systemctl enable --now bluetooth.service" );
p = plan.plasma( facts( { bluetoothEnabled: true } ), {} );
testkit.check( "plasma: an enabled service gives no Bluetooth step and no bluez package", ids( p ) == "fetch,install" );
nf = facts( {} ); nf.delete( "bluetoothEnabled" );
p = plan.plasma( nf, {} );
testkit.check( "plasma: facts without bluetoothEnabled are read as off", ids( p ) == "packages,bluetooth,fetch,install" );
p = plan.plasma( facts( { installed: { git: true, kpackage: true, "python-dbus": true, "python-gobject": true, "qt6-tools": true, swayidle: true, bluez: true, "bluez-utils": true }, bluetoothEnabled: false } ), {} );
testkit.check( "plasma: bluez present and service off gives only the service step first", ids( p ) == "bluetooth,fetch,install" );
p = plan.plasma( facts( { bluetoothEnabled: false, hyprkwinInstalled: true } ), { undoKeys: true } );
testkit.check( "plasma --undo-keys never enables the service", ids( p ) == "fetch,keys-restore" );
testkit.check( "plasma: the service step needs sudo", plan.plasma( facts( { bluetoothEnabled: false, hasSudo: false } ), {} ).errors.len() == 1 );
p = plan.undoPlasma( facts( { plasmaBluetooth: true, bluetoothEnabled: true, hyprkwinInstalled: true } ) );
testkit.check( "undo plasma: the service setup turned on goes off before the uninstall", ids( p ) == "bluetooth,fetch,uninstall" && p.steps[1].commands[1].toList( " " ) == "sudo systemctl disable --now bluetooth.service" );
p = plan.undoPlasma( facts( { plasmaBluetooth: false, bluetoothEnabled: true, hyprkwinInstalled: true } ) );
testkit.check( "undo plasma: a service setup did not enable is left on", ids( p ) == "fetch,uninstall" );
p = plan.undoPlasma( facts( { plasmaBluetooth: true, bluetoothEnabled: false, hyprkwinInstalled: true } ) );
testkit.check( "undo plasma: a service already off needs no step", ids( p ) == "fetch,uninstall" );

p = plan.hyprland( facts( { installed: {}, bluetoothEnabled: false } ), {} );
testkit.check( "hyprland: bluez is installed and bluetooth.service enabled after the packages (sudo systemctl, as a plan step)", ids( p ) == "packages,bluetooth,images,starter,keys" && p.steps[2].kind == "systemd" && p.steps[2].commands[1].toList( " " ) == "sudo systemctl enable --now bluetooth.service" && arrayFind( p.steps[1].commands[1], "bluez" ) > 0 && arrayFind( p.steps[1].commands[1], "bluez-utils" ) > 0 );
p = plan.hyprland( facts( { installed: have, bluetoothEnabled: false } ), {} );
testkit.check( "hyprland: everything installed but the service off still gets the one service step", ids( p ) == "bluetooth,images,starter,keys" );
p = plan.hyprland( facts( { installed: have } ), {} );
testkit.check( "hyprland: an enabled service adds no step", ids( p ) == "images,starter,keys" );
p = {}; p = plan.hyprland( { isRoot: false, hasSudo: true, installed: have, os: "cachyos", arch: "x86_64", hasPacman: true }, {} );
testkit.check( "hyprland: facts without bluetoothEnabled count as not enabled", ids( p ) == "bluetooth,images,starter,keys" );
testkit.check( "hyprland: the service step needs sudo even when every package is there", plan.hyprland( facts( { installed: have, hasSudo: false, bluetoothEnabled: false } ), {} ).errors.len() == 1 );
testkit.check( "hyprland: root, no pacman, other OS, other CPU and no sudo are refused", plan.hyprland( facts( { isRoot: true } ), {} ).errors.len() == 1 && plan.hyprland( facts( { hasPacman: false } ), {} ).errors.len() == 1 && find( "Unsupported OS", plan.hyprland( facts( { os: "fedora" } ), {} ).errors[1] ) > 0 && find( "x86_64", plan.hyprland( facts( { arch: "aarch64" } ), {} ).errors[1] ) > 0 && plan.hyprland( facts( { hasSudo: false, installed: {} } ), {} ).errors.len() == 1 );
testkit.check( "hyprland: Arch is accepted like CachyOS", plan.hyprland( facts( { os: "arch", installed: {} } ), {} ).errors.len() == 0 );
w = {}; w["noctalia-qs"] = true;
testkit.check( "hyprland: the Quickshell variant installed gives a warning, not an error", plan.hyprland( facts( { installed: w } ), {} ).warnings.len() == 1 && plan.hyprland( facts( { installed: w } ), {} ).errors.len() == 0 );
added = [ "noctalia", "ghostty" ]; haveAdded = { noctalia: true, ghostty: true, hyprland: true };
p = plan.undoHyprland( facts( { hyprlandAdded: added, installed: haveAdded } ) );
testkit.check( "undo hyprland: removes only what setup installed", p.steps.len() == 1 && p.steps[1].commands[1].toList( " " ) == "sudo pacman -Rs --noconfirm noctalia ghostty" );
p = plan.undoHyprland( facts( { hyprlandAdded: [ "bluez", "noctalia" ], installed: { bluez: true, noctalia: true } } ) );
testkit.check( "undo hyprland: bluez added by setup means the service is turned off before the removal", p.steps.len() == 2 && p.steps[1].id == "bluetooth" && p.steps[1].commands[1].toList( " " ) == "sudo systemctl disable --now bluetooth.service" && p.steps[2].id == "remove" );
testkit.check( "undo hyprland: nothing recorded is an error", plan.undoHyprland( facts( { hyprlandAdded: [] } ) ).errors.len() == 1 );
testkit.check( "undo hyprland: already removed is an error", plan.undoHyprland( facts( { hyprlandAdded: added, installed: {} } ) ).errors.len() == 1 );

// setup xremap
function xfacts( over = {} ) {
	f = facts( { desktop: "Hyprland", installed: {}, hasYay: true, user: "dev", groups: [ "dev", "wheel" ], udevRule: false } );
	for ( k in over ) f[k] = over[k];
	return f;
}
x = plan.xremap( xfacts(), {} );
testkit.check( "xremap on Hyprland: package, udev, group, config, service", ids( x ) == "package,udev,group,config,service" && x.steps[1].commands[1][5] == "xremap-hypr-bin" );
testkit.check( "xremap udev step writes one rule line and reloads udev", x.steps[2].commands.len() == 2 && x.steps[2].commands[2][4] contains "reload-rules" && x.steps[2].commands[2][4] contains "|| echo" && find( 'KERNEL=="uinput"', x.steps[2].commands[1][4] ) > 0 && x.steps[2].commands[1][4] contains "99-bxrig-input.rules" );
testkit.check( "xremap remembers what it added", x.added.package == "xremap-hypr-bin" && x.added.group && x.added.udev );
x = plan.xremap( xfacts( { desktop: "KDE" } ), {} );
testkit.check( "xremap on KDE uses the kde build", x.steps[1].commands[1][5] == "xremap-kde-bin" );
x = plan.xremap( xfacts( { desktop: "KDE" } ), { build: "hypr" } );
testkit.check( "--build overrides the detected desktop", x.steps[1].commands[1][5] == "xremap-hypr-bin" );
x = plan.xremap( xfacts( { installed: { "xremap-hypr-bin": true }, udevRule: true, groups: [ "dev", "input" ] } ), {} );
testkit.check( "xremap already set up: only config and service", ids( x ) == "config,service" && x.added.package == "" && !x.added.group && !x.added.udev );
testkit.check( "xremap: unknown desktop is an error", plan.xremap( xfacts( { desktop: "" } ), {} ).errors.len() == 1 );
testkit.check( "xremap: no yay is an error when the package is missing", plan.xremap( xfacts( { hasYay: false } ), {} ).errors.len() == 1 );
testkit.check( "xremap: root is an error", plan.xremap( xfacts( { isRoot: true } ), {} ).errors.len() == 1 );
u = plan.undoXremap( xfacts( { installed: { "xremap-hypr-bin": true } } ), { package: "xremap-hypr-bin", group: true, udev: true } );
testkit.check( "undo xremap: service, package, udev, group", ids( u ) == "service,package,udev,group" );
u = plan.undoXremap( xfacts( { installed: { "xremap-hypr-bin": true } } ), { package: "xremap-hypr-bin", group: false, udev: false } );
testkit.check( "undo xremap leaves a group and rule it did not add", ids( u ) == "service,package" );
testkit.check( "undo xremap: nothing recorded is an error", plan.undoXremap( xfacts(), {} ).errors.len() == 1 );

// session set
function sfacts( over = {} ) {
	f = { isRoot: false, hasSudo: true, sessions: [ { file: "hyprland.desktop", path: "/usr/share/wayland-sessions/hyprland.desktop" }, { file: "hyprland-uwsm.desktop", path: "/usr/share/wayland-sessions/hyprland-uwsm.desktop" }, { file: "plasma.desktop", path: "/usr/share/wayland-sessions/plasma.desktop" } ], stateFile: "/var/lib/sddm/state.conf", stateLines: [ "[Last]", "Session=/usr/share/wayland-sessions/plasma.desktop", "User=dev" ], autologin: "", workDir: "" };
	for ( k in over ) f[k] = over[k];
	return f;
}
se = plan.session( sfacts(), "hyprland" );
testkit.check( "session hyprland prefers the uwsm session", se.errors.len() == 0 && se.chosen == "/usr/share/wayland-sessions/hyprland-uwsm.desktop" && ids( se ) == "backup,write" );
w = se.steps[2].commands[1];
testkit.check( "session write replaces Session= and keeps the other lines", w[1] == "sudo" && w[2] == "sh" && w[5] == "/var/lib/sddm/state.conf" && w[6] == "[Last]" & chr( 10 ) && w[7] == "Session=/usr/share/wayland-sessions/hyprland-uwsm.desktop" & chr( 10 ) && w[8] == "User=dev" & chr( 10 ) && w.len() == 8 );
se = plan.session( sfacts( { sessions: [ { file: "hyprland.desktop", path: "/usr/share/wayland-sessions/hyprland.desktop" } ] } ), "hyprland" );
testkit.check( "session falls back to plain hyprland.desktop", se.chosen == "/usr/share/wayland-sessions/hyprland.desktop" );
se = plan.session( sfacts(), "plasma" );
testkit.check( "session plasma", se.chosen == "/usr/share/wayland-sessions/plasma.desktop" );
se = plan.session( sfacts( { stateLines: [] } ), "plasma" );
testkit.check( "session on a missing state file adds [Last]", se.steps[2].commands[1][6] == "[Last]" & chr( 10 ) && se.steps[2].commands[1][7] == "Session=/usr/share/wayland-sessions/plasma.desktop" & chr( 10 ) );
se = plan.session( sfacts( { stateLines: [ "[Last]", "User=dev" ] } ), "plasma" );
testkit.check( "session without a Session= line gets one inside [Last]", se.steps[2].commands[1].len() == 8 && se.steps[2].commands[1][8] == "Session=/usr/share/wayland-sessions/plasma.desktop" & chr( 10 ) );
testkit.check( "session: unknown target, no such session, root, no sudo are refused", plan.session( sfacts(), "gnome" ).errors.len() == 1 && plan.session( sfacts( { sessions: [] } ), "hyprland" ).errors.len() == 1 && plan.session( sfacts( { isRoot: true } ), "plasma" ).errors.len() == 1 && plan.session( sfacts( { hasSudo: false } ), "plasma" ).errors.len() == 1 );
testkit.check( "session: automatic login is a warning", plan.session( sfacts( { autologin: "plasma" } ), "plasma" ).warnings.len() == 1 );

testkit.done( "setup plan tests passed" );
