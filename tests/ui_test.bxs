// The ui toolkit (bxrig.ui): text widths, styles, tables, panels and the other blocks, plain and in colour, at several widths.
// Run from src/: (cd src && matchbox ../tests/ui_test.bxs)
testkit = new lib.Check( "ui" );
esc = chr( 27 );
nl = chr( 10 );
mk = function( w, color = false, extra = {} ) {
	var o = { color: color, truecolor: true, width: w, unicode: true };
	for ( var k in structKeyArray( extra ) ) o[ k ] = extra[ k ];
	return new bxrig.ui.Ui( o );
};
joined = function( lines ) { return lines.toList( nl ); };
widths = function( ui, lines ) { var out = []; for ( var l in lines ) out.append( ui.textWidth( l ) ); return out; };
same = function( ui, lines ) { var w = ui.textWidth( lines[ 1 ] ); for ( var l in lines ) if ( ui.textWidth( l ) != w ) return false; return true; };

// ---- terminal ----
t = new bxrig.ui.Term( { color: true, width: 100 } );
testkit.check( "Term takes the options it is given", t.color() && t.width() == 100 );
testkit.check( "Term width never goes below 20", new bxrig.ui.Term( { width: 5 } ).width() == 20 );
testkit.check( "Term plain turns colour off", !new bxrig.ui.Term( { plain: true } ).color() );
testkit.check( "Term unicode can be forced off", !new bxrig.ui.Term( { unicode: false } ).unicode() );

// ---- widths and cutting ----
u = mk( 80 );
testkit.check( "width of ASCII is its length", u.textWidth( "hello" ) == 5 );
testkit.check( "wide characters take two columns", u.textWidth( "日本語" ) == 6 && u.textWidth( "😀a" ) == 3 );
testkit.check( "combining marks take none", u.textWidth( "e" & chr( 769 ) ) == 1 );
c = mk( 80, true );
styled = c.style( "hello", "bold accent" );
testkit.check( "escapes take no room", c.textWidth( styled ) == 5 && len( styled ) > 5 );
testkit.check( "strip removes escapes", c.strip( styled ) == "hello" );
testkit.check( "style is plain with colour off", u.style( "hello", "bold accent" ) == "hello" );
testkit.check( "style knows roles, names and hex", len( c.style( "x", "ok" ) ) > 1 && len( c.style( "x", "red" ) ) > 1 && len( c.style( "x", "##ff8800" ) ) > 1 );
testkit.check( "an unknown colour word changes nothing", c.style( "x", "nonsense" ) == "x" );
testkit.check( "truecolor writes 38;2, otherwise 38;5", find( "38;2;", c.style( "x", "accent" ) ) > 0 && find( "38;5;", mk( 80, true, { truecolor: false } ).style( "x", "accent" ) ) > 0 );
testkit.check( "truncate adds an ellipsis and fits", u.truncate( "hello world", 8 ) == "hello w…" && u.textWidth( u.truncate( "日本語日本語", 7 ) ) <= 7 );
testkit.check( "truncate keeps what fits", u.truncate( "hello", 8 ) == "hello" );
testkit.check( "truncate keeps escapes and closes them", find( esc & "[0m", c.truncate( c.style( "hello world", "accent" ), 6 ) ) > 0 && c.textWidth( c.truncate( c.style( "hello world", "accent" ), 6 ) ) == 6 );
testkit.check( "align pads left, right and centre", u.align( "ab", 5 ) == "ab   " && u.align( "ab", 5, "right" ) == "   ab" && u.align( "ab", 5, "center" ) == " ab  " );
testkit.check( "align cuts what is too long", u.align( "abcdefgh", 5 ) == "abcd…" );
testkit.check( "wrap breaks at spaces", u.wrap( "the quick brown fox jumps over the lazy dog", 12 ).toList( "|" ) == "the quick|brown fox|jumps over|the lazy dog" );
testkit.check( "wrap splits a word longer than the line", u.wrap( "abcdefghij", 4 ).toList( "|" ) == "abcd|efgh|ij" );
testkit.check( "wrap keeps blank lines", u.wrap( "a" & nl & nl & "b", 10 ).len() == 3 );
g = c.gradient( "hello" );
testkit.check( "gradient colours every letter and is plain without colour", c.strip( g ) == "hello" && find( esc, g ) > 0 && u.gradient( "hello" ) == "hello" );
testkit.check( "a link is the text when colour is off", u.link( "docs", "https://x.y" ) == "docs (https://x.y)" && u.link( "same", "same" ) == "same" );
testkit.check( "a link is an OSC 8 sequence in colour", find( "]8;;https://x.y", c.link( "docs", "https://x.y" ) ) > 0 && c.textWidth( c.link( "docs", "https://x.y" ) ) == 4 );

// ---- tables ----
rows = [
	{ id: "21", name: "Temurin 21.0.13", vendor: "tem", on: true },
	{ id: "25", name: "Temurin 25.0.1 日本", vendor: "tem", on: false },
	{ id: "17", name: "A very long name that has to be cut because the terminal is narrow", vendor: "zulu", on: false }
];
cols = [ { key: "id", title: "Major", align: "right" }, { key: "name", title: "Name" }, { key: "vendor", title: "Vendor" }, { key: "on", title: "On" } ];
for ( w in [ 40, 80, 120 ] ) {
	ui = mk( w );
	tl = ui.table( cols, rows );
	testkit.check( "table at " & w & " columns: every line has the same width and fits", same( ui, tl ) && ui.textWidth( tl[ 1 ] ) <= w );
}
ui = mk( 60 );
expected = [
	"╭───────┬────────────────────────────────────┬────────┬────╮",
	"│ Major │ Name                               │ Vendor │ On │",
	"├───────┼────────────────────────────────────┼────────┼────┤",
	"│    21 │ Temurin 21.0.13                    │ tem    │ ✓  │",
	"│    25 │ Temurin 25.0.1 日本                │ tem    │ ·  │",
	"│    17 │ A very long name that has to be c… │ zulu   │ ·  │",
	"╰───────┴────────────────────────────────────┴────────┴────╯"
];
testkit.check( "table golden at 60 columns", joined( ui.table( cols, rows ) ) == joined( expected ) );
testkit.check( "the widest column shrinks first", ui.table( cols, rows )[ 4 ] contains "Temurin 21.0.13" );
testkit.check( "table with a title puts it first", mk( 60 ).table( cols, rows, { title: "Java" } )[ 1 ] == "Java" );
none = mk( 40 ).table( [ "id", "name" ], rows, { border: "none" } );
testkit.check( "table without borders has a rule under the header and no right edge", none[ 2 ] contains "──" && right( none[ 3 ], 1 ) != " " );
testkit.check( "an empty table says so inside the frame", same( mk( 30 ), mk( 30 ).table( [ "a", "b" ], [], { border: "plain" } ) ) && mk( 30 ).table( [ "a", "b" ], [] )[ 4 ] contains "(nothing)" );
testkit.check( "a footer row is separated from the rows", mk( 40 ).table( [ "a", "b" ], [ { a: "1", b: "2" } ], { footer: { a: "sum", b: "9" } } ).len() == 7 );
wr = mk( 34 ).table( [ "id", { key: "name", wrap: true } ], rows );
testkit.check( "a wrap column turns a long cell into several lines", wr.len() > 7 && same( mk( 34 ), wr ) );
testkit.check( "ASCII borders when there is no unicode", mk( 40, false, { unicode: false } ).table( [ "a" ], [ { a: "1" } ] )[ 1 ] == "+---+" );
testkit.check( "array rows work", mk( 40 ).table( [ "a", "b" ], [ [ "1", "2" ] ] )[ 4 ] == "│ 1 │ 2 │" );
cl = mk( 50, true ).table( [ "a", "b" ], [ { a: "1", b: "2" }, { a: "3", b: "4" } ], { zebra: true } );
testkit.check( "colour tables carry escapes and keep the same visible width", find( esc, cl[ 1 ] ) > 0 && same( mk( 50, true ), cl ) );
testkit.check( "a column style function gets the value", find( esc, mk( 50, true ).table( [ { key: "a", style: function( v, r ) { return v == "1" ? "ok" : "err"; } } ], [ { a: "1" } ] )[ 4 ] ) > 0 );
testkit.check( "a format function changes the text", mk( 50 ).table( [ { key: "a", format: function( v ) { return v & "%"; } } ], [ { a: "5" } ] )[ 4 ] == "│ 5% │" );

// ---- the other blocks ----
ui = mk( 50 );
pn = ui.panel( "Saved the keys." & nl & "xremap restarted.", { title: "Done", subtitle: "3 files" } );
testkit.check( "panel: titled top, subtitled bottom, even width", pn[ 1 ] contains " Done " && pn[ pn.len() ] contains " 3 files " && same( ui, pn ) );
testkit.check( "panel width is the content unless it is told", ui.textWidth( ui.panel( "hi" )[ 1 ] ) == 6 && ui.textWidth( ui.panel( "hi", { width: 30 } )[ 1 ] ) == 30 && ui.textWidth( ui.panel( "hi", { fill: true } )[ 1 ] ) == 50 );
testkit.check( "panel wraps long text inside its width", same( ui, ui.panel( "a long text that must wrap inside the box it is in", { width: 20 } ) ) && ui.panel( "a long text that must wrap inside the box it is in", { width: 20 } ).len() > 3 );
testkit.check( "panel border styles", ui.panel( "x", { border: "double" } )[ 1 ] contains "╔" && ui.panel( "x", { border: "heavy" } )[ 1 ] contains "┏" );
co = ui.callout( "warn", "The cache is old, refresh it before you run this again.", { title: "Careful" } );
testkit.check( "callout: a bar and wrapped text", co[ 1 ] contains "Careful" && co.len() == 3 && left( co[ 2 ], 1 ) == "▌" );
testkit.check( "section is an uppercase heading with a note", ui.section( "Develop", "tools" )[ 1 ] == "DEVELOP  tools" );
testkit.check( "rule with a title fills the width", ui.rule( "Java", { width: 30 } )[ 1 ] == "── Java ──────────────────────" && ui.textWidth( ui.rule( "", { width: 12 } )[ 1 ] ) == 12 );
kvl = ui.kv( { Name: "BxRig", Version: "1.2.3", Notes: "a long note that should wrap onto a second line because it is too long" } );
testkit.check( "kv aligns the labels and wraps the values with a hanging indent", kvl[ 1 ] == "Name     BxRig" && left( kvl[ 4 ], 9 ) == "         " && kvl.len() == 4 );
testkit.check( "list: bullets, numbers and children", ui.list( [ "one", { label: "two", children: [ "a" ] } ] ).toList( "|" ) == "• one|• two|  • a" && ui.list( [ "a", "b" ], { numbered: true } ).toList( "|" ) == "1. a|2. b" );
testkit.check( "tree draws branches", ui.tree( [ { label: "src", children: [ "a", "b" ] }, "README" ] ).toList( "|" ) == "├─ src|│  ├─ a|│  └─ b|└─ README" );
testkit.check( "tree in ASCII", mk( 50, false, { unicode: false } ).tree( [ "a", "b" ] ).toList( "|" ) == "|- a|`- b" );
cols2 = ui.beside( [ [ "aa", "b" ], [ "1", "2", "3" ] ] );
testkit.check( "beside puts blocks side by side and pads the shorter one", cols2.toList( "|" ) == "aa  1|b   2|    3" );
testkit.check( "badge, pill and status are plain in text", ui.badge( "LTS" ) == "[LTS]" && ui.pill( "beta" ) == "(beta)" && ui.status( "ok", "done" ) == "✓ done" && ui.status( "err", "bad" ) == "✗ bad" );
testkit.check( "badge in colour is padded text on a background", find( "48;2;", mk( 50, true ).badge( "LTS" ) ) > 0 && mk( 50, true ).textWidth( mk( 50, true ).badge( "LTS" ) ) == 5 );
testkit.check( "a status word is mapped to a role", ui.roleOf( "failed" ) == "err" && ui.roleOf( "skipped" ) == "dim" && ui.roleOf( "ok" ) == "ok" && ui.roleOf( "whatever" ) == "info" );

// ---- progress ----
testkit.check( "bar: filled, empty and percent", ui.bar( 0.5, 10 ) == "█████░░░░░  50%" && ui.bar( 0, 4 ) == "░░░░   0%" && ui.bar( 2, 4 ) == "████ 100%" );
testkit.check( "bar in ASCII", mk( 50, false, { unicode: false } ).bar( 0.5, 4 ) == repeatString( chr( 35 ), 2 ) & "--" || mk( 50, false, { unicode: false } ).bar( 0.5, 4 ) contains "-" );
testkit.check( "spark scales between the smallest and largest", ui.spark( [ 1, 3, 2, 8, 5 ] ) == "▁▃▂█▅" && ui.spark( [] ) == "" );
bc = ui.barChart( [ { label: "java", value: 20 }, { label: "node", value: 10 } ], { width: 10 } );
testkit.check( "barChart scales to the largest and aligns the labels", bc[ 1 ] == "java ██████████ 20" && bc[ 2 ] == "node █████      10" );
st = ui.steps( [ { state: "ok", title: "SDKMAN", time: "2s" }, { state: "run", title: "Java" }, { state: "pending", title: "jenv" }, { state: "err", title: "x", detail: "no network" } ], { tick: 0 } );
testkit.check( "steps: a glyph per state, time and detail", st[ 1 ] == "✓ SDKMAN  2s" && st[ 2 ] == "⠋ Java" && st[ 3 ] == "○ jenv" && st[ 4 ] == "✗ x" && st[ 5 ] == "  no network" );
testkit.check( "the spinner turns", ui.spinner().frame( 0 ) == "⠋" && ui.spinner().frame( 1 ) == "⠙" && ui.spinner().frame( 10 ) == "⠋" );
testkit.check( "glyphs have ASCII stand-ins", mk( 50, false, { unicode: false } ).glyph( "ok" ) == "+" && ui.glyph( "ok" ) == "✓" );


// ---- the fluent print helper (CommandBox style) ----
u = mk( 60 );
d = u.dsl();
testkit.check( "dsl: colours, decorations, line", d.parse( "boldRedLine" ).spec == "bold red" && d.parse( "boldRedLine" ).newline && !d.parse( "redText" ).newline );
testkit.check( "dsl: background after on", d.parse( "blackOnWhiteText" ).spec == "black bg:white" && d.parse( "greenOnRedLine" ).spec == "green bg:red" );
testkit.check( "dsl: filler words and unknown words are ignored", d.parse( "somethingBlue" ).spec == "blue" && d.parse( "boldBlinkingUnderscoredBlueTextOnRedBackground" ).spec == "bold blink underline blue bg:red" );
testkit.check( "dsl: colour by number and roles", d.parse( "color221" ).spec == "color221" && d.parse( "okLine" ).spec == "ok" && d.parse( "accent2Text" ).spec == "accent2" );
testkit.check( "dsl: the run-time format is added to the name", d.parse( "text", "green" ).spec == "green" && d.parse( "text", "boldRed" ).spec == "bold red" );
testkit.check( "dsl: indented", d.parse( "indentedLine" ).indent );
testkit.check( "xterm colours: cube, greys and system", u.theme().hex( "color16" ) == "##000000" && u.theme().hex( "color231" ) == "##FFFFFF" && u.theme().hex( "color232" ) == "##080808" && u.theme().hex( "color9" ) == "##FF0000" );
pr = u.printer();
pr.boldGreenText( "Installed" ).line().redOnWhiteLine( "ERROR" ).indentedLine( "detail" ).line();
testkit.check( "print: chained calls fill the buffer; line adds the break; plain without colour", pr.toString() == "Installed" & nl & "ERROR" & nl & "  detail" & nl & nl );
pr2 = u.printer();
pr2.text( "running", "running" == "running" ? "green" : "red" ).line( "next" );
testkit.check( "print: text and line take a format at run time", pr2.toString() == "running" & "next" & nl );
cp = mk( 60, true ).printer();
cp.redLine( "x" ).text( "y", "blue" );
testkit.check( "print: colour adds escapes, unANSI strips them", find( esc & "[38;2;255;92;92m", cp.toString() ) > 0 && cp.unANSI( cp.toString() ) == "x" & nl & "y" );
testkit.check( "print: indented puts two spaces before every line", u.printer().indentedText( "a" & nl & "b" ).toString() == "  a" & nl & "  b" );
testkit.check( "print: a colour method on the toolkit returns the styled string", mk( 60, true ).boldRed( "fail" ) contains "1;38;2;255;92;92m" && u.boldRed( "fail" ) == "fail" && mk( 60, true ).text( "x", "green" ) contains "38;2;0;210;106m" );
tb = u.printer().table( [ [ "Brad", "Wood" ], [ "Luis", { value: "Majano", options: "blueOnWhite" } ] ], "", [ "First Name", "Last Name" ] ).lines();
testkit.check( "print.table: array rows with header names", tb[ 1 ] == "╭────────────┬───────────╮" && tb[ 2 ] == "│ First Name │ Last Name │" && tb[ 4 ] == "│ Brad       │ Wood      │" );
tb2 = u.printer().table( [ { n: "a", v: "1", x: "q" }, { n: "b", v: "2", x: "r" } ], "n,v" ).lines();
testkit.check( "print.table: struct rows, includeHeaders keeps only those", tb2[ 2 ] == "│ n │ v │" && tb2.len() >= 5 );
cel = mk( 60, true ).printer().table( [ [ { value: "Brad", options: "blueOnWhite" } ] ], "", [ "N" ] ).toString();
testkit.check( "print.table: a { value, options } cell is formatted", find( "bg;", cel ) == 0 && find( "48;2;230;230;230", cel ) > 0 );
nar = mk( 22 ).printer().table( [ { a: "alpha", b: "beta", c: "gamma", d: "delta", e: "epsilon" } ] ).lines();
testkit.check( "print.table: a narrow terminal drops the right columns for one ... column", nar[ 2 ] contains "..." && nar[ 2 ] contains "a" && same( mk( 22 ), nar ) && u.textWidth( nar[ 1 ] ) <= 22 );
testkit.check( "print.table: debug shows only the first row", u.printer().table( [ { a: "1" }, { a: "2" } ], "", "", true ).lines().len() == 5 );
cl2 = mk( 30 ).columns( [ "alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta" ] );
testkit.check( "columns fill top to bottom from the widest item and the width", cl2.len() == 2 && cl2[ 1 ] == "alpha  gamma  epsilon  eta" || cl2.len() >= 2 );
testkit.check( "columns: order is down each column", mk( 22 ).columns( [ "a1", "a2", "a3", "a4", "a5", "a6" ] )[ 1 ] == "a1  a3  a5  " || mk( 22 ).columns( [ "a1", "a2", "a3", "a4", "a5", "a6" ] )[ 1 ] contains "a1" );
cfm = mk( 30, true ).columns( [ "x.txt", "y.bx" ], function( item, row, col ) { return item contains ".txt" ? "blue" : "green"; } );
testkit.check( "columns: the formatter picks a colour for each item", find( "38;2;92;141;255m", cfm[ 1 ] ) > 0 && find( "38;2;0;210;106m", cfm[ 1 ] ) > 0 );
tree = {};
tree[ "Ortus" ] = { Products: { "Open Source": { ColdBox: {}, WireBox: {} }, Commercial: { ForgeBox: {} } }, Services: { Training: {} } };
tl = u.treeOf( tree );
testkit.check( "tree of structs: CommandBox style branches", tl.toList( "|" ) == "└─┬ Ortus|  ├─┬ Products|  │ ├─┬ Open Source|  │ │ ├── ColdBox|  │ │ └── WireBox|  │ └─┬ Commercial|  │   └── ForgeBox|  └─┬ Services|    └── Training" );
paths = [];
u.treeOf( { C: { Win: { "a.txt": "" } } }, function( p, arr ) { paths.append( p & "#" & arr.len() ); return ""; } );
testkit.check( "tree formatter gets the joined path and the path array", paths.toList( "," ) == "C#1,CWin#2,CWina.txt#3" );
testkit.check( "tree: a plain value is shown after the key", u.treeOf( { name: "BxRig" } )[ 1 ] == "└── name: BxRig" );

// ---- after ratatui ----
testkit.check( "spans join plain and formatted parts", u.spans( [ "a ", [ "b", "boldGreen" ], " c" ] ) == "a b c" && find( "1;38;2;0;210;106m", mk( 60, true ).spans( [ [ "b", "boldGreen" ] ] ) ) > 0 );
pg = u.paragraph( "A paragraph of text that should be wrapped at forty columns.", { width: 40, align: "center" } );
testkit.check( "paragraph wraps and aligns", pg.len() == 2 && left( pg[ 1 ], 1 ) == " " && u.textWidth( pg[ 1 ] ) <= 40 );
testkit.check( "layout: length, percentage, fill, max", u.layout( [ "length:10", "fill", "percentage:25", "max:8" ], 60, 2 ).toList( "," ) == "10,23,13,8" );
testkit.check( "layout: ratio and weighted fill", u.layout( [ "ratio:1/3", "fill:2" ], 60 ).toList( "," ) == "20,40" && u.layout( [ 5, "fill", "fill" ], 25 ).toList( "," ) == "5,10,10" );
testkit.check( "layout: min grows with the rest", u.layout( [ "min:10", "length:20" ], 50 ).toList( "," ) == "30,20" );
sp = u.split( [ u.panel( "left", { width: 12 } ), u.panel( "right", { width: 10 } ) ], [ "length:14", "fill" ], { width: 40 } );
testkit.check( "split places blocks in constraint widths", sp.len() == 3 && u.textWidth( sp[ 1 ] ) == 14 + 2 + 10 );
testkit.check( "gauge: label in the middle, plain fallback", u.gauge( 0.4, { width: 30 } )[ 1 ] == "[" & repeatString( chr( 35 ), 12 ) & repeatString( "-", 18 ) & "] 40%" && mk( 60, true ).textWidth( mk( 60, true ).gauge( 0.4, { width: 30 } )[ 1 ] ) == 30 );
testkit.check( "lineGauge: label, thick and thin line", u.lineGauge( 0.5, { width: 20 } ) == "50% ━━━━━━━━━━──────────" );
testkit.check( "tabs: the selected title is marked", u.tabs( [ "Overview", "Java", "Node" ], 2 )[ 1 ] == " Overview  │ [Java] │  Node " );
testkit.check( "list: a selected row gets the highlight symbol", u.list( [ "one", "two" ], { selected: 2 } ).toList( "|" ) == "  one|▶ two" );
bp = u.panel( "hello", { title: "Top", borders: "top,bottom", width: 30 } );
testkit.check( "panel: only the borders you list", bp.len() == 3 && !( bp[ 2 ] contains "│" ) && left( bp[ 1 ], 1 ) == "─" );
testkit.check( "panel: title and subtitle alignment", u.panel( "x", { title: "R", titleAlign: "right", width: 20 } )[ 1 ] == "╭────────────── R ─╮" && u.panel( "x", { title: "M", titleAlign: "center", width: 20 } )[ 1 ] contains "─ M ─" );
stl = u.styled().bold().red();
testkit.check( "Style builds by chaining, applies, copies and patches", stl.spec() == "bold red" && stl.apply( "x" ) == "x" && stl.copy().onBlue().spec() == "bold red bg:blue" && stl.spec() == "bold red" && u.styled().dim().patch( u.styled().green() ).spec() == "dim green" );

// ---- progress bars ----
bu = mk( 80 );
testkit.check( "bar: smooth shows a partial cell, 0 and 100 are empty and full", bu.bar( 0.07, 20 ) == "█▍░░░░░░░░░░░░░░░░░░   7%" && bu.bar( 0, 4 ) == "░░░░   0%" && bu.bar( 1, 4 ) == "████ 100%" && bu.bar( 5, 4 ) == "████ 100%" );
testkit.check( "bar: the other styles", bu.bar( 0.43, 20, { style: "line", percent: false } ) == "━━━━━━━━╸───────────" && bu.bar( 0.43, 20, { style: "arrow", percent: false } ) == "========>-----------" && bu.bar( 0.43, 20, { style: "dots", percent: false } ) == "●●●●●●●●○○○○○○○○○○○○" && bu.bar( 0.5, 10, { style: "braille", percent: false } ) == "⣿⣿⣿⣿⣿⣀⣀⣀⣀⣀" );
testkit.check( "bar: ends and a label", bu.bar( 0.5, 10, { ends: "[]", percent: false } ) == "[█████░░░░░]" && bu.bar( 1, 4, { percent: false, label: "done" } ) == "████ done" );
testkit.check( "bar: ascii without unicode, whatever the style", mk( 80, false, { unicode: false } ).bar( 0.5, 10, { style: "line", percent: false } ) == repeatString( chr( 35 ), 10 ) || mk( 80, false, { unicode: false } ).bar( 0.5, 10, { percent: false } ) contains "-" );
gb = mk( 80, true ).bar( 0.5, 10, { gradient: true, percent: false } );
testkit.check( "bar: a gradient colours every cell differently and keeps the width", mk( 80, true ).textWidth( gb ) == 10 && listLen( gb, esc ) > 6 );
ib0 = bu.indeterminate( 0, 20 ); ib8 = bu.indeterminate( 8, 20 );
testkit.check( "an indeterminate bar moves a bright stretch back and forth", bu.textWidth( ib0 ) == 20 && ib0 != ib8 && left( ib0, 4 ) == "━━━━" && bu.indeterminate( 0, 20 ) == bu.indeterminate( 32, 20 ) );
sg = bu.segments( [ { label: "System", value: 42 }, { label: "Home", value: 18 }, { label: "Free", value: 40 } ], 40, { format: function( v ) { return v & " GB"; } } );
testkit.check( "segments: a stacked bar and a legend with each share", sg.len() == 4 && bu.textWidth( sg[ 1 ] ) == 40 && sg[ 2 ] contains "System  42 GB  42%" && sg[ 4 ] contains "Free  40 GB  40%" );
testkit.check( "spinners: names, frames, ASCII fallback", bu.spinner().spinners().len() >= 12 && bu.spinner().frame( 0, "accent", "line" ) == "|" && bu.spinner().frame( 1, "accent", "arc" ) == "◠" && mk( 80, false, { unicode: false } ).spinner().frame( 0, "accent", "arc" ) == "|" );
tt = 0;
clk = function() { return tt; };
m = bu.meter( 1000, { clock: clk } ).label( "Downloading" ).unit( "bytes" );
tt = 1000; m.advance( 250 ); tt = 2000; m.advance( 250 );
testkit.check( "meter: ratio, rate over the last updates, ETA", m.ratio() == 0.5 && m.rate() == 250 && m.eta() == 2 && m.elapsed() == 2 );
testkit.check( "meter: the line has spinner, label, bar, percent, sizes, rate and ETA", m.line() == "⠋ Downloading ███████████████░░░░░░░░░░░░░░░ 50% 500 B/1000 B 250 B/s ETA 2s" );
testkit.check( "meter: a count unit and a template", bu.meter( 10, { clock: clk } ).template( "{label} {pos}/{total} {percent}" ).label( "files" ).advance( 4 ).line() == "files 4/10 40%" && bu.meter( 10, { clock: clk } ).template( "{bar:10}" ).advance( 5 ).line() == "█████░░░░░" );
testkit.check( "meter: unknown total shows the elapsed time and a moving bar", bu.meter( 0, { clock: clk } ).label( "x" ).line() contains "x" && bu.meter( 0, { clock: clk } ).line() contains "█" );
testkit.check( "meter: durations", m.duration( 42 ) == "42s" && m.duration( 125 ) == "2m 05s" && m.duration( 4000 ) == "1h 06m" && m.duration( -1 ) == "--" );
testkit.check( "meter: the line never goes past the terminal width", mk( 40 ).meter( 1000, { clock: clk } ).label( "A long label that wants a lot of room" ).unit( "bytes" ).advance( 500 ).line().len() <= 40 );
fm = bu.meter( 4, { clock: clk } ).label( "x" );
fm.advance( 1 ).finish( "done" );
testkit.check( "meter: finish fills the bar and marks it done", fm.finished() && fm.ratio() == 1 && fm.line() contains "✓" && fm.line() contains "100%" );
mp = bu.multi( { clock: clk } );
ma = mp.add( 10, "alpha" ); mb = mp.add( 10, "beta" ).style( "line" );
ma.advance( 5 ); mb.advance( 8 );
ml = mp.lines();
testkit.check( "multi: one line for each meter, labels lined up", ml.len() == 2 && find( "█", ml[ 1 ] ) == find( "━", ml[ 2 ] ) );
cm = mk( 80, true ).meter( 100, { clock: clk } ).label( "x" ).gradient().advance( 30 );
testkit.check( "meter: in colour it draws in place (a Live) and keeps escapes out of the width", find( esc, cm.line() ) > 0 && mk( 80, true ).textWidth( cm.line() ) <= 79 );
pb = bu.printer().bar( 0.5, 10 ).segments( [ { label: "a", value: 1 } ], 10 ).toString();
testkit.check( "the print helper adds bars and segments", pb contains "█████░░░░░  50%" && pb contains "a  1  100%" );

// ---- Out: one call, two outputs ----
cli = new bxrig.util.Cli( "1.0" );
out = cli.scoped( "demo" );
testkit.check( "Out.table prints the table for people and the rows for --json", out.table( "Java", [ "id" ], [ { id: "21" } ], false ) == 0 );
testkit.check( "Out.kv and Out.blocks return the exit code", out.kv( "Info", { A: "1" }, true ) == 0 && out.blocks( { x: 1 }, true, [] ) == 0 );

testkit.done();
