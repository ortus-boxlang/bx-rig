// The Control Center's Look page: its settings, what a key asks for, what it shows, and the colours of the screen. Run from src/: (cd src && matchbox ../tests/look_page_test.bxs)
testkit = new lib.Check( "look page" );
tui = createObject( "rust", "tui.TUI" );
view = new bxrig.ControlCenterView( tui );
page = new bxrig.LookPage( true );
app = new bxrig.ControlCenterApp( new bxrig.ControlCenter( {} ).buildPages( true ), "look" );
page = app.page();
function seek( n ) { app.goto( "look" ); while ( app.page().state().cursor > n ) app.onKey( "Up" ); while ( app.page().state().cursor < n ) app.onKey( "Down" ); }
function shot( w = 120, h = 40 ) { view.paint( app, 10, w, h ); return tui.render_to_string( w, h ); }

reg = new bxrig.ControlCenterPages();
testkit.check( "registry: Look sits before Themes, which stays its own page", find( "secrets,look,themes,accessibility,logs", reg.ids().toList( "," ) ) > 0 && reg.find( "look" ).title == "Look" && reg.find( "themes" ).title == "Themes" );
testkit.check( "the page builds, for the real run and for --demo", new bxrig.PageFactory().make( "look", true, {} ).id() == "look" && new bxrig.PageFactory().make( "themes", false, {} ).id() == "themes" );

s = page.state();
testkit.check( "rows: layout, battery, clock, bar toggle, theme, app grid, dock, screensaver, its timing", s.items.map( function( r ) { return r.id; } ).toList( "," ) == "layout,battery,clock,toggle,theme,appgrid,dock,screensaver,screensaver-time" );
testkit.check( "rows: no theme list on the page (the theme is a link to the Themes page)", s.items.filter( function( r ) { return r.id == "theme"; } )[ 1 ].kind == "link" && s.items.filter( function( r ) { return r.kind == "choice"; } ).len() == 3 );

t = shot();
testkit.check( "screen: the title, the preview of the bar and the dock, the three groups", find( "Look", t ) > 0 && find( "Preview", t ) > 0 && find( "Nov 5 - 04:00", t ) > 0 && find( "▦", t ) > 0 && find( "Bar", t ) > 0 && find( "Colors", t ) > 0 && find( "Apps", t ) > 0 );
testkit.check( "screen: every setting with its value", find( "Top bar layout", t ) > 0 && find( "‹ Standard ›", t ) > 0 && find( "Battery percentage", t ) > 0 && find( "Clock format", t ) > 0 && find( "Bar toggle shortcut", t ) > 0 && find( "Super+Shift+Space", t ) > 0 && find( "Color theme", t ) > 0 && find( "BxRig", t ) > 0 && find( "App grid style", t ) > 0 && find( "Launchpad grid", t ) > 0 && find( "Dock", t ) > 0 );
testkit.check( "screen: the selected setting shows what it does and its command", find( "Selected", t ) > 0 && find( "$  bxrig appearance bar layout standard", t ) > 0 );
testkit.check( "screen: a Look page has no theme list", find( "Tokyo Night", t ) == 0 && find( "Catppuccin", t ) == 0 );

// keys ask for ordinary commands; the plan box comes before anything runs
it = app.onKey( "Right" );
testkit.check( "Right on the layout asks for the next layout (Dense)", it.action == "cli" && it.args.toList( " " ) == "appearance bar layout dense" );
it = app.onKey( "-" );
testkit.check( "- asks for the previous one (Minimal)", it.args.toList( " " ) == "appearance bar layout minimal" );
app.onKey( "Down" );
it = app.onKey( "Enter" );
testkit.check( "Enter on the battery percentage flips it", it.args.toList( " " ) == "appearance battery-percent on" );
app.onKey( "Down" );
it = app.onKey( "Enter" );
testkit.check( "Enter on the clock format opens a question box", app.mode() == "ask" && app.ask().title == "Clock format" );
for ( ch in [ "%", "H", ":", "%", "M" ] ) app.onKey( ch );
it = app.onKey( "Enter" );
testkit.check( "the typed format becomes `time format %H:%M`", it.action == "cli" && it.args.toList( " " ) == "time format %H:%M" );
app.onKey( "Down" );
app.onKey( "Enter" );
testkit.check( "the bar toggle shortcut row opens the Shortcuts page", app.page().id() == "shortcuts" );
seek( 5 ); app.onKey( "Enter" );
t = shot();
testkit.check( "the theme row opens the Themes page (the bigger selector), with its list and the apply key", app.page().id() == "themes" && find( "Themes", t ) > 0 && find( "Tokyo Night", t ) > 0 && find( "plan", t ) > 0 );
seek( 6 );
it = app.onKey( "Right" );
testkit.check( "Right on the app grid switches style (and + does the same)", it.args.toList( " " ) == "appearance appgrid terminal" );
app.onKey( "Down" );
it = app.onKey( " " );
testkit.check( "Space on the dock turns it off", it.args.toList( " " ) == "appearance dock off" );
app.onKey( "Down" ); app.onKey( "Down" ); app.onKey( "Down" );
testkit.check( "the cursor stops on the last row", app.page().state().cursor == 9 );

// clicks
view.paint( app, 10, 120, 40 );
testkit.check( "a click on a row selects it", ( function() { var y = 0; var ls = listToArray( tui.render_to_string( 120, 40 ), chr( 10 ), true ); for ( var i = 1; i <= ls.len(); i++ ) if ( find( "Clock format", ls[ i ] ) ) { y = i - 1; break; } var r = app.act( view.hitAt( 30, y ) ); return y > 0 && app.page().state().cursor == 3; } )() );

// small windows keep the settings and drop the pictures
small = shot( 80, 24 );
testkit.check( "80 x 24: the settings still show", find( "Top bar layout", small ) > 0 && find( "App grid style", small ) > 0 );

// the real (not demo) page reads its values through the status commands; with none it keeps the defaults
real = new bxrig.LookPage( false ); real.load();
testkit.check( "real page: no appearance commands answering means Standard, Launchpad, dock on", real.state().look.layout == "standard" && real.state().look.appgrid == "launchpad" && real.state().look.dock == true );
testkit.check( "data: the demo values", new bxrig.LookData( true ).load().clock_sample == "Nov 5 - 04:00" );

// the status answers a fake bxrig gives
fake = { selfData: function( args, timeout = 30 ) {
		var key = args.toList( " " );
		if ( key == "appearance bar layout status" ) return { layout: "dense", dock: false, battery: true };
		if ( key == "appearance appgrid status" ) return { appgrid: "terminal" };
		if ( key == "appearance battery-percent status" ) return { battery_percent: "on", battery_found: false };
		if ( key == "time format" ) return { format: "%H:%M", sample: "04:00" };
		if ( key == "screensaver status" ) return { enabled: false, screensaver: 300, lock: 600 };
		if ( key == "keys show" ) return { shortcuts: [ { id: "x", keys: "a" }, { id: "bar-toggle", keys: "Super+Alt+B" } ] };
		return {};
	} };
got = new bxrig.LookData( false, fake ).load();
testkit.check( "data: the layout, dock, grid, battery, clock and toggle key come from the status commands", got.layout == "dense" && got.dock == false && got.appgrid == "terminal" && got.battery_percent == "on" && got.battery_found == false && got.clock_format == "%H:%M" && got.clock_sample == "04:00" && got.bar_toggle_keys == "Super+Alt+B" );

testkit.check( "data: the screensaver comes from its status command", got.screensaver == false && got.screensaver_seconds == 300 && got.lock_seconds == 600 );
sp = new bxrig.LookPage( true );
while ( sp.state().cursor < 8 ) sp.onKey( "Down" );
testkit.check( "Screen: the screensaver row switches it off", sp.onKey( "Enter" ).args.toList( " " ) == "screensaver off" );
sp.onKey( "Down" );
testkit.check( "Screen: the timing steps from 2.5 / 5 min to 5 / 10 min", sp.onKey( "+" ).args.toList( " " ) == "screensaver set screensaver=300 lock=600" );
testkit.check( "Screen: and back around to 15 / 30 min", sp.onKey( "-" ).args.toList( " " ) == "screensaver set screensaver=900 lock=1800" );
testkit.check( "Screen: the timing reads in minutes", sp.state().items[ 9 ].value == "2.5 min, lock 5 min" );

// the colours of the Control Center follow the active theme
view2 = new bxrig.ControlCenterView( tui );
testkit.check( "colours: the view starts with the BxRig palette and does not follow a theme unless asked", view2.kit().color( "BASE" ) == "##303446" );
home = testkit.tmp();
env = new bxrig.util.Env( { HOME: home, BXRIG_CONFIG_HOME: home & "/cfg" } );
directoryCreate( home & "/cfg/bxrig", true, true );
fileWrite( home & "/cfg/bxrig/theme.json", '{"name":"nord","mode":"theme"}' );
nordBase = new bxrig.Palette().colorsOf( "nord" ).background;
gruvBase = new bxrig.Palette().colorsOf( "gruvbox" ).background;
view3 = new bxrig.ControlCenterView( tui ).followTheme( true, new bxrig.Palette( env ) );
testkit.check( "colours: followTheme starts in the active theme", view3.kit().color( "BASE" ) == nordBase );
app3 = new bxrig.ControlCenterApp( [ new bxrig.LookPage( true ) ], "look" );
view3.paint( app3, 1, 120, 40 );
fileWrite( home & "/cfg/bxrig/theme.json", '{"name":"gruvbox","mode":"theme"}' );
view3.paint( app3, 5, 120, 40 );
testkit.check( "colours: a theme applied meanwhile is not picked up between checks", view3.kit().color( "BASE" ) == nordBase );
view3.paint( app3, 20, 120, 40 );
testkit.check( "colours: it is picked up within a second (20 frames), so applying a theme from the Themes page recolours the screen", view3.kit().color( "BASE" ) == gruvBase );
// the theme row follows a theme applied meanwhile
lp = new bxrig.LookPage( false, new bxrig.Palette( env ) ); lp.load();
app4 = new bxrig.ControlCenterApp( [ lp ], "look" );
fileWrite( home & "/cfg/bxrig/theme.json", '{"name":"nord","mode":"theme"}' );
view3.paint( app4, 20, 120, 40 );
testkit.check( "the Look page's Color theme row shows the applied theme (Nord) within a second", find( "Nord", tui.render_to_string( 120, 40 ) ) > 0 );
fileWrite( home & "/cfg/bxrig/theme.json", '{"name":"gruvbox","mode":"theme"}' );
view3.paint( app4, 40, 120, 40 );
testkit.check( "and the next theme after that (Gruvbox)", find( "Gruvbox", tui.render_to_string( 120, 40 ) ) > 0 );
testkit.check( "colours: the whole screen is drawn with it (the fill is the new base)", nordBase != gruvBase );
testkit.done();
