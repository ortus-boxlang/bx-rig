// The runner's Shortcuts section, `menu open ROUTE`, `keys search|run`, and the notices. Run from src/: (cd src && matchbox ../tests/shortcuts_runner_test.bxs)
testkit = new lib.Check( "shortcuts-runner" );
cli = new bxrig.util.Cli( "0.0.0" );
menu = new bxrig.Menu( cli );
// every entry, whatever this machine has (no laptop, webcam or touchpad conditions applied)
tree = menu.tree( true );
routes = menu.routes( tree );
paths = routes.map( function( r ) { return lCase( r.path ); } );
testkit.check( "the Shortcuts section is in the runner", arrayFind( tree.map( function( e ) { return e.label; } ), "Shortcuts" ) > 0 );
sec = tree.filter( function( e ) { return e.label == "Shortcuts"; } )[ 1 ];
labels = sec.children.map( function( e ) { return e.label; } ).toList( "|" );
testkit.check( "Shortcuts has list, search, rebind, run", find( "List the shortcuts", labels ) > 0 && find( "Search the shortcuts", labels ) > 0 && find( "Rebind a shortcut", labels ) > 0 && find( "Run a shortcut", labels ) > 0 );
flat = menu.flatten( tree ).map( function( f ) { return f.path; } );
testkit.check( "new runner entries: region record, dictation toggle, color picker, time, battery, weather", arrayFind( flat, "Trigger > Capture > Record a region of the screen" ) > 0 && arrayFind( flat, "Trigger > Toggle > Dictation on or off" ) > 0 && arrayFind( flat, "Trigger > Capture > Color picker" ) > 0 && arrayFind( flat, "Trigger > Notices > Time" ) > 0 && arrayFind( flat, "Trigger > Notices > Battery" ) > 0 && arrayFind( flat, "Trigger > Notices > Weather" ) > 0 && arrayFind( flat, "Trigger > Toggle > Dock: show or hide" ) > 0 && arrayFind( flat, "Trigger > Toggle > Top bar: show or hide" ) > 0 );
// every `menu open ROUTE` key points at a route that exists, and routes are unique by label
sc = new bxrig.Shortcuts( {}, "traditional" );
okRoutes = true;
for ( r in sc.table() ) {
	if ( left( r.words, 10 ) == "menu open " ) {
		want = lCase( mid( r.words, 11, len( r.words ) ) );
		n = routes.filter( function( x ) { return lCase( x.label ) == want || lCase( x.path ) == want; } ).len();
		if ( n != 1 ) { okRoutes = false; println( "route " & want & " matches " & n ); }
	}
}
testkit.check( "menu open: system, capture, toggle, hardware and agent each match exactly one submenu", okRoutes );
hwRoute = routes.filter( function( x ) { return lCase( x.label ) == "hardware"; } );
hwLabels = hwRoute.len() == 1 ? hwRoute[ 1 ].children.map( function( e ) { return e.label; } ).toList( "|" ) : "";
testkit.check( "the Hardware section is top level and holds display, laptop panel, mirror, brightness, webcam, GPU, input", hwRoute.len() == 1 && hwRoute[ 1 ].path == "Hardware" && find( "Monitors", hwLabels ) > 0 && find( "Laptop panel", hwLabels ) > 0 && find( "Mirror the laptop panel", hwLabels ) > 0 && find( "Brightness", hwLabels ) > 0 && find( "Webcam preview on or off", hwLabels ) > 0 && find( "GPU check", hwLabels ) > 0 && find( "Input devices and gestures", hwLabels ) > 0 );
hwEntries = hwRoute.len() == 1 ? hwRoute[ 1 ].children : [];
function hwEntry( label ) { for ( e in hwEntries ) if ( e.label == label ) return e; return {}; }
testkit.check( "Hardware: Audio, Bluetooth and Wi-Fi open the Noctalia control center panel (the action of Super+Alt+C), detached", hwEntry( "Audio" ).kind == "exec" && hwEntry( "Bluetooth" ).kind == "exec" && hwEntry( "Wi-Fi" ).kind == "exec" && hwEntry( "Audio" ).argv.toList( " " ) == "noctalia msg panel-toggle control-center" && sc.table().filter( function( r ) { return r.id == "control-center-panel"; } ).len() == 1 );
testkit.check( "Hardware: the terminal fallbacks run wiremix and bluetui themselves in a terminal, and there is no Wi-Fi terminal entry", hwEntry( "Audio mixer (terminal)" ).kind == "tool" && hwEntry( "Audio mixer (terminal)" ).argv.toList( " " ) == "wiremix" && hwEntry( "Bluetooth devices (terminal)" ).argv.toList( " " ) == "bluetui" && !structKeyExists( hwEntry( "Wi-Fi (terminal)" ), "kind" ) );
testkit.check( "Hardware: status entries run the three read-only commands", hwEntry( "Audio status" ).argv.toList( " " ) == "audio status" && hwEntry( "Bluetooth status" ).argv.toList( " " ) == "bluetooth status" && hwEntry( "Wi-Fi status" ).argv.toList( " " ) == "wifi status" );
testkit.check( "menu describe: tool and exec say what they run", find( "terminal: wiremix", menu.describe( hwEntry( "Audio mixer (terminal)" ) ) ) > 0 && find( "starts: noctalia msg", menu.describe( hwEntry( "Audio" ) ) ) > 0 );
testkit.check( "Setup no longer has its own Hardware submenu", arrayFind( flat, "Setup > Hardware > GPU check" ) == 0 && arrayFind( flat, "Hardware > GPU check" ) > 0 );
testkit.check( "new runner entries: record with audio, quake console, private browser, files here", arrayFind( flat, "Trigger > Capture > Screen recording with desktop audio" ) > 0 && arrayFind( flat, "Trigger > Capture > Screen recording with microphone audio" ) > 0 && arrayFind( flat, "Trigger > Quake console: show or hide" ) > 0 && arrayFind( flat, "Trigger > Send the window to the quake console" ) > 0 && arrayFind( flat, "Trigger > Private browser window" ) > 0 && arrayFind( flat, "Trigger > File manager in the current folder" ) > 0 );
// each new key runs a command that is also an entry of the runner
runnerArgvs = menu.flatten( tree ).filter( function( f ) { return structKeyExists( f.entry, "argv" ); } ).map( function( f ) { return f.entry.argv.toList( " " ); } );
okEntries = true;
for ( id in [ "browser-private", "files-here", "quake-toggle", "quake-send", "webcam", "screen-record-audio" ] ) {
	if ( !arrayFind( runnerArgvs, sc.argvOf( id ).toList( " " ) ) ) { okEntries = false; println( "no runner entry for " & id ); }
}
testkit.check( "each new key's command is also an entry of the runner", okEntries );
testkit.check( "menu open with an unknown route exits 4", menu.open( "no-such-section", false ) == 4 );
testkit.check( "menu open with no route lists the routes (exit 0)", menu.open( "", false ) == 0 );
// the pick lists
testkit.check( "the shortcut pick lists: all rows, and only the ones that run a command", menu.choices( "shortcuts" ).len() == sc.show().len() && menu.choices( "shortcuts-run" ).len() > 20 && menu.choices( "shortcuts-run" ).len() < menu.choices( "shortcuts" ).len() );
// keys search and run
kc = new bxrig.KeysCmd( cli, "", sc );
testkit.check( "keys search finds a shortcut by words or keys, and says so when none match", kc.search( "screenshot", false ) == 0 && kc.search( "Super+Print", false ) == 0 && kc.search( "zzzz-nothing", false ) == 0 );
testkit.check( "keys run: an unknown id exits 4, a window action has no command (exit 4)", kc.run( "nope", false ) == 4 && kc.run( "close", false ) == 4 );
// notices
dir = testkit.tmp();
directoryCreate( dir & "/BAT0" );
fileWrite( dir & "/BAT0/capacity", "73" & chr( 10 ) );
fileWrite( dir & "/BAT0/status", "Discharging" & chr( 10 ) );
directoryCreate( dir & "/AC" );
nt = new bxrig.Notify( cli );
testkit.check( "battery notice text from sysfs", nt.batteryText( dir ) == "73% (discharging)" && nt.batteries( dir ).len() == 1 );
testkit.check( "no battery: empty text", nt.batteryText( dir & "/none" ) == "" );
testkit.check( "an unknown notice is a usage error", new bxrig.Notify( cli, "" ).show( "bogus", false ) != 0 );
testkit.done();
