// NoctaliaConfig: palette JSON and config.toml. Run from src/: (cd src && matchbox ../tests/noctalia_config_test.bxs)
testkit = new lib.Check( "noctalia config" );
nc = new bxrig.NoctaliaConfig();
p = jsonDeserialize( nc.palette() );
testkit.check( "palette: version 2 with dark and light", p.version == 2 && structKeyExists( p, "dark" ) && structKeyExists( p, "light" ) );
roles = [ "primary", "on_primary", "secondary", "on_secondary", "tertiary", "on_tertiary", "error", "on_error", "surface", "on_surface", "surface_container", "on_surface_variant", "outline_variant", "shadow", "hover", "on_hover" ];
ok = true; for ( v in [ "dark", "light" ] ) for ( r in roles ) if ( !structKeyExists( p[v], r ) || !reFind( "^##[0-9a-fA-F]{6}$", p[v][r] ) ) ok = false;
testkit.check( "palette: all 16 roles are hex colours in both variants", ok );
testkit.check( "palette: brand green is the dark primary, brand cyan the secondary", lCase( p.dark.primary ) == "##00ff78" && lCase( p.dark.secondary ) == "##00dbff" );
testkit.check( "palette: terminal has 8 normal and 8 bright colours", structCount( p.dark.terminal.normal ) == 8 && structCount( p.dark.terminal.bright ) == 8 );
t = nc.configToml( "/home/dev" );
testkit.check( "config: custom palette is selected by name", find( 'custom_palette = "BxRig"', t ) > 0 && find( 'source = "custom"', t ) > 0 );
testkit.check( "config: wallpaper paths are absolute under the home directory", find( 'directory = "/home/dev/Pictures/BxRig"', t ) > 0 && find( 'path = "/home/dev/Pictures/BxRig/bxrig.jpg"', t ) > 0 );
testkit.check( "config: bar lists real widget names", find( '"workspaces"', t ) > 0 && find( '"control-center"', t ) > 0 && find( '"bxrig-menu"', t ) > 0 );
// ---- the bar layouts (DESKTOP-DECISIONS.md, layout v3) ----
testkit.check( "layouts: minimal, standard, dense; standard is the default", nc.layouts().len() == 3 && nc.defaultLayout() == "standard" && nc.validLayout( "dense" ) && !nc.validLayout( "huge" ) );
std = nc.zones( "standard", { battery: true } );
testkit.check( "standard start: logo, workspaces, active window (the grid is in the dock)", std.start.toList( "," ) == "bxrig-menu,workspaces,active_window" );
testkit.check( "standard center: the clock and the media player", std.center.toList( "," ) == "bxrig-clock,media" );
testkit.check( "standard end: agents, capture, system, developer, VPN, tray, clipboard, network, bluetooth, volume, battery, notifications, quick settings, control center", std.end.toList( "," ) == "bxrig-agents,screenshot,bxrig-system,bxrig-dev,bxrig-vpn,tray,clipboard,network,bluetooth,volume,battery,notifications,bxrig-quick,control-center" );
mini = nc.zones( "minimal", { battery: true } );
testkit.check( "minimal: logo, workspaces, active window | clock | tray, network, volume, battery, notifications, quick settings, control center", mini.start.toList( "," ) == "bxrig-menu,workspaces,active_window" && mini.center.toList( "," ) == "bxrig-clock" && mini.end.toList( "," ) == "tray,network,volume,battery,notifications,bxrig-quick,control-center" );
dense = nc.zones( "dense", { battery: true } );
testkit.check( "dense: standard plus weather and brightness (caffeine is not a bar icon)", dense.center.toList( "," ) == "bxrig-clock,weather,media" && dense.end.toList( "," ) == "bxrig-agents,screenshot,bxrig-system,bxrig-dev,bxrig-vpn,tray,clipboard,network,bluetooth,volume,brightness,battery,notifications,bxrig-quick,control-center" );
ok = true; for ( l in nc.layouts() ) { z = nc.zones( l, { battery: true } ); if ( z.end[ z.end.len() ] != "control-center" || z.end[ z.end.len() - 1 ] != "bxrig-quick" ) ok = false; }
testkit.check( "every layout: control center is last, quick settings right before it", ok );
ok = true; for ( l in nc.layouts() ) if ( arrayFind( nc.zones( l, { battery: true } ).end, "caffeine" ) ) ok = false;
testkit.check( "caffeine is a switch in quick settings, not a bar icon (no layout carries it)", ok );
testkit.check( "no battery widget without a battery", !arrayFind( nc.zones( "standard", { battery: false } ).end, "battery" ) && find( "[widget.battery]", nc.configToml( "/home/dev" ) ) == 0 );
lap = nc.configToml( "/home/dev", "dark", "bxrig", { battery: true } );
testkit.check( "laptop: battery widget shows the percentage", find( "[widget.battery]", lap ) > 0 && find( 'label_content = "percent"', lap ) > 0 && find( "show_label = true", lap ) > 0 );
testkit.check( "laptop: the battery click opens the power panel (a plugin panel), right click the control center Power tab; no power_profile widget", find( "[widget.battery.actions]", lap ) > 0 && find( 'left = "panel-toggle bxrig/power:panel"', lap ) > 0 && find( 'right = "panel-toggle control-center power"', lap ) > 0 && find( "power_profile", nc.zones( "dense", { battery: true } ).end.toList( "," ) ) == 0 && find( "bxrig-power", lap ) == 0 );
testkit.check( "no battery on a desktop, so no battery actions", find( "[widget.battery.actions]", nc.configToml( "/home/dev" ) ) == 0 );
testkit.check( "laptop with the percentage off", find( "show_label = false", nc.configToml( "/home/dev", "dark", "bxrig", { battery: true, percent: false } ) ) > 0 );
dockOn = nc.configToml( "/home/dev" );
testkit.check( "dock on (default): dock enabled, its built-in launcher button is off and the Apps entry (bxrig-apps) is pinned, no apps widget in the bar", find( "[dock]" & chr( 10 ) & "enabled = true", dockOn ) > 0 && find( 'launcher_position = "none"', dockOn ) > 0 && find( 'pinned = [ "bxrig-apps" ]', dockOn ) > 0 && !arrayFind( nc.zones( "standard", {} ).start, "bxrig-apps" ) );
dockOff = nc.configToml( "/home/dev", "dark", "bxrig", { dock: false } );
testkit.check( "dock off: the Apps button returns to the bar, right after the logo, and opens the BxRig app grid", nc.zones( "standard", { dock: false } ).start.toList( "," ) == "bxrig-menu,bxrig-apps,workspaces,active_window" && find( "[dock]" & chr( 10 ) & "enabled = false", dockOff ) > 0 && find( "[widget.bxrig-apps]", dockOff ) > 0 && find( 'left = "panel-toggle bxrig/launcher:apps"', dockOff ) > 0 );
testkit.check( "dock autohide and position are written", find( "auto_hide = true", nc.configToml( "/home/dev", "dark", "bxrig", { dockAuto: true, dockPos: "left" } ) ) > 0 && find( 'position = "left"', nc.configToml( "/home/dev", "dark", "bxrig", { dockPos: "left" } ) ) > 0 );
testkit.check( "Noctalia's first-run wizard is off, the launcher opens as a grid, screen time is not enabled", find( "setup_wizard_enabled = false", t ) > 0 && find( "app_grid = true", t ) > 0 && find( "screen_time", t ) == 0 );
testkit.check( "hybrid style: bare widgets (capsule off, no blank capsule_border), one palette role, plates only on the logo and the grid", find( "capsule = false", t ) > 0 && find( "capsule_border", t ) == 0 && find( 'color = "on_surface"', t ) > 0 && find( "bxrig-menu.svg", t ) > 0 && find( "bxrig-grid.svg", dockOff ) > 0 && find( "custom_image", t ) > 0 );
testkit.check( "the logo button opens `bxrig menu` detached (setsid)", find( "setsid bxrig menu", t ) > 0 && find( "[widget.bxrig-menu.actions]", t ) > 0 && find( 'type = "custom_button"', t ) > 0 );
testkit.check( "the clock is one plugin widget with its format setting; no built-in clock, no globe", find( '[widget.bxrig-clock]', t ) > 0 && find( 'type = "bxrig/clock:bar"', t ) > 0 && find( '[plugin_settings."bxrig/clock"]', t ) > 0 && find( 'format = "%b %-d - %H:%M"', t ) > 0 && find( "[widget.clock]", t ) == 0 && find( "world-clock", t ) == 0 );
testkit.check( "the VPN widget is defined and sits right after the developer icon on Standard and Dense, never on Minimal", find( "[widget.bxrig-vpn]", t ) > 0 && find( 'type = "bxrig/vpn:bar"', t ) > 0 && std.end[ arrayFind( std.end, "bxrig-dev" ) + 1 ] == "bxrig-vpn" && dense.end[ arrayFind( dense.end, "bxrig-dev" ) + 1 ] == "bxrig-vpn" && !arrayFind( mini.end, "bxrig-vpn" ) );
testkit.check( "the plugins are enabled", find( 'enabled = ["bxrig/clock", "bxrig/agents", "bxrig/system", "bxrig/quick", "bxrig/dev", "bxrig/power", "bxrig/vpn", "bxrig/launcher"]', t ) > 0 );
testkit.check( "the System widget is defined and sits after capture and before the developer widget on Standard and Dense (not on Minimal)", find( 'type = "bxrig/system:bar"', t ) > 0 && find( "screenshot,bxrig-system,bxrig-dev,bxrig-vpn,tray", nc.zones( "standard" ).end.toList( "," ) ) > 0 && find( "screenshot,bxrig-system,bxrig-dev,bxrig-vpn,tray", nc.zones( "dense" ).end.toList( "," ) ) > 0 && !arrayFind( nc.zones( "minimal" ).end, "bxrig-system" ) );
testkit.check( "a custom clock format is quoted for TOML", find( 'format = "%a \"x\" %H:%M"', nc.configToml( "/home/dev", "dark", "bxrig", { timeFormat: '%a "x" %H:%M' } ) ) > 0 );
d = nc.detect( nc.configToml( "/home/dev", "light", "bxrig-light" ) );
testkit.check( "detect: the theme mode and wallpaper of a written config", d.theme == "light" && d.wallpaper == "bxrig-light" );
e = nc.entries( "/home/dev/.config", "/home/dev" );
testkit.check( "entries: config.toml and the palette file", e.len() == 2 && e[1].target == "/home/dev/.config/noctalia/config.toml" && e[2].target == "/home/dev/.config/noctalia/palettes/BxRig.json" );
testkit.done( "all passed" );
