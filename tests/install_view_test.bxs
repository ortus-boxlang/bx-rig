// InstallApp and InstallView: the install screen shows what is running and why it is quiet, the verbose log, and the end with what failed.
// Real tiny commands (sh); needs MatchBox built with bif-tui. Run from src/: (cd src && matchbox ../tests/install_view_test.bxs)
testkit = new lib.Check( "install view" );
tmp = "/tmp/bxrig-install-view-" & createUUID();
directoryCreate( tmp, true, true );
tui = createObject( "rust", "tui.TUI" );
view = new bxrig.InstallView( tui );
log = new bxrig.InitLog( tmp );
steps = [
	{ id: "first", title: "make the first thing", argv: [ "sh", "-c", "echo one; echo two; exit 0" ] },
	{ id: "apps", title: "install 43 apps", argv: [ "sh", "-c", "echo '(7/43) installing foo'; echo 'Error: this line is red'; sleep 30" ] },
	{ id: "later", title: "something after", argv: [ "sh", "-c", "exit 0" ] }
];
run = new bxrig.InitRun( steps, log, new bxrig.util.Proc(), { appsTotal: 43 } );
app = new bxrig.InstallApp( run, { keepAliveTicks: 2, keepAlive: function() { keptAlive++; } } );
keptAlive = 0;
function shot( w = 120, h = 36, tick = 10 ) { view.paint( app, tick, w, h ); return tui.render_to_string( w, h ); }
function spin( n ) { for ( var i = 1; i <= n; i++ ) { app.onTick( i ); sleep( 50 ); } }

spin( 30 );
s = shot();
testkit.check( "running: the title, the bar and the count", find( "Installing", s ) > 0 && find( "%", s ) > 0 && find( "1 of 3 steps", s ) > 0 );
testkit.check( "running: the step that runs, its own progress (7 of 43) and the last line it printed", find( "install 43 apps", s ) > 0 && find( "7 of 43", s ) > 0 && find( "this line is red", s ) > 0 );
testkit.check( "running: the list has a mark for each step", find( "✓", s ) > 0 && find( "make the first thing", s ) > 0 && find( "something after", s ) > 0 );
testkit.check( "running: BXRIG in DOS Rebel (the brand font) when the window is tall, the small logo below that", find( "░░███░░░░░███░░███ ░░███ ░░███░░░░░███", shot( 120, 50 ) ) > 0 && find( "░░███░░░░░███░░███", shot( 120, 40 ) ) == 0 );
testkit.check( "running: the logo is drawn when there is room", find( "▀", s ) > 0 || find( "█", s ) > 0 );
testkit.check( "running: the key bar offers stop and the log", find( "ctrl-c", s ) > 0 && find( "show the log", s ) > 0 );
testkit.check( "a quiet step says how long and that it works", find( "no output for", shot( 120, 36 ) ) == 0 );
testkit.check( "the sudo ticket is refreshed while it runs", keptAlive > 0 );
testkit.check( "too small a window asks for more room", find( "76 x 24", shot( 60, 20 ) ) > 0 );

// verbose
app.onKey( "v" );
s = shot();
testkit.check( "verbose: the log panel with the lines of every step", app.verbose() && find( "Log", s ) > 0 && find( "(live)", s ) > 0 && find( "one", s ) > 0 && find( "two", s ) > 0 && find( "(7/43) installing foo", s ) > 0 );
testkit.check( "verbose: each line shows the step it came from", find( "first", s ) > 0 && find( "apps", s ) > 0 );
testkit.check( "verbose: the logo makes way for the log", find( "hide the log", s ) > 0 && find( "scroll", s ) > 0 );
app.onKey( "Up" ); app.onKey( "Up" );
testkit.check( "verbose: arrows scroll", app.scroll() == 2 );
app.onKey( "End" );
testkit.check( "verbose: End follows the newest line again", app.scroll() == 0 );
app.onKey( "v" );
testkit.check( "v closes the log", !app.verbose() );

// stopping
app.onKey( "Ctrl+c" );
testkit.check( "ctrl-c asks first", app.confirming() && find( "Stop the install?", shot() ) > 0 && !run.finished() );
app.onKey( "n" );
testkit.check( "any other key goes on", !app.confirming() && !run.finished() );
app.onKey( "Ctrl+c" ); app.onKey( "y" );
testkit.check( "y stops: the running step failed (130), the rest not run", run.finished() && run.counts().failed == 1 && run.counts().stopped == 1 && app.outcome() == "running" );

// the end
s = shot();
testkit.check( "finished: what failed with the exit code, and where the log is", find( "Finished", s ) > 0 && find( "What failed", s ) > 0 && find( "(exit 130)", s ) > 0 && find( log.file(), s ) > 0 );
testkit.check( "finished: retry and leave are offered", find( "retry the failed steps", s ) > 0 && find( "leave", s ) > 0 );
app.onKey( "r" );
testkit.check( "r runs the failed and stopped steps again", !run.finished() && run.counts().pending == 2 );
run.stop();
app.onKey( "Enter" );
testkit.check( "enter leaves once it is over", app.outcome() == "done" );

// the sudo password: asked on the screen, typed hidden, checked, then the run starts with the helper
pwLog = new bxrig.InitLog( tmp );
pwRun = new bxrig.InitRun( [ { id: "one", title: "one", argv: [ "sh", "-c", "echo hi" ] } ], pwLog, new bxrig.util.Proc(), {} );
asked = [];
pwApp = new bxrig.InstallApp( pwRun, { passwordNeeded: true, user: "ada", verify: function( pw ) { asked.append( pw ); return pw == "secret" ? { ok: true, askpass: "/run/x/askpass.sh", error: "" } : { ok: false, askpass: "", error: "wrong password" }; } } );
function pwShot( w = 120, h = 44 ) { view.paint( pwApp, 10, w, h ); return tui.render_to_string( w, h ); }
pwApp.onTick( 1 );
s = pwShot();
testkit.check( "password: the screen asks, with the user's name, and the run has not started", pwApp.phase() == "password" && find( "sudo password", s ) > 0 && find( "Password for ada", s ) > 0 && pwRun.state().startedAt == 0 );
for ( ch in [ "s", "e", "c" ] ) pwApp.onKey( ch );
s = pwShot();
testkit.check( "password: typed characters are shown as dots, never as text", find( "•••", s ) > 0 && find( "sec", s ) == 0 );
pwApp.onKey( "Backspace" );
testkit.check( "password: backspace removes one", pwApp.maskedPassword() == "••" );
pwApp.onKey( "Enter" );
testkit.check( "password: a wrong one is refused with how many tries are used, and the box stays", pwApp.phase() == "password" && find( "(1 of 3)", pwShot() ) > 0 && pwApp.maskedPassword() == "" );
for ( ch in [ "s", "e", "c", "r", "e", "t" ] ) pwApp.onKey( ch );
pwApp.onKey( "Enter" );
testkit.check( "password: the right one starts the run and gives it the helper", pwApp.phase() == "run" && asked.toList( "," ) == "se,secret" && !pwApp.cancelled() );
pwApp.onTick( 2 );
for ( i = 1; i <= 100 && !pwRun.finished(); i++ ) { pwApp.onTick( i ); sleep( 50 ); }
testkit.check( "password: then the run goes on as usual", pwRun.finished() && pwRun.counts().done == 1 );
// three wrong tries, or escape, give up before anything runs
pwRun2 = new bxrig.InitRun( [ { id: "one", title: "one", argv: [ "sh", "-c", "echo hi" ] } ], new bxrig.InitLog( tmp ), new bxrig.util.Proc(), {} );
pwApp2 = new bxrig.InstallApp( pwRun2, { passwordNeeded: true, verify: function( pw ) { return { ok: false, askpass: "", error: "wrong password" }; } } );
for ( n = 1; n <= 3; n++ ) { pwApp2.onKey( "x" ); pwApp2.onKey( "Enter" ); }
testkit.check( "password: three wrong tries cancel the install before it starts", pwApp2.cancelled() && pwApp2.outcome() == "done" && pwRun2.state().startedAt == 0 && find( "did not accept", pwApp2.message() ) > 0 );
pwApp3 = new bxrig.InstallApp( pwRun2, { passwordNeeded: true, verify: function( pw ) { return { ok: true, askpass: "", error: "" }; } } );
pwApp3.onKey( "Escape" );
testkit.check( "password: escape cancels", pwApp3.cancelled() && pwApp3.outcome() == "done" );
noPw = new bxrig.InstallApp( pwRun2, {} );
testkit.check( "no password needed (root, a ticket, NOPASSWD): straight to the run", noPw.phase() == "run" );

directoryDelete( tmp, true );
// ---- the finish screen offers a log out or a reboot, after a question ----
mkFin = function( ids ) {
	var done = ids.map( function( i ) { return { id: i }; } );
	return new bxrig.InstallApp( { finished: function() { return true; }, result: function() { return { done: done, failed: [], stopped: [], skipped: [] }; }, begin: function() {}, tick: function() {} } );
};
fa = mkFin( [ "hyprland", "xremap" ] );
testkit.check( "after a new session the screen offers log out, not reboot", fa.advice().relogin && !fa.advice().reboot );
fa.onKey( "b" );
testkit.check( "b does nothing when no reboot is advised", fa.asking() == "" );
fa.onKey( "l" );
testkit.check( "l asks first", fa.asking() == "logout" && fa.outcome() == "running" );
fa.onKey( "n" );
testkit.check( "any other key than y stays", fa.asking() == "" && fa.advice().action == "" && fa.outcome() == "running" );
fa.onKey( "l" ); fa.onKey( "y" );
testkit.check( "y confirms: the choice is kept and the screen ends", fa.advice().action == "logout" && fa.outcome() == "done" );
fb = mkFin( [ "hyprland", "session" ] );
fb.onKey( "l" );
testkit.check( "when a reboot is advised l is not offered", fb.asking() == "" && fb.advice().reboot );
fb.onKey( "b" ); fb.onKey( "y" );
testkit.check( "b reboots after y", fb.advice().action == "reboot" );
fc = mkFin( [ "git-name" ] );
fc.onKey( "l" ); fc.onKey( "b" );
testkit.check( "nothing advised: neither key does anything", fc.asking() == "" );
testkit.done();
