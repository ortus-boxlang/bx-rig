// Control Center: the dashboard data and attention list, the shell model (pages, focus, intents, plan box) and what the screen shows.
// Run from src/: (cd src && matchbox ../tests/control_center_test.bxs)
testkit = new lib.Check( "control center" );
dd = new bxrig.DashboardData( {} );
d = dd.demo();
att = dd.attention( d );
testkit.check( "attention: updates, a stale backup and nothing else in the demo", att.len() == 2 && att[ 1 ].text == "14 updates available" && find( "Files nas backup is 3 days old", att[ 2 ].text ) > 0 );
d2 = dd.demo(); d2.updates = 0; d2.backups = []; d2.disk.used = 450000000000; d2.battery.percent = 12;
a2 = dd.attention( d2 );
testkit.check( "attention: a full disk and a low battery", a2.len() == 2 && a2[ 1 ].level == "warn" && a2[ 2 ].level == "error" && find( "Battery at 12%", a2[ 2 ].text ) > 0 );
d3 = dd.demo(); d3.updates = -1; d3.backups = [ { id: "config", label: "Config", count: 0, latest: 0, error: "", ages: [] } ];
testkit.check( "attention: unknown updates are not a warning, no backup yet is", dd.attention( d3 ).len() == 1 && find( "no backup yet", dd.attention( d3 )[ 1 ].text ) > 0 );
testkit.check( "data: the real collect never fails and has the parts", structKeyExists( dd.collect(), "mem" ) && structKeyExists( dd.collect(), "backups" ) );

page = new bxrig.DashboardPage( new bxrig.DashboardDemo( dd ) );
app = new bxrig.ControlCenterApp( [ page ], "dashboard" );
testkit.check( "app: starts running on the dashboard", app.outcome() == "running" && app.page().id() == "dashboard" && app.focus() == "page" );
it = app.onKey( "Enter" );
testkit.check( "app: Enter on the first warning asks for the system update plan", it.action == "cli" && it.args[ 1 ] == "system" && it.args[ 2 ] == "update" );
app.showPlan( it.title, [ "Plan: update" ], it );
testkit.check( "app: the plan box waits for y", app.mode() == "confirm" && structCount( app.onKey( "x" ) ) == 0 && app.mode() == "confirm" );
yes = app.onKey( "y" );
testkit.check( "app: y returns the confirmed intent", yes.confirmed == true && app.mode() == "main" );
app.showPlan( it.title, [ "Plan" ], it ); app.onKey( "n" );
testkit.check( "app: n drops the plan", app.mode() == "main" );
testkit.check( "app: b leaves for BxTimeMachine", structCount( app.onKey( "b" ) ) == 0 && app.outcome() == "launch:timemachine" );
app3 = new bxrig.ControlCenterApp( [ new bxrig.DashboardPage( new bxrig.DashboardDemo( dd ) ) ], "dashboard" );
testkit.check( "app: w leaves for the setup wizard", structCount( app3.onKey( "w" ) ) == 0 && app3.outcome() == "launch:wizard" );

app2 = new bxrig.ControlCenterApp( [ new bxrig.DashboardPage( new bxrig.DashboardDemo( dd ) ) ], "dashboard" );
app2.onKey( "Down" ); testkit.check( "page: Down moves the attention cursor", app2.page().state().cursor == 2 );
app2.onKey( "Left" ); testkit.check( "app: Left moves focus to the sidebar", app2.focus() == "sidebar" );
app2.onKey( "Right" ); testkit.check( "app: Right goes back to the page", app2.focus() == "page" );
app2.onKey( "q" ); testkit.check( "app: q quits", app2.outcome() == "quit" );
app3 = new bxrig.ControlCenterApp( [ new bxrig.DashboardPage( new bxrig.DashboardDemo( dd ) ) ], "" );
app3.onKey( "Ctrl+c" ); testkit.check( "app: Ctrl+c quits", app3.outcome() == "quit" );
testkit.check( "app: a click on a warning returns its intent", new bxrig.ControlCenterApp( [ new bxrig.DashboardPage( new bxrig.DashboardDemo( dd ) ) ], "" ).act( { kind: "att", n: 1, m: 0 } ).action == "cli" );

tui = createObject( "rust", "tui.TUI" );
view = new bxrig.ControlCenterView( tui );
app4 = new bxrig.ControlCenterApp( [ new bxrig.DashboardPage( new bxrig.DashboardDemo( dd ) ) ], "" );
view.paint( app4, 100, 110, 34 );
s = tui.render_to_string( 110, 34 );
testkit.check( "screen: sidebar, header and the meters", find( "Control Center", s ) > 0 && find( "Dashboard", s ) > 0 && find( "orion", s ) > 0 && find( "CachyOS", s ) > 0 && find( "CPU", s ) > 0 && find( "RAM", s ) > 0 );
testkit.check( "screen: attention, machines and backups", find( "Needs attention", s ) > 0 && find( "14 updates available", s ) > 0 && find( "postgres", s ) > 0 && find( "win11", s ) > 0 && find( "Files nas", s ) > 0 && find( "3 days ago", s ) > 0 );
testkit.check( "screen: key hints", find( "quit", s ) > 0 && find( "pages", s ) > 0 );
testkit.check( "screen: a click on the first warning and on the sidebar", view.hitAt( 25, 5 ).kind == "att" && view.hitAt( 3, 6 ).kind == "nav" );
app4.showPlan( "System update", [ "Plan: pacman -Syu" ], it );
view.paint( app4, 101, 110, 34 );
s2 = tui.render_to_string( 110, 34 );
testkit.check( "screen: the plan box", find( "System update", s2 ) > 0 && find( "Plan: pacman -Syu", s2 ) > 0 && find( "do it", s2 ) > 0 );

// ---- every page, in demo mode
cc = new bxrig.ControlCenter( {} );
pages = cc.buildPages( true );
testkit.check( "pages: nineteen, in order", pages.len() == 19 && pages[ 1 ].id() == "dashboard" && pages[ 2 ].id() == "apps" && pages[ 5 ].id() == "maven" && pages[ 6 ].id() == "gradle" && pages[ 8 ].id() == "ports" && pages[ 9 ].id() == "network" && pages[ 13 ].id() == "databases" && pages[ 14 ].id() == "mail" && pages[ 17 ].id() == "look" && pages[ 18 ].id() == "themes" && pages[ 19 ].id() == "logs" );
want = { look: "Top bar layout", apps: "Firefox", boxlang: "1.9.0-snapshot", java: "temurin-21.0.13_9", maven: "3.10.0", gradle: "9.9.1", versions: "MatchBox", ports: "postgres", shortcuts: "Launcher", machines: "webtop-ubuntu", databases: "postgres", mail: "Your order 4821 has shipped", storage: "syno/backups", network: "Home-5G", secrets: "ANTHROPIC_API_KEY", themes: "Tokyo Night", logs: "port 5432 already in use" };
big = new bxrig.ControlCenterApp( pages, "" );
for ( pg in pages ) {
	if ( pg.id() == "dashboard" ) continue;
	big.goto( pg.id() );
	view.paint( big, 10, 120, 38 );
	sc = tui.render_to_string( 120, 38 );
	ok = find( pg.title(), sc ) > 0 && find( want[ pg.id() ], sc ) > 0;
	if ( pg.id() == "packages" ) ok = find( "Press /", sc ) > 0;
	testkit.check( "page " & pg.id() & ": title and its demo rows show", ok );
}
// the table: filter, cursor, actions
big.goto( "ports" ); port = big.page();
testkit.check( "ports: 7 demo rows, two on 5432 are conflicts", port.state().rows == 7 && port.state().items.filter( function( r ) { return r.conflict; } ).len() == 2 );
big.onKey( "/" ); for ( ch in [ "r", "e", "d" ] ) big.onKey( ch ); big.onKey( "Enter" );
testkit.check( "ports: / filters rows (redis only)", port.state().shown == 1 && port.selected().process == "redis-server" );
x = big.onKey( "x" );
testkit.check( "ports: x is a plan to send SIGTERM", x.action == "exec" && x.argv[ 1 ] == "kill" && x.argv[ 2 ] == "4177" && x.plan.len() >= 1 );
testkit.check( "ports: K is kill -9 and o opens the browser", big.onKey( "K" ).argv[ 2 ] == "-9" && big.onKey( "o" ).argv[ 1 ] == "xdg-open" );
big.onKey( "/" ); big.onKey( "Escape" );
testkit.check( "ports: Escape clears the filter", port.state().shown == 7 );
big.goto( "java" );
testkit.check( "java: d makes the default plan, x the removal plan", big.onKey( "d" ).args[ 1 ] == "java" && big.onKey( "d" ).args[ 2 ] == "default" && big.onKey( "x" ).args[ 2 ] == "remove" );
ask = big.onKey( "i" );
testkit.check( "java: i asks for a version, then plans the install", structCount( ask ) == 0 && big.mode() == "ask" );
for ( ch in [ "2", "5" ] ) big.onKey( ch );
inst = big.onKey( "Enter" );
testkit.check( "java: the answer becomes the install intent", inst.action == "cli" && inst.args[ 3 ] == "25" && big.mode() == "main" );
big.goto( "java" ); big.onKey( "a" );
testkit.check( "java: a shows what SDKMAN offers and i installs the highlighted identifier", big.page().state().rows == 5 && big.onKey( "i" ).args[ 3 ] == "25.0.5.0+8-tem" );
big.onKey( "a" );
big.goto( "maven" );
mv = big.page();
testkit.check( "maven: installed versions first, the default starred", mv.state().items[ 1 ].version == "3.9.9" && mv.state().items[ 1 ].default && mv.state().items[ 2 ].version == "3.9.8" && mv.state().rows == 5 );
big.onKey( "End" );
mi = big.onKey( "i" );
testkit.check( "maven: i is `sdk install maven VERSION`", mi.args[ 1 ] == "sdk" && mi.args[ 2 ] == "install" && mi.args[ 3 ] == "maven" );
testkit.check( "maven: d on a version that is not installed does nothing", structCount( big.onKey( "d" ) ) == 0 );
big.onKey( "Home" );
testkit.check( "maven: d on an installed one makes it the default", big.onKey( "d" ).args[ 2 ] == "default" && big.onKey( "x" ).args[ 2 ] == "remove" );
big.goto( "versions" ); big.onKey( "Down" ); big.onKey( "Down" );
testkit.check( "versions: Enter on Java opens the Java page", structCount( big.onKey( "Enter" ) ) == 0 && big.page().id() == "java" );
big.goto( "machines" );
testkit.check( "machines: VMs only", big.page().state().rows == 2 );
st = big.onKey( "s" );
testkit.check( "machines: s on a stopped VM starts it", st.args[ 1 ] == "vm" && st.args[ 2 ] == "start" && st.args[ 3 ] == "win11" );
big.goto( "databases" );
testkit.check( "databases: the two demo databases", big.page().state().rows == 2 );
dst = big.onKey( "s" );
testkit.check( "databases: s on a running one stops it by engine and name", dst.args[ 1 ] == "db" && dst.args[ 2 ] == "stop" && dst.args[ 3 ] == "postgres" && dst.args[ 4 ] == "--name=postgres" );
big.goto( "packages" ); big.onKey( "/" ); for ( ch in [ "d", "o", "c", "k" ] ) big.onKey( ch ); big.onKey( "Enter" );
testkit.check( "packages: a live search loads the matches", big.page().state().rows == 4 );
testkit.check( "packages: i on an AUR package adds --aur", ( function() { big.onKey( "Down" ); big.onKey( "Down" ); big.onKey( "Down" ); var it = big.onKey( "i" ); return it.args[ it.args.len() ] == "--aur"; } )() );
big.goto( "logs" ); lg = big.page();
testkit.check( "logs: warnings and errors by default", lg.state().rows == 3 );
big.onKey( "p" ); testkit.check( "logs: p moves to info and reloads", lg.state().rows == 5 );
big.goto( "secrets" );
testkit.check( "secrets: v reveals through a read-only show, never in the table", big.onKey( "v" ).action == "show" && find( "ANTHROPIC_API_KEY", tui.render_to_string( 120, 38 ) ) >= 0 );
// mail: rows, auto refresh keeps the cursor, delete/clear plan first
big.goto( "mail" ); ml = big.page();
testkit.check( "mail: four demo messages, unread first row", ml.state().rows == 4 && ml.selected().subject == "Your order 4821 has shipped" && !ml.selected().read );
view.paint( big, 10, 130, 40 ); msc = tui.render_to_string( 130, 40 );
testkit.check( "mail: the detail shows the headers and the text body", find( "From: Shop Orders", msc ) > 0 && find( "Subject: Your order 4821 has shipped", msc ) > 0 && find( "should arrive on Tuesday", msc ) > 0 );
testkit.check( "mail: the attachment column and unread mark", find( "+", msc ) > 0 && find( "Billing", msc ) > 0 );
dl = big.onKey( "d" );
testkit.check( "mail: d plans `mail delete ID`", dl.action == "cli" && dl.args[ 1 ] == "mail" && dl.args[ 2 ] == "delete" && dl.args[ 3 ] == "msgA1b2c3" );
testkit.check( "mail: c plans `mail clear`, o and t run at once", big.onKey( "c" ).args[ 2 ] == "clear" && big.onKey( "o" ).action == "show" && big.onKey( "o" ).args[ 3 ] == "msgA1b2c3" && big.onKey( "t" ).args[ 2 ] == "test" );
big.onKey( "Down" ); big.onKey( "Down" );
testkit.check( "mail: the cursor moved to the third message", ml.state().cursor == 3 );
view.paint( big, 400, 130, 40 );
testkit.check( "mail: the page reloads itself after a few seconds and keeps the cursor", ml.state().cursor == 3 && ml.selected().id == "msgG7h8i9" );
// parsers
pp = new bxrig.PortsProvider( false );
ssText = 'LISTEN 0 4096 127.0.0.1:5432 0.0.0.0:* users:(("postgres",pid=4102,fd=5))' & chr( 10 ) & 'LISTEN 0 4096 [::]:5432 [::]:* users:(("postgres",pid=4102,fd=6))' & chr( 10 ) & 'LISTEN 0 128 *:631 *:*' & chr( 10 ) & 'LISTEN 0 511 0.0.0.0:8080 0.0.0.0:* users:(("java",pid=12044,fd=9))';
psText = '  4102 you          259200 postgres -D /data' & chr( 10 ) & ' 12044 you             720 java -jar app.jar';
pr = pp.build( ssText, psText );
testkit.check( "ports parser: one row per port and pid, sorted, with owners", pr.len() == 3 && pr[ 1 ].port == 631 && pr[ 2 ].port == 5432 && pr[ 2 ].pid == 4102 && pr[ 2 ].user == "you" && pr[ 2 ].up == "3d" && pr[ 3 ].command == "java -jar app.jar" );
bp = new bxrig.BoxlangProvider( false ).parseList( "Installed versions:" & chr( 10 ) & "  1.7.2" & chr( 10 ) & "* 1.8.0" & chr( 10 ) & "  1.9.0-snapshot (snapshot)", "" );
testkit.check( "bvm parser: every version, the starred one is active", bp.len() == 3 && bp[ 2 ].active && !bp[ 1 ].active && bp[ 3 ].version == "1.9.0-snapshot" );
lp = new bxrig.LogsProvider( false ).parseLine( '{"PRIORITY":"3","SYSLOG_IDENTIFIER":"podman","MESSAGE":"boom","__REALTIME_TIMESTAMP":"1794583800000000"}' );
testkit.check( "journal parser: level, unit, message", lp.level == "error" && lp.unit == "podman" && lp.message == "boom" && lp.time == "15:30:00" );
// icons: the sidebar and page headers carry them when switched on, nothing when off
app5 = new bxrig.ControlCenterApp( cc.buildPages( true ), "ports" );
view.setIcons( false ); view.paint( app5, 5, 120, 38 ); plain = tui.render_to_string( 120, 38 );
view.setIcons( true ); view.paint( app5, 5, 120, 38 ); withIcons = tui.render_to_string( 120, 38 );
glyph = function( code ) { return chr( code ); };
testkit.check( "icons: off draws none of them", find( chr( 61461 ), plain ) == 0 && find( chr( 61926 ), plain ) == 0 );
testkit.check( "icons: on draws the home, plug and coffee icons in the sidebar and the plug in the header", find( chr( 61461 ), withIcons ) > 0 && find( chr( 61926 ), withIcons ) > 0 && find( chr( 61684 ), withIcons ) > 0 && find( "Ports", withIcons ) > 0 );
testkit.check( "icons: the page list still reads the same", find( "Dashboard", withIcons ) > 0 && find( "Databases", withIcons ) > 0 );
// ---- the sidebar: collapse, toggle keys, breadcrumb, width, solo pages
reg = new bxrig.ControlCenterPages();
testkit.check( "registry: the pages are the Control Center pages, in order", reg.ids().len() == 19 && reg.ids().toList( "," ) == cc.buildPages( true ).map( function( q ) { return q.id(); } ).toList( "," ) && reg.find( "databases" ).title == "Databases" && structIsEmpty( reg.find( "nope" ) ) );
sb = new bxrig.ControlCenterApp( cc.buildPages( true ), "ports" );
testkit.check( "sidebar: open by default", sb.sidebarOpen() );
sb.onKey( chr( 92 ) ); testkit.check( "sidebar: the backslash key collapses it", !sb.sidebarOpen() );
sb.onKey( chr( 92 ) ); testkit.check( "sidebar: and opens it again", sb.sidebarOpen() );
sb.onKey( "Ctrl+b" ); testkit.check( "sidebar: Ctrl+b collapses it", !sb.sidebarOpen() );
sb.onKey( "Left" ); testkit.check( "sidebar: Left expands a collapsed sidebar", sb.sidebarOpen() && sb.focus() == "page" );
sb.onKey( "Left" ); testkit.check( "sidebar: Left again moves focus into it", sb.focus() == "sidebar" );
sb.onKey( "Ctrl+b" ); testkit.check( "sidebar: collapsing returns the focus to the page", !sb.sidebarOpen() && sb.focus() == "page" );
sb.onKey( "Tab" ); testkit.check( "sidebar: Tab still changes page while collapsed", sb.page().id() == "network" && !sb.sidebarOpen() );
sb.onKey( "Shift+Tab" ); testkit.check( "sidebar: Shift+Tab goes back", sb.page().id() == "ports" );
solo = new bxrig.ControlCenterApp( cc.buildPages( true ), "databases", "off" );
testkit.check( "solo: a page started collapsed", !solo.sidebarOpen() && solo.page().id() == "databases" );
solo.act( { kind: "sidetoggle" } ); testkit.check( "solo: a click on the toggle opens it", solo.sidebarOpen() );
forced = new bxrig.ControlCenterApp( cc.buildPages( true ), "ports", "on" ); forced.noteWidth( 70 );
testkit.check( "sidebar: --sidebar stays open on a narrow terminal", forced.sidebarOpen() );
nar = new bxrig.ControlCenterApp( cc.buildPages( true ), "ports" ); nar.noteWidth( 80 );
testkit.check( "sidebar: below 90 columns it starts collapsed", !nar.sidebarOpen() );
nar.onKey( chr( 92 ) ); nar.noteWidth( 80 ); testkit.check( "sidebar: and the key opens it, wide or not", nar.sidebarOpen() );
nar.noteWidth( 200 ); testkit.check( "sidebar: once toggled the width no longer decides", nar.sidebarOpen() );
wide = new bxrig.ControlCenterApp( cc.buildPages( true ), "ports" ); wide.noteWidth( 120 );
testkit.check( "sidebar: at 120 columns it is open", wide.sidebarOpen() );
cap = new bxrig.ControlCenterApp( cc.buildPages( true ), "ports" ); cap.noteWidth( 120 );
cap.onKey( "/" ); cap.onKey( chr( 92 ) );
testkit.check( "sidebar: while a page takes text the backslash is text, not a toggle", cap.sidebarOpen() );
cap.onKey( "Ctrl+b" ); testkit.check( "sidebar: but Ctrl+b still toggles", !cap.sidebarOpen() );
// the screen: collapsed shows the breadcrumb and gives the page the room
sbv = new bxrig.ControlCenterApp( cc.buildPages( true ), "ports", "on" );
view.setIcons( false ); view.paint( sbv, 5, 120, 38 ); openScr = tui.render_to_string( 120, 38 );
testkit.check( "screen: open has the sidebar title and the tab hint", find( "Control Center", openScr ) > 0 && find( "tab  next page", openScr ) > 0 );
testkit.check( "screen: the keys bar teaches the toggle", find( "sidebar", openScr ) > 0 );
sbv.onKey( chr( 92 ) ); view.paint( sbv, 6, 120, 38 ); shut = tui.render_to_string( 120, 38 );
testkit.check( "screen: collapsed drops the sidebar and shows BXRIG > Ports", find( "tab  next page", shut ) == 0 && find( "Control Center", shut ) == 0 && find( "Ports", shut ) > 0 && find( "BXRIG", shut ) > 0 && find( chr( 8250 ), shut ) > 0 );
testkit.check( "screen: collapsed still lists the demo rows", find( "postgres", shut ) > 0 );
testkit.check( "screen: a click on the strip or the breadcrumb is the toggle", view.hitAt( 0, 10 ).kind == "sidetoggle" && view.hitAt( 15, 0 ).kind == "sidetoggle" );
solo2 = new bxrig.ControlCenterApp( cc.buildPages( true ), "databases", "off" );
view.paint( solo2, 7, 90, 30 ); s90 = tui.render_to_string( 90, 30 );
testkit.check( "screen: a solo page at 90 columns shows its rows", find( "Databases", s90 ) > 0 && find( "postgres", s90 ) > 0 );
// a narrow terminal draws the collapsed layout by itself
nv = new bxrig.ControlCenterApp( cc.buildPages( true ), "ports" );
view.paint( nv, 8, 80, 30 ); n80 = tui.render_to_string( 80, 30 );
testkit.check( "screen: 80 columns start collapsed", !nv.sidebarOpen() && find( "tab  next page", n80 ) == 0 && find( "BXRIG", n80 ) > 0 );
// the menu and the shortcut table follow the registry
mt = new bxrig.MenuTree().sections();
ccs = mt.filter( function( e ) { return e.label == "Control Center"; } );
testkit.check( "menu: a last Control Center section, the whole thing first, then every page", mt[ mt.len() ].label == "Control Center" && ccs.len() == 1 && ccs[ 1 ].children.len() == 20 && ccs[ 1 ].children[ 1 ].argv.len() == 1 && ccs[ 1 ].children[ 14 ].argv[ 2 ] == "databases" );
tr = new bxrig.Shortcuts( {} ).table().filter( function( r ) { return left( r.id, 4 ) == "tui-"; } );
testkit.check( "shortcuts: one unbound row per page, running bxrig tui PAGE", tr.len() == 19 && tr[ 1 ].keys == "" && find( "tui databases", tr[ 13 ].dispatch ) > 0 );
testkit.done( "all passed" );
