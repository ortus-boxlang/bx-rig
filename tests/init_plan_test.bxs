// InitPlan: wizard answers to ordered commands (pure). Run from src/: (cd src && matchbox ../tests/init_plan_test.bxs)
testkit = new lib.Check( "init plan" );
ip = new bxrig.InitPlan();
function ids( p ) { return p.steps.map( function( s ) { return s.id; } ).toList( "," ); }
function cmd( p, id ) { for ( var s in p.steps ) if ( s.id == id ) return s.argv.toList( " " ); return ""; }

p = ip.plan( {} );
testkit.check( "no answers, no steps (an unanswered page does nothing)", p.steps.len() == 0 && p.pending.len() == 0 && p.errors.len() == 0 );

p = ip.plan( { desktops: "hyprland", layout: "master", terminal: "ghostty", shell: "zsh" } );
testkit.check( "Hyprland only: hyprland, terminal, shell, then the session", ids( p ) == "hyprland,terminal,icons,shell,xremap,default-terminal,session" );
testkit.check( "hyprland step carries the terminal and the layout", cmd( p, "hyprland" ) == "bxrig setup hyprland --terminal=ghostty --layout=master" );
testkit.check( "KDE is not configured when only Hyprland is chosen", find( "plasma", ids( p ) ) == 0 || !find( "setup plasma", p.steps.map( function( s ) { return s.argv.toList( " " ); } ).toList( "|" ) ) );
testkit.check( "the session follows the desktop", cmd( p, "session" ) == "bxrig session set hyprland" );

p = ip.plan( { desktops: "plasma" } );
testkit.check( "KDE only: plasma and the plasma session", ids( p ) == "plasma,icons,xremap,session" && cmd( p, "session" ) == "bxrig session set plasma" );

p = ip.plan( { desktops: "both", login_session: "plasma", mac_keys: true } );
testkit.check( "Both configures both, login_session picks the session", ids( p ) == "key-style,hyprland,plasma,icons,xremap,session" && cmd( p, "session" ) == "bxrig session set plasma" );
testkit.check( "Both without login_session starts on Hyprland", cmd( ip.plan( { desktops: "both" } ), "session" ) == "bxrig session set hyprland" );
testkit.check( "xremap builds for KDE when Plasma is the only desktop", cmd( ip.plan( { desktops: "plasma", mac_keys: true } ), "xremap" ) == "bxrig setup xremap --build=kde" );
testkit.check( "the Mac key style is set first, with the keyboard (a PC swaps Alt and Win, an Apple keyboard does not)", cmd( ip.plan( { desktops: "hyprland", mac_keys: true } ), "key-style" ) == "bxrig keys style mac --keyboard=pc" && cmd( ip.plan( { desktops: "hyprland", mac_keys: true, keyboard_type: "apple" } ), "key-style" ) == "bxrig keys style mac --keyboard=apple" && ids( ip.plan( { desktops: "hyprland", mac_keys: true } ) ).startsWith( "key-style," ) );
testkit.check( "xremap is always set up, with or without Mac keys (copy and paste are remaps in both styles)", find( "xremap", ids( ip.plan( { desktops: "hyprland", mac_keys: false } ) ) ) > 0 && find( "key-style", ids( ip.plan( { desktops: "hyprland", mac_keys: false } ) ) ) == 0 );
testkit.check( "the screensaver: a time sets the lock at twice it, off keeps the lock, Plasma has none", cmd( ip.plan( { desktops: "hyprland", screensaver: "300" } ), "screensaver" ) == "bxrig screensaver set screensaver=300 lock=600" && cmd( ip.plan( { desktops: "hyprland", screensaver: "off" } ), "screensaver" ) == "bxrig screensaver off" && find( "screensaver", ids( ip.plan( { desktops: "plasma", screensaver: "300" } ) ) ) == 0 );
testkit.check( "the screensaver: an unknown time is an error", ip.plan( { desktops: "hyprland", screensaver: "7" } ).errors.toList().find( "screensaver" ) > 0 );

p = ip.plan( { terminal: "ghostty", terminals_extra: [ "kitty", "foot" ] } );
testkit.check( "terminals: default plus extras in one step", cmd( p, "terminal" ) == "bxrig setup terminal --default=ghostty --also=kitty,foot" );

p = ip.plan( { ai_orchestrators: [ "pane", "herdr" ], ai_agents: [ "claude-code" ] } );
testkit.check( "apps: orchestrators and agents in one install", cmd( p, "apps" ) == "bxrig install pane herdr claude-code tmux" );
testkit.check( "no apps chosen, no install step", find( "apps", ids( ip.plan( { ai_orchestrators: [], ai_agents: [] } ) ) ) == 0 );

p = ip.plan( { git_name: "Ada Lovelace", git_email: "ada@example.com" } );
testkit.check( "git identity is two argument arrays (no shell string)", ids( p ) == "git-name,git-email" && p.steps[ 1 ].argv[ 5 ] == "Ada Lovelace" && p.steps[ 1 ].argv.len() == 5 );

p = ip.plan( { launcher: "rofi", menu: "walker" } );
testkit.check( "launcher and menu: install what is needed, then record the choice", ids( p ) == "apps,launcher,menu" && cmd( p, "apps" ) == "bxrig install rofi walker" && cmd( p, "launcher" ) == "bxrig runner set rofi" && cmd( p, "menu" ) == "bxrig runner menu-set walker" );
p = ip.plan( { launcher: "noctalia", menu: "rofi" } );
p = ip.plan( { launcher: "fuzzel", menu: "wofi" } );
testkit.check( "Fuzzel and Wofi are installed from the catalog", cmd( p, "apps" ) == "bxrig install fuzzel wofi" );
p = ip.plan( { launcher: "rofi", menu: "rofi", theme_name: "bxrig" } );
testkit.check( "a chosen runner gets the BxRig theme even with the default theme", ids( p ) == "theme,apps,launcher,menu" && cmd( p, "theme" ) == "bxrig theme set bxrig" );
p = ip.plan( { theme_name: "bxrig" } );
testkit.check( "the default theme alone adds no step without a desktop or a runner", ids( p ) == "" );
p = ip.plan( { launcher: "noctalia", menu: "rofi" } );
testkit.check( "Noctalia needs no package of its own", cmd( p, "apps" ) == "bxrig install rofi" && cmd( p, "launcher" ) == "bxrig runner set noctalia" );

p = ip.plan( { ssh_key: true, natural_scroll: false, layouts: [] } );
testkit.check( "ssh_key is now a step (optional: ssh-keygen asks for a passphrase), no longer pending", p.pending.len() == 0 && cmd( p, "ssh-key" ) == "bxrig ssh key" && ( p.steps[ 1 ].optional ?: false ) );
testkit.check( "power_setup is a step that skips itself without a battery", cmd( ip.plan( { power_setup: true } ), "power-setup" ) == "bxrig power setup" && find( "power-setup", ids( ip.plan( {} ) ) ) == 0 );
testkit.check( "input_devices: each choice but none is one optional `input offer` step, no answer adds nothing", cmd( ip.plan( { input_devices: "detect" } ), "input-devices" ) == "bxrig input offer --for=detect" && cmd( ip.plan( { input_devices: "logitech" } ), "input-devices" ) == "bxrig input offer --for=logitech" && cmd( ip.plan( { input_devices: "both" } ), "input-devices" ) == "bxrig input offer --for=both" && find( "input-devices", ids( ip.plan( { input_devices: "none" } ) ) ) == 0 && find( "input-devices", ids( ip.plan( {} ) ) ) == 0 && ( ip.plan( { input_devices: "apple" } ).steps[ 1 ].optional ?: false ) );
p = ip.plan( { desktops: "hyprland", input_devices: "apple", gestures: true } );
testkit.check( "the input helpers install before the gestures step needs them", find( "input-devices,gestures", ids( p ) ) > 0 );
pg = ip.plan( { ssh_key: true, git_signing: true, git_email: "ada@example.com" } );
testkit.check( "git_signing is an optional step after the SSH key", cmd( pg, "git-signing" ) == "bxrig git signing on --yes" && find( "ssh-key,git-signing", ids( pg ) ) > 0 && find( "git-signing", ids( ip.plan( { ssh_key: true } ) ) ) == 0 );
testkit.check( "the SSH key takes the git email as its comment", cmd( ip.plan( { ssh_key: true, git_email: "ada@example.com" } ), "ssh-key" ) == "bxrig ssh key --email=ada@example.com" && find( "ssh-key", ids( ip.plan( { ssh_key: false } ) ) ) == 0 );
p = ip.plan( { desktops: "plasma", layouts: [ "us-intl", "es" ] } );
testkit.check( "Plasma gets its keyboard layouts through setup keyboard (not pending)", cmd( p, "plasma-keyboard" ) == "bxrig setup keyboard --layouts=us-intl,es" && p.pending.len() == 0 );
testkit.check( "Hyprland-only has no Plasma keyboard step", find( "plasma-keyboard", ids( ip.plan( { desktops: "hyprland", layouts: [ "us" ] } ) ) ) == 0 );
p = ip.plan( { container_engine: "docker", databases: [ "postgres", "meilisearch" ] } );
testkit.check( "databases: docker is remembered, then each service starts", ids( p ) == "apps,db-engine,db-postgres,db-meilisearch" && cmd( p, "db-engine" ) == "bxrig db engine docker" && cmd( p, "db-postgres" ) == "bxrig db start postgres" && cmd( p, "db-meilisearch" ) == "bxrig db start meilisearch" );
p = ip.plan( { databases: [ "postgres", "redis" ], database_passwords: "ask" } );
testkit.check( "asking for passwords adds the prompt flag, except for engines with no password", cmd( p, "db-postgres" ) == "bxrig db start postgres --ask-password" && cmd( p, "db-redis" ) == "bxrig db start redis" );
testkit.check( "generated passwords add nothing", cmd( ip.plan( { databases: [ "postgres" ], database_passwords: "generate" } ), "db-postgres" ) == "bxrig db start postgres" );
p = ip.plan( { desktops: "hyprland", dotfiles_repo: "https://github.com/me/dotfiles" } );
testkit.check( "your dotfiles are the last step", ids( p ) == "hyprland,session,dotfiles" || ids( p ).endsWith( ",dotfiles" ) );
testkit.check( "dotfiles: the command takes the repo, the method is detected", cmd( p, "dotfiles" ) == "bxrig dotfiles apply https://github.com/me/dotfiles" );
testkit.check( "an empty repo answer adds nothing", find( "dotfiles", ids( ip.plan( { dotfiles_repo: "" } ) ) ) == 0 );
testkit.check( "no databases picked: nothing starts (Podman needs no setting)", ids( ip.plan( { container_engine: "podman", databases: [] } ) ) == "containers" );
testkit.check( "Docker without databases is still remembered", cmd( ip.plan( { container_engine: "docker", databases: [] } ), "db-engine" ) == "bxrig db engine docker" );
p = ip.plan( { desktops: "hyprland", workspaces: 4, natural_scroll: true, layouts: [ "us-intl", "es" ], theme: "light", wallpaper: "nord" } );
testkit.check( "the Hyprland starter takes workspaces, natural scroll, layouts, theme and wallpaper", cmd( p, "hyprland" ) == "bxrig setup hyprland --workspaces=4 --natural-scroll --layouts=us-intl,es --theme=light --wallpaper=nord" && p.pending.len() == 0 );
p = ip.plan( { desktops: "plasma", workspaces: 4, theme: "light" } );
testkit.check( "those answers are pending when Hyprland is not set up", p.pending.toList( "," ) == "workspaces,theme" );
p = ip.plan( { desktops: "hyprland", theme_name: "nord" } );
testkit.check( "a colour theme other than the default is applied after the terminals", cmd( p, "theme" ) == "bxrig theme set nord" );
testkit.check( "Auto mode is passed on to the theme", cmd( ip.plan( { desktops: "plasma", theme_name: "nord", theme: "auto" } ), "theme" ) == "bxrig theme set nord --mode=auto" );
testkit.check( "the default theme needs no step", find( "theme", ids( ip.plan( { desktops: "hyprland", theme_name: "bxrig" } ) ) ) == 0 || !reFind( "(^|,)theme(,|$)", ids( ip.plan( { desktops: "hyprland", theme_name: "bxrig" } ) ) ) );
testkit.check( "a Light answer with the default theme picks BxRig Light", cmd( ip.plan( { desktops: "hyprland", theme_name: "bxrig", theme: "light" } ), "theme" ) == "bxrig theme set bxrig-light" );
p = ip.plan( { vm_windows: "tiny11", vm_linux: "arch-xfce" } );
testkit.check( "a Windows VM and a Linux desktop become optional vm steps", cmd( p, "vm-windows" ) == "bxrig vm create windows --version=tiny11" && cmd( p, "vm-linux" ) == "bxrig vm create linux desktop --tag=arch-xfce" && p.steps.filter( function( s ) { return s.id == "vm-windows" || s.id == "vm-linux"; } ).filter( function( s ) { return s.optional; } ).len() == 2 );
testkit.check( "VMs without a container engine answer also install Podman, first", reFind( "^containers,", ids( p ) ) > 0 );
testkit.check( "none means no vm step and no Podman", ids( ip.plan( { vm_windows: "none", vm_linux: "none" } ) ) == "" );
testkit.check( "no desktop, no theme step", !reFind( "(^|,)theme(,|$)", ids( ip.plan( { theme_name: "nord" } ) ) ) );
testkit.check( "the theme step is optional and comes after the terminal step", ip.plan( { desktops: "hyprland", terminal: "ghostty", theme_name: "nord" } ).steps.filter( function( s ) { return s.id == "theme"; } )[ 1 ].optional && reFind( "terminal,theme", ids( ip.plan( { desktops: "hyprland", terminal: "ghostty", theme_name: "nord" } ) ) ) > 0 );

p = ip.plan( { toolchains: [ "java", "php", "go" ] } );
testkit.check( "toolchains: a catalog profile each, Laravel after PHP", ids( p ) == "toolchain-java,toolchain-php,laravel,toolchain-go" && cmd( p, "toolchain-java" ) == "bxrig profile-install jvm" && cmd( p, "laravel" ) == "composer global require laravel/installer" );
p = ip.plan( { toolchains: [ "javascript" ], js_runtimes: [ "node", "bun", "deno" ] } );
testkit.check( "JavaScript: Node through nvm, Bun and Deno as catalog apps", ids( p ) == "toolchain-node,apps" && cmd( p, "toolchain-node" ) == "bxrig toolchain node" && cmd( p, "apps" ) == "bxrig install bun deno" );
testkit.check( "JavaScript without a runtime answer means Node", cmd( ip.plan( { toolchains: [ "javascript" ] } ), "toolchain-node" ) == "bxrig toolchain node" );
testkit.check( "Bun only is just the catalog app", ids( ip.plan( { toolchains: [ "javascript" ], js_runtimes: [ "bun" ] } ) ) == "apps" );
testkit.check( "python is the python profile", cmd( ip.plan( { toolchains: [ "python" ] } ), "toolchain-python" ) == "bxrig profile-install python" );
testkit.check( "no toolchains, no steps", ip.plan( { toolchains: [] } ).steps.len() == 0 );

testkit.check( "Podman is the containers profile", cmd( ip.plan( { container_engine: "podman" } ), "containers" ) == "bxrig profile-install containers" );
testkit.check( "Docker is one extra package", cmd( ip.plan( { container_engine: "docker" } ), "apps" ) == "bxrig install docker" && find( "containers", ids( ip.plan( { container_engine: "docker" } ) ) ) == 0 );

p = ip.plan( { vpn: "proton", password_manager: "keepassxc", gaming: "steam", backups: [ "snapper", "restic" ] } );
testkit.check( "VPN, password manager, Steam and backups share one install", cmd( p, "apps" ) == "bxrig install proton-vpn keepassxc steam snapper snap-pac restic" );
testkit.check( "VPN none and gaming none add nothing", ip.plan( { vpn: "none", gaming: "none", password_manager: "none" } ).steps.len() == 0 );
testkit.check( "the gaming bundle is the gaming profile", cmd( ip.plan( { gaming: "bundle" } ), "gaming" ) == "bxrig profile-install gaming" );

p = ip.plan( { desktops: "gnome" } );
testkit.check( "an unknown desktop is an error", p.errors.len() == 1 && p.steps.len() == 0 );

// ---- apps: Basic or Customize, the default browser and terminal ----
testkit.check( "Basic installs the recommended set for the chosen desktop", cmd( ip.plan( { desktops: "hyprland", app_mode: "defaults" } ), "apps-basic" ) == "bxrig install --shell=hyprland" && cmd( ip.plan( { desktops: "plasma", app_mode: "defaults" } ), "apps-basic" ) == "bxrig install --shell=plasma" && cmd( ip.plan( { desktops: "both", app_mode: "defaults" } ), "apps-basic" ) == "bxrig install --shell=all" );
testkit.check( "Basic without a desktop answer uses the running desktop", cmd( ip.plan( { app_mode: "defaults" } ), "apps-basic" ) == "bxrig install" );
testkit.check( "no app_mode answer, no app step", find( "apps-basic", ids( ip.plan( { desktops: "hyprland" } ) ) ) == 0 );
sm = { "hypr-tool": [ "hyprland" ], "kde-tool": [ "plasma" ] };
c = { app_mode: "custom", apps_everyday_browsers: [ "firefox" ], apps_media_video: [ "mpv", "hypr-tool", "kde-tool" ] };
c.desktops = "plasma"; p = ip.plan( c, sm );
testkit.check( "Customize installs what was ticked, dropping apps for the other desktop", cmd( p, "apps" ) == "bxrig install firefox mpv kde-tool" && find( "apps-basic", ids( p ) ) == 0 );
c.desktops = "hyprland"; testkit.check( "and the reverse on Hyprland", cmd( ip.plan( c, sm ), "apps" ) == "bxrig install firefox mpv hypr-tool" );
c.desktops = "both"; testkit.check( "Both keeps everything", cmd( ip.plan( c, sm ), "apps" ) == "bxrig install firefox mpv hypr-tool kde-tool" );
p = ip.plan( { app_mode: "custom", default_browser: "brave", apps_everyday_browsers: [ "firefox" ] } );
testkit.check( "the default browser is installed too (even when not ticked) and set as default, after the install", cmd( p, "apps" ) == "bxrig install firefox brave" && cmd( p, "default-browser" ) == "bxrig default browser brave" && ids( p ) == "apps,default-browser" );
p = ip.plan( { app_mode: "defaults", file_manager: "strata", toolchains: [ "rust" ] } );
testkit.check( "file manager: installed, then set as default; rust: rustup stable, optional", cmd( p, "apps" ) == "bxrig install strata" && cmd( p, "default-filemanager" ) == "bxrig default filemanager strata" && cmd( p, "toolchain-rust" ) == "rustup default stable" && cmd( p, "strata-integrations" ) == "bxrig strata integrations" );
p = ip.plan( { app_mode: "defaults" } );
testkit.check( "Basic sets Gwenview for images and Okular for PDFs, after the install, optional", find( "apps-basic", ids( p ) ) < find( "default-images", ids( p ) ) && left( cmd( p, "default-images" ), 62 ) == "xdg-mime default org.kde.gwenview.desktop image/png image/jpeg" && cmd( p, "default-pdf" ) == "xdg-mime default org.kde.okular.desktop application/pdf" );
p = ip.plan( { app_mode: "custom", apps_everyday_documents: [ "okular" ] } );
testkit.check( "Customize sets only the viewers that were ticked", find( "default-pdf", ids( p ) ) > 0 && find( "default-images", ids( p ) ) == 0 );
p = ip.plan( { app_mode: "defaults", dictation: "voxtype" } );
testkit.check( "dictation voxtype installs voxtype and wtype", cmd( p, "apps" ) == "bxrig install voxtype wtype" );
p = ip.plan( { app_mode: "defaults", web_bundles: [ "google", "apple" ] } );
testkit.check( "web bundles: one optional step each", cmd( p, "web-google" ) == "bxrig web install google" && cmd( p, "web-apple" ) == "bxrig web install apple" );
p = ip.plan( { app_mode: "defaults", boxlang_modules: [ "bx-ai", "bx-sites" ], boxlang_vscode: true } );
testkit.check( "BoxLang modules and the VS Code extension are optional steps", cmd( p, "boxlang-modules" ) == "bxrig boxlang modules install bx-ai bx-sites" && cmd( p, "boxlang-vscode" ) == "bxrig boxlang vscode" );
p = ip.plan( { app_mode: "defaults", update_channel: "beta", update_notifications: true } );
testkit.check( "update channel and notifications", cmd( p, "update-channel" ) == "bxrig update channel beta" && cmd( p, "update-notifications" ) == "bxrig update notifications on" );
p = ip.plan( { app_mode: "defaults", agent_skills: [ "bxrig", "boxlang" ] } );
testkit.check( "agent skills are one optional step", cmd( p, "agent-skills" ) == "bxrig skills install bxrig boxlang" );
p = ip.plan( { app_mode: "defaults", dictation: "none" } );
testkit.check( "dictation none adds nothing", ids( p ) == "apps-basic,default-images,default-pdf" );
p = ip.plan( { desktops: "plasma", app_mode: "defaults", workspaces: 4, plasma_panels: "bxrig" } );
testkit.check( "Plasma: the panel layout step with 4 desktops, and its widgets are installed", cmd( p, "plasma-panels" ) == "bxrig plasma panels apply --desktops=4" && find( "panel-colorizer", cmd( p, "apps" ) ) > 0 && find( "window-title", cmd( p, "apps" ) ) > 0 && find( "kvitals", cmd( p, "apps" ) ) > 0 && find( "kdeplasma-addons", cmd( p, "apps" ) ) > 0 );
p = ip.plan( { desktops: "plasma", app_mode: "defaults", workspaces: 3, plasma_panels: "bxrig", plasma_weather: false, plasma_agenda: true } );
testkit.check( "Plasma: no weather and the agenda clock", cmd( p, "plasma-panels" ) == "bxrig plasma panels apply --desktops=3 --without-weather --agenda" && find( "event-calendar", cmd( p, "apps" ) ) > 0 && find( "kdeplasma-addons", cmd( p, "apps" ) ) == 0 );
p = ip.plan( { desktops: "both", app_mode: "defaults", plasma_panels: "keep" } );
testkit.check( "Plasma: keeping your panels only sets the desktops", cmd( p, "plasma-desktops" ) == "bxrig plasma desktops 4" && cmd( p, "plasma-panels" ) == "" );
p = ip.plan( { desktops: "hyprland", app_mode: "defaults" } );
p = ip.plan( { desktops: "plasma", app_mode: "defaults" } );
testkit.check( "Plasma without a panels answer adds no panel step", cmd( p, "plasma-panels" ) == "" && cmd( p, "plasma-desktops" ) == "" );
p = ip.plan( { desktops: "hyprland", app_mode: "defaults" } );
testkit.check( "Hyprland only: no Plasma panel steps", cmd( p, "plasma-panels" ) == "" && cmd( p, "plasma-desktops" ) == "" );
p = ip.plan( { app_mode: "defaults", default_browser: "firefox" } );
testkit.check( "in Basic mode a different default browser is added to the install", ids( p ) == "apps-basic,apps,default-browser,default-images,default-pdf" && cmd( p, "apps" ) == "bxrig install firefox" );
testkit.check( "the default terminal follows the terminal answer", cmd( ip.plan( { terminal: "kitty" } ), "default-terminal" ) == "bxrig default terminal kitty" );

// ---- AI: agents, keys, default ----
p = ip.plan( { ai_agents: [ "claude-code", "codex-cli" ], ai_default: "codex-cli", ai_keys: "later" } );
testkit.check( "agents are installed, a keyring is checked, and the default is set", cmd( p, "apps" ) == "bxrig install claude-code codex-cli tmux" && cmd( p, "secrets-setup" ) == "bxrig secrets setup" && cmd( p, "ai-default" ) == "bxrig ai default codex-cli" );
testkit.check( "keys 'later' asks for nothing", find( "key-", ids( p ) ) == 0 );
testkit.check( "the keyring check comes after the install and before the default", ids( p ) == "apps,secrets-setup,ai-default" );
p = ip.plan( { ai_agents: [ "claude-code", "gemini-cli" ], ai_keys: "now", ai_global_keys: [ "GEMINI_API_KEY", "OPENAI_API_KEY" ] } );
testkit.check( "keys 'now' types one key per chosen agent, as optional steps", cmd( p, "key-ANTHROPIC_API_KEY" ) == "bxrig secrets set ANTHROPIC_API_KEY" && cmd( p, "key-GEMINI_API_KEY" ) == "bxrig secrets set GEMINI_API_KEY" && find( "key-OPENAI_API_KEY", ids( p ) ) == 0 );
optional = true; for ( s in p.steps ) if ( left( s.id, 4 ) == "key-" && !( s.optional ?: false ) ) optional = false;
testkit.check( "key steps are optional (skipping never stops the plan)", optional );
testkit.check( "a global export is planned only for a key of a chosen agent", cmd( p, "global-GEMINI_API_KEY" ) == "bxrig secrets global on GEMINI_API_KEY" && find( "global-OPENAI_API_KEY", ids( p ) ) == 0 );
p = ip.plan( { ai_agents: [ "opencode-cli" ], ai_keys: "now", ai_providers: [ "novita", "openrouter", "anthropic" ], ai_global_keys: [ "NOVITA_API_KEY", "GROQ_API_KEY" ] } );
testkit.check( "a many-provider agent implies no key; the ticked providers are asked", cmd( p, "key-NOVITA_API_KEY" ) == "bxrig secrets set NOVITA_API_KEY" && cmd( p, "key-OPENROUTER_API_KEY" ) == "bxrig secrets set OPENROUTER_API_KEY" && cmd( p, "key-ANTHROPIC_API_KEY" ) == "bxrig secrets set ANTHROPIC_API_KEY" && find( "key-OPENAI_API_KEY", ids( p ) ) == 0 );
testkit.check( "global export only for keys that are being typed", cmd( p, "global-NOVITA_API_KEY" ) == "bxrig secrets global on NOVITA_API_KEY" && find( "global-GROQ_API_KEY", ids( p ) ) == 0 );
p = ip.plan( { ai_agents: [ "claude-code" ], ai_keys: "now", ai_providers: [ "anthropic", "novita" ] } );
testkit.check( "a key is asked once even when the agent and the providers both name it", ids( p ) == "apps,secrets-setup,key-ANTHROPIC_API_KEY,key-NOVITA_API_KEY" );
testkit.check( "an unknown provider is an error", ip.plan( { ai_keys: "now", ai_providers: [ "nope" ] } ).errors.len() == 1 );
testkit.check( "local model apps you tick are installed as they are", cmd( ip.plan( { ai_local: [ "ollama", "jan" ] } ), "apps" ) == "bxrig install ollama jan" );
testkit.check( "Plasma with an agent also installs Yakuake for the pull-down AI shell", cmd( ip.plan( { desktops: "plasma", ai_agents: [ "claude-code" ] } ), "apps" ) == "bxrig install claude-code tmux yakuake" && cmd( ip.plan( { desktops: "both", ai_agents: [ "claude-code" ] } ), "apps" ) == "bxrig install claude-code tmux yakuake" );
testkit.check( "Hyprland only, or Plasma without agents, adds no Yakuake", cmd( ip.plan( { desktops: "hyprland", ai_agents: [ "claude-code" ] } ), "apps" ) == "bxrig install claude-code tmux" && find( "apps", ids( ip.plan( { desktops: "plasma" } ) ) ) == 0 );
p = ip.plan( { ai_local_setup: "now" } );
testkit.check( "local AI now: one optional ai setup step with the balanced pick", ids( p ) == "ai-setup" && cmd( p, "ai-setup" ) == "bxrig ai setup --yes" && p.steps[ 1 ].optional );
testkit.check( "local AI: all three picks and the tune when asked", cmd( ip.plan( { ai_local_setup: "now", ai_local_picks: "all", ai_local_tune: true } ), "ai-setup" ) == "bxrig ai setup --yes --picks=all --tune" );
testkit.check( "local AI later (the default): no step", find( "ai-setup", ids( ip.plan( { ai_local_setup: "later", ai_local_tune: true } ) ) ) == 0 && find( "ai-setup", ids( ip.plan( {} ) ) ) == 0 );
bp = ip.plan( { ai_local_setup: "now", boxy: "now" } );
testkit.check( "Boxy now: bx-agents, then Boxy, both optional and after the local AI", cmd( bp, "bx-agents" ) == "bxrig ai agents install --yes" && cmd( bp, "boxy" ) == "bxrig ai agents setup --yes"
	&& listFind( ids( bp ), "ai-setup" ) < listFind( ids( bp ), "bx-agents" ) && listFind( ids( bp ), "bx-agents" ) < listFind( ids( bp ), "boxy" ) );
testkit.check( "Boxy later (the default): no step", find( "boxy", ids( ip.plan( { boxy: "later" } ) ) ) == 0 && find( "bx-agents", ids( ip.plan( {} ) ) ) == 0 );
testkit.check( "tmux comes with the agents", cmd( ip.plan( { ai_agents: [ "claude-code" ] } ), "apps" ) == "bxrig install claude-code tmux" );
p = ip.plan( { container_engine: "podman", docker_compat: true } );
testkit.check( "Podman with docker compatibility adds the shim step after the containers profile", ids( p ) == "containers,docker-compat" && cmd( p, "docker-compat" ) == "bxrig containers docker-compat" );
testkit.check( "no docker shim without the answer, or on Docker", find( "docker-compat", ids( ip.plan( { container_engine: "podman" } ) ) ) == 0 && find( "docker-compat", ids( ip.plan( { container_engine: "docker", docker_compat: true } ) ) ) == 0 );
testkit.check( "the LazyVim starter is a step", cmd( ip.plan( { editor_starter: "lazyvim" } ), "editor-lazyvim" ) == "bxrig editor lazyvim" && find( "editor-lazyvim", ids( ip.plan( { editor_starter: "none" } ) ) ) == 0 );
p = ip.plan( { desktop_utilities: [ "cliphist", "wf-recorder", "playerctl" ] } );
testkit.check( "desktop utilities are installed in the one apps step", cmd( p, "apps" ) == "bxrig install cliphist wf-recorder playerctl" );
p = ip.plan( { vpn: "nordvpn", remote_desktop: [ "remmina", "rustdesk" ] } );
testkit.check( "NordVPN is installed, then set up (optional step); remote desktop apps join the install", cmd( p, "apps" ) == "bxrig install remmina rustdesk nordvpn" && cmd( p, "vpn-nordvpn" ) == "bxrig vpn nordvpn setup" && ( p.steps[ 2 ].optional ?: false ) );
testkit.check( "NordLayer is installed and needs no extra step", cmd( ip.plan( { vpn: "nordlayer" } ), "apps" ) == "bxrig install nordlayer" && ip.plan( { vpn: "nordlayer" } ).steps.len() == 1 );
testkit.check( "cloud storage installs rclone and fuse3, and nothing without the answer", cmd( ip.plan( { cloud_storage: true } ), "apps" ) == "bxrig install rclone fuse3" && ip.plan( { cloud_storage: false } ).steps.len() == 0 );
p = ip.plan( { desktops: "plasma", plasma_layout: "master" } );
plStep = p.steps.filter( function( x ) { return x.id == "plasma-layout"; } )[ 1 ];
testkit.check( "the Plasma layout is an optional tiling layout step", cmd( p, "plasma-layout" ) == "bxrig tiling layout master" && ( plStep.optional ?: false ) );
testkit.check( "no Plasma layout step on Hyprland only, and an unknown layout is an error", find( "plasma-layout", ids( ip.plan( { desktops: "hyprland", plasma_layout: "master" } ) ) ) == 0 && ip.plan( { desktops: "plasma", plasma_layout: "spiral" } ).errors.len() == 1 );
testkit.check( "no keys step without an answer", find( "key-", ids( ip.plan( { ai_agents: [ "claude-code" ] } ) ) ) == 0 );
p = ip.plan( { ai_agents: [ "claude-code" ], ai_default: "gemini-cli" } );
testkit.check( "a default agent that was not ticked is installed too", cmd( p, "apps" ) == "bxrig install claude-code gemini-cli tmux" );
testkit.check( "an unknown default agent is an error", ip.plan( { ai_default: "bogus" } ).errors.len() == 1 );
testkit.check( "no agents, no keyring step", ip.plan( { ai_agents: [], ai_keys: "later" } ).steps.len() == 0 );


// NAS, remote backups and the backup layers
p = ip.plan( { nas_use: true, nas_name: "synology", nas_host: "ds920.local", nas_protocol: "smb", nas_user: "luis", nas_share: "backups", nas_auto: true, backup_layers: [ "config", "snapshots", "data" ], backup_schedule: "daily" } );
testkit.check( "a NAS: tools, save (password asked in the terminal), mount, automount, use as a backup place", cmd( p, "nas-setup" ) == "bxrig nas setup --yes" && cmd( p, "nas-add" ) == "bxrig nas add synology --host=ds920.local --protocol=smb --user=luis --ask-password" && cmd( p, "nas-mount" ) == "bxrig nas mount synology backups --yes" && cmd( p, "nas-auto" ) == "bxrig nas auto on synology backups --yes" && cmd( p, "nas-use" ) == "bxrig nas use synology backups" );
testkit.check( "files: restic is installed, the repository is created on the NAS, it becomes the default, a daily schedule", find( "restic", cmd( p, "apps" ) ) > 0 && cmd( p, "backup-init-nas-synology" ) == "bxrig backup data init nas-synology --yes" && cmd( p, "backup-default" ) == "bxrig backup data default nas-synology" && cmd( p, "backup-schedule" ) == "bxrig backup data schedule daily --yes" );
testkit.check( "system snapshots are a step; the config layer needs none", cmd( p, "backup-snapshots" ) == "bxrig backup snapshots setup --yes" && find( "backup-config-off", ids( p ) ) == 0 );
testkit.check( "the NAS steps never stop the plan", p.steps.filter( function( s ) { return left( s.id, 3 ) == "nas" && s.id != "nas-use"; } ).every( function( s ) { return s.optional ?: false; } ) && p.errors.len() == 0 );
testkit.check( "no password is in any step", ( function() { for ( s in p.steps ) if ( findNoCase( "password=", s.argv.toList( " " ) ) ) return false; return true; } )() );
p = ip.plan( { nas_use: true, nas_name: "vault", nas_host: "10.0.0.5", nas_protocol: "nfs", nas_share: "/volume1/media", backup_layers: [] } );
testkit.check( "NFS has no user or password; with no layers the config snapshots go off", cmd( p, "nas-add" ) == "bxrig nas add vault --host=10.0.0.5 --protocol=nfs" && cmd( p, "backup-config-off" ) == "bxrig backup config auto off" );
p = ip.plan( { nas_use: true, nas_name: "x", nas_protocol: "smb" } );
testkit.check( "a NAS without an address or user is an error", p.errors.len() == 1 && find( "nas_host", p.errors[ 1 ] ) > 0 );
p = ip.plan( { remote_type: "s3", remote_name: "spaces", remote_endpoint: "https://nyc3.digitaloceanspaces.com", remote_bucket: "mybackups", remote_region: "nyc3", remote_path: "bx", backup_layers: [ "data" ], backup_schedule: "hourly" } );
testkit.check( "S3: the target is added with --ask-keys, then created, then scheduled", cmd( p, "backup-remote" ) == "bxrig backup data target add spaces --type=s3 --bucket=mybackups --endpoint=https://nyc3.digitaloceanspaces.com --region=nyc3 --path=bx --ask-keys" && cmd( p, "backup-init-spaces" ) == "bxrig backup data init spaces --yes" && cmd( p, "backup-schedule" ) == "bxrig backup data schedule hourly --yes" );
p = ip.plan( { remote_type: "gs", remote_name: "g", remote_bucket: "b", backup_layers: [] } );
testkit.check( "Google needs the project and the key file", p.errors.len() == 1 && find( "remote_credentials", p.errors[ 1 ] ) > 0 );
p = ip.plan( { remote_type: "local", remote_name: "usb", remote_path: "/run/media/me/disk/repo", backup_layers: [ "data" ], backup_schedule: "off" } );
testkit.check( "a disk needs only a path; schedule off adds no timer", cmd( p, "backup-remote" ) == "bxrig backup data target add usb --type=local --path=/run/media/me/disk/repo" && find( "backup-schedule", ids( p ) ) == 0 );
p = ip.plan( { backup_layers: [ "data" ] } );
testkit.check( "files without any place are told what to do", p.pending.len() == 1 && find( "no NAS or remote place", p.pending[ 1 ] ) > 0 );
testkit.check( "nothing is added when nothing is asked", find( "nas-add", ids( ip.plan( {} ) ) ) == 0 && find( "backup-remote", ids( ip.plan( {} ) ) ) == 0 && find( "backup-config-off", ids( ip.plan( {} ) ) ) == 0 );
// every password manager the wizard offers is a Security app of the catalog, and the plan installs it by that id
cat = new bxrig.Catalog();
pages = jsonDeserialize( new bxrig.WizardData().demoPages() ).pages;
pmValues = [];
for ( pg in pages ) for ( q in pg.questions ) if ( compare( q.id, "password_manager" ) == 0 ) for ( o in q.options ) pmValues.append( o.value );
testkit.check( "the wizard offers ten password managers", pmValues.len() == 10 );
allCatalog = true;
for ( v in pmValues ) { app = cat.find( cat.load(), v ); if ( !structKeyExists( app, "category" ) || compare( app.category, "Security" ) != 0 ) allCatalog = false; }
testkit.check( "every password manager option is a Security app of the catalog", allCatalog );
for ( v in [ "proton-pass", "enpass", "nordpass", "keeper", "bitwarden-cli", "pass", "gopass" ] ) testkit.check( "password manager " & v & " installs by its catalog id", cmd( ip.plan( { password_manager: v } ), "apps" ) == "bxrig install " & v );
// ---- the top bar layout, app grid style and theme pages ----
p = ip.plan( { desktops: "hyprland", bar_layout: "dense", appgrid_style: "terminal", theme_name: "nord", bar_position: "top", dock: true } );
testkit.check( "bar layout and app grid steps run `appearance` after the desktop setup, theme, bar and dock", ids( p ) == "hyprland,theme,icons,bar,dock,bar-layout,appgrid,xremap,session" || ids( p ) == "hyprland,theme,icons,bar,dock,bar-layout,appgrid,xremap,default-terminal,session" || reFind( "^hyprland,theme,icons,bar,dock,bar-layout,appgrid", ids( p ) ) > 0 );
testkit.check( "the commands are `bxrig appearance bar layout X` and `appearance appgrid X`, optional (Noctalia may not run during the install)", cmd( p, "bar-layout" ) == "bxrig appearance bar layout dense" && cmd( p, "appgrid" ) == "bxrig appearance appgrid terminal" && p.steps.filter( function( s ) { return ( s.id == "bar-layout" || s.id == "appgrid" ) && ( s.optional ?: false ); } ).len() == 2 );
testkit.check( "the theme step is `theme set X`", cmd( p, "theme" ) == "bxrig theme set nord" );
testkit.check( "the dock answer is the persistent `appearance dock on|off`, not the runtime show and hide", cmd( p, "dock" ) == "bxrig appearance dock on" && cmd( ip.plan( { desktops: "hyprland", dock: false } ), "dock" ) == "bxrig appearance dock off" );
testkit.check( "the defaults add the layout and the grid: standard and launchpad", cmd( ip.plan( { desktops: "hyprland", bar_layout: "standard", appgrid_style: "launchpad" } ), "bar-layout" ) == "bxrig appearance bar layout standard" && cmd( ip.plan( { desktops: "both", appgrid_style: "launchpad" } ), "appgrid" ) == "bxrig appearance appgrid launchpad" );
testkit.check( "no bar or grid step without Hyprland: the answers are pending", find( "bar-layout", ids( ip.plan( { desktops: "plasma", bar_layout: "dense" } ) ) ) == 0 && ip.plan( { desktops: "plasma", bar_layout: "dense", appgrid_style: "terminal" } ).pending.toList( "," ) == "bar_layout,appgrid_style" );
testkit.check( "an unknown layout or grid is an error, not a command", ip.plan( { desktops: "hyprland", bar_layout: "huge" } ).errors.len() == 1 && ip.plan( { desktops: "hyprland", appgrid_style: "list" } ).errors.len() == 1 );
// going back to the default theme from another one still runs `theme set`: the planner is told what is applied now
testkit.check( "bxrig chosen again while nord is applied runs theme set bxrig", cmd( ip.plan( { desktops: "hyprland", theme_name: "bxrig" }, {}, { theme: "nord" } ), "theme" ) == "bxrig theme set bxrig" && find( "theme", ids( ip.plan( { desktops: "hyprland", theme_name: "bxrig" }, {}, { theme: "bxrig" } ) ) ) == 0 );
testkit.check( "the theme step is `theme set X` for KDE only too (the theme page is for every desktop)", cmd( ip.plan( { desktops: "plasma", theme_name: "nord" } ), "theme" ) == "bxrig theme set nord" );

testkit.done( "all passed" );
